{"key":"tree-preorder-0349ca07e442ae48","sourceHash":"0349ca07e442ae4886ba7d029386cb95f8714f30615cb6ad7cb3ef8ec6a737fe","pattern":"tree-preorder","category":"trees","title":"Preorder DFS: Mental Model","idea":"Process the node before its children so parent context is available first.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn preorder(root: &Tree) -> Vec<i32> {\n    fn visit(root: &Tree, out: &mut Vec<i32>) {\n        if let Some(n) = root {\n            out.push(n.value);\n            visit(&n.left, out);\n            visit(&n.right, out);\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(preorder(&node(\n        1,\n        node(2, node(4, None, None), node(5, None, None)),\n        node(3, None, node(6, None, None)),\n    )));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":24,"function":"preorder","statement":"let mut out = Vec::new();"},{"line":25,"function":"preorder","statement":"visit(root, &mut out);"},{"line":26,"function":"preorder","statement":"out"},{"line":18,"function":"visit","statement":"if let Some(n) = root {"},{"line":19,"function":"visit","statement":"out.push(n.value);"},{"line":20,"function":"visit","statement":"visit(&n.left, out);"},{"line":21,"function":"visit","statement":"visit(&n.right, out);"},{"line":22,"function":"visit","statement":"}"},{"line":30,"function":"main","statement":"let result = csv(preorder(&node("},{"line":35,"function":"main","statement":"println!(\"{result}\");"