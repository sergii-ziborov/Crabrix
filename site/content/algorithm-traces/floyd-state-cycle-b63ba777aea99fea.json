{"key":"floyd-state-cycle-b63ba777aea99fea","sourceHash":"b63ba777aea99feacac9910fd5bde12dfe3a974180e11b782649a2072be71333","pattern":"floyd-state-cycle","category":"scans","title":"Floyd State Cycle Detection: Mental Model","idea":"Advance one state once and another twice; their meeting proves a cycle without a visited set.","complexity":"O(mu + lambda) time · O(1) space","source":"fn cycle_entry(next: &[usize]) -> usize {\n    let (mut slow, mut fast) = (next[0], next[next[0]]);\n    while slow != fast {\n        slow = next[slow];\n        fast = next[next[fast]];\n    }\n    slow = 0;\n    while slow != fast {\n        slow = next[slow];\n        fast = next[fast];\n    }\n    slow\n}\n\nfn main() {\n    let result = cycle_entry(&[1, 2, 3, 1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"cycle_entry","statement":"let (mut slow, mut fast) = (next[0], next[next[0]]);"},{"line":3,"function":"cycle_entry","statement":"while slow != fast {"},{"line":4,"function":"cycle_entry","statement":"slow = next[slow];"},{"line":5,"function":"cycle_entry","statement":"fast = next[next[fast]];"},{"line":6,"function":"cycle_entry","statement":"}"},{"line":7,"function":"cycle_entry","statement":"slow = 0;"},{"line":8,"function":"cycle_entry","statement":"while slow != fast {"},{"line":9,"function":"cycle_entry","statement":"slow = next[slow];"},{"line":10,"function":"cycle_entry","statement":"fast = next[fast];"},{"line":11,"function":"cycle_entry","statement":"}"},{"line":12,"function":"cycle_entry","statement":"slow"},{"line":16,"function":"main","statement":"let result = cycle_entry(&[1, 2, 3, 1]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"next=[1,2,3,1]","stdout":"1\n","values":[{"type":"&[usize]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"