{"key":"tree-serialize-4f8c2f897bae1bb0","sourceHash":"4f8c2f897bae1bb0c44c5bb72ae74cbdf9514995cba6ac815b7f6626cb7d0408","pattern":"tree-serialize","category":"trees","title":"Challenge: Tree Serialize/Deserialize","idea":"Emit null markers as well as values so structure is reconstructible, not only traversal order.","complexity":"O(n) time · O(n) output","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\n\nfn serialize(root: &Tree) -> String {\n    fn visit(root: &Tree, out: &mut Vec<String>) {\n        match root {\n            None => out.push(\"#\".into()),\n            Some(n) => {\n                out.push(n.value.to_string());\n                visit(&n.left, out);\n                visit(&n.right, out);\n            }\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out.join(\",\")\n}\nfn deserialize(text: &str) -> Tree {\n    // Tokens arrive in the same preorder, so each # closes exactly one child.\n    fn build<'a>(tokens: &mut impl Iterator<Item = &'a str>) -> Tree {\n        match tokens.next() {\n            None | Some(\"#\") => None,\n            Some(token) => {\n                let value = token.parse().unwrap();\n                let left = build(tokens);\n                let right = build(tokens);\n                node(value, left, right)\n            }\n        }\n    }\n    build(&mut text.split(','))\n}\nfn round_trip(root: &Tree) -> String {\n    let text = serialize(root);\n    assert_eq!(serialize(&deserialize(&text)), text);\n    text\n}\nfn inorder_values(root: &Tree) -> Vec<i32> {\n    match root {\n        None => Vec::new(),\n        Some(n) => {\n            let mut out = inorder_values(&n.left);\n            out.push(n.value);\n            out.extend(inorder_values(&n.right));\n            out\n        }\n    }\n}\n\nfn main() {\n    let result = round_trip(&node(1, None, None));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":22,"function":"serialize","statement":"let mut out = Vec::new();"},{"line":23,"function":"serialize","statement":"visit(root, &mut out);"},{"line":24,"function":"serialize","statement":"out.join(\",\")"},{"line":13,"function":"visit","statement":"match root {"},{"line":16,"function":"visit","statement":"out.push(n.value.to_string());"},{"line":17,"function":"visit","statement":"visit(&n.left, out);"},{"line":18,"function":"visit","statement":"visit(&n.right, out);"},{"line":19,"function":"visit","statement":"}"},{"line":39,"function":"deserialize","statement":"build(&mut text.split(','))"},{"line":29,"function":"build","statement":"match tokens.next() {"},{"line":32,"function":"build","statement":"let value = token.parse().unwrap();"},{"line":33,"function":"build","statement":"let left = build(tokens);"},{"line":34,"function":"build","statement":"let right = build(tokens);"},{"line":35,"function":"build","statement":"node(value, left, right)"},{"line":42,"function":"round_trip","statement":"let text = serialize(root);"},{"line":43,"function":"round_trip","statement":"assert_eq!(serialize(&deserialize(&text)), text);"},{"line":44,"function":"round_trip","statement":"text"},{"line":47,"function":"inorder_values","statement":"match root {"},{"line":50,"function":"inorder_values","statement":"let mut out = inorder_values(&n.left);"},{"line":51,"function":"inorder_values","statement":"out.push(n.value);"},{"line":52,"function":"inorder_values","statement":"out.extend(inorder_values(&n.right));"},{"line":53,"function":"inorder_values","statement":"out"},{"line":59,"function":"main","statement":"let result = round_trip(&node(1, None, None));"},{"line":60,"function":"main","statement":"println!(\"{result}\");"},{"line":61,"function":"main","statement":"}"}],"version":1,"input":"tree=[1]","stdout