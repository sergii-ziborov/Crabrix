{"key":"word-break-dp-4eff3cec719bbcc5","sourceHash":"4eff3cec719bbcc50ac328fefeaf2e4becbf2503757518e0070532bc7f5e548d","pattern":"word-break-dp","category":"dynamic-1d","title":"Word Break DP: Mental Model","idea":"Mark a prefix reachable when an earlier reachable prefix is followed by a dictionary word.","complexity":"O(n * dictionary characters) direct suffix comparisons · O(n) state","source":"fn word_break(text: &str, words: &[&str]) -> bool {\n    assert!(text.is_ascii());\n    let mut possible = vec![false; text.len() + 1];\n    possible[0] = true;\n    for end in 1..=text.len() {\n        possible[end] = words.iter().any(|word| {\n            word.len() <= end && possible[end - word.len()] && &text[end - word.len()..end] == *word\n        });\n    }\n    possible[text.len()]\n}\n\nfn main() {\n    let result = word_break(\"leetcode\", &[\"leet\", \"code\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"word_break","statement":"assert!(text.is_ascii());"},{"line":3,"function":"word_break","statement":"let mut possible = vec![false; text.len() + 1];"},{"line":4,"function":"word_break","statement":"possible[0] = true;"},{"line":5,"function":"word_break","statement":"for end in 1..=text.len() {"},{"line":6,"function":"word_break","statement":"possible[end] = words.iter().any(|word| {"},{"line":9,"function":"word_break","statement":"}"},{"line":10,"function":"word_break","statement":"possible[text.len()]"},{"line":7,"function":"closure · line 6","statement":"word.len() <= end && possible[end - word.len()] && &text[end - word.len()..end] == *word"},{"line":14,"function":"main","statement":"let result = word_break(\"leetcode\", &[\"leet\", \"code\"]).to_string();"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"input":"text=leetcode dict=[leet,code]","stdout":"true\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"leetcode\""}},{"type":"&[&s