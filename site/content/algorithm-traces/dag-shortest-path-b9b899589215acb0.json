{"key":"dag-shortest-path-b9b899589215acb0","sourceHash":"b9b899589215acb075cf4303f15d7f3f94052f826b7a548060d370ddc200a646","pattern":"dag-shortest-path","category":"weighted-graphs","title":"Challenge: DAG Shortest Path","idea":"Relax outgoing edges once in topological order because no path can return to an earlier node.","complexity":"O(V+E) time · O(V) space","source":"fn dag_distance(graph: &[Vec<(usize, i64)>], start: usize, goal: usize) -> i64 {\n    let n = graph.len();\n    let mut degree = vec![0; n];\n    for ns in graph {\n        for &(u, _) in ns {\n            degree[u] += 1;\n        }\n    }\n    let mut queue: std::collections::VecDeque<_> = (0..n).filter(|&v| degree[v] == 0).collect();\n    let mut distance = vec![i64::MAX; n];\n    distance[start] = 0;\n    let mut visited = 0;\n    while let Some(v) = queue.pop_front() {\n        visited += 1;\n        for &(u, w) in &graph[v] {\n            if distance[v] != i64::MAX {\n                distance[u] = distance[u].min(distance[v].checked_add(w).unwrap());\n            }\n            degree[u] -= 1;\n            if degree[u] == 0 {\n                queue.push_back(u);\n            }\n        }\n    }\n    assert_eq!(visited, n);\n    if distance[goal] == i64::MAX {\n        -1\n    } else {\n        distance[goal]\n    }\n}\n\nfn main() {\n    let result = dag_distance(&[vec![(4, 2)], vec![], vec![], vec![], vec![]], 0, 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"dag_distance","statement":"let n = graph.len();"},{"line":3,"function":"dag_distance","statement":"let mut degree = vec![0; n];"},{"line":4,"function":"dag_distance","statement":"for ns in graph {"},{"line":5,"function":"dag_distance","statement":"for &(u, _) in ns {"},{"line":6,"function":"dag_distance","statement":"degree[u] += 1;"},{"line":7,"function":"dag_distance","statement":"}"},{"line":9,"function":"dag_distance","statement":"let mut queue: std::collections::VecDeque<_> = (0..n).filter(|&v| degree[v] == 0).collect();"},{"line":10,"function":"dag_distance","statement":"let mut distance = vec![i64::MAX; n];"},{"line":11,"function":"dag_distance","statement":"distance[start] = 0;"},{"line":12,"function":"dag_distance","statement":"let mut visited = 0;"},{"line":13,"function":"dag_distance","statement":"while let Some(v) = queue.pop_front() {"},{"line":14,"function":"dag_distance","statement":"visited += 1;"},{"line":15,"function":"dag_distance","statement":"for &(u, w) in &graph[v] {"},{"line":16,"function":"dag_distance","statement":"if distance[v] != i64::MAX {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":17,"function":"dag_distance","statement":"distance[u] = distance[u].min(distance[v].checked_add(w).unwrap());","edge":{"collection":"graph","from":"v","to":"u"}},{"line":18,"function":"dag_distance","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":19,"function":"dag_distance","statement":"degree[u] -= 1;","edge":{"collection":"graph","from":"v","to":"u"}},{"line":20,"function":"dag_distance","statement":"if degree[u] == 0 {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":21,"function":"dag_distance","statement":"queue.push_back(u);","edge":{"collection":"graph","from":"v","to":"u"}},{"line":22,"function":"dag_distance","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":25,"function":"dag_distance","statement":"assert_eq!(visited, n);"},{"line":26,"function":"dag_distance","statement":"if distance[goal] == i64::MAX {"},{"line":27,"function":"dag_distance","statement":"-1"},{"line":29,"function":"dag_distance","statement":"distance[goal]"},{"line":9,"function":"closure · line 9","statement":"degree[v] == 0"},{"line":34,"function":"main","statement":"let result = dag_distance(&[vec![(4, 2)], vec![], vec![], vec![], vec![]], 0, 4).to_string();"},{"line":35,"function":"main","statement":"println!(\"{result}\");"},{"line":36,"function":"main","statement":"}"}],"version":1,"input":"0->4