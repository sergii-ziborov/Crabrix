{"key":"palindrome-partition-6aaba1d417faa2d1","sourceHash":"6aaba1d417faa2d13b3d119b73863f091b2dbf7a47f7fe4982d6c56443faab6d","pattern":"palindrome-partition","category":"backtracking","title":"Palindrome Partitioning: Mental Model","idea":"Choose each palindromic prefix as the next piece and recurse on the remaining suffix.","complexity":"O(n*2^n) worst · O(n^2) palindrome work","source":"fn palindrome_partitions(text: &str) -> usize {\n    assert!(text.is_ascii());\n    let a = text.as_bytes();\n    let n = a.len();\n    let mut palindrome = vec![vec![false; n]; n];\n    for i in (0..n).rev() {\n        for j in i..n {\n            palindrome[i][j] = a[i] == a[j] && (j - i < 2 || palindrome[i + 1][j - 1]);\n        }\n    }\n    fn count(i: usize, p: &[Vec<bool>]) -> usize {\n        if i == p.len() {\n            return 1;\n        }\n        (i..p.len())\n            .filter(|&j| p[i][j])\n            .map(|j| count(j + 1, p))\n            .sum()\n    }\n    count(0, &palindrome)\n}\n\nfn main() {\n    let result = palindrome_partitions(\"aab\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"palindrome_partitions","statement":"assert!(text.is_ascii());"},{"line":3,"function":"palindrome_partitions","statement":"let a = text.as_bytes();"},{"line":4,"function":"palindrome_partitions","statement":"let n = a.len();"},{"line":5,"function":"palindrome_partitions","statement":"let mut palindrome = vec![vec![false; n]; n];"},{"line":6,"function":"palindrome_partitions","statement":"for i in (0..n).rev() {"},{"line":7,"function":"palindrome_partitions","statement":"for j in i..n {"},{"line":8,"function":"palindrome_partitions","statement":"palindrome[i][j] = a[i] == a[j] && (j - i < 2 || palindrome[i + 1][j - 1]);"},{"line":9,"function":"palindrome_partitions","statement":"}"},{"line":20,"function":"palindrome_partitions","statement":"count(0, &palindrome)"},{"line":12,"function":"count","statement":"if i == p.len() {"},{"line":13,"functi