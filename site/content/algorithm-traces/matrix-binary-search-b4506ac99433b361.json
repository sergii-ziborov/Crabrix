{"key":"matrix-binary-search-b4506ac99433b361","sourceHash":"b4506ac99433b3618e281c1093b42abf99ae080e9541887b6b3a98a780a701d0","pattern":"matrix-binary-search","category":"binary-search","title":"Challenge: Flattened Matrix Search","idea":"Map a flat midpoint back to row and column when rows form one global sorted order.","complexity":"O(log(rows*cols)) time · O(1) space","source":"fn matrix_contains(a: &[Vec<i32>], target: i32) -> bool {\n    if a.is_empty() || a[0].is_empty() {\n        return false;\n    }\n    let cols = a[0].len();\n    let (mut lo, mut hi) = (0, a.len() * cols);\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        let value = a[mid / cols][mid % cols];\n        if value == target {\n            return true;\n        }\n        if value < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    false // Row-major ordering must be globally sorted.\n}\n\nfn main() {\n    let result = matrix_contains(&[vec![1, 2], vec![3, 4]], 16).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"matrix_contains","statement":"if a.is_empty() || a[0].is_empty() {"},{"line":3,"function":"matrix_contains","statement":"return false;"},{"line":5,"function":"matrix_contains","statement":"let cols = a[0].len();"},{"line":6,"function":"matrix_contains","statement":"let (mut lo, mut hi) = (0, a.len() * cols);"},{"line":7,"function":"matrix_contains","statement":"while lo < hi {"},{"line":8,"function":"matrix_contains","statement":"let mid = lo + (hi - lo) / 2;"},{"line":9,"function":"matrix_contains","statement":"let value = a[mid / cols][mid % cols];"},{"line":10,"function":"matrix_contains","statement":"if value == target {"},{"line":11,"function":"matrix_contains","statement":"return true;"},{"line":13,"function":"matrix_contains","statement":"if value < target {"},{"line":14,"function":"matrix_contains","statement":"lo = mid + 1;"},{"line":15,"function":"matrix_contains","statement":"}"},{"line":16,"function":"matrix_contains","statement":"hi = mid;"},{"line":17,"function":"matrix_contains","statement":"}"},{"line":19,"function":"matrix_contains","statement":"false"},{"line":23,"function":"main","statement":"let result = matrix_contains(&[vec![1, 2], vec![3, 4]], 16).to_string();"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"[[1,2],[3,4]]","stdout":"false\n","values":[{"type":"&[alloc::vec::Vec<i32>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"}],"tuple":false}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"16"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"false\""}}],"frames":[{"site":15,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1]]},{"site":2,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1]]},{"site":3,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2]]},{"site":4,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4]]},{"site":5,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4]]},{"site":6,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4],["mid",2]]},{"site":7,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4],