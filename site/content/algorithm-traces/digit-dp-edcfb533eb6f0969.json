{"key":"digit-dp-edcfb533eb6f0969","sourceHash":"edcfb533eb6f09699ca066c297930bcf97103beae92510e0195c5334980ff024","pattern":"digit-dp","category":"dynamic-2d","title":"Challenge: Digit DP","idea":"Process digits with position, tight-bound, leading-zero, and property state.","complexity":"O(digits * states * base) time","source":"fn digit_sum_count(bound: u64, target: usize) -> u64 {\n    fn count(\n        pos: usize,\n        left: usize,\n        tight: bool,\n        digits: &[u8],\n        memo: &mut [Vec<Option<u64>>],\n    ) -> u64 {\n        if pos == digits.len() {\n            return u64::from(left == 0);\n        }\n        if !tight {\n            if let Some(answer) = memo[pos][left] {\n                return answer;\n            }\n        }\n        let limit = if tight { digits[pos] } else { 9 };\n        let mut answer = 0;\n        for digit in 0..=limit {\n            if digit as usize <= left {\n                answer += count(\n                    pos + 1,\n                    left - digit as usize,\n                    tight && digit == limit,\n                    digits,\n                    memo,\n                );\n            }\n        }\n        if !tight {\n            memo[pos][left] = Some(answer);\n        }\n        answer\n    }\n    let digits: Vec<_> = bound.to_string().bytes().map(|c| c - b'0').collect();\n    count(\n        0,\n        target,\n        true,\n        &digits,\n        &mut vec![vec![None; target + 1]; digits.len()],\n    )\n}\n\nfn main() {\n    let result = digit_sum_count(9, 5).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":35,"function":"digit_sum_count","statement":"let digits: Vec<_> = bound.to_string().bytes().map(|c| c - b'0').collect();"},{"line":36,"function":"digit_sum_count","statement":"count("},{"line":9,"function":"count","statement":"if pos == digits.len() {"},{"line":10,"function":"count","statement":"return u64::from(left == 0);"},{"line":12,"function":"count","statement":"if !tight {"},{"line":13,"function":"count","statement":"if let Some(answer) = memo[pos][left] {"},{"line":14,"function":"count","statement":"return answer;"},{"line":17,"function":"count","statement":"let limit = if tight { digits[pos] } else { 9 };"},{"line":17,"function":"count","statement":"digits[pos]"},{"line":17,"function":"count","statement":"9"},{"line":18,"function":"count","statement":"let mut answer = 0;"},{"line":19,"function":"count","statement":"for digit in 0..=limit {"},{"line":20,"function":"count","statement":"if digit as usize <= left {"},{"line":21,"function":"count","statement":"answer += count("},{"line":28,"function":"count","statement":"}"},{"line":30,"function":"count","statement":"if !tight {"},{"line":31,"function":"count","statement":"memo[pos][left] = Some(answer);"},{"line":32,"function":"count","statement":"}"},{"line":33,"function":"count","statement":"answer"},{"line":35,"function":"closure · line 35","statement":"c - b'0'"},{"line":46,"function":"main","statement":"let result = digit_sum_count(9, 5).to_string();"},{"line":47,"function":"main","statement":"println!(\"{result}\");"},{"line":48,"function":"main","statement":"}"}],"version":1,"input":"bound=9 sum=5","stdout":"1\n","values":[{"type":"u64","data":{"kind":"scalar","text":"9"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"u8","data":{"kind":"scalar","text":"57"}},{"type":"alloc::vec::Vec<u8>","data":{"kind":"list","items":[{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"bool","data":{"kind":"scalar","text":"true"}},{"type":"&[u8]","data":{"kind":"list","items":[{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"&mut [alloc::vec::Vec<core::option::Option<u64>>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":"scalar","text"