{"key":"undirected-cycle-795aed68c69a2861","sourceHash":"795aed68c69a28610f4faf7c051d71cb12efb3b88414df0e8a27b22bb105c530","pattern":"undirected-cycle","category":"graph-traversal","title":"Undirected Cycle Detection: Mental Model","idea":"During traversal ignore the edge back to the parent; any other seen neighbor closes a cycle.","complexity":"O(V+E) time · O(V) space","source":"fn has_cycle(graph: &[Vec<usize>]) -> bool {\n    fn visit(v: usize, parent: usize, g: &[Vec<usize>], seen: &mut [bool]) -> bool {\n        seen[v] = true;\n        for &u in &g[v] {\n            if u != parent && (seen[u] || visit(u, v, g, seen)) {\n                return true;\n            }\n        }\n        false\n    }\n    // Simple undirected graph: parallel edges require edge IDs instead.\n    let mut seen = vec![false; graph.len()];\n    (0..graph.len()).any(|v| !seen[v] && visit(v, graph.len(), graph, &mut seen))\n}\n\nfn main() {\n    let result = has_cycle(&[vec![1, 2], vec![0, 2], vec![0, 1, 3], vec![2]]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":12,"function":"has_cycle","statement":"let mut seen = vec![false; graph.len()];"},{"line":13,"function":"has_cycle","statement":"(0..graph.len()).any(|v| !seen[v] && visit(v, graph.len(), graph, &mut seen))"},{"line":3,"function":"visit","statement":"seen[v] = true;"},{"line":4,"function":"visit","statement":"for &u in &g[v] {"},{"line":5,"function":"visit","statement":"if u != parent && (seen[u] || visit(u, v, g, seen)) {","edge":{"collection":"g","from":"v","to":"u"}},{"line":6,"function":"visit","statement":"return true;","edge":{"collection":"g","from":"v","to":"u"}},{"line":9,"function":"visit","statement":"false"},{"line":13,"function":"closure · line 13","statement":"!seen[v] && visit(v, graph.len(), graph, &mut seen)"},{"line":17,"function":"main","statement":"let result = has_cycle(&[vec![1, 2], vec![0, 2], vec![0, 1, 3], vec![2]]).to_string();"},{"line":18,"function":"main","statement":"println!(\"{r