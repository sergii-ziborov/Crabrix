{"key":"same-direction-dcd57a1de34c9d50","sourceHash":"dcd57a1de34c9d50646a0aba47fa90ef1299ac22b6ada41e978017b9f84431cb","pattern":"same-direction","category":"two-pointers","title":"Challenge: Same-Direction Pointers","idea":"Let a read pointer inspect every item while a write pointer marks the kept prefix.","complexity":"O(n) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn keep_at_least(values: &mut Vec<i32>, threshold: i32) {\n    let mut write = 0;\n    for read in 0..values.len() {\n        if values[read] >= threshold {\n            values[write] = values[read];\n            write += 1;\n        }\n    }\n    values.truncate(write);\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![1, 6, 5];\n        keep_at_least(&mut values, 5);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"keep_at_least","statement":"let mut write = 0;"},{"line":9,"function":"keep_at_least","statement":"for read in 0..values.len() {"},{"line":10,"function":"keep_at_least","statement":"if values[read] >= threshold {"},{"line":11,"function":"keep_at_least","statement":"values[write] = values[read];"},{"line":12,"function":"keep_at_least","statement":"write += 1;"},{"line":13,"function":"keep_at_least","statement":"}"},{"line":15,"function":"keep_at_least","statement":"values.truncate(write);"},{"line":16,"function":"keep_at_least","statement":"}"},{"line":19,"function":"main","statement":"let result = {"},{"line":20,"function":"main","statement":"let mut values = vec![1, 6, 5];"},{"line":21,"function":"main","statement":"keep_at_least(&mut values, 5);"},{"line":22,"function":"main","statement":"csv(values)"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"[1,6,5]","stdout":"6,5