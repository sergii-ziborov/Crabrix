{"key":"merge-two-lists-c52e185dd401fa0a","sourceHash":"c52e185dd401fa0a5c40efba709d60bc040bc1df202e20910f639c41b22df739","pattern":"merge-two-lists","category":"linked-lists","title":"Challenge: Merge Two Sorted Lists","idea":"Always detach the smaller head and append it to the merged tail.","complexity":"O(n+m) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn merge_lists(mut a: Link, mut b: Link) -> Link {\n    let mut out = None;\n    let mut tail = &mut out;\n    while a.is_some() && b.is_some() {\n        let chosen = if a.as_ref().unwrap().value <= b.as_ref().unwrap().value {\n            &mut a\n        } else {\n            &mut b\n        };\n        let mut node = chosen.take().unwrap();\n        *chosen = node.next.take();\n        *tail = Some(node);\n        tail = &mut tail.as_mut().unwrap().next;\n    }\n    *tail = if a.is_some() { a } else { b };\n    out\n}\n\nfn main() {\n    let result = csv(list_values(&merge_lists(list(&[1, 3]), list(&[2, 4]))));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"merge_lists","statement":"let mut out = None;"},{"line":28,"function":"merge_lists","statement":"let mut tail = &mut out;"},{"line":29,"function":"merge_lists","statement":"while a.is_some() && b.is_some() {"},{"line":30,"function":"merge_lists","statement":"let chosen = if a.as_ref().unwrap().value <= b.as_ref().unwrap().value {"},{"line":31,"function":"merge_lists","statement":"&mut a"},{"line":33,"function":"merge_lists","statement":"&mut b"},{"line":35,"function":"merge_lists","statement":"let mut node = chosen.take().unwrap();"},{"line":36,"function":"merge_lists","statement":"*chosen = node.next.take();"},{"line":37,"function":"merge_lists","statement":"*tail = Some(node);"},{"line":38,"function":"merge_lists","statement":"tail = &mut tail.as_mut().unwrap().next;"},{"line":39,"function":"merge_lists","statement":"}"},{"line":40,"function":"merge_lists","statement":"*tail = if a.is_some() { a } else { b };"},{"line":40,"function":"merge_lists","statement":"a"},{"line":40,"function":"merge_lists","statement":"b"},{"line":41,"function":"merge_lists","statement":"out"},{"line":45,"function":"main","statement":"let result = csv(list_values(&merge_lists(list(&[1, 3]), list(&[2, 4]))));"},{"line":46,"function":"main","statement":"println!(\"{result}\");"},{"line":47,"function":"main","statement":"}"}],"version":1,"input":"1->3 and 2->4","stdout":"1,2,3,4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar",