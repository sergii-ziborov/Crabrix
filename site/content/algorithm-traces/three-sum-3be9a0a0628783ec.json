{"key":"three-sum-3be9a0a0628783ec","sourceHash":"3be9a0a0628783ec626650f6ccfbc3eb98592149ff9fc1b7e8a283fcaef5f4bb","pattern":"three-sum","category":"two-pointers","title":"Three-Sum Reduction: Mental Model","idea":"Sort, fix one value, and solve the remaining target with two pointers while skipping duplicates.","complexity":"O(n^2) time · O(n) owned sorted copy in this example","source":"fn zero_triples(values: &[i32]) -> usize {\n    let mut a = values.to_vec();\n    a.sort_unstable();\n    let mut count = 0;\n    for i in 0..a.len().saturating_sub(2) {\n        if i > 0 && a[i] == a[i - 1] {\n            continue;\n        }\n        let (mut left, mut right) = (i + 1, a.len() - 1);\n        while left < right {\n            let sum = a[i] + a[left] + a[right];\n            if sum < 0 {\n                left += 1;\n            } else if sum > 0 {\n                right -= 1;\n            } else {\n                count += 1;\n                let x = a[left];\n                let y = a[right];\n                while left < right && a[left] == x {\n                    left += 1;\n                }\n                while left < right && a[right] == y {\n                    right -= 1;\n                }\n            }\n        }\n    }\n    count\n}\n\nfn main() {\n    let result = zero_triples(&[-1, 0, 1, 2, -1, -4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"zero_triples","statement":"let mut a = values.to_vec();"},{"line":3,"function":"zero_triples","statement":"a.sort_unstable();"},{"line":4,"function":"zero_triples","statement":"let mut count = 0;"},{"line":5,"function":"zero_triples","statement":"for i in 0..a.len().saturating_sub(2) {"},{"line":6,"function":"zero_triples","statement":"if i > 0 && a[i] == a[i - 1] {"},{"line":7,"function":"zero_triples","statement":"continue;"},{"line":9,"function":"zero_triples","statement":"let (mut left, mut right) = (i + 1, a.len() - 1);"},{"line":10,"function":"zero_triples","statement"