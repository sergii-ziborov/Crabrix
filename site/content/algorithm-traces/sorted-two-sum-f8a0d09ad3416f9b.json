{"key":"sorted-two-sum-f8a0d09ad3416f9b","sourceHash":"f8a0d09ad3416f9b4ef8ef0880bfd236c432a85cd97cfadea69633c803fed554","pattern":"sorted-two-sum","category":"two-pointers","title":"Challenge: Sorted Two-Sum","idea":"Compare the end-pair sum with the target and discard one impossible endpoint.","complexity":"O(n) time · O(1) space","source":"fn sorted_pair(values: &[i32], target: i32) -> Option<(usize, usize)> {\n    if values.len() < 2 {\n        return None;\n    }\n    let (mut left, mut right) = (0, values.len() - 1);\n    while left < right {\n        match (values[left] + values[right]).cmp(&target) {\n            std::cmp::Ordering::Equal => return Some((left + 1, right + 1)),\n            std::cmp::Ordering::Less => left += 1,\n            std::cmp::Ordering::Greater => right -= 1,\n        }\n    }\n    None\n}\n\nfn main() {\n    let result = sorted_pair(&[1, 8, 9], 17).map_or(\"-1,-1\".into(), |(a, b)| format!(\"{a},{b}\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"sorted_pair","statement":"if values.len() < 2 {"},{"line":3,"function":"sorted_pair","statement":"return None;"},{"line":5,"function":"sorted_pair","statement":"let (mut left, mut right) = (0, values.len() - 1);"},{"line":6,"function":"sorted_pair","statement":"while left < right {"},{"line":7,"function":"sorted_pair","statement":"match (values[left] + values[right]).cmp(&target) {"},{"line":13,"function":"sorted_pair","statement":"None"},{"line":17,"function":"main","statement":"let result = sorted_pair(&[1, 8, 9], 17).map_or(\"-1,-1\".into(), |(a, b)| format!(\"{a},{b}\"));"},{"line":18,"function":"main","statement":"println!(\"{result}\");"},{"line":19,"function":"main","statement":"}"},{"line":17,"function":"closure · line 17","statement":"format!(\"{a},{b}\")"}],"version":1,"input":"[1,8,9]","stdout":"2,3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"9"}],"tuple":fals