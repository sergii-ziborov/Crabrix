{"key":"container-area-62984f73935d924b","sourceHash":"62984f73935d924b1e5f3e1dc41a5ed3b1298f66b9ee2608fb3c19d845319385","pattern":"container-area","category":"two-pointers","title":"Challenge: Container Area","idea":"The shorter boundary limits area, so only moving that boundary can improve the result.","complexity":"O(n) time · O(1) space","source":"fn greatest_container(heights: &[i32]) -> i32 {\n    if heights.len() < 2 {\n        return 0;\n    }\n    let (mut left, mut right, mut best) = (0, heights.len() - 1, 0);\n    while left < right {\n        best = best.max((right - left) as i32 * heights[left].min(heights[right]));\n        if heights[left] <= heights[right] {\n            left += 1;\n        } else {\n            right -= 1;\n        }\n    }\n    best\n}\n\nfn main() {\n    let result = greatest_container(&[1, 1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"greatest_container","statement":"if heights.len() < 2 {"},{"line":3,"function":"greatest_container","statement":"return 0;"},{"line":5,"function":"greatest_container","statement":"let (mut left, mut right, mut best) = (0, heights.len() - 1, 0);"},{"line":6,"function":"greatest_container","statement":"while left < right {"},{"line":7,"function":"greatest_container","statement":"best = best.max((right - left) as i32 * heights[left].min(heights[right]));"},{"line":8,"function":"greatest_container","statement":"if heights[left] <= heights[right] {"},{"line":9,"function":"greatest_container","statement":"left += 1;"},{"line":10,"function":"greatest_container","statement":"}"},{"line":11,"function":"greatest_container","statement":"right -= 1;"},{"line":12,"function":"greatest_container","statement":"}"},{"line":14,"function":"greatest_container","statement":"best"},{"line":18,"function":"main","statement":"let result = greatest_container(&[1, 1]).to_string();"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement"