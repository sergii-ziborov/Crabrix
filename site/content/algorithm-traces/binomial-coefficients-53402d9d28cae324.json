{"key":"binomial-coefficients-53402d9d28cae324","sourceHash":"53402d9d28cae3242e17548d3da44b01f0e18812f5c016dee07d154d3cd0eac3","pattern":"binomial-coefficients","category":"math-bits","title":"Challenge: Binomial Coefficients","idea":"Build Pascal recurrence or multiply a shortened numerator while controlling division.","complexity":"O(min(k,n-k)) exact multiplicative steps · O(1) state","source":"fn choose(n: u64, k: u64) -> u64 {\n    if k > n {\n        return 0;\n    }\n    assert!(n <= 60);\n    let k = k.min(n - k);\n    let mut answer = 1_u128;\n    for i in 1..=k {\n        answer = answer * (n - k + i) as u128 / i as u128;\n    }\n    answer as u64\n}\n\nfn main() {\n    let result = choose(5, 2).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"choose","statement":"if k > n {"},{"line":3,"function":"choose","statement":"return 0;"},{"line":5,"function":"choose","statement":"assert!(n <= 60);"},{"line":6,"function":"choose","statement":"let k = k.min(n - k);"},{"line":7,"function":"choose","statement":"let mut answer = 1_u128;"},{"line":8,"function":"choose","statement":"for i in 1..=k {"},{"line":9,"function":"choose","statement":"answer = answer * (n - k + i) as u128 / i as u128;"},{"line":10,"function":"choose","statement":"}"},{"line":11,"function":"choose","statement":"answer as u64"},{"line":15,"function":"main","statement":"let result = choose(5, 2).to_string();"},{"line":16,"function":"main","statement":"println!(\"{result}\");"},{"line":17,"function":"main","statement":"}"}],"version":1,"input":"n=5 k=2","stdout":"10\n","values":[{"type":"u64","data":{"kind":"scalar","text":"5"}},{"type":"u64","data":{"kind":"scalar","text":"2"}},{"type":"u128","data":{"kind":"scalar","text":"1"}},{"type":"u64","data":{"kind":"scalar","text":"1"}},{"type":"u128","data":{"kind":"scalar","text":"4"}},{"type":"u128","data":{"kind":"scalar","text":"10"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"10\""}}],"frames":[{