{"key":"reverse-k-group-81c8d8082d72a663","sourceHash":"81c8d8082d72a6637efbe740ac113b9608aa3fcd158586d346fe19fc80e8f50c","pattern":"reverse-k-group","category":"linked-lists","title":"Challenge: Reverse Nodes in K-Groups","idea":"Verify a complete group exists, reverse exactly that range, then reconnect both boundaries.","complexity":"O(n) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn reverse_groups(mut head: Link, k: usize) -> Link {\n    assert!(k > 0);\n    let mut result = None;\n    let mut tail = &mut result;\n    loop {\n        let mut scan = head.as_deref();\n        let mut count = 0;\n        while count < k {\n            if let Some(n) = scan {\n                scan = n.next.as_deref();\n                count += 1;\n            } else {\n                break;\n            }\n        }\n        if count < k {\n            *tail = head;\n            break;\n        }\n        let mut group = None;\n        for _ in 0..k {\n            let mut n = head.take().unwrap();\n            head = n.next.take();\n            n.next = group;\n            group = Some(n);\n        }\n        *tail = group;\n        for _ in 0..k {\n            tail = &mut tail.as_mut().unwrap().next;\n        }\n    }\n    result\n}\n\nfn main() {\n    let result = csv(list_values(&reverse_groups(list(&[1, 2]), 3)));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"reverse_groups","statement":"assert!(k > 0);"},{"line":28,"function":"reverse_groups","statement":"let mut result = None;"},{"line":29,"function":"reverse_groups","statement":"let mut tail = &mut result;"},{"line":30,"function":"reverse_groups","statement":"loop {"},{"line":31,"function":"reverse_groups","statement":"let mut scan = head.as_deref();"},{"line":32,"function":"reverse_groups","statement":"let mut count = 0;"},{"line":33,"function":"reverse_groups","statement":"while count < k {"},{"line":34,"function":"reverse_groups","statement":"if let Some(n) = scan {"},{"line":35,"function":"reverse_groups","statement":"scan = n.next.as_deref();"},{"line":36,"function":"reverse_groups","statement":"count += 1;"},{"line":37,"function":"reverse_groups","statement":"}"},{"line":38,"function":"reverse_groups","statement":"break;"},{"line":41,"function":"reverse_groups","statement":"if count < k {"},{"line":42,"function":"reverse_groups","statement":"*tail = head;"},{"line":43,"function":"reverse_groups","statement":"break;"},{"line":45,"function":"reverse_groups","statement":"let mut group = None;"},{"line":46,"function":"reverse_groups","statement":"for _ in 0..k {"},{"line":47,"function":"reverse_groups","statement":"let mut n = head.take().unwrap();"},{"line":48,"function":"reverse_groups","stat