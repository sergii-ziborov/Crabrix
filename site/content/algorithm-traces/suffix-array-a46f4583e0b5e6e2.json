{"key":"suffix-array-a46f4583e0b5e6e2","sourceHash":"a46f4583e0b5e6e27282265cbd585e2b29e5c1392e805f5ac6de4d2cba0d7739","pattern":"suffix-array","category":"strings-tries","title":"Challenge: Suffix Array","idea":"Sort suffix ranks by doubling compared prefix length until every suffix has a unique rank.","complexity":"O(n log^2 n) comparison-sort doubling · O(n) auxiliary space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn suffix_array(text: &str) -> Vec<usize> {\n    let n = text.len();\n    let mut order: Vec<_> = (0..n).collect();\n    let mut rank: Vec<i32> = text.bytes().map(i32::from).collect();\n    let mut width = 1;\n    while width < n {\n        order.sort_unstable_by_key(|&i| (rank[i], rank.get(i + width).copied().unwrap_or(-1)));\n        let mut next = vec![0; n];\n        for i in 1..n {\n            let (a, b) = (order[i - 1], order[i]);\n            let key = |j: usize| (rank[j], rank.get(j + width).copied().unwrap_or(-1));\n            next[b] = next[a] + i32::from(key(a) != key(b));\n        }\n        rank = next;\n        if n == 0 || rank[order[n - 1]] == n as i32 - 1 {\n            break;\n        }\n        width *= 2;\n    }\n    order // comparison-sort doubling: O(n log² n), byte indexes\n}\n\nfn main() {\n    let result = csv(suffix_array(\"aba\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"suffix_array","statement":"let n = text.len();"},{"line":9,"function":"suffix_array","statement":"let mut order: Vec<_> = (0..n).collect();"},{"line":10,"function":"suffix_array","statement":"let mut rank: Vec<i32> = text.bytes().map(i32::from).collect();"},{"line":11,"function":"suffix_array","statement":"let mut width = 1;"},{"line":12,"function":"suffix_array","statement":"while width < n {"},{"line":13,"function":"suffix_array","statement":"order.sort_unstable_by_key(|&i| (rank[i], rank.get(i + width).copied().unwrap_or(-1)));"},{"line":14,"function":"suffix_array","statement":"let mut next = vec![0; n];"},{"line":15,"function":"suffix_array","statement":"for i in 1..n {"},{"line":16,"function":"suffix_array","statement":"let (a, b) = (order[i - 1], order[i]);"},{"line":17,"function":"suffix_array","statement":"let key = |j: usize| (rank[j], rank.get(j + width).copied().unwrap_or(-1));"},{"line":18,"function":"suffix_array","statement":"next[b] = next[a] + i32::from(key(a) != key(b));"},{"line":19,"function":"suffix_array","statement":"}"},{"line":20,"function":"suffix_array","statement":"rank = next;"},{"line":21,"function":"suffix_array","statement":"if n == 0 || rank[order[n - 1]] == n as i32 - 1 {"},{"line":22,"function":"suffix_array","statement":"break;"},{"line":24,"function":"suffix_array","statement":"width *= 2;"},{"line":25,"function":"suffix_array","statement":"}"},{"line":26,"function":"suffix_array","statement":"order"},{"line":13,"function":"closure · line 13","statement":"(rank[i], rank.get(i + width).copied().unwrap_or(-1))"},{"line":17,"function":"closure · line 17","statement":"(rank[j], rank.get(j + width).copied().unwrap_or(-1))"},{"line":30,"function":"main","statement":"let result = csv(suffix_array(\"aba\"));"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"aba","stdout":"2,0,1\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"aba\""}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"97"},{"kind":"scalar","text":"98"},{"kind":"scalar","text":"97"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"