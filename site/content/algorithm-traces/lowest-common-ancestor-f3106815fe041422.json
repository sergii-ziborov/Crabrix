{"key":"lowest-common-ancestor-f3106815fe041422","sourceHash":"f3106815fe0414222709c8e3f21df2824702b8c14b243d023b2f0ef3cb55bfea","pattern":"lowest-common-ancestor","category":"trees","title":"Lowest Common Ancestor: Mental Model","idea":"Combine child evidence; the first node reached from both targets is their lowest shared ancestor.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn ancestor(root: &Tree, a: i32, b: i32) -> Option<i32> {\n    // Contract: both distinct target values exist in the tree and are unique.\n    match root {\n        None => None,\n        Some(n) if n.value == a || n.value == b => Some(n.value),\n        Some(n) => match (ancestor(&n.left, a, b), ancestor(&n.right, a, b)) {\n            (Some(_), Some(_)) => Some(n.value),\n            (left, right) => left.or(right),\n        },\n    }\n}\n\nfn main() {\n    let result = ancestor(\n        &node(\n            3,\n            node(\n                5,\n                node(6, None, None),\n                node(2, node(7, None, None), node(4, None, None)),\n            ),\n            node(1, node(0, None, None), node(8, None, None)),\n        ),\n        5,\n        1,\n    )\n    .unwrap()\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":12,"function":"ancestor","statement":"match root {"},{"line":23,"function":"main","statement":"let result = ancestor("},{"line":38,"function":"main","statement":"println!(\"{result}\");"},{"line":39,"function":"main","statement":"}"}],"version":1,"input":"tree=[3,5,1,6,2,0,8,null,null,7,4]","stdout":"3\n","values":[{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind