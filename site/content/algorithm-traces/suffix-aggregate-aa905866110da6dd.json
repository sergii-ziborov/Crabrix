{"key":"suffix-aggregate-aa905866110da6dd","sourceHash":"aa905866110da6ddf58a40b5a2da18de71ef302bfd477e5a759b4dc0ba1fef75","pattern":"suffix-aggregate","category":"ranges","title":"Challenge: Suffix Aggregate","idea":"Precompute information from right to left for queries about everything after a position.","complexity":"O(n) build · O(1) query · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn suffix_maxima(values: &[i32]) -> Vec<i32> {\n    let mut result = vec![0; values.len()];\n    let mut high = i32::MIN;\n    for i in (0..values.len()).rev() {\n        high = high.max(values[i]);\n        result[i] = high;\n    }\n    result\n}\n\nfn main() {\n    let result = csv(suffix_maxima(&[2, 4, 1]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"suffix_maxima","statement":"let mut result = vec![0; values.len()];"},{"line":9,"function":"suffix_maxima","statement":"let mut high = i32::MIN;"},{"line":10,"function":"suffix_maxima","statement":"for i in (0..values.len()).rev() {"},{"line":11,"function":"suffix_maxima","statement":"high = high.max(values[i]);"},{"line":12,"function":"suffix_maxima","statement":"result[i] = high;"},{"line":13,"function":"suffix_maxima","statement":"}"},{"line":14,"function":"suffix_maxima","statement":"result"},{"line":18,"function":"main","statement":"let result = csv(suffix_maxima(&[2, 4, 1]));"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"}],"version":1,"input":"[2, 4, 1]","stdout":"4,4,1\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"