{"key":"k-way-merge-0e951c7972586bbf","sourceHash":"0e951c7972586bbf5195afe1229ffe992bf4bf47ab8d2f3a562196790e0802df","pattern":"k-way-merge","category":"heaps-streaming","title":"K-Way Heap Merge: Mental Model","idea":"Push one frontier item per sorted source and advance only the source that wins.","complexity":"O(N log k) time · O(k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn merge_many(lists: &[Vec<i32>]) -> Vec<i32> {\n    let mut heap = std::collections::BinaryHeap::new();\n    let mut out = Vec::new();\n    for (i, list) in lists.iter().enumerate() {\n        if let Some(&x) = list.first() {\n            heap.push(std::cmp::Reverse((x, i, 0)));\n        }\n    }\n    while let Some(std::cmp::Reverse((x, i, j))) = heap.pop() {\n        out.push(x);\n        if let Some(&next) = lists[i].get(j + 1) {\n            heap.push(std::cmp::Reverse((next, i, j + 1)));\n        }\n    }\n    out\n}\n\nfn main() {\n    let result = csv(merge_many(&[vec![1, 4, 7], vec![2, 5, 8], vec![0, 6, 9]]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"merge_many","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":9,"function":"merge_many","statement":"let mut out = Vec::new();"},{"line":10,"function":"merge_many","statement":"for (i, list) in lists.iter().enumerate() {"},{"line":11,"function":"merge_many","statement":"if let Some(&x) = list.first() {"},{"line":12,"function":"merge_many","statement":"heap.push(std::cmp::Reverse((x, i, 0)));"},{"line":13,"function":"merge_many","statement":"}"},{"line":15,"function":"merge_many","statement":"while let Some(std::cmp::Reverse((x, i, j))) = heap.pop() {"},{"line":16,"function":"merge_many","statement":"out.push(x);"},{"line":17,"function":"merge_many","statement":"if let Some(&next) = lists[i].get(j + 1) {"},{"line":18,"function":"merge_many","statement":"heap.push(std::cmp::Reverse((next, i, j + 1)));"},{"line":19,"function":"merge_many","statement":"}"},{"line":21,"function":"merge_many","statement":"out"},{"line":25,"function":"main","statement":"let result = csv(merge_many(&[vec![1, 4, 7], vec![2, 5, 8], vec![0, 6, 9]]));"},{"line":26,"function":"main","statement":"println!(\"{result}\");"},{"line":27,"function":"main","statement":"}"}],"version":1,"input":"[1,4,7];[2,5,8];[0,6,9]","stdout":"0,1,2,4,5,6,7,8,9\n","values":[{"type":"&[alloc::vec::Vec<i32>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"7"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"8"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"9"}],"tuple":false}],"tuple":false}},{"type":"alloc::collections::binary_heap::BinaryHeap<core::cmp::Reverse<(i32, usize, usize)>>","data":{"kind":"list","items":[],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"&alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"alloc::collections::binary_heap::BinaryHeap<core::cmp::Reverse<(i32, usize, usize)>>","data":{"kind":"list","items":[{"kind":"named","name":"Reverse","value":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":true}],"tuple":true}}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"},{"kind":"scalar","tex