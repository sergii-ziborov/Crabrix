{"key":"reorder-list-2d4812d5a01679f4","sourceHash":"2d4812d5a01679f40201c37b6f8b8ef12ece38f2d2c6c966e169afd8940dd0e9","pattern":"reorder-list","category":"linked-lists","title":"Reorder by Split, Reverse, Merge: Mental Model","idea":"Find the middle, reverse the second half, then alternate nodes from both halves.","complexity":"O(n) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn reorder(mut head: Link) -> Link {\n    let mut length: usize = 0;\n    let mut scan = head.as_deref();\n    while let Some(n) = scan {\n        length += 1;\n        scan = n.next.as_deref();\n    }\n    if length < 3 {\n        return head;\n    }\n    let mut cut = &mut head;\n    for _ in 0..length.div_ceil(2) {\n        cut = &mut cut.as_mut().unwrap().next;\n    }\n    let mut rest = cut.take();\n    let mut reversed = None;\n    while let Some(mut n) = rest {\n        rest = n.next.take();\n        n.next = reversed;\n        reversed = Some(n);\n    }\n    let mut cursor = &mut head;\n    while let Some(mut n) = reversed {\n        reversed = n.next.take();\n        let old = cursor.as_mut().unwrap().next.take();\n        n.next = old;\n        cursor.as_mut().unwrap().next = Some(n);\n        cursor = &mut cursor.as_mut().unwrap().next.as_mut().unwrap().next;\n    }\n    head\n}\n\nfn main() {\n    let result = csv(list_values(&reorder(list(&[1, 2, 3, 4, 5]))));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"reorder","statement":"let mut length: usize = 0;"},{"line":28,"function":"reorder","statement":"let mut scan = head.as_deref();"},{"line":29,"function":"reorder","statement":"while let Some(n) = scan {"},{"line":30,"function":"reorder","statement":"length += 1;"},{"line":31,"function":"reorder","statement":"scan = n.next.as_deref();"},{"line":32,"function":"reorder","statement":"}"},{"line":33,"function":"reorder","statement":"if length < 3 {"},{"line":34,"function":"reorder","statement":"return head;"},{"line":36,"function":"reorder","statement":"let mut cut = &mut head;"},{"line":37,"function":"reorder","statement":"for _ in 0..length.div_ceil(2) {"},{"line":38,"function":"reorder","statement":"cut = &mut cut.as_mut().unwrap().next;"},{"line":39,"function":"reorder","statement":"}"},{"line":40,"function":"reorder","statement":"let mut rest = cut.take();"},{"line":41,"function":"reorder","statement":"let mut reversed = None;"},{"line":42,"function":"reorder","statement":"while let Some(mut n) = rest {"},{"line":43,"function":"reorder","statement":"rest = n.next.take();"},{"line":44,"function":"reorder","statement":"n.next = reversed;"},{"line":45,"function":"reorder","statement":"reversed = Some(n);"},{"line":46,"function":"reorder","statement":"}"},