{"key":"dutch-flag-4d659c8ce09c0c45","sourceHash":"4d659c8ce09c0c45a11ccd77bd70bc1e12bb34e7ee76418508cc738ff6f70cf7","pattern":"dutch-flag","category":"two-pointers","title":"Challenge: Dutch National Flag","idea":"Maintain less-than, unknown, and greater-than regions with three boundaries.","complexity":"O(n) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn sort_three(values: &mut [i32]) {\n    let (mut low, mut scan, mut high) = (0, 0, values.len());\n    while scan < high {\n        match values[scan] {\n            0 => {\n                values.swap(low, scan);\n                low += 1;\n                scan += 1;\n            }\n            1 => scan += 1,\n            2 => {\n                high -= 1;\n                values.swap(scan, high);\n            }\n            _ => panic!(\"only 0, 1 and 2 are allowed\"),\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![1, 2, 0];\n        sort_three(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"sort_three","statement":"let (mut low, mut scan, mut high) = (0, 0, values.len());"},{"line":9,"function":"sort_three","statement":"while scan < high {"},{"line":10,"function":"sort_three","statement":"match values[scan] {"},{"line":12,"function":"sort_three","statement":"values.swap(low, scan);"},{"line":13,"function":"sort_three","statement":"low += 1;"},{"line":14,"function":"sort_three","statement":"scan += 1;"},{"line":15,"function":"sort_three","statement":"}"},{"line":18,"function":"sort_three","statement":"high -= 1;"},{"line":19,"function":"sort_three","statement":"values.swap(scan, high);"},{"line":20,"function":"sort_three","statement":"}"},{"line":27,"function":"main","statement":"let result = {"},{"line":28,"function":"main","statement":"let mut values = vec![1, 2, 0];"},{"line":29,"function":"main","statement":"sort_three(&mut values);"},{"line":30,"function":"main","statement":"csv(values)"},{"line":32,"function":"main","statement":"println!(\"{result}\");"},{"line":33,"function":"main","statement":"}"}],"version":1,"input":"[1,2,0]","stdout":"0,1,2\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0,1,2\""}}],"frames":[{"site":10,"stack":[["main",1]],"locals":[]},{"site":11,"stack":[["main",1]],"locals":[]},{"site":12,"stack":[["main",1]],"locals":[["values",0]]},{"site":0,"stack":[["main",1],["sort_three",2]],"locals":[["values",1]]},{"site":1,"stack":[["main",1],["sort_three",2]],"locals":[["values",1],["low",2],["scan",2],["high",3]]},{"site":2,"stack":[["main",1],["sort_three",2]],"locals":[["values",1],["low",2],["scan",2],["high",3]]},{"site":2,"stack":[["main",1],["sort_three",2]],"locals":[["values",1],["low",2],["scan",4],["high",3]]},{"site":7,"stack":[["main",1],["sort_three",2