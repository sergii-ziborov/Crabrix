{"key":"largest-histogram-82c173d24122931e","sourceHash":"82c173d24122931ee582483dc2af0f24d77693aa24f319f502c58c3584496034","pattern":"largest-histogram","category":"stacks-queues","title":"Largest Histogram Rectangle: Mental Model","idea":"When height decreases, pop bars whose right boundary is now known and compute their maximal width.","complexity":"O(n) time · O(n) space","source":"fn largest_rectangle(heights: &[i32]) -> i32 {\n    let mut stack: Vec<usize> = Vec::new();\n    let mut best = 0;\n    for i in 0..=heights.len() {\n        let h = heights.get(i).copied().unwrap_or(0);\n        while stack.last().is_some_and(|&j| heights[j] > h) {\n            let height = heights[stack.pop().unwrap()];\n            let left = stack.last().map_or(0, |&j| j + 1);\n            best = best.max(height * (i - left) as i32);\n        }\n        stack.push(i);\n    }\n    best\n}\n\nfn main() {\n    let result = largest_rectangle(&[2, 1, 5, 6, 2, 3]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"largest_rectangle","statement":"let mut stack: Vec<usize> = Vec::new();"},{"line":3,"function":"largest_rectangle","statement":"let mut best = 0;"},{"line":4,"function":"largest_rectangle","statement":"for i in 0..=heights.len() {"},{"line":5,"function":"largest_rectangle","statement":"let h = heights.get(i).copied().unwrap_or(0);"},{"line":6,"function":"largest_rectangle","statement":"while stack.last().is_some_and(|&j| heights[j] > h) {"},{"line":7,"function":"largest_rectangle","statement":"let height = heights[stack.pop().unwrap()];"},{"line":8,"function":"largest_rectangle","statement":"let left = stack.last().map_or(0, |&j| j + 1);"},{"line":9,"function":"largest_rectangle","statement":"best = best.max(height * (i - left) as i32);"},{"line":10,"function":"largest_rectangle","statement":"}"},{"line":11,"function":"largest_rectangle","statement":"stack.push(i);"},{"line":12,"function":"largest_rectangle","statement":"}"},{"line":13,"function":"largest_rectangle","statement":"best"},{"line":6,"function":"closure · line 6","statement":"heights[j] > h"},{"line":8,"function":"closure · line 8","statement":"j + 1"},{"line":17,"function":"main","statement":"let result = largest_rectangle(&[2, 1, 5, 6, 2, 3]).to_string();"},{"line":18,"function":"main","statement":"println!(\"{result}\");"},{"line":19,"function":"main","statement":"}"}],"version":1,"input":"[2,1,5,6,2,3]","stdout":"10\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"10"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"}],"t