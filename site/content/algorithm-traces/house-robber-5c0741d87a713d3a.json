{"key":"house-robber-5c0741d87a713d3a","sourceHash":"5c0741d87a713d3ae5923b85b49e688bab6a0f1166e54071187e084da4150631","pattern":"house-robber","category":"dynamic-1d","title":"Challenge: Take-or-Skip DP","idea":"For each item compare skipping it with taking it plus the best compatible earlier state.","complexity":"O(n) time · O(1) space","source":"fn non_adjacent_sum(values: &[i32]) -> i32 {\n    let (mut previous, mut best) = (0, 0);\n    for &value in values {\n        let next = best.max(previous + value);\n        previous = best;\n        best = next;\n    }\n    best\n}\n\nfn main() {\n    let result = non_adjacent_sum(&[5, 1, 1, 5]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"non_adjacent_sum","statement":"let (mut previous, mut best) = (0, 0);"},{"line":3,"function":"non_adjacent_sum","statement":"for &value in values {"},{"line":4,"function":"non_adjacent_sum","statement":"let next = best.max(previous + value);"},{"line":5,"function":"non_adjacent_sum","statement":"previous = best;"},{"line":6,"function":"non_adjacent_sum","statement":"best = next;"},{"line":7,"function":"non_adjacent_sum","statement":"}"},{"line":8,"function":"non_adjacent_sum","statement":"best"},{"line":12,"function":"main","statement":"let result = non_adjacent_sum(&[5, 1, 1, 5]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[5,1,1,5]","stdout":"10\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"i32","data":{"kind":"scalar","text":"10"}},{"type":"alloc::string::String","data":{"kind":"scalar","te