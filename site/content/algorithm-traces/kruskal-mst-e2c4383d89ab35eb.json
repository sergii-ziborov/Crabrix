{"key":"kruskal-mst-e2c4383d89ab35eb","sourceHash":"e2c4383d89ab35ebaeab1331b1a503c2f1f577b819dfe70b586de27e5e8e6772","pattern":"kruskal-mst","category":"weighted-graphs","title":"Challenge: Kruskal Minimum Spanning Tree","idea":"Sort edges and add one only when union-find says it joins different components.","complexity":"O(E log E) time · O(V) DSU space","source":"struct Dsu {\n    parent: Vec<usize>,\n    size: Vec<usize>,\n    count: usize,\n}\nimpl Dsu {\n    fn new(n: usize) -> Self {\n        Self {\n            parent: (0..n).collect(),\n            size: vec![1; n],\n            count: n,\n        }\n    }\n    fn root(&mut self, mut x: usize) -> usize {\n        while x != self.parent[x] {\n            self.parent[x] = self.parent[self.parent[x]];\n            x = self.parent[x];\n        }\n        x\n    }\n    fn join(&mut self, a: usize, b: usize) -> bool {\n        let (mut a, mut b) = (self.root(a), self.root(b));\n        if a == b {\n            return false;\n        }\n        if self.size[a] < self.size[b] {\n            std::mem::swap(&mut a, &mut b);\n        }\n        self.parent[b] = a;\n        self.size[a] += self.size[b];\n        self.count -= 1;\n        true\n    }\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn kruskal_weights(n: usize, edges: &[(usize, usize, i64)]) -> Vec<i64> {\n    let mut sorted = edges.to_vec();\n    sorted.sort_by_key(|&(a, b, w)| (w, a, b));\n    let mut dsu = Dsu::new(n);\n    let mut out = Vec::new();\n    for (a, b, w) in sorted {\n        if dsu.join(a, b) {\n            out.push(w);\n        }\n    }\n    assert!(n == 0 || out.len() == n - 1, \"connected graph required\");\n    out\n}\n\nfn main() {\n    let result = csv(kruskal_weights(3, &[(0, 1, 2), (1, 2, 3), (0, 2, 10)]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"new","statement":"Self {"},{"line":15,"function":"root","statement":"while x != self.parent[x] {"},{"line":16,"function":"root","statement":"self.parent[x] = self.parent[self.parent[x]];"},{"line":17,"function":"root","statement":"x = self.parent[x];"},{"line":18,"function":"root","statement":"}"},{"line":19,"function":"root","statement":"x"},{"line":22,"function":"join","statement":"let (mut a, mut b) = (self.root(a), self.root(b));"},{"line":23,"function":"join","statement":"if a == b {"},{"line":24,"function":"join","statement":"return false;"},{"line":26,"function":"join","statement":"if self.size[a] < self.size[b] {"},{"line":27,"function":"join","statement":"std::mem::swap(&mut a, &mut b);"},{"line":28,"function":"join","statement":"}"},{"line":29,"function":"join","statement":"self.parent[b] = a;"},{"line":30,"function":"join","statement":"self.size[a] += self.size[b];"},{"line":31,"function":"join","statement":"self.count -= 1;"},{"line":32,"function":"join","statement":"true"},{"line":42,"function":"kruskal_weights","statement":"let mut sorted = edges.to_vec();"},{"line":43,"function":"kruskal_weights","statement":"sorted.sort_by_key(|&(a, b, w)| (w, a, b));"},{"line":44,"function":"kruskal_weights","statement":"let mut dsu = Dsu::new(n);"},{"line":45,"function":"kruskal_weights","statement":"let mut out = Vec::new();"},{"line":46,"function":"kruskal_weights","statement":"for (a, b, w) in sorted {"},{"line":47,"function":"kruskal_weights","statement":"if dsu.join(a, b) {"},{"line":48,"function":"kruskal_weights","statement":"out.push(w);"},{"line":49,"function":"kruskal_weights","statement":"}"},{"line":51,"function":"kruskal_weights","statement":"assert!(n == 0 || out.len() == n - 1, \"connected graph required\");"},{"line":52,"function":"kruskal_weights","statement":"out"},{"line":43,"function":"closure · line 43","statement":"(w, a, b)"},{"line":56,"function":"main","statement":"let result = csv(kruskal_weights(3, &[(0, 1, 2), (1, 2, 3), (0, 2, 10)]));"},{"line":57,"function":"