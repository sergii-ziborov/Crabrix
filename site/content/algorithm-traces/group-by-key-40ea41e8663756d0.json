{"key":"group-by-key-40ea41e8663756d0","sourceHash":"40ea41e8663756d093339f43d3503b20ce6d8646d1156856fa9f62ab3ec1a5e2","pattern":"group-by-key","category":"hashing","title":"Group by Canonical Key: Mental Model","idea":"Transform each item to a stable key and collect items sharing that key.","complexity":"O(sum of L log L) letter-key sorting · O(total symbols) space","source":"fn largest_anagram_group(words: &[&str]) -> usize {\n    let mut groups = std::collections::HashMap::new();\n    for word in words {\n        let mut key: Vec<char> = word.chars().collect();\n        key.sort_unstable();\n        *groups.entry(key).or_insert(0) += 1;\n    }\n    groups.values().copied().max().unwrap_or(0)\n}\n\nfn main() {\n    let result = largest_anagram_group(&[\"eat\", \"tea\", \"tan\", \"ate\", \"nat\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"largest_anagram_group","statement":"let mut groups = std::collections::HashMap::new();"},{"line":3,"function":"largest_anagram_group","statement":"for word in words {"},{"line":4,"function":"largest_anagram_group","statement":"let mut key: Vec<char> = word.chars().collect();"},{"line":5,"function":"largest_anagram_group","statement":"key.sort_unstable();"},{"line":6,"function":"largest_anagram_group","statement":"*groups.entry(key).or_insert(0) += 1;"},{"line":7,"function":"largest_anagram_group","statement":"}"},{"line":8,"function":"largest_anagram_group","statement":"groups.values().copied().max().unwrap_or(0)"},{"line":12,"function":"main","statement":"let result = largest_anagram_group(&[\"eat\", \"tea\", \"tan\", \"ate\", \"nat\"]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[eat,tea,tan,ate,nat]","stdout":"3\n","values":[{"type":"&[&str]","data":{"kind":"list","items":[{"kind":"scalar","text":"\"eat\""},{"kind":"scalar","text":"\"tea\""},{"kind":"scalar","text":"\"tan\""},{"kind":"s