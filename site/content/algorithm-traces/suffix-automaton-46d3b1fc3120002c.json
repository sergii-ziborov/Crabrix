{"key":"suffix-automaton-46d3b1fc3120002c","sourceHash":"46d3b1fc3120002c16cb9018189afb831b523137ba5c7a02c1bb9488977fb8d9","pattern":"suffix-automaton","category":"advanced-structures","title":"Suffix Automaton: Mental Model","idea":"Extend one character while cloning states when needed to preserve end-position equivalence classes.","complexity":"O(n log alphabet) with ordered transitions · O(n) states and transitions","source":"#[derive(Clone)]\nstruct SuffixState {\n    length: usize,\n    link: Option<usize>,\n    next: std::collections::BTreeMap<u8, usize>,\n}\nfn distinct_substrings(text: &str) -> usize {\n    let empty = SuffixState {\n        length: 0,\n        link: None,\n        next: std::collections::BTreeMap::new(),\n    };\n    let mut states = vec![empty.clone()];\n    let mut last = 0;\n    for c in text.bytes() {\n        let current = states.len();\n        states.push(SuffixState {\n            length: states[last].length + 1,\n            ..empty.clone()\n        });\n        let mut p = Some(last);\n        while let Some(v) = p {\n            if states[v].next.contains_key(&c) {\n                break;\n            }\n            states[v].next.insert(c, current);\n            p = states[v].link;\n        }\n        if let Some(v) = p {\n            let q = states[v].next[&c];\n            if states[v].length + 1 == states[q].length {\n                states[current].link = Some(q);\n            } else {\n                let clone = states.len();\n                let mut copied = states[q].clone();\n                copied.length = states[v].length + 1;\n                states.push(copied);\n                while let Some(v) = p {\n                    if states[v].next.get(&c) != Some(&q) {\n                        break;\n                    }\n                    states[v].next.insert(c, clone);\n                    p = states[v].link;\n                }\n                states[q].link = Some(clone);\n                states[current].link = Some(clone);\n            }\n        } else {\n            states[current].link = Some(0);\n        }\n        last = current;\n    }\n    states\n        .iter()\n        .skip(1)\n        .map(|s| s.length - states[s.link.unwrap()].length)\n        .sum()\n}\n\nfn main() {\n    let result = distinct_substrings(\"ababa\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"distinct_substrings","statement":"let empty = SuffixState {"},{"line":13,"function":"distinct_substrings","statement":"let mut states = vec![empty.clone()];"},{"line":14,"function":"distinct_substrings","statement":"let mut last = 0;"},{"line":15,"function":"distinct_substrings","statement":"for c in text.bytes() {"},{"line":16,"function":"distinct_substrings","statement":"let current = states.len();"},{"line":17,"function":"distinct_substrings","statement":"states.push(SuffixState {"},{"line":21,"function":"distinct_substrings","statement":"let mut p = Some(last);"},{"line":22,"function":"distinct_substrings","statement":"while let Some(v) = p {"},{"line":23,"function":"distinct_substrings","statement":"if states[v].next.contains_key(&c) {"},{"line":24,"function":"distinct_substrings","statement":"break;"},{"line":26,"function":"distinct_substrings","statement":"states[v].next.insert(c, current);"},{"line":27,"function":"distinct_substrings","statement":"p = states[v].link;"},{"line":28,"function":"distinct_substrings","statement":"}"},{"line":29,"function":"distinct_substrings","statement":"if let Some(v) = p {"},{"line":30,"function":"distinct_substrings","statement":"let q = states[v].next[&c];"},{"line":31,"function":"distinct_substrings","statement":"if states[v].length + 1 == states[q].length {"},{"line":32,"function":"distinct_substrings","statement":"states[current].link = Some(q);"},{"line":33,"function":"distinct_substrings","statement":"}"},{"line":34,"function":"distinct_substrings","statement":"let clone = states.len();"},{"line":35,"function":"distinct_subs