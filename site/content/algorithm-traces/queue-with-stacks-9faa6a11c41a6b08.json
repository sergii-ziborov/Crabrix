{"key":"queue-with-stacks-9faa6a11c41a6b08","sourceHash":"9faa6a11c41a6b087415b3557301bad3f174d4e10cf2f4cbca73e1baa6a7ba57","pattern":"queue-with-stacks","category":"stacks-queues","title":"Challenge: Queue from Two Stacks","idea":"Reverse the input stack into an output stack only when the output side is empty.","complexity":"O(1) amortised operation · O(n) space","source":"fn queue_front(operations: &[&str]) -> i32 {\n    let (mut incoming, mut outgoing) = (Vec::new(), Vec::new());\n    for op in operations {\n        if let Some(value) = op.strip_prefix(\"enqueue\") {\n            incoming.push(value.parse::<i32>().unwrap());\n            continue;\n        }\n        if outgoing.is_empty() {\n            while let Some(x) = incoming.pop() {\n                outgoing.push(x);\n            }\n        }\n        if *op == \"dequeue\" {\n            outgoing.pop().unwrap();\n        }\n    }\n    *outgoing.last().unwrap()\n}\n\nfn main() {\n    let result = queue_front(&[\"enqueue1\", \"enqueue2\", \"dequeue\", \"front\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"queue_front","statement":"let (mut incoming, mut outgoing) = (Vec::new(), Vec::new());"},{"line":3,"function":"queue_front","statement":"for op in operations {"},{"line":4,"function":"queue_front","statement":"if let Some(value) = op.strip_prefix(\"enqueue\") {"},{"line":5,"function":"queue_front","statement":"incoming.push(value.parse::<i32>().unwrap());"},{"line":6,"function":"queue_front","statement":"continue;"},{"line":8,"function":"queue_front","statement":"if outgoing.is_empty() {"},{"line":9,"function":"queue_front","statement":"while let Some(x) = incoming.pop() {"},{"line":10,"function":"queue_front","statement":"outgoing.push(x);"},{"line":11,"function":"queue_front","statement":"}"},{"line":13,"function":"queue_front","statement":"if *op == \"dequeue\" {"},{"line":14,"function":"queue_front","statement":"outgoing.pop().unwrap();"},{"line":15,"function":"queue_front","statement":"}"},{"line":17,"function":"queue_front","statement":"*outgoing.last().unwrap()"},{"line":21,"function":"main","statement":"let result = queue_front(&[\"enqueue1\", \"enqueue2\", \"dequeue\", \"front\"]).to_string();"},{"line":22,"function":"main","statement":"println!(\"{result}\");"},{"line":23,"function":"main","statement":"}"}],"version":1,"input":"enqueue1 enqueue2 dequeue front","stdout":"2\n","values":[{"type":"&[&str]","data":{"kind":"list","items":[{"kind":"scalar","text":"\"enqueue1\""},{"kind":"scalar","text":"\"enqueue2\""},{"kind":"scalar","text":"\"dequeue\""},{"kind":"scalar","text":"\"front\""}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"enqueue1\""}},{"type":"&str","data":{"kind":"scalar","text":"\"1\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"enqueue2\""}},{"type":"&str","data":{"kind":"scalar","text":"\"2\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"dequeue\""}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"front\""}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"2\""}}],"frames":[{"site":13,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["queue_front",2]],"locals":[["operations",0]]},{"site":1,"stack":[["main",1],["queue_front",2]],"locals":[["operations",0],["incoming",1],["outgoing"