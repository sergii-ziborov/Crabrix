{"key":"partition-labels-5591891e6ae19bea","sourceHash":"5591891e6ae19beaaf0d621d926e7d11614cc1cf4082b0de26e2580b45f11324","pattern":"partition-labels","category":"greedy-intervals","title":"Challenge: Last-Occurrence Partition","idea":"Extend the current segment to the farthest last occurrence of every symbol encountered.","complexity":"O(n) time · O(alphabet) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn partition_lengths(text: &str) -> Vec<usize> {\n    assert!(text.is_ascii());\n    let mut last = [0; 256];\n    for (i, c) in text.bytes().enumerate() {\n        last[c as usize] = i;\n    }\n    let (mut start, mut end) = (0, 0);\n    let mut out = Vec::new();\n    for (i, c) in text.bytes().enumerate() {\n        end = end.max(last[c as usize]);\n        if i == end {\n            out.push(i + 1 - start);\n            start = i + 1;\n        }\n    }\n    out\n}\n\nfn main() {\n    let result = csv(partition_lengths(\"abc\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"partition_lengths","statement":"assert!(text.is_ascii());"},{"line":9,"function":"partition_lengths","statement":"let mut last = [0; 256];"},{"line":10,"function":"partition_lengths","statement":"for (i, c) in text.bytes().enumerate() {"},{"line":11,"function":"partition_lengths","statement":"last[c as usize] = i;"},{"line":12,"function":"partition_lengths","statement":"}"},{"line":13,"function":"partition_lengths","statement":"let (mut start, mut end) = (0, 0);"},{"line":14,"function":"partition_lengths","statement":"let mut out = Vec::new();"},{"line":15,"function":"partition_lengths","statement":"for (i, c) in text.bytes().enumerate() {"},{"line":16,"function":"partition_lengths","statement":"end = end.max(last[c as usize]);"},{"line":17,"function":"partition_lengths","statement":"if i == end {"},{"line":18,"function":"