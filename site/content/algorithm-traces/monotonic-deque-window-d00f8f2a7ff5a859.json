{"key":"monotonic-deque-window-d00f8f2a7ff5a859","sourceHash":"d00f8f2a7ff5a8593603fcb376715d884cc63a5141948f1d3385ec3ea5177d4f","pattern":"monotonic-deque-window","category":"sliding-window","title":"Challenge: Monotonic Deque Window","idea":"Keep candidate indexes in decreasing value order and evict those outside the window.","complexity":"O(n) time · O(k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn window_maxima(values: &[i32], k: usize) -> Vec<i32> {\n    assert!(k > 0 && k <= values.len());\n    let mut deque = std::collections::VecDeque::new();\n    let mut result = Vec::new();\n    for (i, &x) in values.iter().enumerate() {\n        while deque.front().is_some_and(|&j| j + k <= i) {\n            deque.pop_front();\n        }\n        while deque.back().is_some_and(|&j| values[j] <= x) {\n            deque.pop_back();\n        }\n        deque.push_back(i);\n        if i + 1 >= k {\n            result.push(values[*deque.front().unwrap()]);\n        }\n    }\n    result\n}\n\nfn main() {\n    let result = csv(window_maxima(&[4, 2, 12, 3], 3));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"window_maxima","statement":"assert!(k > 0 && k <= values.len());"},{"line":9,"function":"window_maxima","statement":"let mut deque = std::collections::VecDeque::new();"},{"line":10,"function":"window_maxima","statement":"let mut result = Vec::new();"},{"line":11,"function":"window_maxima","statement":"for (i, &x) in values.iter().enumerate() {"},{"line":12,"function":"window_maxima","statement":"while deque.front().is_some_and(|&j| j + k <= i) {"},{"line":13,"function":"window_maxima","statement":"deque.pop_front();"},{"line":14,"function":"window_maxima","statement":"}"},{"line":15,"function":"window_maxima","statement":"while deque.back().is_some_and(|&j| values[j] <= x) {"},{"line":16,"function":"win