{"key":"matrix-binary-search-8703b7e7f9889d6a","sourceHash":"8703b7e7f9889d6abe26620d6bdd7d2de923c0a164f60a8ddd42b94d27007785","pattern":"matrix-binary-search","category":"binary-search","title":"Flattened Matrix Search: Mental Model","idea":"Map a flat midpoint back to row and column when rows form one global sorted order.","complexity":"O(log(rows*cols)) time · O(1) space","source":"fn matrix_contains(a: &[Vec<i32>], target: i32) -> bool {\n    if a.is_empty() || a[0].is_empty() {\n        return false;\n    }\n    let cols = a[0].len();\n    let (mut lo, mut hi) = (0, a.len() * cols);\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        let value = a[mid / cols][mid % cols];\n        if value == target {\n            return true;\n        }\n        if value < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    false // Row-major ordering must be globally sorted.\n}\n\nfn main() {\n    let result = matrix_contains(\n        &[vec![1, 3, 5, 7], vec![10, 11, 16, 20], vec![23, 30, 34, 60]],\n        16,\n    )\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"matrix_contains","statement":"if a.is_empty() || a[0].is_empty() {"},{"line":3,"function":"matrix_contains","statement":"return false;"},{"line":5,"function":"matrix_contains","statement":"let cols = a[0].len();"},{"line":6,"function":"matrix_contains","statement":"let (mut lo, mut hi) = (0, a.len() * cols);"},{"line":7,"function":"matrix_contains","statement":"while lo < hi {"},{"line":8,"function":"matrix_contains","statement":"let mid = lo + (hi - lo) / 2;"},{"line":9,"function":"matrix_contains","statement":"let value = a[mid / cols][mid % cols];"},{"line":10,"function":"matrix_contains","statement":"if value == target {"},{"line":11,"function":"matrix_contains","statement":"return true;"},{"line":13,"function":"matrix_contains","statement":"if value < target {"},{"line":14,"function":"matrix_contains","statement":"lo = mid + 1;"},{"line":15,"function":"matrix_contains","statement":"}"},{"line":16,"function":"matrix_contains","statement":"hi = mid;"},{"line":17,"function":"matrix_contains","statement":"}"},{"line":19,"function":"matrix_contains","statement":"false"},{"line":23,"function":"main","statement":"let result = matrix_contains("},{"line":28,"function":"main","statement":"println!(\"{result}\");"},{"line":29,"function":"main","statement":"}"}],"version":1,"input":"[[1,3,5,7],[10,11,16,20],[23,30,34,60]]","stdout":"true\n","values":[{"type":"&[alloc::vec::Vec<i32>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"7"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"10"},{"kind":"scalar","text":"11"},{"kind":"scalar","text":"16"},{"kind":"scalar","text":"20"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"23"},{"kind":"scalar","text":"30"},{"kind":"scalar","text":"34"},{"kind":"scalar","text":"60"}],"tuple":false}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"16"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"12"}},{"type":"usize","data":{"kind":"scalar","text":"6"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"true\""}}],"frames":[{"site":15,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1]]},{"site":2,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1]]},{"site":3,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2]]},{"site":4,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4]]},{"site":5,"stack":[["main",1],["matrix_contains",2]],"locals":[["a",0],["target",1],["cols",2],["lo",3],["hi",4]]},{"sit