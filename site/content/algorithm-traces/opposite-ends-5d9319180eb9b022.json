{"key":"opposite-ends-5d9319180eb9b022","sourceHash":"5d9319180eb9b022598ddd3a97434ed962352533a5118455e34fd7811193bd3d","pattern":"opposite-ends","category":"two-pointers","title":"Opposite-End Pointers: Mental Model","idea":"Move inward from both ends when ordering tells which side cannot improve.","complexity":"O(n) time · O(1) space","source":"fn pair_exists(values: &[i32], target: i32) -> bool {\n    if values.len() < 2 {\n        return false;\n    }\n    let (mut left, mut right) = (0, values.len() - 1);\n    while left < right {\n        let sum = values[left] + values[right];\n        if sum == target {\n            return true;\n        }\n        if sum < target {\n            left += 1;\n        } else {\n            right -= 1;\n        }\n    }\n    false\n}\n\nfn main() {\n    let result = pair_exists(&[1, 2, 4, 6, 9], 10).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"pair_exists","statement":"if values.len() < 2 {"},{"line":3,"function":"pair_exists","statement":"return false;"},{"line":5,"function":"pair_exists","statement":"let (mut left, mut right) = (0, values.len() - 1);"},{"line":6,"function":"pair_exists","statement":"while left < right {"},{"line":7,"function":"pair_exists","statement":"let sum = values[left] + values[right];"},{"line":8,"function":"pair_exists","statement":"if sum == target {"},{"line":9,"function":"pair_exists","statement":"return true;"},{"line":11,"function":"pair_exists","statement":"if sum < target {"},{"line":12,"function":"pair_exists","statement":"left += 1;"},{"line":13,"function":"pair_exists","statement":"}"},{"line":14,"function":"pair_exists","statement":"right -= 1;"},{"line":15,"function":"pair_exists","statement":"}"},{"line":17,"function":"pair_exists","statement":"false"},{"line":21,"function":"main","statement":"let result = pair_exists(&[1, 2, 4, 6, 9], 10).to_string();"},{"line":22,"function":"main","statement":"println!(\"{result}\");"},{"line":23,"function":"main","state