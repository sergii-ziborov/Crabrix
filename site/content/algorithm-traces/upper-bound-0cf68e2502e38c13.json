{"key":"upper-bound-0cf68e2502e38c13","sourceHash":"0cf68e2502e38c13c9701a6c879cdc7b6c5b4e5a042f63f924117b54f06a745e","pattern":"upper-bound","category":"binary-search","title":"Upper Bound: Mental Model","idea":"Maintain the first position whose value is strictly greater than target.","complexity":"O(log n) time · O(1) space","source":"fn upper_bound(a: &[i32], target: i32) -> usize {\n    let (mut lo, mut hi) = (0, a.len());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] <= target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    lo\n}\n\nfn main() {\n    let result = upper_bound(&[1, 2, 4, 4, 7], 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"upper_bound","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":3,"function":"upper_bound","statement":"while lo < hi {"},{"line":4,"function":"upper_bound","statement":"let mid = lo + (hi - lo) / 2;"},{"line":5,"function":"upper_bound","statement":"if a[mid] <= target {"},{"line":6,"function":"upper_bound","statement":"lo = mid + 1;"},{"line":7,"function":"upper_bound","statement":"}"},{"line":8,"function":"upper_bound","statement":"hi = mid;"},{"line":9,"function":"upper_bound","statement":"}"},{"line":11,"function":"upper_bound","statement":"lo"},{"line":15,"function":"main","statement":"let result = upper_bound(&[1, 2, 4, 4, 7], 4).to_string();"},{"line":16,"function":"main","statement":"println!(\"{result}\");"},{"line":17,"function":"main","statement":"}"}],"version":1,"input":"[1,2,4,4,7]","stdout":"4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"usize","data":{"ki