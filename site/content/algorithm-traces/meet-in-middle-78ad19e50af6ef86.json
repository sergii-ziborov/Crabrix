{"key":"meet-in-middle-78ad19e50af6ef86","sourceHash":"78ad19e50af6ef867086cfac53a34f50ff677a89c36d93dae334d7f6da993665","pattern":"meet-in-middle","category":"backtracking","title":"Meet in the Middle: Mental Model","idea":"Enumerate two half-spaces and combine their summaries instead of exploring the full product directly.","complexity":"O(2^(n/2) log 2^(n/2)) time · O(2^(n/2)) space","source":"fn subset_exists(values: &[i32], target: i32) -> bool {\n    fn sums(a: &[i32]) -> Vec<i32> {\n        let mut out = vec![0];\n        for &x in a {\n            let n = out.len();\n            for i in 0..n {\n                out.push(out[i] + x);\n            }\n        }\n        out\n    }\n    let mid = values.len() / 2;\n    let left = sums(&values[..mid]);\n    let mut right = sums(&values[mid..]);\n    right.sort_unstable();\n    left.into_iter()\n        .any(|x| right.binary_search(&(target - x)).is_ok())\n}\n\nfn main() {\n    let result = subset_exists(&[7, 3, 2, 9, 5, 11], 15).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":12,"function":"subset_exists","statement":"let mid = values.len() / 2;"},{"line":13,"function":"subset_exists","statement":"let left = sums(&values[..mid]);"},{"line":14,"function":"subset_exists","statement":"let mut right = sums(&values[mid..]);"},{"line":15,"function":"subset_exists","statement":"right.sort_unstable();"},{"line":16,"function":"subset_exists","statement":"left.into_iter()"},{"line":3,"function":"sums","statement":"let mut out = vec![0];"},{"line":4,"function":"sums","statement":"for &x in a {"},{"line":5,"function":"sums","statement":"let n = out.len();"},{"line":6,"function":"sums","statement":"for i in 0..n {"},{"line":7,"function":"sums","statement":"out.push(out[i] + x);"},{"line":8,"function":"sums","statement":"}"},{"line":10,"function":"sums","statement":"out"},{"line":17,"function":"closure · line 17","statement":"right.binary_search(&(target - x)).is_ok()"},{"line":21,"function":"main","statement"