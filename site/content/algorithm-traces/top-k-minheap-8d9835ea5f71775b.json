{"key":"top-k-minheap-8d9835ea5f71775b","sourceHash":"8d9835ea5f71775bdc0aab8779031fbf5d5b6ef47e412b599b0e609976ba0ea8","pattern":"top-k-minheap","category":"heaps-streaming","title":"Challenge: Top-K with a Min-Heap","idea":"Keep a heap of only k winners and evict its smallest whenever it grows.","complexity":"O(n log k) time · O(k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn top_k(values: &[i32], k: usize) -> Vec<i32> {\n    let mut heap = std::collections::BinaryHeap::new();\n    for &x in values {\n        heap.push(std::cmp::Reverse(x));\n        if heap.len() > k {\n            heap.pop();\n        }\n    }\n    let mut out: Vec<_> = heap.into_iter().map(|std::cmp::Reverse(x)| x).collect();\n    out.sort_unstable_by(|a, b| b.cmp(a));\n    out\n}\n\nfn main() {\n    let result = csv(top_k(&[1, 2, 3, 4], 3));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"top_k","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":9,"function":"top_k","statement":"for &x in values {"},{"line":10,"function":"top_k","statement":"heap.push(std::cmp::Reverse(x));"},{"line":11,"function":"top_k","statement":"if heap.len() > k {"},{"line":12,"function":"top_k","statement":"heap.pop();"},{"line":13,"function":"top_k","statement":"}"},{"line":15,"function":"top_k","statement":"let mut out: Vec<_> = heap.into_iter().map(|std::cmp::Reverse(x)| x).collect();"},{"line":16,"function":"top_k","statement":"out.sort_unstable_by(|a, b| b.cmp(a));"},{"line":17,"function":"top_k","statement":"out"},{"line":15,"function":"closure · line 15","statement":"x"},{"line":16,"function":"closure · line 16","statement":"b.cmp(a)"},{"line":21,"function":"main","statement":"let result = csv(top_k(&[1, 2, 3, 4], 3));"},{"line":22,"function":"main","statement":"println!(\"{result}\");"},{"line":23,"function":"main","