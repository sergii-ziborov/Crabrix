{"key":"tree-serialize-67b0e1df2b43e054","sourceHash":"67b0e1df2b43e054091a986393484cf4a30d8e3da58c8c0f5a9798131a0d551a","pattern":"tree-serialize","category":"trees","title":"Tree Serialize/Deserialize: Mental Model","idea":"Emit null markers as well as values so structure is reconstructible, not only traversal order.","complexity":"O(n) time · O(n) output","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn serialize(root: &Tree) -> String {\n    fn visit(root: &Tree, out: &mut Vec<String>) {\n        match root {\n            None => out.push(\"#\".into()),\n            Some(n) => {\n                out.push(n.value.to_string());\n                visit(&n.left, out);\n                visit(&n.right, out);\n            }\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out.join(\",\")\n}\n\nfn main() {\n    let result = serialize(&node(\n        1,\n        node(2, None, None),\n        node(3, node(4, None, None), node(5, None, None)),\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":21,"function":"serialize","statement":"let mut out = Vec::new();"},{"line":22,"function":"serialize","statement":"visit(root, &mut out);"},{"line":23,"function":"serialize","statement":"out.join(\",\")"},{"line":12,"function":"visit","statement":"match root {"},{"line":15,"function":"visit","statement":"out.push(n.value.to_string());"},{"line":16,"function":"visit","statement":"visit(&n.left, out);"},{"line":17,"function":"visit","statement":"visit(&n.right, out);"},{"line":18,"function":"visit","statement":"}"},{"line":27,"function":"main","statement":"let result = serialize(&node("},{"line":32,"function":"main","statement":"println!(\"{result}\");"},{"line":33,"function":"main","state