{"key":"rotated-search-d5eade6f824bc39c","sourceHash":"d5eade6f824bc39c931c53c38739796a0708084e8dc50cfc8168eec299361509","pattern":"rotated-search","category":"binary-search","title":"Rotated Sorted Search: Mental Model","idea":"At least one half remains sorted; use that fact to choose the viable side.","complexity":"O(log n) time · O(1) space","source":"fn rotated_index(a: &[i32], target: i32) -> i32 {\n    let (mut lo, mut hi) = (0, a.len()); // distinct values\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] == target {\n            return mid as i32;\n        }\n        if a[lo] <= a[mid] {\n            if a[lo] <= target && target < a[mid] {\n                hi = mid;\n            } else {\n                lo = mid + 1;\n            }\n        } else if a[mid] < target && target <= a[hi - 1] {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    -1\n}\n\nfn main() {\n    let result = rotated_index(&[4, 5, 6, 7, 0, 1, 2], 0).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"rotated_index","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":3,"function":"rotated_index","statement":"while lo < hi {"},{"line":4,"function":"rotated_index","statement":"let mid = lo + (hi - lo) / 2;"},{"line":5,"function":"rotated_index","statement":"if a[mid] == target {"},{"line":6,"function":"rotated_index","statement":"return mid as i32;"},{"line":8,"function":"rotated_index","statement":"if a[lo] <= a[mid] {"},{"line":9,"function":"rotated_index","statement":"if a[lo] <= target && target < a[mid] {"},{"line":10,"function":"rotated_index","statement":"hi = mid;"},{"line":11,"function":"rotated_index","statement":"}"},{"line":12,"function":"rotated_index","statement":"lo = mid + 1;"},{"line":13,"function":"rotated_index","statement":"}"},{"line":15,"function":"rotated_index","statement":"lo = mid + 1;"},{"line":16,"function":"rotated_index","statement":"}"},{"line":17,"function":"rotated_index","statement":"hi = mid;"},{"line":18,"function":"rotated_index","statement":"}"},{"line":20,"function":"rotated_index","statement":"-1"},{"line":24,"function":"main","statement":"let result = rotated_index(&[4, 5, 6, 7, 0, 1, 2], 0).to_string();"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"[4,5,6,7,0,1,2]","stdout":"4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"7"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"4\""}}],"frames":[{"site":16,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1]]},{"site":1,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3]]},{"site":2,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3]]},{"site":3,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3],["mid",4]]},{"site":5,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3],["mid",4]]},{"site":6,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3],["mid",4]]},{"site":9,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",2],["hi",3],["mid",4]]},{"site":10,"stack":[["main",1],["rotated_index",2]],"locals":[["a",0],["target",1],["lo",5],["hi",3],["mid",4