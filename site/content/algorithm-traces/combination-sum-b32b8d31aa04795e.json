{"key":"combination-sum-b32b8d31aa04795e","sourceHash":"b32b8d31aa04795ebb328371e7cb10bfb04eb08802cd68b8d8701b147cfb5f4c","pattern":"combination-sum","category":"backtracking","title":"Challenge: Combination Sum","idea":"Choose a candidate again or move forward while pruning when the remaining target is negative.","complexity":"Exponential worst case · O(target) depth","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn semicolon<T: std::fmt::Display>(a: Vec<Vec<T>>) -> String {\n    a.into_iter().map(csv).collect::<Vec<_>>().join(\";\")\n}\nfn combinations_sum(candidates: &[i32], target: i32) -> Vec<Vec<i32>> {\n    fn visit(a: &[i32], start: usize, left: i32, path: &mut Vec<i32>, out: &mut Vec<Vec<i32>>) {\n        if left == 0 {\n            out.push(path.clone());\n            return;\n        }\n        for i in start..a.len() {\n            if a[i] > left {\n                break;\n            }\n            path.push(a[i]);\n            visit(a, i, left - a[i], path, out);\n            path.pop();\n        }\n    }\n    let mut a = candidates.to_vec();\n    assert!(a.iter().all(|&x| x > 0));\n    a.sort_unstable();\n    a.dedup();\n    let mut out = Vec::new();\n    visit(&a, 0, target, &mut Vec::new(), &mut out);\n    out\n}\n\nfn main() {\n    let result = semicolon(combinations_sum(&[7], 7));\n    println!(\"{result}\");\n}\n","sites":[{"line":25,"function":"combinations_sum","statement":"let mut a = candidates.to_vec();"},{"line":26,"function":"combinations_sum","statement":"assert!(a.iter().all(|&x| x > 0));"},{"line":27,"function":"combinations_sum","statement":"a.sort_unstable();"},{"line":28,"function":"combinations_sum","statement":"a.dedup();"},{"line":29,"function":"combinations_sum","statement":"let mut out = Vec::new();"},{"line":30,"function":"combinations_sum","statement":"visit(&a, 0, target, &mut Vec::new(), &mut out);"},{"line":31,"function":"combinations_sum","statement":"out"},{"line":12,"function":"visit","statement":"if left == 0 {"},{"line":13,"function":"visit","statement":"out.push(path.clone());"},{"line":14,"function":"visit","statement":"return;"},{"line":16,"function":"visit","statement":"for i in start..a.len() {"},{"line":17,"function":"visit","statement":"if a[i] > left {"},{"line":18,"function":"visit","statement":"break;"},{"line":20,"function":"visit","statement":"path.push(a[i]);"},{"line":21,"function":"visit","statement":"visit(a, i, left - a[i], path, out);"},{"line":22,"function":"visit","statement":"path.pop();"},{"line":23,"function":"visit","statement":"}"},{"line":35,"function":"main","statement":"let result = semicolon(combinations_sum(&[7], 7));"},{"line":36,"function":"main","statement":"println!(\"{result}\");"},{"line":37,"function":"main","statement":"}"}],"version":1,"input":"candidates=[7]","stdout":"7\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"7"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"&mut alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&mut alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&mut alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"&mut alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"7"}],"tuple":false}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind"