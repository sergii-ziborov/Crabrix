{"key":"two-heap-median-5c7e988542f63aaf","sourceHash":"5c7e988542f63aaf6e78fdacd8adee908bdf47bfbeb26fbd5f8d335c113aad6d","pattern":"two-heap-median","category":"heaps-streaming","title":"Challenge: Median from Two Heaps","idea":"Keep the lower half in a max-heap and upper half in a min-heap with sizes differing by at most one.","complexity":"O(log n) insert · O(1) median · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn stream_medians(values: &[i32]) -> Vec<f64> {\n    let mut low = std::collections::BinaryHeap::new();\n    let mut high = std::collections::BinaryHeap::new();\n    let mut out = Vec::new();\n    for &x in values {\n        if low.peek().is_none_or(|&m| x <= m) {\n            low.push(x);\n        } else {\n            high.push(std::cmp::Reverse(x));\n        }\n        if low.len() > high.len() + 1 {\n            high.push(std::cmp::Reverse(low.pop().unwrap()));\n        }\n        if high.len() > low.len() {\n            low.push(high.pop().unwrap().0);\n        }\n        out.push(if low.len() == high.len() {\n            (*low.peek().unwrap() as f64 + high.peek().unwrap().0 as f64) / 2.0\n        } else {\n            *low.peek().unwrap() as f64\n        });\n    }\n    out\n}\n\nfn main() {\n    let result = csv(stream_medians(&[1, 3]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"stream_medians","statement":"let mut low = std::collections::BinaryHeap::new();"},{"line":9,"function":"stream_medians","statement":"let mut high = std::collections::BinaryHeap::new();"},{"line":10,"function":"stream_medians","statement":"let mut out = Vec::new();"},{"line":11,"function":"stream_medians","statement":"for &x in values {"},{"line":12,"function":"stream_medians","statement":"if low.peek().is_none_or(|&m| x <= m) {"},{"line":13,"function":"stream_medians","statement":"low.push(x)