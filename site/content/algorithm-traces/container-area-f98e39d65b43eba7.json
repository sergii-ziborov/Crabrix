{"key":"container-area-f98e39d65b43eba7","sourceHash":"f98e39d65b43eba74cec417c495ddcf3fa7cfed3d389f66b9317da0604d0bf32","pattern":"container-area","category":"two-pointers","title":"Container Area: Mental Model","idea":"The shorter boundary limits area, so only moving that boundary can improve the result.","complexity":"O(n) time · O(1) space","source":"fn greatest_container(heights: &[i32]) -> i32 {\n    if heights.len() < 2 {\n        return 0;\n    }\n    let (mut left, mut right, mut best) = (0, heights.len() - 1, 0);\n    while left < right {\n        best = best.max((right - left) as i32 * heights[left].min(heights[right]));\n        if heights[left] <= heights[right] {\n            left += 1;\n        } else {\n            right -= 1;\n        }\n    }\n    best\n}\n\nfn main() {\n    let result = greatest_container(&[1, 8, 6, 2, 5, 4, 8, 3, 7]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"greatest_container","statement":"if heights.len() < 2 {"},{"line":3,"function":"greatest_container","statement":"return 0;"},{"line":5,"function":"greatest_container","statement":"let (mut left, mut right, mut best) = (0, heights.len() - 1, 0);"},{"line":6,"function":"greatest_container","statement":"while left < right {"},{"line":7,"function":"greatest_container","statement":"best = best.max((right - left) as i32 * heights[left].min(heights[right]));"},{"line":8,"function":"greatest_container","statement":"if heights[left] <= heights[right] {"},{"line":9,"function":"greatest_container","statement":"left += 1;"},{"line":10,"function":"greatest_container","statement":"}"},{"line":11,"function":"greatest_container","statement":"right -= 1;"},{"line":12,"function":"greatest_container","statement":"}"},{"line":14,"function":"greatest_container","statement":"best"},{"line":18,"function":"main","statement":"let result = greatest_container(&[1, 8, 6, 2, 5, 4, 8, 3, 7]).to_string();"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"}],"version":1,"input":"[1,8,6,2,5,4,8,3,7]","stdout":"49\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"8"}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"8"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"49"}},{"type":"usize","data":{"kind":"scalar","text":"7"}},{"type":"usize","data":{"kind":"scalar","text":"6"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"49\""}}],"frames":[{"site":11,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0]]},{"site":2,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0]]},{"site":3,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0],["left",1],["right",2],["best",3]]},{"site":4,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0],["left",1],["right",2],["best",3]]},{"site":5,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0],["left",1],["right",2],["best",4]]},{"site":6,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0],["left",1],["right",2],["best",4]]},{"site":7,"stack":[["main",1],["greatest_container",2]],"locals":[["heights",0],["left",5],["right",2],["best",4]]},{"site":4,"stack":[["main",1],["greatest_containe