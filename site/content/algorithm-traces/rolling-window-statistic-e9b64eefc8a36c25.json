{"key":"rolling-window-statistic-e9b64eefc8a36c25","sourceHash":"e9b64eefc8a36c25fec357133296f64d8f88133c0bfcc4ee236e2c6eb53fd969","pattern":"rolling-window-statistic","category":"sliding-window","title":"Rolling Mean and Variance: Mental Model","idea":"Update sufficient statistics as samples enter and leave rather than retaining every computation.","complexity":"O(n) time · O(1) extra state over a borrowed slice; a stream needs an eviction buffer","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\n\nfn window_stats(values: &[i64], k: usize) -> Vec<(i64, i64)> {\n    assert!(k > 0 && k <= values.len());\n    let width = k as i64;\n    // Sum and sum of squares stay exact; only the reported values are rounded down.\n    let mut sum: i64 = values[..k].iter().sum();\n    let mut squares: i64 = values[..k].iter().map(|x| x * x).sum();\n    let report = |sum: i64, squares: i64| {\n        (\n            sum.div_euclid(width),\n            (width * squares - sum * sum).div_euclid(width * width),\n        )\n    };\n    let mut result = vec![report(sum, squares)];\n    for i in k..values.len() {\n        sum += values[i] - values[i - k];\n        squares += values[i] * values[i] - values[i - k] * values[i - k];\n        result.push(report(sum, squares));\n    }\n    result\n}\nfn window_means(values: &[i64], k: usize) -> Vec<i64> {\n    window_stats(values, k).into_iter().map(|s| s.0).collect()\n}\nfn window_variances(values: &[i64], k: usize) -> Vec<i64> {\n    window_stats(values, k).into_iter().map(|s| s.1).collect()\n}\n\nfn main() {\n    let result = csv(window_means(&[2, 4, 6, 8, 10], 3));\n    println!(\"{result}\");\n}\n","sites":[{"line":9,"function":"window_stats","statement":"assert!(k > 0 && k <= values.len());"},{"line":10,"function":"window_stats","statement":"let width = k as i64;"},{"line":12,"function":"window_stats","statement":"let mut sum: i64 = values[..k].iter().sum();"},{"line":13,"function":"window_stats","statement":"let mut squares: i64 = values[..k].iter().map(|x| x * x).sum();"},{"line":14,"function":"window_stats","statement":"let report = |sum: i64, squares: i64| {"},{"line":20,"function":"window_stats","statement":"let mut result = vec![report(sum, squares)];"},{"line":21,"function":"window_stats","statement":"for i in k..values.len() {"},{"line":22,"function":"window_stats","statement":"sum += values[i] - values[i - k];"},{"line":23,"function":"window_stats","statement":"squares += values[i] * values[i] - values[i - k] * values[i - k];"},{"line":24,"function":"window_stats","statement":"result.push(report(sum, squares));"},{"line":25,"function":"window_stats","statement":"}"},{"line":26,"function":"window_stats","statement":"result"},{"line":13,"function":"closure · line 13","statement":"x * x"},{"line":15,"function":"closure · line 14","statement":"("},{"line":29,"function":"window_means","statement":"window_stats(values, k).into_iter().map(|s| s.0).collect()"},{"line":29,"function":"closure · line 29","statement":"s.0"},{"line":32,"function":"window_variances","statement":"window_stats(values, k).into_iter().map(|s| s.1).collect()"},{"line":32,"function":"closure · line 32","statement":"s.1"},{"line":36,"function":"main","statement":"let result = csv(window_means(&[2, 4, 6, 8, 10], 3));"},{"line":37,"function":"main","statement":"println!(\"{result}\");"},{"line":38,"function":"main","statement":"}"}],"version":1,"input":"[2,4,6,8,10]","stdout":"4,6,8\n","values":[{"type":"&[i64]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"10"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i64","data":{"kind":"scalar","text":"3"}},{"type":"i64","data":{"kind":"scalar","text":"12"}},{"type":"&i64","data":{"kind":"scalar",