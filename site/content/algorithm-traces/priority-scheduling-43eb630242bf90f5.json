{"key":"priority-scheduling-43eb630242bf90f5","sourceHash":"43eb630242bf90f509107cee8aae833f2da9a81057cbf56a7e4eaeba59656c25","pattern":"priority-scheduling","category":"heaps-streaming","title":"Challenge: Priority Scheduling","idea":"Order available work by the decision criterion while time controls when work becomes eligible.","complexity":"O(n log n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn completion_order(jobs: &[(usize, i32, i32)]) -> Vec<usize> {\n    let mut arrivals = jobs.to_vec();\n    arrivals.sort_by_key(|&(id, t, _)| (t, id));\n    let mut ready = std::collections::BinaryHeap::new();\n    let (mut i, mut time) = (0, 0);\n    let mut out = Vec::new();\n    while i < arrivals.len() || !ready.is_empty() {\n        if ready.is_empty() {\n            time = time.max(arrivals[i].1);\n        }\n        while i < arrivals.len() && arrivals[i].1 <= time {\n            let (id, _, duration) = arrivals[i];\n            ready.push(std::cmp::Reverse((duration, id)));\n            i += 1;\n        }\n        let std::cmp::Reverse((duration, id)) = ready.pop().unwrap();\n        time += duration;\n        out.push(id);\n    }\n    out\n}\n\nfn main() {\n    let result = csv(completion_order(&[(0, 0, 2), (1, 0, 1), (2, 3, 1)]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"completion_order","statement":"let mut arrivals = jobs.to_vec();"},{"line":9,"function":"completion_order","statement":"arrivals.sort_by_key(|&(id, t, _)| (t, id));"},{"line":10,"function":"completion_order","statement":"let mut ready = std::collections::BinaryHeap::new();"},{"line":11,"function":"completion_order","statement":"let (mut i, mut time) = (0, 0);"},{"line":12,"function":"completion_order","statement":"let mut out = Vec::new();"},{"line":13,"function":"completion_order","statement":"while i < arrivals.len() || !ready.is_empty() {"},{"line":14,"function":"completion_order","statement":"if ready.is_empty() {"},{"line":15,"function":"completion_order","statement":"time = time.max(arrivals[i].1);"},{"line":16,"function":"completion_order","statement":"}"},{"line":17,"function":"completion_order","statement":"while i < arrivals.len() && arrivals[i].1 <= time {"},{"line":18,"function":"completion_order","statement":"let (id, _, duration) = arrivals[i];"},{"line":19,"function":"completion_order","statement":"ready.push(std::cmp::Reverse((duration, id)));"},{"line":20,"function":"completion_order","statement":"i += 1;"},{"line":21,"function":"completion_order","statement":"}"},{"line":22,"function":"completion_order","statement":"let std::cmp::Reverse((duration, id)) = ready.pop().unwrap();"},{"line":23,"function":"completion_order","statement":"time += duration;"},{"line":24,"function":"completion_order","statement":"out.push(id);"},{"line":25,"function":"completion_order","statement":"}"},{"line":26,"function":"completion_order","statement":"out"},{"line":9,"function":"closure · line 9","statement":"(t, id)"},{"line":30,"function":"main","statement":"let result = csv(completion_order(&[(0, 0, 2), (1, 0, 1), (2, 3, 1)]));"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"(id0,t0,d2),(id1,t0,d1),(id2,t3,d1)","stdout":"1,0,2\n","values":[{"type":"&[(usize, i32, i32)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"1"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(usize, i32, i32)>","data":{"kind":"list","items":[{"kind":"list","ite