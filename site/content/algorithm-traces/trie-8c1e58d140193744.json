{"key":"trie-8c1e58d140193744","sourceHash":"8c1e58d140193744a30f2f9f2007b9305f61233b2c16d954551f26d4dcd9f330","pattern":"trie","category":"strings-tries","title":"Challenge: Prefix Trie","idea":"Store one edge per next symbol so shared prefixes occupy shared nodes.","complexity":"O(total symbols * log alphabet) with ordered child maps; O(prefix length * log alphabet) query","source":"#[derive(Default)]\nstruct TrieNode {\n    children: std::collections::BTreeMap<char, usize>,\n    pass: usize,\n}\nfn prefix_count(words: &[&str], prefix: &str) -> usize {\n    let mut nodes = vec![TrieNode::default()];\n    for word in words {\n        let mut v = 0;\n        nodes[v].pass += 1;\n        for c in word.chars() {\n            let u = if let Some(&u) = nodes[v].children.get(&c) {\n                u\n            } else {\n                let u = nodes.len();\n                nodes.push(TrieNode::default());\n                nodes[v].children.insert(c, u);\n                u\n            };\n            v = u;\n            nodes[v].pass += 1;\n        }\n    }\n    let mut v = 0;\n    for c in prefix.chars() {\n        let Some(&u) = nodes[v].children.get(&c) else {\n            return 0;\n        };\n        v = u;\n    }\n    nodes[v].pass\n}\n\nfn main() {\n    let result = prefix_count(&[\"cat\", \"dog\"], \"ca\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"prefix_count","statement":"let mut nodes = vec![TrieNode::default()];"},{"line":8,"function":"prefix_count","statement":"for word in words {"},{"line":9,"function":"prefix_count","statement":"let mut v = 0;"},{"line":10,"function":"prefix_count","statement":"nodes[v].pass += 1;"},{"line":11,"function":"prefix_count","statement":"for c in word.chars() {"},{"line":12,"function":"prefix_count","statement":"let u = if let Some(&u) = nodes[v].children.get(&c) {"},{"line":13,"function":"prefix_count","statement":"u"},{"line":15,"function":"prefix_count","statement":"let u = nodes.len();"},{"line":16,"function":"prefix_count","statement":"nodes.push(TrieNode::default());"},{"line":17,"function":"prefix_count","statement":"nodes[v].children.insert(c, u);"},{"line":18,"function":"prefix_count","statement":"u"},{"line":20,"function":"prefix_count","statement":"v = u;"},{"line":21,"function":"prefix_count","statement":"nodes[v].pass += 1;"},{"line":22,"function":"prefix_count","statement":"}"},{"line":24,"function":"prefix_count","statement":"let mut v = 0;"},{"line":25,"function":"prefix_count","statement":"for c in prefix.chars() {"},{"line":26,"function":"prefix_count","statement":"let Some(&u) = nodes[v].children.get(&c) else {"},{"line":27,"function":"prefix_count","statement":"return 0;"},{"line":29,"function":"prefix_count","statement":"v = u;"},{"line":30,"function":"prefix_count","statement":"}"},{"line":31,"function":"prefix_count","statement":"nodes[v].pass"},{"line":35,"function":"main","statement":"let result = prefix_count(&[\"cat\", \"dog\"], \"ca\").to_string();"},{"line":36,"function":"main","statement":"println!(\"{result}\");"},{"line":37,"function":"main","statement":"}"}],"version":1,"input":"words=[cat,dog] prefix=ca","stdout":"1\n","values":[{"type":"&[&str]","data":{"kind":"list","items":[{"kind":"scalar","text":"\"cat\""},{"kind":"scalar","text":"\"dog\""}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"ca\""}},{"type":"alloc::vec::Vec<traced::TrieNode>","data":{"kind":"list","items":[{"kind":"named","name":"TrieNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"children"},{"kind":"set","items":[]}],[{"kind":"scalar","text":"pass"},{"kind":"scalar","text":"0"}]]}}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"cat\""}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"alloc::vec::Vec<traced::TrieNode>","data":{"kind":"list","items":[{"kind":"named","name":"TrieNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"children"},{"kind":"set","items":[]}],[{"