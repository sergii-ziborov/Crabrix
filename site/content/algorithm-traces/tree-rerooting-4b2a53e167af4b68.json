{"key":"tree-rerooting-4b2a53e167af4b68","sourceHash":"4b2a53e167af4b6848aff0174f00a2d555177084c84a6303f3ba2dd056e3e330","pattern":"tree-rerooting","category":"trees","title":"Tree Rerooting DP: Mental Model","idea":"Compute child-to-parent contributions, then propagate the outside contribution while changing the root.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn distance_sums(graph: &[Vec<usize>]) -> Vec<usize> {\n    fn collect(v: usize, parent: usize, g: &[Vec<usize>], size: &mut [usize], down: &mut [usize]) {\n        size[v] = 1;\n        for &u in &g[v] {\n            if u != parent {\n                collect(u, v, g, size, down);\n                size[v] += size[u];\n                down[v] += down[u] + size[u];\n            }\n        }\n    }\n    fn reroot(v: usize, parent: usize, g: &[Vec<usize>], size: &[usize], answer: &mut [usize]) {\n        for &u in &g[v] {\n            if u != parent {\n                answer[u] = answer[v] + g.len() - 2 * size[u];\n                reroot(u, v, g, size, answer);\n            }\n        }\n    }\n    let n = graph.len();\n    if n == 0 {\n        return Vec::new();\n    }\n    let (mut size, mut answer) = (vec![0; n], vec![0; n]);\n    collect(0, n, graph, &mut size, &mut answer);\n    reroot(0, n, graph, &size, &mut answer);\n    answer\n}\n\nfn main() {\n    let result = csv(distance_sums(&[vec![1], vec![0, 2, 3], vec![1], vec![1]]));\n    println!(\"{result}\");\n}\n","sites":[{"line":26,"function":"distance_sums","statement":"let n = graph.len();"},{"line":27,"function":"distance_sums","statement":"if n == 0 {"},{"line":28,"function":"distance_sums","statement":"return Vec::new();"},{"line":30,"function":"distance_sums","statement":"let (mut size, mut answer) = (vec![0; n], vec![0; n]);"},{"line":31,"function":"distance_sums","statement":"collect(0, n, graph, &mut size, &mut answer);"},{"line":32,"function":"distance_sums","statement":"reroot(0, n, graph, &size, &mut answer);"},{"line":33,"function":"distance_sums","statement":"answer"},{"line":9,"function":"collect","statement":"size[v] = 1;"},{"line":10,"function":"collect","statement":"for &u in &g[v] {"},{"line":11,"function":"collect","statement":"if u != parent {","edge":{"collection":"g","from":"v","to":"u"}},{"line":12,"function":"collect","statement":"collect(u, v, g, size, down);","edge":{"collection":"g","from":"v","to":"u"}},{"line":13,"function":"collect","statement":"size[v] += size[u];","edge":{"collection":"g","from":"v","to":"u"}},{"line":14,"function":"collect","statement":"down[v] += down[u] + size[u];","edge":{"collection":"g","from":"v","to":"u"}},{"line":15,"function":"collect","statement":"}","edge":{"collection":"g","from":"v","to":"u"}},{"line":19,"function":"reroot","statement":"for &u in &g[v] {"},{"line":20,"function":"reroot","statement":"if u != parent {","edge":{"collection":"g","from":"v","to":"u"}},{"line":21,"function":"reroot","statement":"answer[u] = answer[v] + g.len() - 2 * size[u];","edge":{"collection":"g","from":"v","to":"u"}},{"line":22,"function":"reroot","statement":"reroot(u, v, g, size, answer);","edge":{"collection":"g","from":"v","to":"u"}},{"line":23,"function":"reroot","statement":"}","edge":{"collection":"g","from":"v","to":"u"}},{"line":37,"function":"main","statement":"let result = csv(distance_sums(&[vec![1], vec![0, 2, 3], vec![1], vec![1]]));"},{"line":38,"function":"main","statement":"println!(\"{result}\");"},{"line":39,"function":"main","statement":"}"}],"version":1,"input":"n=4 edges=(0,1),(1,2),(1,3)","stdout":"5,3,5,5\n","values":[{"type":"&[alloc::vec::Vec<usize>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tu