{"key":"prefix-suffix-product-5f454a380ad4e261","sourceHash":"5f454a380ad4e261dd66bbd6a64ee6355da39960ae3e5a291bdbad10b9590411","pattern":"prefix-suffix-product","category":"ranges","title":"Prefix/Suffix Product: Mental Model","idea":"Combine the product before and after each index without division.","complexity":"O(n) time · O(1) output-excluded space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn products_except_self(values: &[i64]) -> Vec<i64> {\n    let mut result = vec![1; values.len()];\n    let mut product = 1;\n    for i in 0..values.len() {\n        result[i] = product;\n        product *= values[i];\n    }\n    product = 1;\n    for i in (0..values.len()).rev() {\n        result[i] *= product;\n        product *= values[i];\n    }\n    result\n}\n\nfn main() {\n    let result = csv(products_except_self(&[1, 2, 3, 4]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"products_except_self","statement":"let mut result = vec![1; values.len()];"},{"line":9,"function":"products_except_self","statement":"let mut product = 1;"},{"line":10,"function":"products_except_self","statement":"for i in 0..values.len() {"},{"line":11,"function":"products_except_self","statement":"result[i] = product;"},{"line":12,"function":"products_except_self","statement":"product *= values[i];"},{"line":13,"function":"products_except_self","statement":"}"},{"line":14,"function":"products_except_self","statement":"product = 1;"},{"line":15,"function":"products_except_self","statement":"for i in (0..values.len()).rev() {"},{"line":16,"function":"products_except_self","statement":"result[i] *= product;"},{"line":17,"function":"products_except_self","statement":"product *= values[i];"},{"line":18,"function":"products_except_self","statement":"}"},{"line":19,"function":"products_except_self","statement":"result"},{"line":23,"fu