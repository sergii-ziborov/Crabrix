{"key":"decode-ways-ad345c1385c16248","sourceHash":"ad345c1385c162484b11b11dae025acf5f8bcdd3f57a67613ae0e461c1a39636","pattern":"decode-ways","category":"dynamic-1d","title":"Decode Ways DP: Mental Model","idea":"Count valid one-symbol and two-symbol predecessors while rejecting leading zero states.","complexity":"O(n) time · O(1) space","source":"fn decodings(text: &str) -> u64 {\n    assert!(text.bytes().all(|c| c.is_ascii_digit()));\n    let a = text.as_bytes();\n    let (mut before, mut current) = (1, 1);\n    for i in 0..a.len() {\n        let mut next = if a[i] != b'0' { current } else { 0 };\n        if i > 0 && (a[i - 1] == b'1' || a[i - 1] == b'2' && a[i] <= b'6') {\n            next += before;\n        }\n        before = current;\n        current = next;\n    }\n    current\n}\n\nfn main() {\n    let result = decodings(\"226\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"decodings","statement":"assert!(text.bytes().all(|c| c.is_ascii_digit()));"},{"line":3,"function":"decodings","statement":"let a = text.as_bytes();"},{"line":4,"function":"decodings","statement":"let (mut before, mut current) = (1, 1);"},{"line":5,"function":"decodings","statement":"for i in 0..a.len() {"},{"line":6,"function":"decodings","statement":"let mut next = if a[i] != b'0' { current } else { 0 };"},{"line":6,"function":"decodings","statement":"current"},{"line":6,"function":"decodings","statement":"0"},{"line":7,"function":"decodings","statement":"if i > 0 && (a[i - 1] == b'1' || a[i - 1] == b'2' && a[i] <= b'6') {"},{"line":8,"function":"decodings","statement":"next += before;"},{"line":9,"function":"decodings","statement":"}"},{"line":10,"function":"decodings","statement":"before = current;"},{"line":11,"function":"decodings","statement":"current = next;"},{"line":12,"function":"decodings","statement":"}"},{"line":13,"function":"decodings","statement":"current"},{"line":17,"function":"main","statement":"let result = decodings(\"226\").to_strin