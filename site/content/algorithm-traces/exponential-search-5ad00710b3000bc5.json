{"key":"exponential-search-5ad00710b3000bc5","sourceHash":"5ad00710b3000bc5e745ee6606aadefa561da205a3234918bbb2b3783d904c65","pattern":"exponential-search","category":"binary-search","title":"Challenge: Exponential Search","idea":"Double the search boundary until it brackets the target, then binary-search that finite range.","complexity":"O(log position) probes · O(1) space","source":"fn exponential_index(a: &[i32], target: i32) -> i32 {\n    if a.first() == Some(&target) {\n        return 0;\n    }\n    let mut bound = 1;\n    while bound < a.len() && a[bound] < target {\n        bound = bound.saturating_mul(2);\n    }\n    let (mut lo, mut hi) = (bound / 2, a.len().min(bound.saturating_add(1)));\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    if a.get(lo) == Some(&target) {\n        lo as i32\n    } else {\n        -1\n    }\n}\n\nfn main() {\n    let result = exponential_index(&[21, 30], 21).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"exponential_index","statement":"if a.first() == Some(&target) {"},{"line":3,"function":"exponential_index","statement":"return 0;"},{"line":5,"function":"exponential_index","statement":"let mut bound = 1;"},{"line":6,"function":"exponential_index","statement":"while bound < a.len() && a[bound] < target {"},{"line":7,"function":"exponential_index","statement":"bound = bound.saturating_mul(2);"},{"line":8,"function":"exponential_index","statement":"}"},{"line":9,"function":"exponential_index","statement":"let (mut lo, mut hi) = (bound / 2, a.len().min(bound.saturating_add(1)));"},{"line":10,"function":"exponential_index","statement":"while lo < hi {"},{"line":11,"function":"exponential_index","statement":"let mid = lo + (hi - lo) / 2;"},{"line":12,"function":"exponential_index","statement":"if a[mid] < target {"},{"line":13,"function":"exponential_index","statement":"lo = mid + 1;"},{"line":14,"function":"exponential_index","statement":"}"},{"line":15,"function":"exponential_index","statement":"hi = mid;"},{"line":16,"function":"exponential_index","statement":"}"},{"line":18,"function":"exponential_index","statement":"if a.get(lo) == Some(&target) {"},{"line":19,"function":"exponential_index","statement":"lo as i32"},{"line":21,"function":"exponential_index","statement":"-1"},{"line":26,"function":"main","statement":"let result = exponential_index(&[21, 30], 21).to_string();"},{"line":27,"function":"main","statement":"println!(\"{result}\");"},{"line":28,"function":"main","statement":"}"}],"version":1,"input":"[21,30]","stdout":"0\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"21"},{"kind":"scalar","text":"30"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"21"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0\""}}],"frames":[{"site":17,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["exponential_index",2]],"locals":[["a",0],["target",1]]},{"site":1,"stack":[["main",1],["exponential_index",2]],"locals":[["a",0],["target",1]]},{"site":18,"stack":[["main",1]],"locals":[["result",2]]},{"site":19,"stack":[["main",1]],"locals":[["result",2]]}],"verification":{"stdoutMatchesOriginal":true,"independentOracle":true,"omittedCaptures":0}}
