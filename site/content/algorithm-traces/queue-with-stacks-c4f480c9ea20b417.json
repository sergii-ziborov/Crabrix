{"key":"queue-with-stacks-c4f480c9ea20b417","sourceHash":"c4f480c9ea20b41709cf45cc2552c0cb7277c1218de2c585f2169cc16cb9000b","pattern":"queue-with-stacks","category":"stacks-queues","title":"Queue from Two Stacks: Mental Model","idea":"Reverse the input stack into an output stack only when the output side is empty.","complexity":"O(1) amortised operation · O(n) space","source":"fn queue_front(operations: &[&str]) -> i32 {\n    let (mut incoming, mut outgoing) = (Vec::new(), Vec::new());\n    for op in operations {\n        if let Some(value) = op.strip_prefix(\"enqueue\") {\n            incoming.push(value.parse::<i32>().unwrap());\n            continue;\n        }\n        if outgoing.is_empty() {\n            while let Some(x) = incoming.pop() {\n                outgoing.push(x);\n            }\n        }\n        if *op == \"dequeue\" {\n            outgoing.pop().unwrap();\n        }\n    }\n    *outgoing.last().unwrap()\n}\n\nfn main() {\n    let result = queue_front(&[\n        \"enqueue3\", \"enqueue5\", \"enqueue8\", \"dequeue\", \"dequeue\", \"enqueue2\", \"front\",\n    ])\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"queue_front","statement":"let (mut incoming, mut outgoing) = (Vec::new(), Vec::new());"},{"line":3,"function":"queue_front","statement":"for op in operations {"},{"line":4,"function":"queue_front","statement":"if let Some(value) = op.strip_prefix(\"enqueue\") {"},{"line":5,"function":"queue_front","statement":"incoming.push(value.parse::<i32>().unwrap());"},{"line":6,"function":"queue_front","statement":"continue;"},{"line":8,"function":"queue_front","statement":"if outgoing.is_empty() {"},{"line":9,"function":"queue_front","statement":"while let Some(x) = incoming.pop() {"},{"line":10,"function":"queue_front","statement":"outgoing.push(x);"},{"line":11,"function":"queue_front","statement":"}"},{"line":13,"function":"queue_front","statement":"if *op == \"dequeue\" {"},{"line":14,"function":"queue_front","statement":"outgoing.pop().unwrap();"},{"line":15,"function":"queue_front","statement":"}"},{"line":17,"function":"queue_front","statement":"*outgoing.last().unwrap()"},{"line":21,"function":"main","statement":"let result = queue_front(&["},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"enqueue3 enqueue5 enqueue8 dequeue dequeue enqueue2 front","stdout":"8\n","values":[{"type":"&[&str]","data":{"kind":"list","items":[{"kind":"scalar","text":"\"enqueue3\""},{"kind":"scalar","text":"\"enqueue5\""},{"kind":"scalar","text":"\"enqueue8\""},{"kind":"scalar","text":"\"dequeue\""},{"kind":"scalar","text":"\"dequeue\""},{"kind":"scalar","text":"\"enqueue2\""},{"kind":"scalar","text":"\"front\""}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"enqueue3\""}},{"type":"&str","data":{"kind":"scalar","text":"\"3\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"enqueue5\""}},{"type":"&str","data":{"kind":"scalar","text":"\"5\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"enqueue8\""}},{"type":"&str","data":{"kind":"scalar","text":"\"8\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"8"}],"tuple":false}},{"type":"&&str","data":{"kind":"scalar","text":"\"dequeue\""}},{"type":"i32","data":{"kind":"scalar","text":"8"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"8"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"sca