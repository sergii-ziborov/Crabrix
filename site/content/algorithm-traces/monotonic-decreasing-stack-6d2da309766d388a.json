{"key":"monotonic-decreasing-stack-6d2da309766d388a","sourceHash":"6d2da309766d388ac73ebd656caf649bb888248c34cd71f8bbd88655eecee1b5","pattern":"monotonic-decreasing-stack","category":"stacks-queues","title":"Monotonic Decreasing Stack: Mental Model","idea":"Pop smaller candidates so unresolved values remain in decreasing order.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn stock_spans(prices: &[i32]) -> Vec<usize> {\n    let mut stack: Vec<(i32, usize)> = Vec::new();\n    let mut result = Vec::new();\n    for &price in prices {\n        let mut span = 1; // include today\n        while stack.last().is_some_and(|&(p, _)| p <= price) {\n            span += stack.pop().unwrap().1;\n        }\n        stack.push((price, span));\n        result.push(span);\n    }\n    result\n}\n\nfn main() {\n    let result = csv(stock_spans(&[100, 80, 60, 70, 60, 75, 85]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"stock_spans","statement":"let mut stack: Vec<(i32, usize)> = Vec::new();"},{"line":9,"function":"stock_spans","statement":"let mut result = Vec::new();"},{"line":10,"function":"stock_spans","statement":"for &price in prices {"},{"line":11,"function":"stock_spans","statement":"let mut span = 1;"},{"line":12,"function":"stock_spans","statement":"while stack.last().is_some_and(|&(p, _)| p <= price) {"},{"line":13,"function":"stock_spans","statement":"span += stack.pop().unwrap().1;"},{"line":14,"function":"stock_spans","statement":"}"},{"line":15,"function":"stock_spans","statement":"stack.push((price, span));"},{"line":16,"function":"stock_spans","statement":"result.push(span);"},{"line":17,"function":"stock_spans","statement":"}"},{"line":18,"function":"stock_spans","statement":"result"},{"line":12,"function":"closure · line 12","statement":"p <= price"},{"line":22,"fu