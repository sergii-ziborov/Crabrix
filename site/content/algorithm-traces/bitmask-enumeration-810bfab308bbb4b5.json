{"key":"bitmask-enumeration-810bfab308bbb4b5","sourceHash":"810bfab308bbb4b5a225dbcc6bb546891555d845ec104ec67f67b8a853580388","pattern":"bitmask-enumeration","category":"math-bits","title":"Challenge: Bitmask Enumeration","idea":"Use each bit as an include/exclude choice for one item.","complexity":"O(2^n*n) time · O(1) state excluding output","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn matching_masks(values: &[i32], target: i32) -> Vec<usize> {\n    assert!(values.len() < usize::BITS as usize);\n    (0..1_usize << values.len())\n        .filter(|&mask| {\n            values\n                .iter()\n                .enumerate()\n                .filter(|(i, _)| mask >> i & 1 == 1)\n                .map(|(_, x)| x)\n                .sum::<i32>()\n                == target\n        })\n        .collect()\n}\n\nfn main() {\n    let result = csv(matching_masks(&[2, 3], 5));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"matching_masks","statement":"assert!(values.len() < usize::BITS as usize);"},{"line":9,"function":"matching_masks","statement":"(0..1_usize << values.len())"},{"line":11,"function":"closure · line 10","statement":"values"},{"line":14,"function":"closure · line 14","statement":"mask >> i & 1 == 1"},{"line":15,"function":"closure · line 15","statement":"x"},{"line":23,"function":"main","statement":"let result = csv(matching_masks(&[2, 3], 5));"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"values=[2,3]","stdout":"3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"&usize","data":{"kind":"scalar","text":"0"}},{"type":"&usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&i32","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"&i32","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"3\""}}],"frames":[{"site":5,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["matching_masks",2]],"locals":[["values",0],["target",1]]},{"site":1,"stack":[["main",1],["matching_masks",2]],"locals":[["values",0],["target",1]]},{"site":2,"stack":[["main",1],["matching_masks",2],["closure · line 10",3]],"locals":[["mask",2],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],["closure · line 10",3],["closure · line 14",4]],"locals":[["i",3],["mask",2],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],["closure · line 10",3],["closure · line 14",5]],"locals":[["i",4],["mask",2],["values",0],["target",1]]},{"site":2,"stack":[["main",1],["matching_masks",2],["closure · line 10",6]],"locals":[["mask",5],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],["closure · line 10",6],["closure · line 14",7]],"locals":[["i",3],["mask",5],["values",0],["target",1]]},{"site":4,"stack":[["main",1],["matching_masks",2],["closure · line 10",6],["closure · line 15",8]],"locals":[["x",6],["mask",5],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],["closure · line 10",6],["closure · line 14",9]],"locals":[["i",4],["mask",5],["values",0],["target",1]]},{"site":2,"stack":[["main",1],["matching_masks",2],["closure · line 10",10]],"locals":[["mask",7],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],["closure · line 10",10],["closure · line 14",11]],"locals":[["i",3],["mask",7],["values",0],["target",1]]},{"site":3,"stack":[["main",1],["matching_masks",2],