{"key":"adjacency-list-71ada5b90735c091","sourceHash":"71ada5b90735c091c42075285119f4d16f6cc1c203f23cca8117da14e50a8fc2","pattern":"adjacency-list","category":"graph-traversal","title":"Challenge: Adjacency List","idea":"Store only existing neighbors so traversal cost follows vertices plus edges.","complexity":"O(V+E) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn neighbors(n: usize, edges: &[(usize, usize)], query: usize) -> Vec<usize> {\n    let mut graph = vec![Vec::new(); n];\n    for &(a, b) in edges {\n        graph[a].push(b);\n        graph[b].push(a);\n    }\n    graph[query].sort_unstable();\n    graph[query].clone()\n}\n\nfn main() {\n    let result = csv(neighbors(3, &[(0, 1), (1, 2)], 2));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"neighbors","statement":"let mut graph = vec![Vec::new(); n];"},{"line":9,"function":"neighbors","statement":"for &(a, b) in edges {"},{"line":10,"function":"neighbors","statement":"graph[a].push(b);"},{"line":11,"function":"neighbors","statement":"graph[b].push(a);"},{"line":12,"function":"neighbors","statement":"}"},{"line":13,"function":"neighbors","statement":"graph[query].sort_unstable();"},{"line":14,"function":"neighbors","statement":"graph[query].clone()"},{"line":18,"function":"main","statement":"let result = csv(neighbors(3, &[(0, 1), (1, 2)], 2));"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"}],"version":1,"input":"n=3 edges=(0,1),(1,2)","stdout":"1\n","values":[{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"&[(usize, usize)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true}],"tuple":fal