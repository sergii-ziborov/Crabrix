{"key":"insert-interval-c540e1095c1c1949","sourceHash":"c540e1095c1c194902f5f3ee7b45745ed333f552aa4e582afd6596d6600c8fc2","pattern":"insert-interval","category":"greedy-intervals","title":"Insert into Sorted Intervals: Mental Model","idea":"Copy intervals before, merge every overlap, then copy intervals after.","complexity":"O(n) time · O(n) output","source":"fn inserted_interval(intervals: &[(i32, i32)], mut new: (i32, i32)) -> Vec<(i32, i32)> {\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < intervals.len() && intervals[i].1 < new.0 {\n        out.push(intervals[i]);\n        i += 1;\n    }\n    while i < intervals.len() && intervals[i].0 <= new.1 {\n        new.0 = new.0.min(intervals[i].0);\n        new.1 = new.1.max(intervals[i].1);\n        i += 1;\n    }\n    out.push(new);\n    out.extend_from_slice(&intervals[i..]);\n    out\n}\n\nfn main() {\n    let result = inserted_interval(&[(1, 2), (3, 5), (6, 7), (8, 10), (12, 16)], (4, 8))\n        .iter()\n        .map(|(a, b)| format!(\"{a}-{b}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"inserted_interval","statement":"let mut out = Vec::new();"},{"line":3,"function":"inserted_interval","statement":"let mut i = 0;"},{"line":4,"function":"inserted_interval","statement":"while i < intervals.len() && intervals[i].1 < new.0 {"},{"line":5,"function":"inserted_interval","statement":"out.push(intervals[i]);"},{"line":6,"function":"inserted_interval","statement":"i += 1;"},{"line":7,"function":"inserted_interval","statement":"}"},{"line":8,"function":"inserted_interval","statement":"while i < intervals.len() && intervals[i].0 <= new.1 {"},{"line":9,"function":"inserted_interval","statement":"new.0 = new.0.min(intervals[i].0);"},{"line":10,"function":"inserted_interval","statement":"new.1 = new.1.max(intervals[i].1);"},{"line":11,"function":"inserted_interval","statement":"i += 1;"},{"line":12,"function":"inserted_interval","st