{"key":"monotonic-increasing-stack-bed9ab785182491f","sourceHash":"bed9ab785182491fabfd2e31afc65275353dccfcdc6acae2b8b4dc98d1229be0","pattern":"monotonic-increasing-stack","category":"stacks-queues","title":"Monotonic Increasing Stack: Mental Model","idea":"Pop larger candidates so the stack represents the nearest smaller boundary.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn previous_smaller(values: &[i32]) -> Vec<i32> {\n    let mut stack = Vec::new();\n    let mut result = Vec::new();\n    for &x in values {\n        while stack.last().is_some_and(|&old| old >= x) {\n            stack.pop();\n        }\n        result.push(stack.last().copied().unwrap_or(-1));\n        stack.push(x);\n    }\n    result\n}\n\nfn main() {\n    let result = csv(previous_smaller(&[4, 5, 2, 10, 8]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"previous_smaller","statement":"let mut stack = Vec::new();"},{"line":9,"function":"previous_smaller","statement":"let mut result = Vec::new();"},{"line":10,"function":"previous_smaller","statement":"for &x in values {"},{"line":11,"function":"previous_smaller","statement":"while stack.last().is_some_and(|&old| old >= x) {"},{"line":12,"function":"previous_smaller","statement":"stack.pop();"},{"line":13,"function":"previous_smaller","statement":"}"},{"line":14,"function":"previous_smaller","statement":"result.push(stack.last().copied().unwrap_or(-1));"},{"line":15,"function":"previous_smaller","statement":"stack.push(x);"},{"line":16,"function":"previous_smaller","statement":"}"},{"line":17,"function":"previous_smaller","statement":"result"},{"line":11,"function":"closure · line 11","statement":"old >= x"},{"line":21,"function":"main","statement":"let result = csv(previous_smaller(&[4, 5, 2, 10, 8]));"},{"line":22,"function":"main","stateme