{"key":"copy-random-list-e0e499ec2f15ba4d","sourceHash":"e0e499ec2f15ba4d6fa3050c4e0999bc754f5cb32f749efb83e7c4f0b376d423","pattern":"copy-random-list","category":"linked-lists","title":"Challenge: Copy with Random Links","idea":"Map old nodes to new nodes or interleave copies so arbitrary links can be reconstructed.","complexity":"O(n) time · O(n) old-to-new map and copied nodes","source":"struct RandomNode {\n    value: i32,\n    next: Option<usize>,\n    random: Option<usize>,\n}\nfn deep_copy(arena: &[RandomNode], head: Option<usize>) -> Vec<RandomNode> {\n    // First pass: give every source node a slot in the new arena, in list order.\n    let mut slot = std::collections::HashMap::new();\n    let mut copy = Vec::new();\n    let mut cursor = head;\n    while let Some(old) = cursor {\n        slot.insert(old, copy.len());\n        copy.push(RandomNode {\n            value: arena[old].value,\n            next: None,\n            random: None,\n        });\n        cursor = arena[old].next;\n    }\n    // Second pass: an old index names a source node, so translate every link.\n    let mut cursor = head;\n    while let Some(old) = cursor {\n        let new = slot[&old];\n        copy[new].next = arena[old].next.map(|n| slot[&n]);\n        copy[new].random = arena[old].random.map(|r| slot[&r]);\n        cursor = arena[old].next;\n    }\n    copy\n}\nfn copied_pairs(values: &[i32], next: &[Option<usize>], random: &[Option<usize>]) -> String {\n    let original: Vec<_> = values\n        .iter()\n        .enumerate()\n        .map(|(i, &value)| RandomNode {\n            value,\n            next: next[i],\n            random: random[i],\n        })\n        .collect();\n    let mut copy = deep_copy(&original, (!original.is_empty()).then_some(0));\n    let out = copy\n        .iter()\n        .map(|n| {\n            format!(\n                \"{}:{}\",\n                n.value,\n                n.random.map_or(\"null\".into(), |i| i.to_string())\n            )\n        })\n        .collect::<Vec<_>>()\n        .join(\",\");\n    // The copy owns separate nodes, so changing it leaves the source untouched.\n    if !copy.is_empty() {\n        copy[0].value += 1;\n        assert_ne!(original[0].value, copy[0].value);\n    }\n    out\n}\n\nfn main() {\n    let result = copied_pairs(&[1], &[None], &[None]);\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"deep_copy","statement":"let mut slot = std::collections::HashMap::new();"},{"line":9,"function":"deep_copy","statement":"let mut copy = Vec::new();"},{"line":10,"function":"deep_copy","statement":"let mut cursor = head;"},{"line":11,"function":"deep_copy","statement":"while let Some(old) = cursor {"},{"line":12,"function":"deep_copy","statement":"slot.insert(old, copy.len());"},{"line":13,"function":"deep_copy","statement":"copy.push(RandomNode {"},{"line":18,"function":"deep_copy","statement":"cursor = arena[old].next;"},{"line":19,"function":"deep_copy","statement":"}"},{"line":21,"function":"deep_copy","statement":"let mut cursor = head;"},{"line":22,"function":"deep_copy","statement":"while let Some(old) = cursor {"},{"line":23,"function":"deep_copy","statement":"let new = slot[&old];"},{"line":24,"function":"deep_copy","statement":"copy[new].next = arena[old].next.map(|n| slot[&n]);"},{"line":25,"function":"deep_copy","statement":"copy[new].random = arena[old].random.map(|r| slot[&r]);"},{"line":26,"function":"deep_copy","statement":"cursor = arena[old].next;"},{"line":27,"function":"deep_copy","statement":"}"},{"line":28,"function":"deep_copy","statement":"copy"},{"line":24,"function":"closure · line 24","statement":"slot[&n]"},{"line":25,"function":"closure · line 25","statement":"slot[&r]"},{"line":31,"function":"copied_pairs","statement":"let original: Vec<_> = values"},{"line":40,"function":"copied_pairs","statement":"let mut copy = deep_copy(&original, (!original.is_empty()).then_some(0));"},{"line":41,"function":"copied_pairs","statement":"let out = copy"},{