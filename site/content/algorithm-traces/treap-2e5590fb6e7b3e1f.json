{"key":"treap-2e5590fb6e7b3e1f","sourceHash":"2e5590fb6e7b3e1fb14ae47318e918d1b8b1fe1f1088b8a6d1de6a3b78c9bd06","pattern":"treap","category":"advanced-structures","title":"Challenge: Randomized Treap","idea":"Keep BST order by key and heap order by random priority; split and merge preserve both.","complexity":"O(log n) expected operation · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\ntype TreapLink = Option<Box<TreapNode>>;\nstruct TreapNode {\n    key: i32,\n    priority: u64,\n    left: TreapLink,\n    right: TreapLink,\n}\nfn merge_treaps(a: TreapLink, b: TreapLink) -> TreapLink {\n    match (a, b) {\n        (None, b) => b,\n        (a, None) => a,\n        (Some(mut a), Some(mut b)) => {\n            if a.priority > b.priority {\n                a.right = merge_treaps(a.right.take(), Some(b));\n                Some(a)\n            } else {\n                b.left = merge_treaps(Some(a), b.left.take());\n                Some(b)\n            }\n        }\n    }\n}\nfn treap_insert(root: TreapLink, key: i32, priority: u64) -> TreapLink {\n    let Some(mut n) = root else {\n        return Some(Box::new(TreapNode {\n            key,\n            priority,\n            left: None,\n            right: None,\n        }));\n    };\n    if key == n.key {\n        return Some(n);\n    }\n    if key < n.key {\n        n.left = treap_insert(n.left.take(), key, priority);\n        if n.left.as_ref().unwrap().priority > n.priority {\n            let mut top = n.left.take().unwrap();\n            n.left = top.right.take();\n            top.right = Some(n);\n            return Some(top);\n        }\n    } else {\n        n.right = treap_insert(n.right.take(), key, priority);\n        if n.right.as_ref().unwrap().priority > n.priority {\n            let mut top = n.right.take().unwrap();\n            n.right = top.left.take();\n            top.left = Some(n);\n            return Some(top);\n        }\n    }\n    Some(n)\n}\nfn treap_delete(root: TreapLink, key: i32) -> TreapLink {\n    let Some(mut n) = root else {\n        return None;\n    };\n    if key == n.key {\n        return merge_treaps(n.left.take(), n.right.take());\n    }\n    if key < n.key {\n        n.left = treap_delete(n.left.take(), key);\n    } else {\n        n.right = treap_delete(n.right.take(), key);\n    }\n    Some(n)\n}\nfn treap_operations(ops: &[(bool, i32)]) -> Vec<i32> {\n    let mut root = None;\n    let mut random = 0xC0FFEE_u64;\n    for &(insert, key) in ops {\n        random ^= random << 13;\n        random ^= random >> 7;\n        random ^= random << 17;\n        root = if insert {\n            treap_insert(root, key, random)\n        } else {\n            treap_delete(root, key)\n        };\n    }\n    fn walk(root: &TreapLink, out: &mut Vec<i32>) {\n        if let Some(n) = root {\n            walk(&n.left, out);\n            out.push(n.key);\n            walk(&n.right, out);\n        }\n    }\n    let mut out = Vec::new();\n    walk(&root, &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(treap_operations(&[(true, 4), (true, 2), (false, 4)]));\n    println!(\"{result}\");\n}\n","sites":[{"line":15,"function":"merge_treaps","statement":"match (a, b) {"},{"line":19,"function":"merge_treaps","statement":"if a.priority > b.priority {"},{"line":20,"function":"merge_treaps","statement":"a.right = merge_treaps(a.right.take(), Some(b));"},{"line":21,"function":"merge_treaps","statement":"Some(a)"},{"line":23,"function":"merge_treaps","statement":"b.left = merge_treaps(Some(a), b.left.take());"},{"line":24,"function":"merge_treaps","statement":"Some(b)"},{"line":30,"function":"treap_insert","statement":"let Some(mut n) = root else {"},{"line":31,"function":"treap_insert","statement":"return Some(Box::new(TreapNode {"},{"line":38,"function":"treap_insert","statement":"if key == n.key {"},{"line":