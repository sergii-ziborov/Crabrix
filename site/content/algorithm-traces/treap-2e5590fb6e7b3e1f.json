tion":"treap_operations","statement":"let mut root = None;"},{"line":76,"function":"treap_operations","statement":"let mut random = 0xC0FFEE_u64;"},{"line":77,"function":"treap_operations","statement":"for &(insert, key) in ops {"},{"line":78,"function":"treap_operations","statement":"random ^= random << 13;"},{"line":79,"function":"treap_operations","statement":"random ^= random >> 7;"},{"line":80,"function":"treap_operations","statement":"random ^= random << 17;"},{"line":81,"function":"treap_operations","statement":"root = if insert {"},{"line":82,"function":"treap_operations","statement":"treap_insert(root, key, random)"},{"line":84,"function":"treap_operations","statement":"treap_delete(root, key)"},{"line":86,"function":"treap_operations","statement":"}"},{"line":94,"function":"treap_operations","statement":"let mut out = Vec::new();"},{"line":95,"function":"treap_operations","statement":"walk(&root, &mut out);"},{"line":96,"function":"treap_operations","statement":"out"},{"line":88,"function":"walk","statement":"if let Some(n) = root {"},{"line":89,"function":"walk","statement":"walk(&n.left, out);"},{"line":90,"function":"walk","statement":"out.push(n.key);"},{"line":91,"function":"walk","statement":"walk(&n.right, out);"},{"line":92,"function":"walk","statement":"}"},{"line":100,"function":"main","statement":"let result = csv(treap_operations(&[(true, 4), (true, 2), (false, 4)]));"},{"line":101,"function":"main","statement":"println!(\"{result}\");"},{"line":102,"function":"main","statement":"}"}],"version":1,"input":"insert4 insert2 delete4 inorder","stdout":"2\n","values":[{"type":"&[(bool, i32)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"true"},{"kind":"scalar","text":"4"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"true"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"false"},{"kind":"scalar","text":"4"}],"tuple":true}],"tuple":false}},{"type":"core::