{"key":"matrix-exponentiation-1444cc0c14591f9a","sourceHash":"1444cc0c14591f9abe593e21c83e081dde63b3f2f0b282b4b52e1211d0d26e83","pattern":"matrix-exponentiation","category":"math-bits","title":"Challenge: Matrix Exponentiation","idea":"Encode a linear recurrence as a matrix and exponentiate the transition by squaring.","complexity":"O(k^3 log n) time · O(k^2) space","source":"fn fibonacci_matrix(mut n: u64) -> u64 {\n    fn multiply(a: [[u64; 2]; 2], b: [[u64; 2]; 2]) -> [[u64; 2]; 2] {\n        let mut out = [[0; 2]; 2];\n        for i in 0..2 {\n            for j in 0..2 {\n                for k in 0..2 {\n                    out[i][j] += a[i][k] * b[k][j];\n                }\n            }\n        }\n        out\n    }\n    assert!(n <= 90);\n    let mut result = [[1, 0], [0, 1]];\n    let mut power = [[1, 1], [1, 0]];\n    while n > 0 {\n        if n & 1 == 1 {\n            result = multiply(result, power);\n        }\n        n >>= 1;\n        if n > 0 {\n            power = multiply(power, power);\n        }\n    }\n    result[0][1]\n}\n\nfn main() {\n    let result = fibonacci_matrix(10).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":13,"function":"fibonacci_matrix","statement":"assert!(n <= 90);"},{"line":14,"function":"fibonacci_matrix","statement":"let mut result = [[1, 0], [0, 1]];"},{"line":15,"function":"fibonacci_matrix","statement":"let mut power = [[1, 1], [1, 0]];"},{"line":16,"function":"fibonacci_matrix","statement":"while n > 0 {"},{"line":17,"function":"fibonacci_matrix","statement":"if n & 1 == 1 {"},{"line":18,"function":"fibonacci_matrix","statement":"result = multiply(result, power);"},{"line":19,"function":"fibonacci_matrix","statement":"}"},{"line":20,"function":"fibonacci_matrix","statement":"n >>= 1;"},{"line":21,"function":"fibonacci_matrix","statement":"if n > 0 {"},{"line":22,"function":"fibonacci_matrix","statement":"power = multiply(power, power);"},{"line":23,"function":"fibonacci_matrix","statement":"}"},{"line"