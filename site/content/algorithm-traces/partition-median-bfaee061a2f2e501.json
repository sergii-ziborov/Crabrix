{"key":"partition-median-bfaee061a2f2e501","sourceHash":"bfaee061a2f2e5015c114fa19771e518a9ba6a32ac7efe12c447088df4ee4e0e","pattern":"partition-median","category":"binary-search","title":"Partition Median: Mental Model","idea":"Binary-search a partition where every left-side value is no larger than every right-side value.","complexity":"O(log min(n,m)) time · O(1) space","source":"fn sorted_median(a: &[i32], b: &[i32]) -> f64 {\n    if a.len() > b.len() {\n        return sorted_median(b, a);\n    }\n    assert!(!b.is_empty());\n    let half = (a.len() + b.len()).div_ceil(2);\n    let (mut lo, mut hi) = (0, a.len());\n    loop {\n        let i = lo + (hi - lo) / 2;\n        let j = half - i;\n        let al = if i == 0 { i32::MIN } else { a[i - 1] };\n        let ar = a.get(i).copied().unwrap_or(i32::MAX);\n        let bl = if j == 0 { i32::MIN } else { b[j - 1] };\n        let br = b.get(j).copied().unwrap_or(i32::MAX);\n        if al <= br && bl <= ar {\n            if (a.len() + b.len()) % 2 == 1 {\n                return al.max(bl) as f64;\n            }\n            return (al.max(bl) as f64 + ar.min(br) as f64) / 2.0;\n        }\n        if al > br {\n            hi = i - 1;\n        } else {\n            lo = i + 1;\n        }\n    }\n}\n\nfn main() {\n    let result = sorted_median(&[1, 3], &[2, 4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"sorted_median","statement":"if a.len() > b.len() {"},{"line":3,"function":"sorted_median","statement":"return sorted_median(b, a);"},{"line":5,"function":"sorted_median","statement":"assert!(!b.is_empty());"},{"line":6,"function":"sorted_median","statement":"let half = (a.len() + b.len()).div_ceil(2);"},{"line":7,"function":"sorted_median","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":8,"function":"sorted_median","statement":"loop {"},{"line":9,"function":"sorted_median","statement":"let i = lo + (hi - lo) / 2;"},{"line":10,"function":"sorted_median","statement":"let j = half - i;"},{"line":11,"function":"sorted_median","statement":"let al = if i == 0 { i32::MIN } else { a[i - 1] };"},{"line":11,"function":"sorted_median","statement":"i32::MIN"},{"line":11,"function":"sorted_median","statement":"a[i - 1]"},{"line":12,"function":"sorted_median","statement":"let ar = a.get(i).copied().unwrap_or(i32::MAX);"},{"line":13,"function":"sorted_median","statement":"let bl = if j == 0 { i32::MIN } else { b[j - 1] };"},{"line":13,"function":"sorted_median","statement":"i32::MIN"},{"line":13,"function":"sorted_median","statement":"b[j - 1]"},{"line":14,"function":"sorted_median","statement":"let br = b.get(j).copied().unwrap_or(i32::MAX);"},{"line":15,"function":"sorted_median","statement":"if al <= br && bl <= ar {"},{"line":16,"function":"sorted_median","statement":"if (a.len() + b.len()) % 2 == 1 {"},{"line":17,"function":"sorted_median","statement":"return al.max(bl) as f64;"},{"line":19,"function":"sorted_median","statement":"return (al.max(bl) as f64 + ar.min(br) as f64) / 2.0;"},{"line":21,"function":"sorted_median","statement":"if al > br {"},{"line":22,"function":"sorted_median","statement":"hi = i - 1;"},{"line":23,"function":"sorted_median","statement":"}"},{"line":24,"function":"sorted_median","statement":"lo = i + 1;"},{"line":25,"function":"sorted_median","statement":"}"},{"line":30,"function":"main","statement":"let result = sorted_median(&[1, 3], &[2, 4]).to_string();"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"[1,3] and [2,4]","stdout":"2.5\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar"