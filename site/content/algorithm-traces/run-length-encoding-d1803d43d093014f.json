{"key":"run-length-encoding-d1803d43d093014f","sourceHash":"d1803d43d093014fb54771ee80e6f6be3978fac27f220cff99b7c4629000669c","pattern":"run-length-encoding","category":"strings-tries","title":"Challenge: Run-Length Encoding","idea":"Group maximal adjacent equal symbols and emit the symbol with its run length.","complexity":"O(n) time · O(n) output","source":"fn run_lengths(text: &str) -> String {\n    let mut chars = text.chars();\n    let Some(mut previous) = chars.next() else {\n        return String::new();\n    };\n    let mut length = 1;\n    let mut out = String::new();\n    for current in chars {\n        if current == previous {\n            length += 1;\n        } else {\n            out.push(previous);\n            out.push_str(&length.to_string());\n            previous = current;\n            length = 1;\n        }\n    }\n    out.push(previous);\n    out.push_str(&length.to_string());\n    out\n}\n\nfn main() {\n    let result = run_lengths(\"ab\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"run_lengths","statement":"let mut chars = text.chars();"},{"line":3,"function":"run_lengths","statement":"let Some(mut previous) = chars.next() else {"},{"line":4,"function":"run_lengths","statement":"return String::new();"},{"line":6,"function":"run_lengths","statement":"let mut length = 1;"},{"line":7,"function":"run_lengths","statement":"let mut out = String::new();"},{"line":8,"function":"run_lengths","statement":"for current in chars {"},{"line":9,"function":"run_lengths","statement":"if current == previous {"},{"line":10,"function":"run_lengths","statement":"length += 1;"},{"line":11,"function":"run_lengths","statement":"}"},{"line":12,"function":"run_lengths","statement":"out.push(previous);"},{"line":13,"function":"run_lengths","statement":"out.push_str(&length.to_string());"},{"line":14,"function":"run_lengths","statement":"previous = current;"},{"line":15,"function":"run_lengths","statement":"length = 1;"},{"line":16,"function":"run_lengths","statement":"}"},{"line":18,"function":"run_lengths","statement":"out.push(previous);"},{"line":19,"function":"run_lengths","statement":"out.push_str(&length.to_string());"},{"line":20,"function":"run_lengths","statement":"out"},{"line":24,"function":"main","statement":"let result = run_lengths(\"ab\").to_string();"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"ab","stdout":"a1b1\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"ab\""}},{"type":"core::str::iter::Chars<'_>","data":{"kind":"named","name":"Chars","value":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"'a'"},{"kind":"scalar","text":"'b'"}],"tuple":false}],"tuple":true}}},{"type":"core::str::iter::Chars<'_>","data":{"kind":"named","name":"Chars","value":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"'b'"}],"tuple":false}],"tuple":true}}},{"type":"char","data":{"kind":"scalar","text":"'a'"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"\""}},{"type":"char","data":{"kind":"scalar","text":"'b'"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"a\""}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"a1\""}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"a1b\""}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"a1b1\""}}],"frames":[{"site":17,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["run_lengths",2]],"locals":[["text",0]]},{"site":1,"stack":[["main",1],["run_lengths",2]],"locals":[["text",0],["chars",1]]},{"site":3,"stack":[["main",1],["run_lengths",2]],"locals":[["text",0],["chars",2],["previous",3]]},{"site":4,"stack":[["main",1],["run_lengths",2]],"locals":[["text",0],["chars",2],["previous",3],["length",4]]},{"site":5,"stack":[["main",1],["run_lengths",2]],"locals":[["