{"key":"in-place-merge-94b3e00ef98897ee","sourceHash":"94b3e00ef98897ee78c222d0e7d04c8421767d2a8c6a12640201f30bc8cdd465","pattern":"in-place-merge","category":"two-pointers","title":"Challenge: Backward In-Place Merge","idea":"Fill free capacity from the end so unread source values are never overwritten.","complexity":"O(n+m) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn merge_into(a: &mut [i32], mut m: usize, b: &[i32]) {\n    assert_eq!(a.len(), m + b.len());\n    let mut n = b.len();\n    let mut write = a.len();\n    while n > 0 {\n        write -= 1;\n        if m > 0 && a[m - 1] > b[n - 1] {\n            m -= 1;\n            a[write] = a[m];\n        } else {\n            n -= 1;\n            a[write] = b[n];\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut a = vec![2, 0];\n        merge_into(&mut a, 1, &[1]);\n        csv(a)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"merge_into","statement":"assert_eq!(a.len(), m + b.len());"},{"line":9,"function":"merge_into","statement":"let mut n = b.len();"},{"line":10,"function":"merge_into","statement":"let mut write = a.len();"},{"line":11,"function":"merge_into","statement":"while n > 0 {"},{"line":12,"function":"merge_into","statement":"write -= 1;"},{"line":13,"function":"merge_into","statement":"if m > 0 && a[m - 1] > b[n - 1] {"},{"line":14,"function":"merge_into","statement":"m -= 1;"},{"line":15,"function":"merge_into","statement":"a[write] = a[m];"},{"line":16,"function":"merge_into","statement":"}"},{"line":17,"function":"merge_into","statement":"n -= 1;"},{"line":18,"function":"merge_into","statement":"a[write] = b[n];"},{"line":19,"function":"merge_into","statement":"}"},{"line":24,"function":"main","statement":"let result = {"},{"line":25,"function":"main","statement":"let mut a = vec![2, 