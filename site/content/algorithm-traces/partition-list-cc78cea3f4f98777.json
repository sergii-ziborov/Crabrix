{"key":"partition-list-cc78cea3f4f98777","sourceHash":"cc78cea3f4f9877726b09e4e58ee4bd62c907892bf65c22defe7526f726b8973","pattern":"partition-list","category":"linked-lists","title":"Challenge: Stable List Partition","idea":"Build two stable chains around a pivot and join them after traversal.","complexity":"O(n) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn partition_list(mut head: Link, pivot: i32) -> Link {\n    let (mut low, mut high) = (None, None);\n    let (mut a, mut b) = (&mut low, &mut high);\n    while let Some(mut node) = head {\n        head = node.next.take();\n        if node.value < pivot {\n            *a = Some(node);\n            a = &mut a.as_mut().unwrap().next;\n        } else {\n            *b = Some(node);\n            b = &mut b.as_mut().unwrap().next;\n        }\n    }\n    *a = high;\n    low\n}\n\nfn main() {\n    let result = csv(list_values(&partition_list(list(&[4, 1]), 3)));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"partition_list","statement":"let (mut low, mut high) = (None, None);"},{"line":28,"function":"partition_list","statement":"let (mut a, mut b) = (&mut low, &mut high);"},{"line":29,"function":"partition_list","statement":"while let Some(mut node) = head {"},{"line":30,"function":"partition_list","statement":"head = node.next.take();"},{"line":31,"function":"partition_list","statement":"if node.value < pivot {"},{"line":32,"function":"partition_list","statement":"*a = Some(node);"},{"line":33,"function":"partition_list","statement":"a = &mut a.as_mut().unwrap().next;"},{"line":34,"function":"partition_list","statement":"}"},{"line":35,"function":"partition_list","statement":"*b = Some(node);"},{"line":36,"function":"partition_list","statement":"b = &mut b.as_mut().unwrap().next;"},{"line":37,"function":"partition_list","statement":"}"},{"line":39,"function":"partition_list","statement":"*a = high;"},{"line":40,"function":"partition_list","statement":"low"},{"line":44,"function":"main","statement":"let result = csv(list_values(&partition_list(list(&[4, 1]), 3)));"},{"line":45,"function":"main","statement":"println!(\"{result}\");"},{"line":46,"function":"main","statement":"}"}],"version":1,"input":"4->1","stdout":"1,4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"