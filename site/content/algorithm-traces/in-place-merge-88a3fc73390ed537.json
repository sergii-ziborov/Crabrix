{"key":"in-place-merge-88a3fc73390ed537","sourceHash":"88a3fc73390ed5370a753cda79978d1ebb3627f49fd31feae99b626f3f9d449b","pattern":"in-place-merge","category":"two-pointers","title":"Backward In-Place Merge: Mental Model","idea":"Fill free capacity from the end so unread source values are never overwritten.","complexity":"O(n+m) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn merge_into(a: &mut [i32], mut m: usize, b: &[i32]) {\n    assert_eq!(a.len(), m + b.len());\n    let mut n = b.len();\n    let mut write = a.len();\n    while n > 0 {\n        write -= 1;\n        if m > 0 && a[m - 1] > b[n - 1] {\n            m -= 1;\n            a[write] = a[m];\n        } else {\n            n -= 1;\n            a[write] = b[n];\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut a = vec![1, 3, 7, 0, 0, 0];\n        merge_into(&mut a, 3, &[2, 5, 6]);\n        csv(a)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"merge_into","statement":"assert_eq!(a.len(), m + b.len());"},{"line":9,"function":"merge_into","statement":"let mut n = b.len();"},{"line":10,"function":"merge_into","statement":"let mut write = a.len();"},{"line":11,"function":"merge_into","statement":"while n > 0 {"},{"line":12,"function":"merge_into","statement":"write -= 1;"},{"line":13,"function":"merge_into","statement":"if m > 0 && a[m - 1] > b[n - 1] {"},{"line":14,"function":"merge_into","statement":"m -= 1;"},{"line":15,"function":"merge_into","statement":"a[write] = a[m];"},{"line":16,"function":"merge_into","statement":"}"},{"line":17,"function":"merge_into","statement":"n -= 1;"},{"line":18,"function":"merge_into","statement":"a[write] = b[n];"},{"line":19,"function":"merge_into","statement":"}"},{"line":24,"function":"main","statement":"let result = {"},{"line":25,"function":"main","statement":"let mut a = vec![1, 3, 7, 0, 0, 0];"},{"line":26,"function":"main","statement":"merge_into(&mut a, 3, &[2, 5, 6]);"},{"line":27,"function":"main","statement":"csv(a)"},{"line":29,"function":"main","statement":"println!(\"{result}\");"},{"line":30,"function":"main","statement":"}"}],"version":1,"input":"a=[1,3,7,0,0,0] m=3; b=[2,5,6]","stdout":"1,2,3,5,6,7\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"6"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"5"},{"kind":