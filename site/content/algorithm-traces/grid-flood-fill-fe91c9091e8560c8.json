{"key":"grid-flood-fill-fe91c9091e8560c8","sourceHash":"fe91c9091e8560c84ccbb2e4456c35142f4ff251bf6732f41d8888a0f6dcab6c","pattern":"grid-flood-fill","category":"graph-traversal","title":"Grid Flood Fill: Mental Model","idea":"Treat cells as graph nodes and traverse only neighbors satisfying the region predicate.","complexity":"O(rows*cols) time · O(rows*cols) space worst","source":"fn component_size(grid: &[Vec<i32>], start: (usize, usize)) -> usize {\n    let (rows, cols) = (grid.len(), grid[0].len());\n    let target = grid[start.0][start.1];\n    let mut seen = vec![vec![false; cols]; rows];\n    let mut stack = vec![start];\n    let mut size = 0;\n    while let Some((r, c)) = stack.pop() {\n        if seen[r][c] || grid[r][c] != target {\n            continue;\n        }\n        seen[r][c] = true;\n        size += 1;\n        if r > 0 {\n            stack.push((r - 1, c));\n        }\n        if c > 0 {\n            stack.push((r, c - 1));\n        }\n        if r + 1 < rows {\n            stack.push((r + 1, c));\n        }\n        if c + 1 < cols {\n            stack.push((r, c + 1));\n        }\n    }\n    size\n}\n\nfn main() {\n    let result = component_size(&[vec![1, 0, 0], vec![1, 1, 0], vec![0, 1, 1]], (1, 1)).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"component_size","statement":"let (rows, cols) = (grid.len(), grid[0].len());"},{"line":3,"function":"component_size","statement":"let target = grid[start.0][start.1];"},{"line":4,"function":"component_size","statement":"let mut seen = vec![vec![false; cols]; rows];"},{"line":5,"function":"component_size","statement":"let mut stack = vec![start];"},{"line":6,"function":"component_size","statement":"let mut size = 0;"},{"line":7,"function":"component_size","statement":"while let Some((r, c)) = stack.pop() {"},{"line":8,"function":"component_size","statement":"if seen[r][c] || grid[r][c] != target {"},{"line":9,"function":"component_size","statement":"continue;"},{"line"