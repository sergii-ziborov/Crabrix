{"key":"median-of-medians-2faf520369c5f8eb","sourceHash":"2faf520369c5f8eb875e3d393dbc9f3b585d047f76b6bf27f36d90dabaee42e7","pattern":"median-of-medians","category":"sorting-selection","title":"Median of Medians: Mental Model","idea":"Choose a guaranteed-good pivot from medians of small groups before selecting one side.","complexity":"O(n) worst-case time · O(n) or in-place variants","source":"fn deterministic_select(a: &[i32], k: usize) -> i32 {\n    assert!(k < a.len());\n    if a.len() <= 5 {\n        let mut small = a.to_vec();\n        small.sort_unstable();\n        return small[k];\n    }\n    let medians: Vec<_> = a\n        .chunks(5)\n        .map(|group| {\n            let mut g = group.to_vec();\n            g.sort_unstable();\n            g[g.len() / 2]\n        })\n        .collect();\n    let pivot = deterministic_select(&medians, medians.len() / 2);\n    let smaller: Vec<_> = a.iter().copied().filter(|&x| x < pivot).collect();\n    let equal = a.iter().filter(|&&x| x == pivot).count();\n    if k < smaller.len() {\n        deterministic_select(&smaller, k)\n    } else if k < smaller.len() + equal {\n        pivot\n    } else {\n        let greater: Vec<_> = a.iter().copied().filter(|&x| x > pivot).collect();\n        deterministic_select(&greater, k - smaller.len() - equal)\n    }\n}\n\nfn main() {\n    let result = deterministic_select(&[12, 3, 5, 7, 4, 19, 26, 1, 9], 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"deterministic_select","statement":"assert!(k < a.len());"},{"line":3,"function":"deterministic_select","statement":"if a.len() <= 5 {"},{"line":4,"function":"deterministic_select","statement":"let mut small = a.to_vec();"},{"line":5,"function":"deterministic_select","statement":"small.sort_unstable();"},{"line":6,"function":"deterministic_select","statement":"return small[k];"},{"line":8,"function":"deterministic_select","statement":"let medians: Vec<_> = a"},{"line":16,"function":"deterministic_select","statement":"let pivot = deterministic_select(&medians, medians.len() / 2);"},{"line":17,"function":"deterministic_select","statement":"let smaller: Vec<_> = a.iter().copied().filter(|&x| x < pivot).collect();"},{"line":18,"function":"deterministic_select","statement":"let equal = a.iter().filter(|&&x| x == pivot).count();"},{"line":19,"function":"deterministic_select","statement":"if k < smaller.len() {"},{"line":20,"function":"deterministic_select","statement":"deterministic_select(&smaller, k)"},{"line":22,"function":"deterministic_select","statement":"pivot"},{"line":24,"function":"deterministic_select","statement":"let greater: Vec<_> = a.iter().copied().filter(|&x| x > pivot).collect();"},{"line":25,"function":"deterministic_select","statement":"deterministic_select(&greater, k - smaller.len() - equal)"},{"line":11,"function":"closure · line 10","statement":"let mut g = group.to_vec();"},{"line":12,"function":"closure · line 10","statement":"g.sort_unstable();"},{"line":13,"function":"closure · line 10","statement":"g[g.len() / 2]"},{"line":17,"function":"closure · line 17","statement":"x < pivot"},{"line":18,"function":"closure · line 18","statement":"x == pivot"},{"line":24,"function":"closure · line 24","statement":"x > pivot"},{"line":30,"function":"main","statement":"let result = deterministic_select(&[12, 3, 5, 7, 4, 19, 26, 1, 9], 4).to_string();"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"[12,3,5,7,4,19,26,1,9]","stdout":"7\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"12"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"19"},{"kind":"scalar","text":"26"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"&[i32]","data":{"kind":"list","items":[{"k