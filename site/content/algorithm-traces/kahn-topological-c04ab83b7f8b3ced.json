{"key":"kahn-topological-c04ab83b7f8b3ced","sourceHash":"c04ab83b7f8b3ced2adee14c00840dd29221726c5606e73b223f7c03e5d89c0c","pattern":"kahn-topological","category":"graph-traversal","title":"Challenge: Kahn Topological Sort","idea":"Repeatedly remove zero-indegree nodes and decrement dependents; leftovers prove a cycle.","complexity":"O(E + V log V) with lexicographic min-heap · O(V) state","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn smallest_topological(graph: &[Vec<usize>]) -> Vec<usize> {\n    let mut degree = vec![0; graph.len()];\n    for ns in graph {\n        for &u in ns {\n            degree[u] += 1;\n        }\n    }\n    let mut ready = std::collections::BinaryHeap::new();\n    for (v, &d) in degree.iter().enumerate() {\n        if d == 0 {\n            ready.push(std::cmp::Reverse(v));\n        }\n    }\n    let mut out = Vec::new();\n    while let Some(std::cmp::Reverse(v)) = ready.pop() {\n        out.push(v);\n        for &u in &graph[v] {\n            degree[u] -= 1;\n            if degree[u] == 0 {\n                ready.push(std::cmp::Reverse(u));\n            }\n        }\n    }\n    assert_eq!(out.len(), graph.len(), \"the contract requires a DAG\");\n    out\n}\n\nfn main() {\n    let result = csv(smallest_topological(&[vec![], vec![2], vec![]]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"smallest_topological","statement":"let mut degree = vec![0; graph.len()];"},{"line":9,"function":"smallest_topological","statement":"for ns in graph {"},{"line":10,"function":"smallest_topological","statement":"for &u in ns {"},{"line":11,"function":"smallest_topological","statement":"degree[u] += 1;"},{"line":12,"function":"smallest_topological","statement":"}"},{"line":14,"function":"smallest_topological","statement":"let mut ready = std::collections::BinaryHeap::new();"},{"line":15,"function":"smallest_topological","statement":"for (v, &d) in degree.iter().enumerate() {"},{"line":16,"function":"smallest_topological","statement":"if d == 0 {"},{"line":17,"function":"smallest_topological","statement":"ready.push(std::cmp::Reverse(v));"},{"line":18,"function":"smallest_topological","statement":"}"},{"line":20,"function":"smallest_topological","statement":"let mut out = Vec::new();"},{"line":21,"function":"smallest_topological","statement":"while let Some(std::cmp::Reverse(v)) = ready.pop() {"},{"line":22,"function":"smallest_topological","statement":"out.push(v);"},{"line":23,"function":"smallest_topological","statement":"for &u in &graph[v] {"},{"line":24,"function":"smallest_topological","statement":"degree[u] -= 1;","edge":{"collection":"graph","from":"v","to":"u"}},{"line":25,"function":"smallest_topological","statement":"if degree[u] == 0 {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":26,"function":"smallest_topological","statement":"ready.push(std::cmp::Reverse(u));","edge":{"collection":"graph","from":"v","to":"u"}},{"line":27,"function":"smallest_topological","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":30,"function":"smallest_topological","statement":"assert_eq!(out.len(), graph.len(), \"the contract requires a DAG\");"},{"line":31,"function":"smallest_topological","statement":"out"},{"line":35,"function":"main","statement":"let result = csv(smallest_topological(&[vec![], vec![2], vec![]]));"},{"line":36,"function":"main","statement":"println!(\"{result}\");"},{"line":37,"function":"main","statement":"}"}],"version":1,"input":"n=3 edges=1->2","stdout":"0,1,2\n","values":[{"type":"&[alloc::vec::Vec<usize>]","data":{"kind":"list","items":[{"kind":"list","items":[],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[],"tuple":false}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":