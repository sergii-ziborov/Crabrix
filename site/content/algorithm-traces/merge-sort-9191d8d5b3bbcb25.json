{"key":"merge-sort-9191d8d5b3bbcb25","sourceHash":"9191d8d5b3bbcb25f4f117487da33bce96cb9d8be9151647af0864adf6a4bd2f","pattern":"merge-sort","category":"sorting-selection","title":"Challenge: Merge Sort","idea":"Sort halves independently, then merge two ordered streams without backtracking.","complexity":"O(n log n) time · O(n) space","source":"fn stable_merge_sort(values: &[(i32, char)]) -> Vec<(i32, char)> {\n    if values.len() < 2 {\n        return values.to_vec();\n    }\n    let mid = values.len() / 2;\n    let left = stable_merge_sort(&values[..mid]);\n    let right = stable_merge_sort(&values[mid..]);\n    let (mut i, mut j) = (0, 0);\n    let mut out = Vec::with_capacity(values.len());\n    while i < left.len() && j < right.len() {\n        if left[i].0 <= right[j].0 {\n            out.push(left[i]);\n            i += 1;\n        } else {\n            out.push(right[j]);\n            j += 1;\n        }\n    }\n    out.extend_from_slice(&left[i..]);\n    out.extend_from_slice(&right[j..]);\n    out\n}\n\nfn main() {\n    let result = stable_merge_sort(&[(1, 'b'), (1, 'a'), (0, 'z')])\n        .iter()\n        .map(|(k, v)| format!(\"{k}{v}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"stable_merge_sort","statement":"if values.len() < 2 {"},{"line":3,"function":"stable_merge_sort","statement":"return values.to_vec();"},{"line":5,"function":"stable_merge_sort","statement":"let mid = values.len() / 2;"},{"line":6,"function":"stable_merge_sort","statement":"let left = stable_merge_sort(&values[..mid]);"},{"line":7,"function":"stable_merge_sort","statement":"let right = stable_merge_sort(&values[mid..]);"},{"line":8,"function":"stable_merge_sort","statement":"let (mut i, mut j) = (0, 0);"},{"line":9,"function":"stable_merge_sort","statement":"let mut out = Vec::with_capacity(values.len());"},{"line":10,"function":"stable_merge_sort","statement":"while i < left.len() && j < right.len() {"}