{"key":"frequency-counting-f121c1cabe37ec08","sourceHash":"f121c1cabe37ec08f60cb0e49fea62be02215e92802052b55b4a2ce5cce928c4","pattern":"frequency-counting","category":"scans","title":"Frequency Counting: Mental Model","idea":"Turn repeated observations into counts keyed by the observed value.","complexity":"O(n) expected time · O(k) space","source":"fn mode(values: &[i32]) -> i32 {\n    let mut counts = std::collections::HashMap::new();\n    for &x in values {\n        *counts.entry(x).or_insert(0) += 1;\n    }\n    *counts\n        .iter()\n        .min_by_key(|&(x, count)| (-*count, *x))\n        .unwrap()\n        .0\n}\n\nfn main() {\n    let result = mode(&[4, 2, 4, 3, 2, 4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"mode","statement":"let mut counts = std::collections::HashMap::new();"},{"line":3,"function":"mode","statement":"for &x in values {"},{"line":4,"function":"mode","statement":"*counts.entry(x).or_insert(0) += 1;"},{"line":5,"function":"mode","statement":"}"},{"line":6,"function":"mode","statement":"*counts"},{"line":8,"function":"closure · line 8","statement":"(-*count, *x)"},{"line":14,"function":"main","statement":"let result = mode(&[4, 2, 4, 3, 2, 4]).to_string();"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"input":"[4, 2, 4, 3, 2, 4]","stdout":"4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"std::collections::hash::map::HashMap<i32, i32>","data":{"kind":"map","entries":[]}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"std::collections::hash::map::HashMap<i32, i32>","data":{"kind":"map","entries":[[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"1"}]]}},{"type":"i32","data":{"kind":"scalar","te