{"key":"lazy-heap-deletion-ab0bf57a54e070e3","sourceHash":"ab0bf57a54e070e39f13da244194182368faec01f4baebb30f709da4b51ab59e","pattern":"lazy-heap-deletion","category":"heaps-streaming","title":"Lazy Heap Deletion: Mental Model","idea":"Record invalidated values separately and discard stale roots only when they surface.","complexity":"O(log n) amortised operation · O(n) space","source":"fn valid_min(ops: &[&str]) -> i32 {\n    let mut heap = std::collections::BinaryHeap::new();\n    let mut deleted = std::collections::HashMap::<i32, usize>::new();\n    for op in ops {\n        if let Some(raw) = op.strip_prefix(\"push\") {\n            heap.push(std::cmp::Reverse(raw.parse::<i32>().unwrap()));\n        }\n        if let Some(raw) = op.strip_prefix(\"delete\") {\n            *deleted.entry(raw.parse().unwrap()).or_default() += 1;\n        }\n        while let Some(&std::cmp::Reverse(x)) = heap.peek() {\n            let count = deleted.entry(x).or_default();\n            if *count == 0 {\n                break;\n            }\n            *count -= 1;\n            heap.pop();\n        }\n    }\n    heap.peek().unwrap().0\n}\n\nfn main() {\n    let result = valid_min(&[\"push4\", \"push7\", \"push2\", \"delete2\", \"min\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"valid_min","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":3,"function":"valid_min","statement":"let mut deleted = std::collections::HashMap::<i32, usize>::new();"},{"line":4,"function":"valid_min","statement":"for op in ops {"},{"line":5,"function":"valid_min","statement":"if let Some(raw) = op.strip_prefix(\"push\") {"},{"line":6,"function":"valid_min","statement":"heap.push(std::cmp::Reverse(raw.parse::<i32>().unwrap()));"},{"line":7,"function":"valid_min","statement":"}"},{"line":8,"function":"valid_min","statement":"if let Some(raw) = op.strip_prefix(\"delete\") {"},{"line":9,"function":"valid_min","statement":"*deleted.entry(raw.parse().unw