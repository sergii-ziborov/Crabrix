{"key":"centroid-decomposition-7e7809511c85c44d","sourceHash":"7e7809511c85c44dbeb7b94aa580233cf9587058d54cda5a9c196043eadf74ab","pattern":"centroid-decomposition","category":"advanced-structures","title":"Challenge: Centroid Decomposition","idea":"Remove a balancing centroid and recurse on components no larger than half the original.","complexity":"O(n log n) decomposition build · O(n) live traversal state","source":"fn centroid_root(graph: &[Vec<usize>]) -> usize {\n    fn collect(\n        v: usize,\n        p: usize,\n        g: &[Vec<usize>],\n        blocked: &[bool],\n        sizes: &mut [usize],\n        members: &mut Vec<usize>,\n    ) {\n        sizes[v] = 1;\n        members.push(v);\n        for &u in &g[v] {\n            if u != p && !blocked[u] {\n                collect(u, v, g, blocked, sizes, members);\n                sizes[v] += sizes[u];\n            }\n        }\n    }\n    fn decompose(\n        start: usize,\n        parent: Option<usize>,\n        g: &[Vec<usize>],\n        blocked: &mut [bool],\n        answer: &mut [Option<usize>],\n        sizes: &mut [usize],\n    ) {\n        let mut members = Vec::new();\n        collect(start, g.len(), g, blocked, sizes, &mut members);\n        let total = members.len();\n        let centroid = *members\n            .iter()\n            .filter(|&&v| {\n                let mut largest = total - sizes[v];\n                for &u in &g[v] {\n                    if !blocked[u] && sizes[u] < sizes[v] {\n                        largest = largest.max(sizes[u]);\n                    }\n                }\n                largest <= total / 2\n            })\n            .min()\n            .unwrap();\n        answer[centroid] = parent;\n        blocked[centroid] = true;\n        for &u in &g[centroid] {\n            if !blocked[u] {\n                decompose(u, Some(centroid), g, blocked, answer, sizes);\n            }\n        }\n    }\n    assert!(!graph.is_empty());\n    let mut parents = vec![None; graph.len()];\n    decompose(\n        0,\n        None,\n        graph,\n        &mut vec![false; graph.len()],\n        &mut parents,\n        &mut vec![0; graph.len()],\n    );\n    parents.iter().position(Option::is_none).unwrap()\n}\n\nfn main() {\n    let result = centroid_root(&[vec![1, 2, 3, 4], vec![0], vec![0], vec![0], vec![0]]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":51,"function":"centroid_root","statement":"assert!(!graph.is_empty());"},{"line":52,"function":"centroid_root","statement":"let mut parents = vec![None; graph.len()];"},{"line":53,"function":"centroid_root","statement":"decompose("},{"line":61,"function":"centroid_root","statement":"parents.iter().position(Option::is_none).unwrap()"},{"line":10,"function":"collect","statement":"sizes[v] = 1;"},{"line":11,"function":"collect","statement":"members.push(v);"},{"line":12,"function":"collect","statement":"for &u in &g[v] {"},{"line":13,"function":"collect","statement":"if u != p && !blocked[u] {","edge":{"collection":"g","from":"v","to":"u"}},{"line":14,"function":"collect","statement":"collect(u, v, g, blocked, sizes, members);","edge":{"collection":"g","from":"v","to":"u"}},{"line":15,"function":"collect","statement":"sizes[v] += sizes[u];","edge":{"collection":"g","from":"v","to":"u"}},{"line":16,"function":"collect","statement":"}","edge":{"collection":"g","from":"v","to":"u"}},{"line":27,"function":"decompose","statement":"let mut members = Vec::new();"},{"line":28,"function":"decompose","statement":"collect(start, g.len(), g, blocked, sizes, &mut members);"},{"line":29,"function":"decompose","statement":"let total = members.len();"},{"line":30,"function":"decompose","statement":"let centroid = *members"},{"line":43,"function":"decompose","statement":"answer[centroid] = parent;"},{"line":44,"function":"decompose","statement":"blocked[centroid] = true;"},{"line":45,"function":"decompose","statement":"for &u in &g[centroid] {"},{"line":46,"function":"decompose","statement":"if !blocked[u] {","edge":{"collection":"g","from":"centroid","to":"u"}},{"line":47,"function":"decompose","statement":"decompose(u, Some(centroid), g, blocked, answer, sizes);","edge":{"collection":"g","from":"centroid","to":"u"}},{"line":48,"function":"decompose","statement":"}","edge":{"collection":"g","from":"centroid","to":"u"}},{"line":33,"function":"closure · line 32","statement":"let mut largest = total - sizes[v];"},{"line":34,"function":"closure · line 32","statement":"for &u in &g[v] {"},{"line":35,"function":"closure · line 32","statement":"if !blocked[u] && sizes[u] < sizes[v] {","edge":{"collection":"g","from":"v","to":"u"}},{"line":36,"function":"closure · line 32","statement":"largest = largest.max(sizes[u]);","edge":{"collection":"g","from":"v","to":"u"}},{"line":37,"function":"closure · line 32","statement":"}","edge":{"collection":"g","from":"v","to":"u"}},{"line":39,"function":"closure · line 32","statement":"largest <= total / 2"},{"line":65,"function":"main","statement":"let result = centroid_root(&[vec![1, 2, 3, 4], vec![0], vec![0], vec![0], vec![0]]).to_string();"},{"line":66,"function":"main","statement":"println!(\"{result}\");"},{"line":67,"function":"main","statement":"}"}],"version":1,"input":"n=5 edges=(0,1),(0,2),(0,3),(0,4)","stdout":"0\n","values":[{"type":"&[alloc::vec::Vec<usize>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false}],"tuple":false}},{"type":"alloc::vec::Vec<core::option::Option<usize>>","data":{"kind":"list","items":[{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},