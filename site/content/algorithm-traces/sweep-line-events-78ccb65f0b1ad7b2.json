{"key":"sweep-line-events-78ccb65f0b1ad7b2","sourceHash":"78ccb65f0b1ad7b2af935a1992f7f97393f0582c0f5da083edf74fb2b6d59f4a","pattern":"sweep-line-events","category":"greedy-intervals","title":"Sweep-Line Events: Mental Model","idea":"Sort starts and ends as signed events and integrate active state across coordinates.","complexity":"O(n log n) time · O(n) events","source":"fn maximum_sessions(intervals: &[(i32, i32)]) -> i32 {\n    let mut events = Vec::new();\n    for &(start, end) in intervals {\n        assert!(start < end);\n        events.push((start, 1));\n        events.push((end, -1));\n    }\n    events.sort_unstable(); // -1 precedes +1: half-open intervals\n    let (mut active, mut peak) = (0, 0);\n    for (_, delta) in events {\n        active += delta;\n        peak = peak.max(active);\n    }\n    peak\n}\n\nfn main() {\n    let result = maximum_sessions(&[(1, 4), (2, 5), (4, 6)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"maximum_sessions","statement":"let mut events = Vec::new();"},{"line":3,"function":"maximum_sessions","statement":"for &(start, end) in intervals {"},{"line":4,"function":"maximum_sessions","statement":"assert!(start < end);"},{"line":5,"function":"maximum_sessions","statement":"events.push((start, 1));"},{"line":6,"function":"maximum_sessions","statement":"events.push((end, -1));"},{"line":7,"function":"maximum_sessions","statement":"}"},{"line":8,"function":"maximum_sessions","statement":"events.sort_unstable();"},{"line":9,"function":"maximum_sessions","statement":"let (mut active, mut peak) = (0, 0);"},{"line":10,"function":"maximum_sessions","statement":"for (_, delta) in events {"},{"line":11,"function":"maximum_sessions","statement":"active += delta;"},{"line":12,"function":"maximum_sessions","statement":"peak = peak.max(active);"},{"line":13,"function":"maximum_sessions","statement":"}"},{"line":14,"function":"maximum_sessions","statement":"peak"},{"line":18,"function":"main","statement":"let result = maximum_sessions(&[(1, 4), (2, 5), (4, 6)]).to_string();"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"}],"version":1,"input":"[(1,4),(2,5),(4,6)]","stdout":"2\n","values":[{"type":"&[(i32, i32)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"-1"}],"tuple":true}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"-1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"-1"}],"tu