{"key":"prim-mst-d122af5ac06d7ab8","sourceHash":"d122af5ac06d7ab8d852d50d3eac012514ae467781fec32254879dda8aeb12f1","pattern":"prim-mst","category":"weighted-graphs","title":"Prim Minimum Spanning Tree: Mental Model","idea":"Grow one connected tree by repeatedly choosing the cheapest edge crossing its boundary.","complexity":"O(E log V) time · O(V+E) space","source":"fn prim_weight(graph: &[Vec<(usize, i64)>]) -> i64 {\n    if graph.is_empty() {\n        return 0;\n    }\n    let mut seen = vec![false; graph.len()];\n    let mut heap = std::collections::BinaryHeap::from([std::cmp::Reverse((0, 0))]);\n    let mut total = 0;\n    while let Some(std::cmp::Reverse((weight, v))) = heap.pop() {\n        if seen[v] {\n            continue;\n        }\n        seen[v] = true;\n        total += weight;\n        for &(u, w) in &graph[v] {\n            if !seen[u] {\n                heap.push(std::cmp::Reverse((w, u)));\n            }\n        }\n    }\n    assert!(seen.into_iter().all(|v| v), \"connected graph required\");\n    total\n}\n\nfn main() {\n    let result = prim_weight(&[\n        vec![(1, 1), (2, 4)],\n        vec![(0, 1), (2, 2), (3, 5)],\n        vec![(0, 4), (1, 2), (3, 3)],\n        vec![(1, 5), (2, 3)],\n    ])\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"prim_weight","statement":"if graph.is_empty() {"},{"line":3,"function":"prim_weight","statement":"return 0;"},{"line":5,"function":"prim_weight","statement":"let mut seen = vec![false; graph.len()];"},{"line":6,"function":"prim_weight","statement":"let mut heap = std::collections::BinaryHeap::from([std::cmp::Reverse((0, 0))]);"},{"line":7,"function":"prim_weight","statement":"let mut total = 0;"},{"line":8,"function":"prim_weight","statement":"while let Some(std::cmp::Reverse((weight, v))) = heap.pop() {"},{"line":9,"function":"prim_weight","statement":"if seen[v] {"},{"line":10,"function":"prim_weight","statement":"continue;"},{"line":12,"function":"prim_weight","statement":"seen[v] = true;"},{"line":13,"function":"prim_weight","statement":"total += weight;"},{"line":14,"function":"prim_weight","statement":"for &(u, w) in &graph[v] {"},{"line":15,"function":"prim_weight","statement":"if !seen[u] {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":16,"function":"prim_weight","statement":"heap.push(std::cmp::Reverse((w, u)));","edge":{"collection":"graph","from":"v","to":"u"}},{"line":17,"function":"prim_weight","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":20,"function":"prim_weight","statement":"assert!(seen.into_iter().all(|v| v), \"connected graph required\");"},{"line":21,"function":"prim_weight","statement":"total"},{"line":25,"function":"main","statement":"let result = prim_weight(&["},{"line":32,"function":"main","statement":"println!(\"{result}\");"},{"line":33,"function":"main","statement":"}"}],"version":1,"input":"edges=0-1:1,0-2:4,1-2:2,1-3:5,2-3:3","stdout":"6\n","values":[{"type":"&[alloc::vec::Vec<(usize, i64)>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"}],"tuple":true}],"tuple":false},{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"}],"tuple":true}],"tuple":false},{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"4"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"3"}],"tuple":true}],"tuple":false},{"kind":"list","items":[{"kind":"list","items":[{"kind"