{"key":"floyd-warshall-7e0cd2574b9d1549","sourceHash":"7e0cd2574b9d15491ab0f64eac209b511210f96b065095d1d9a4fe54e743a397","pattern":"floyd-warshall","category":"weighted-graphs","title":"Challenge: Floyd–Warshall","idea":"Allow intermediate vertices one by one and combine paths through the newly allowed vertex.","complexity":"O(V^3) time · O(V^2) space","source":"fn all_pairs(mut distance: Vec<Vec<i64>>) -> Vec<Vec<i64>> {\n    let n = distance.len();\n    let infinity = 999_999_999;\n    for k in 0..n {\n        for i in 0..n {\n            for j in 0..n {\n                if distance[i][k] != infinity && distance[k][j] != infinity {\n                    distance[i][j] = distance[i][j].min(distance[i][k] + distance[k][j]);\n                }\n            }\n        }\n    }\n    distance\n}\n\nfn main() {\n    let result = all_pairs(vec![\n        vec![0, 7, 2],\n        vec![999999999, 0, 1],\n        vec![999999999, 999999999, 0],\n    ])[0][2]\n        .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"all_pairs","statement":"let n = distance.len();"},{"line":3,"function":"all_pairs","statement":"let infinity = 999_999_999;"},{"line":4,"function":"all_pairs","statement":"for k in 0..n {"},{"line":5,"function":"all_pairs","statement":"for i in 0..n {"},{"line":6,"function":"all_pairs","statement":"for j in 0..n {"},{"line":7,"function":"all_pairs","statement":"if distance[i][k] != infinity && distance[k][j] != infinity {"},{"line":8,"function":"all_pairs","statement":"distance[i][j] = distance[i][j].min(distance[i][k] + distance[k][j]);"},{"line":9,"function":"all_pairs","statement":"}"},{"line":13,"function":"all_pairs","statement":"distance"},{"line":17,"function":"main","statement":"let result = all_pairs(vec!["},{"line":23,"function":"main","statement":"println!(\"{result}\");"},{"line":24,"function":"main","statement":"}"}],"version":1,"input":"matrix=[[0,7,2],[inf,0,1],[inf,inf,0]]","stdout":"2\n","values":[{"type":"alloc::vec::V