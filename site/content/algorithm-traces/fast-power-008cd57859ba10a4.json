{"key":"fast-power-008cd57859ba10a4","sourceHash":"008cd57859ba10a422d7027a4f72849fe007e71bcb611acc9ed6df5ecabe5040","pattern":"fast-power","category":"math-bits","title":"Binary Exponentiation: Mental Model","idea":"Square the base and consume exponent bits so only logarithmically many multiplications occur.","complexity":"O(log exponent) time · O(1) space","source":"fn mod_power(mut base: u64, mut exponent: u64, modulus: u64) -> u64 {\n    assert!(modulus > 0);\n    let mut result = 1 % modulus;\n    base %= modulus;\n    while exponent > 0 {\n        if exponent & 1 == 1 {\n            result = (result as u128 * base as u128 % modulus as u128) as u64;\n        }\n        base = (base as u128 * base as u128 % modulus as u128) as u64;\n        exponent >>= 1;\n    }\n    result\n}\n\nfn main() {\n    let result = mod_power(3, 13, 1000).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"mod_power","statement":"assert!(modulus > 0);"},{"line":3,"function":"mod_power","statement":"let mut result = 1 % modulus;"},{"line":4,"function":"mod_power","statement":"base %= modulus;"},{"line":5,"function":"mod_power","statement":"while exponent > 0 {"},{"line":6,"function":"mod_power","statement":"if exponent & 1 == 1 {"},{"line":7,"function":"mod_power","statement":"result = (result as u128 * base as u128 % modulus as u128) as u64;"},{"line":8,"function":"mod_power","statement":"}"},{"line":9,"function":"mod_power","statement":"base = (base as u128 * base as u128 % modulus as u128) as u64;"},{"line":10,"function":"mod_power","statement":"exponent >>= 1;"},{"line":11,"function":"mod_power","statement":"}"},{"line":12,"function":"mod_power","statement":"result"},{"line":16,"function":"main","statement":"let result = mod_power(3, 13, 1000).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"base=3 exp=13 mod=1000","stdout":"323\n","values":[{"type":"u64"