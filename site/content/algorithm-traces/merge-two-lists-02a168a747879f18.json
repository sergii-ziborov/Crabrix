{"key":"merge-two-lists-02a168a747879f18","sourceHash":"02a168a747879f189850d9ca9b380030ff0069a102e9413bf3492c8e40ab87c5","pattern":"merge-two-lists","category":"linked-lists","title":"Merge Two Sorted Lists: Mental Model","idea":"Always detach the smaller head and append it to the merged tail.","complexity":"O(n+m) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn merge_lists(mut a: Link, mut b: Link) -> Link {\n    let mut out = None;\n    let mut tail = &mut out;\n    while a.is_some() && b.is_some() {\n        let chosen = if a.as_ref().unwrap().value <= b.as_ref().unwrap().value {\n            &mut a\n        } else {\n            &mut b\n        };\n        let mut node = chosen.take().unwrap();\n        *chosen = node.next.take();\n        *tail = Some(node);\n        tail = &mut tail.as_mut().unwrap().next;\n    }\n    *tail = if a.is_some() { a } else { b };\n    out\n}\n\nfn main() {\n    let result = csv(list_values(&merge_lists(\n        list(&[1, 2, 4]),\n        list(&[1, 3, 4]),\n    )));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let 