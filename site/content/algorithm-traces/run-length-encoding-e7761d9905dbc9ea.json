{"key":"run-length-encoding-e7761d9905dbc9ea","sourceHash":"e7761d9905dbc9eab8d808f0900fb9b717c4ae7114283a208c7a545be35fb71a","pattern":"run-length-encoding","category":"strings-tries","title":"Run-Length Encoding: Mental Model","idea":"Group maximal adjacent equal symbols and emit the symbol with its run length.","complexity":"O(n) time · O(n) output","source":"fn run_lengths(text: &str) -> String {\n    let mut chars = text.chars();\n    let Some(mut previous) = chars.next() else {\n        return String::new();\n    };\n    let mut length = 1;\n    let mut out = String::new();\n    for current in chars {\n        if current == previous {\n            length += 1;\n        } else {\n            out.push(previous);\n            out.push_str(&length.to_string());\n            previous = current;\n            length = 1;\n        }\n    }\n    out.push(previous);\n    out.push_str(&length.to_string());\n    out\n}\n\nfn main() {\n    let result = run_lengths(\"aaabbcaaaa\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"run_lengths","statement":"let mut chars = text.chars();"},{"line":3,"function":"run_lengths","statement":"let Some(mut previous) = chars.next() else {"},{"line":4,"function":"run_lengths","statement":"return String::new();"},{"line":6,"function":"run_lengths","statement":"let mut length = 1;"},{"line":7,"function":"run_lengths","statement":"let mut out = String::new();"},{"line":8,"function":"run_lengths","statement":"for current in chars {"},{"line":9,"function":"run_lengths","statement":"if current == previous {"},{"line":10,"function":"run_lengths","statement":"length += 1;"},{"line":11,"function":"run_lengths","statement":"}"},{"line":12,"function":"run_lengths","statement":"out.push(previous);"},{"line":13,"function":"run_lengths","statement":"out.push_str(&length.to_string());"},{"line":14,"function":"run_lengths","statement":"previous = current;"},{"line":15,"function":"run_lengths","statement":"length = 1;"},{"l