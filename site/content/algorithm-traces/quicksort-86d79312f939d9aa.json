{"key":"quicksort-86d79312f939d9aa","sourceHash":"86d79312f939d9aabd9ab2a9587423e8bd2e646944e93dc894708e522bd83c9d","pattern":"quicksort","category":"sorting-selection","title":"Challenge: Quicksort","idea":"Partition around a pivot, then recurse only on the two unresolved regions.","complexity":"O(n log n) average · O(n^2) worst · O(log n) stack average","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn quicksort(a: &mut [i32]) {\n    if a.len() < 2 {\n        return;\n    }\n    let pivot = a[a.len() / 2];\n    let (mut low, mut i, mut high) = (0, 0, a.len());\n    while i < high {\n        if a[i] < pivot {\n            a.swap(low, i);\n            low += 1;\n            i += 1;\n        } else if a[i] > pivot {\n            high -= 1;\n            a.swap(i, high);\n        } else {\n            i += 1;\n        }\n    }\n    quicksort(&mut a[..low]);\n    quicksort(&mut a[high..]);\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![2, 2, 1];\n        quicksort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"quicksort","statement":"if a.len() < 2 {"},{"line":9,"function":"quicksort","statement":"return;"},{"line":11,"function":"quicksort","statement":"let pivot = a[a.len() / 2];"},{"line":12,"function":"quicksort","statement":"let (mut low, mut i, mut high) = (0, 0, a.len());"},{"line":13,"function":"quicksort","statement":"while i < high {"},{"line":14,"function":"quicksort","statement":"if a[i] < pivot {"},{"line":15,"function":"quicksort","statement":"a.swap(low, i);"},{"line":16,"function":"quicksort","statement":"low += 1;"},{"line":17,"function":"quicksort","statement":"i += 1;"},{"line":18,"function":"quicksort","statement":"}"},{"line":19,"function":"quicksort","statement":"high -= 1;"},{"line":20,"function":"quicksort","statement":"a.swap(i, high);"},{"line":21,"function":"quicksort","statement":"}"},{"line":22,"function":"quicksort","statement":"i += 1;"},{"line":23,"function":"quicksort","statement":"}"},{"line":25,"function":"quicksort","statement":"quicksort(&mut a[..low]);"},{"line":26,"function":"quicksort","statement":"quicksort(&mut a[high..]);"},{"line":27,"function":"quicksort","statement":"}"},{"line":30,"function":"main","statement":"let result = {"},{"line":31,"function":"main","statement":"let mut values = vec![2, 2, 1];"},{"line":32,"function":"main","statement":"quicksort(&mut values);"},{"line":33,"function":"main","statement":"csv(values)"},{"line":35,"function":"main","statement":"println!(\"{result}\");"},{"line":36,"function":"main","statement":"}"}],"version":1,"input":"[2,2,1]","stdout":"1,2,2\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1,2,2\""}}],"frames":[{"site":18,"stack":[["main"