{"key":"dag-shortest-path-e2cf0d8f3a3a55b0","sourceHash":"e2cf0d8f3a3a55b09a787a5d7b883e4d8821bcec6d2e97c47039c24c2fdfb171","pattern":"dag-shortest-path","category":"weighted-graphs","title":"DAG Shortest Path: Mental Model","idea":"Relax outgoing edges once in topological order because no path can return to an earlier node.","complexity":"O(V+E) time · O(V) space","source":"fn dag_distance(graph: &[Vec<(usize, i64)>], start: usize, goal: usize) -> i64 {\n    let n = graph.len();\n    let mut degree = vec![0; n];\n    for ns in graph {\n        for &(u, _) in ns {\n            degree[u] += 1;\n        }\n    }\n    let mut queue: std::collections::VecDeque<_> = (0..n).filter(|&v| degree[v] == 0).collect();\n    let mut distance = vec![i64::MAX; n];\n    distance[start] = 0;\n    let mut visited = 0;\n    while let Some(v) = queue.pop_front() {\n        visited += 1;\n        for &(u, w) in &graph[v] {\n            if distance[v] != i64::MAX {\n                distance[u] = distance[u].min(distance[v].checked_add(w).unwrap());\n            }\n            degree[u] -= 1;\n            if degree[u] == 0 {\n                queue.push_back(u);\n            }\n        }\n    }\n    assert_eq!(visited, n);\n    if distance[goal] == i64::MAX {\n        -1\n    } else {\n        distance[goal]\n    }\n}\n\nfn main() {\n    let result = dag_distance(\n        &[\n            vec![(1, 2), (2, 4)],\n            vec![(3, 7)],\n            vec![(3, 1)],\n            vec![(4, 3)],\n            vec![],\n        ],\n        0,\n        4,\n    )\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"dag_distance","statement":"let n = graph.len();"},{"line":3,"function":"dag_distance","statement":"let mut degree = vec![0; n];"},{"line":4,"function":"dag_distance","statement":"for ns in graph {"},{"line":5,"function":"dag_distance","statement":"for &(u, _) in ns {"},{"line":6,"function":"dag_distance","statement":"degree[u] += 1;"},{"line":7,"function":"da