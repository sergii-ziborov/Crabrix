{"key":"bidirectional-bfs-76dc39b5134673cd","sourceHash":"76dc39b5134673cd64f98ba65db28e08f6229cdd7538e8b81b234e7a67215f74","pattern":"bidirectional-bfs","category":"weighted-graphs","title":"Challenge: Bidirectional BFS","idea":"Expand the smaller frontier from each endpoint until the visited sets meet.","complexity":"O(b^(d/2)) frontier typical · O(V) space","source":"fn ladder_length(start: &str, goal: &str, words: &[&str]) -> usize {\n    use std::collections::{HashMap, HashSet};\n    // Every word after the start must come from the list, including the goal.\n    if !words.contains(&goal) {\n        return 0;\n    }\n    let mut front = HashSet::from([start.to_owned()]);\n    let mut back = HashSet::from([goal.to_owned()]);\n    let mut left = HashMap::from([(start.to_owned(), 1)]);\n    let mut right = HashMap::from([(goal.to_owned(), 1)]);\n    while !front.is_empty() && !back.is_empty() {\n        if front.len() > back.len() {\n            std::mem::swap(&mut front, &mut back);\n            std::mem::swap(&mut left, &mut right);\n        }\n        let mut next = HashSet::new();\n        let mut best = usize::MAX;\n        for word in &front {\n            if let Some(&d) = right.get(word) {\n                best = best.min(left[word] + d - 1);\n            }\n            for &candidate in words {\n                if candidate.len() != word.len()\n                    || word\n                        .bytes()\n                        .zip(candidate.bytes())\n                        .filter(|(a, b)| a != b)\n                        .count()\n                        != 1\n                {\n                    continue;\n                }\n                let d = left[word] + 1;\n                if let Some(&other) = right.get(candidate) {\n                    best = best.min(d + other - 1);\n                }\n                if !left.contains_key(candidate) {\n                    left.insert(candidate.to_owned(), d);\n                    next.insert(candidate.to_owned());\n                }\n            }\n        }\n        if best != usize::MAX {\n            return best;\n        }\n        front = next;\n    }\n    0\n}\n\nfn main() {\n    let result = ladder_length(\"hit\", \"hot\", &[\"hot\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":4,"function":"ladder_length","statement":"if !words.contains(&goal) {"},{"line":5,"function":"ladder_length","statement":"return 0;"},{"line":7,"function":"ladder_length","statement":"let mut front = HashSet::from([start.to_owned()]);"},{"line":8,"function":"ladder_length","statement":"let mut back = HashSet::from([goal.to_owned()]);"},{"line":9,"function":"ladder_length","statement":"let mut left = HashMap::from([(start.to_owned(), 1)]);"},{"line":10,"function":"ladder_length","statement":"let mut right = HashMap::from([(goal.to_owned(), 1)]);"},{"line":11,"function":"ladder_length","statement":"while !front.is_empty() && !back.is_empty() {"},{"line":12,"function":"ladder_length","statement":"if front.len() > back.len() {"},{"line":13,"function":"ladder_length","statement":"std::mem::swap(&mut front, &mut back);"},{"line":14,"function":"ladder_length","statement":"std::mem::swap(&mut left, &mut right);"},{"line":15,"function":"ladder_length","statement":"}"},{"line":16,"function":"ladder_length","statement":"let mut next = HashSet::new();"},{"line":17,"function":"ladder_length","statement":"let mut best = usize::MAX;"},{"line":18,"function":"ladder_length","statement":"for word in &front {"},{"line":19,"function":"ladder_length","statement":"if let Some(&d) = right.get(word) {"},{"line":20,"function":"ladder_length","statement":"best = best.min(left[word] + d - 1);"},{"line":21,"function":"ladder_length","statement":"}"},{"line":22,"function":"ladder_length","statement":"for &candidate in words {"},{"line":23,"function":"ladder_length","statement":"if candidate.len() != word.len()"},{"line":31,"function":"ladder_length","statement":"continue;"},{"line":33,"func