{"key":"interval-dp-aaa2563624ee1671","sourceHash":"aaa2563624ee1671d70cd3f908be0ecda693d54d2f2bdaf7db417dbedb97d857","pattern":"interval-dp","category":"dynamic-2d","title":"Challenge: Interval DP","idea":"Solve increasing interval lengths and choose the last or first action inside each interval.","complexity":"O(n^3) typical · O(n^2) space","source":"fn balloon_coins(values: &[i32]) -> i32 {\n    let mut a = vec![1];\n    a.extend_from_slice(values);\n    a.push(1);\n    let n = a.len();\n    let mut dp = vec![vec![0; n]; n];\n    for width in 2..n {\n        for left in 0..n - width {\n            let right = left + width;\n            for last in left + 1..right {\n                dp[left][right] = dp[left][right]\n                    .max(dp[left][last] + dp[last][right] + a[left] * a[last] * a[right]);\n            }\n        }\n    }\n    dp[0][n - 1]\n}\n\nfn main() {\n    let result = balloon_coins(&[1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"balloon_coins","statement":"let mut a = vec![1];"},{"line":3,"function":"balloon_coins","statement":"a.extend_from_slice(values);"},{"line":4,"function":"balloon_coins","statement":"a.push(1);"},{"line":5,"function":"balloon_coins","statement":"let n = a.len();"},{"line":6,"function":"balloon_coins","statement":"let mut dp = vec![vec![0; n]; n];"},{"line":7,"function":"balloon_coins","statement":"for width in 2..n {"},{"line":8,"function":"balloon_coins","statement":"for left in 0..n - width {"},{"line":9,"function":"balloon_coins","statement":"let right = left + width;"},{"line":10,"function":"balloon_coins","statement":"for last in left + 1..right {"},{"line":11,"function":"balloon_coins","statement":"dp[left][right] = dp[left][right]"},{"line":13,"function":"balloon_coins","statement":"}"},{"line":16,"function":"balloon_coins","statement":"dp[0][n - 1]"},{"line":20,"function":"main","statement":"let result = balloon_coins(&[1]).to_string();"},{"line":21,"function":"main","stat