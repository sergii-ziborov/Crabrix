{"key":"min-max-tracking-b3c406528ff4e458","sourceHash":"b3c406528ff4e458fcea922a87678e21cc94588e6f512678d9e006572aa0ce5d","pattern":"min-max-tracking","category":"scans","title":"Min/Max Tracking: Mental Model","idea":"Carry the best value seen so far and update it from each element.","complexity":"O(n) time · O(1) extra space","source":"fn spread(values: &[i32]) -> i32 {\n    assert!(!values.is_empty());\n    let (mut low, mut high) = (values[0], values[0]);\n    for &x in &values[1..] {\n        low = low.min(x);\n        high = high.max(x);\n    }\n    high - low\n}\n\nfn main() {\n    let result = spread(&[8, 3, 11, 6]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"spread","statement":"assert!(!values.is_empty());"},{"line":3,"function":"spread","statement":"let (mut low, mut high) = (values[0], values[0]);"},{"line":4,"function":"spread","statement":"for &x in &values[1..] {"},{"line":5,"function":"spread","statement":"low = low.min(x);"},{"line":6,"function":"spread","statement":"high = high.max(x);"},{"line":7,"function":"spread","statement":"}"},{"line":8,"function":"spread","statement":"high - low"},{"line":12,"function":"main","statement":"let result = spread(&[8, 3, 11, 6]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[8, 3, 11, 6]","stdout":"8\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"8"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"11"},{"kind":"scalar","text":"6"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"8"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"11"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"8\""}}],"frames":[{"site":7,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["spread",2]],"locals":[["