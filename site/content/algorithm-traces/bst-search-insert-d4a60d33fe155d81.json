{"key":"bst-search-insert-d4a60d33fe155d81","sourceHash":"d4a60d33fe155d816de0799609cf24e28c5e81ede938df8072b4d75121febc2e","pattern":"bst-search-insert","category":"trees","title":"Challenge: BST Search and Insert","idea":"Use the ordering invariant to follow one child and preserve it at insertion.","complexity":"O(h) time · O(h) stack or O(1) iterative","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn insert_bst(root: &mut Tree, value: i32) {\n    match root {\n        None => *root = node(value, None, None),\n        Some(n) if value < n.value => insert_bst(&mut n.left, value),\n        Some(n) => insert_bst(&mut n.right, value), // duplicates go right\n    }\n}\nfn bst_values(root: &Tree) -> Vec<i32> {\n    match root {\n        None => Vec::new(),\n        Some(n) => {\n            let mut out = bst_values(&n.left);\n            out.push(n.value);\n            out.extend(bst_values(&n.right));\n            out\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut root = node(2, node(1, None, None), node(3, None, None));\n        insert_bst(&mut root, 5);\n        csv(bst_values(&root))\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":17,"function":"insert_bst","statement":"match root {"},{"line":24,"function":"bst_values","statement":"match root {"},{"line":27,"function":"bst_values","statement":"let mut out = bst_values(&n.left);"},{"line":28,"function":"bst_values","statement":"out.push(n.value);"},{"line":29,"function":"bst_values","statement":"out.extend(bst_values(&n.right));"},{"line":30,"function":"bst_values","statement":"out"},{"line":36,"function":"main","statement":"let result = {"},{"line":37,"function":"main","statement":"let mut root = node(2, node(1, None, None), node(3, None, None));"},{"line":38,"function":"main","statement":"insert_bst(&mut root, 5);"},{"line":39,"function":"main","statement":"csv(bst_values(&root))"},{"line":41,"function":"main","statement":"println!(\"{result}\");"},{"line":42,"function":"main","statement":"}"}],"version":1,"input":"BST=[2,1,3]","stdout":"1,2,3,5\n","values":[{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":true}}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"3"}]]}}],"tuple":true}}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kin