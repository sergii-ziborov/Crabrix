{"key":"remove-nth-from-end-08b39999dd063801","sourceHash":"08b39999dd063801577a00491304dc302216fa04c28916593dd9be4a845bfd86","pattern":"remove-nth-from-end","category":"linked-lists","title":"Challenge: Gap Pointer Removal","idea":"Keep a fixed gap so the leading pointer reaching the end positions the trailing pointer before the target.","complexity":"O(n) time · O(1) extra space over the arena","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\n\nstruct ListNode {\n    value: i32,\n    next: Option<usize>,\n}\nfn arena(values: &[i32]) -> Vec<ListNode> {\n    values\n        .iter()\n        .enumerate()\n        .map(|(i, &value)| ListNode {\n            value,\n            next: (i + 1 < values.len()).then_some(i + 1),\n        })\n        .collect()\n}\n// Rust rejects a shared lead reference and a mutable trail reference into one\n// Box chain. Two indexes into an arena can move together without that conflict.\nfn remove_from_end(nodes: &mut [ListNode], head: usize, n: usize) -> Option<usize> {\n    // Open a gap of n links between the two cursors, without measuring the list.\n    let mut lead = Some(head);\n    for _ in 0..n {\n        lead = nodes[lead.expect(\"n is at most the list length\")].next;\n    }\n    // Lead fell off the end during the gap, so the target is the head itself.\n    let Some(mut lead) = lead else {\n        return nodes[head].next;\n    };\n    // Move both until lead is on the last node; trail then sits before the target.\n    let mut trail = head;\n    while let Some(next) = nodes[lead].next {\n        lead = next;\n        trail = nodes[trail].next.unwrap();\n    }\n    let target = nodes[trail].next.unwrap();\n    nodes[trail].next = nodes[target].next;\n    Some(head)\n}\nfn remaining_values(values: &[i32], n: usize) -> Vec<i32> {\n    let mut nodes = arena(values);\n    let mut cursor = remove_from_end(&mut nodes, 0, n);\n    let mut out = Vec::new();\n    while let Some(i) = cursor {\n        out.push(nodes[i].value);\n        cursor = nodes[i].next;\n    }\n    out\n}\n\nfn main() {\n    let result = csv(remaining_values(&[1, 2], 2));\n    println!(\"{result}\");\n}\n","sites":[{"line":13,"function":"arena","statement":"values"},{"line":16,"function":"closure · line 16","statement":"ListNode {"},{"line":26,"function":"remove_from_end","statement":"let mut lead = Some(head);"},{"line":27,"function":"remove_from_end","statement":"for _ in 0..n {"},{"line":28,"function":"remove_from_end","statement":"lead = nodes[lead.expect(\"n is at most the list length\")].next;"},{"line":29,"function":"remove_from_end","statement":"}"},{"line":31,"function":"remove_from_end","statement":"let Some(mut lead) = lead else {"},{"line":32,"function":"remove_from_end","statement":"return nodes[head].next;"},{"line":35,"function":"remove_from_end","statement":"let mut trail = head;"},{"line":36,"function":"remove_from_end","statement":"while let Some(next) = nodes[lead].next {"},{"line":37,"function":"remove_from_end","statement":"lead = next;"},{"line":38,"function":"remove_from_end","statement":"trail = nodes[trail].next.unwrap();"},{"line":39,"function":"remove_from_end","statement":"}"},{"line":40,"function":"remove_from_end","statement":"let target = nodes[trail].next.unwrap();"},{"line":41,"function":"remove_from_end","statement":"nodes[trail].next = nodes[target].next;"},{"line":42,"function":"remove_from_end","statement":"Some(head)"},{"line":45,"function":"remaining_values","statement":"let mut nodes = arena(values);"},{"line":46,"function":"remaining_values","statement":"let mut cursor = remove_from_end(&mut nodes, 0, n);"},{"line":47,"function":"remaining_values","statement":"let mut out = Vec::new();"},{"line":48,"function":"remaining_values","statement":"while let Some(i) = cursor {"},{"line":49,"function":"remaining_values","statement":"out.push(nodes[i].value);"},{"line":50,"function":"remaining_values","statement":"cursor = nodes[i].next;"},{"line":51,"function":"remaining_values","statement":"}"},{"line":52,"function":"remaining_values","statement":"out"},{"line":56,"function":"main","statement":"let result = csv(remaining_values(&[1, 2], 2));"},{"line":57,"function":"main","statement":"println!(\"{result}\");"},{"line":58,"function":"main","statement":"}"}],"version":1,"input":"1->2","stdout":"2\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<traced::ListNode>","data":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":true}}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}},{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"2"}]]}}],"tuple":false}},{"type":"&mut [traced::ListNode]","data":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":true}}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}},{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"2"}]]}}],"tuple":false}},{"type":"core::option::Option<u