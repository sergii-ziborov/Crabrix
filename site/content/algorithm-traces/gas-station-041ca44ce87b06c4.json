{"key":"gas-station-041ca44ce87b06c4","sourceHash":"041ca44ce87b06c4db9d7d482d346ce331601df260e1fc2f19451377a472116a","pattern":"gas-station","category":"greedy-intervals","title":"Gas Station Reset: Mental Model","idea":"When running fuel becomes negative, no station in that failed segment can be a valid start.","complexity":"O(n) time · O(1) space","source":"fn starting_station(gas: &[i32], cost: &[i32]) -> i32 {\n    assert_eq!(gas.len(), cost.len());\n    let (mut total, mut tank, mut start) = (0, 0, 0);\n    for i in 0..gas.len() {\n        let net = gas[i] - cost[i];\n        total += net;\n        tank += net;\n        if tank < 0 {\n            tank = 0;\n            start = i + 1;\n        }\n    }\n    if total < 0 || gas.is_empty() {\n        -1\n    } else {\n        start as i32\n    }\n}\n\nfn main() {\n    let result = starting_station(&[1, 2, 3, 4, 5], &[3, 4, 5, 1, 2]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"starting_station","statement":"assert_eq!(gas.len(), cost.len());"},{"line":3,"function":"starting_station","statement":"let (mut total, mut tank, mut start) = (0, 0, 0);"},{"line":4,"function":"starting_station","statement":"for i in 0..gas.len() {"},{"line":5,"function":"starting_station","statement":"let net = gas[i] - cost[i];"},{"line":6,"function":"starting_station","statement":"total += net;"},{"line":7,"function":"starting_station","statement":"tank += net;"},{"line":8,"function":"starting_station","statement":"if tank < 0 {"},{"line":9,"function":"starting_station","statement":"tank = 0;"},{"line":10,"function":"starting_station","statement":"start = i + 1;"},{"line":11,"function":"starting_station","statement":"}"},{"line":13,"function":"starting_station","statement":"if total < 0 || gas.is_empty() {"},{"line":14,"function":"starting_station","statement":"-1"},{"line":16,"function":"starting_station","statement":"start as i32"},{"line":21,"function":"main","statement":"let result = starting_station(&[1, 2, 3, 4, 5], &[3, 4, 5, 1, 2]).to_string();"},{"line":22,"function":"main","statement":"println!(\"{result}\");"},{"line":23,"function":"main","statement":"}"}],"version":1,"input":"gas=[1,2,3,4,5] cost=[3,4,5,1,2]","stdout":"3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"-2"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"-4"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"-6"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"-3"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"3\""}}],"frames":[{"site":13,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["starting_station",2]],"locals":[["gas",0],["cost",1]]},{"site":1,"stack":[["main",1],["starting_station",2]],"locals":[["gas",0],["cost",1]]},{"site":2,"stack":[["main",1],["starting_station",2]],"locals":[["gas",0],["cost",1],["total",2],["tank",2],["start",3]]},{"site":3,"stack":[["main",1],["starting_station",2]],"locals":[["gas",0],["cost",1],["total",2],["tank",2],["start",3],["i",3]]},{"site":4,"stack":[["main",1],["starting_station",2]],"locals":[["gas",0],["cost",1],["total",2],["tank",2],["start",3],["i",3],["net",4]]},{"site":5,"