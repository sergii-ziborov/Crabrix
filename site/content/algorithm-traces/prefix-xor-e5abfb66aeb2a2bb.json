{"key":"prefix-xor-e5abfb66aeb2a2bb","sourceHash":"e5abfb66aeb2a2bbd7a391ff06cde64d4bd32239fbad543f0e2a65ab7af7edc5","pattern":"prefix-xor","category":"ranges","title":"Prefix XOR: Mental Model","idea":"Use XOR self-cancellation so a range value is two prefix states combined.","complexity":"O(n) build · O(1) query · O(n) space","source":"fn range_xor(values: &[i32], left: usize, right: usize) -> i32 {\n    let mut prefix = vec![0; values.len() + 1];\n    for (i, &x) in values.iter().enumerate() {\n        prefix[i + 1] = prefix[i] ^ x;\n    }\n    prefix[right + 1] ^ prefix[left]\n}\n\nfn main() {\n    let result = range_xor(&[5, 1, 7, 3, 2], 1, 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"range_xor","statement":"let mut prefix = vec![0; values.len() + 1];"},{"line":3,"function":"range_xor","statement":"for (i, &x) in values.iter().enumerate() {"},{"line":4,"function":"range_xor","statement":"prefix[i + 1] = prefix[i] ^ x;"},{"line":5,"function":"range_xor","statement":"}"},{"line":6,"function":"range_xor","statement":"prefix[right + 1] ^ prefix[left]"},{"line":10,"function":"main","statement":"let result = range_xor(&[5, 1, 7, 3, 2], 1, 4).to_string();"},{"line":11,"function":"main","statement":"println!(\"{result}\");"},{"line":12,"function":"main","statement":"}"}],"version":1,"input":"[5,1,7,3,2]","stdout":"7\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text"