{"key":"combinations-50f9cace2f51d6ac","sourceHash":"50f9cace2f51d6ac80081902db827b70745e27059ae56fea6468e5dc2a661efe","pattern":"combinations","category":"backtracking","title":"Combination Backtracking: Mental Model","idea":"Advance the start index so order does not create duplicate selections.","complexity":"O(C(n,k)*k) output-sensitive","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn semicolon<T: std::fmt::Display>(a: Vec<Vec<T>>) -> String {\n    a.into_iter().map(csv).collect::<Vec<_>>().join(\";\")\n}\nfn combinations(values: &[i32], k: usize) -> Vec<Vec<i32>> {\n    fn visit(a: &[i32], start: usize, k: usize, path: &mut Vec<i32>, out: &mut Vec<Vec<i32>>) {\n        if path.len() == k {\n            out.push(path.clone());\n            return;\n        }\n        for i in start..a.len() {\n            if a.len() - i < k - path.len() {\n                break;\n            }\n            path.push(a[i]);\n            visit(a, i + 1, k, path, out);\n            path.pop();\n        }\n    }\n    let mut out = Vec::new();\n    visit(values, 0, k, &mut Vec::new(), &mut out);\n    out\n}\n\nfn main() {\n    let result = semicolon(combinations(&[1, 2, 3], 2));\n    println!(\"{result}\");\n}\n","sites":[{"line":25,"function":"combinations","statement":"let mut out = Vec::new();"},{"line":26,"function":"combinations","statement":"visit(values, 0, k, &mut Vec::new(), &mut out);"},{"line":27,"function":"combinations","statement":"out"},{"line":12,"function":"visit","statement":"if path.len() == k {"},{"line":13,"function":"visit","statement":"out.push(path.clone());"},{"line":14,"function":"visit","statement":"return;"},{"line":16,"function":"visit","statement":"for i in start..a.len() {"},{"line":17,"function":"visit","statement":"if a.len() - i < k - path.len() {"},{"line":18,"function":"visit","statement":"break;"},{"line"