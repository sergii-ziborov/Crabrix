{"key":"mo-algorithm-4305cec259be0e56","sourceHash":"4305cec259be0e56a8860d9939815a1230a2d0965300febc0a3bca91a8a0e4bf","pattern":"mo-algorithm","category":"advanced-structures","title":"Challenge: Mo's Algorithm","idea":"Order offline range queries so adjacent queries move their boundaries only a small distance.","complexity":"O((n+q)*sqrt(n)) operations · O(state) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn distinct_queries(values: &[i32], queries: &[(usize, usize)]) -> Vec<usize> {\n    let block = (values.len() as f64).sqrt().max(1.0) as usize;\n    let mut order: Vec<_> = (0..queries.len()).collect();\n    order.sort_by_key(|&i| {\n        let (l, r) = queries[i];\n        (\n            l / block,\n            if l / block % 2 == 0 {\n                r as isize\n            } else {\n                -(r as isize)\n            },\n        )\n    });\n    let mut counts = std::collections::HashMap::<i32, usize>::new();\n    let (mut left, mut right, mut distinct) = (0, 0, 0);\n    let mut out = vec![0; queries.len()];\n    fn change(\n        counts: &mut std::collections::HashMap<i32, usize>,\n        distinct: &mut usize,\n        x: i32,\n        add: bool,\n    ) {\n        let count = counts.entry(x).or_default();\n        if add {\n            if *count == 0 {\n                *distinct += 1;\n            }\n            *count += 1;\n        } else {\n            *count -= 1;\n            if *count == 0 {\n                *distinct -= 1;\n            }\n        }\n    }\n    for i in order {\n        let (l, r) = queries[i];\n        let end = r + 1;\n        while left > l {\n            left -= 1;\n            change(&mut counts, &mut distinct, values[left], true);\n        }\n        while right < end {\n            change(&mut counts, &mut distinct, values[right], true);\n            right += 1;\n        }\n        while left < l {\n            change(&mut counts, &mut distinct, values[left], false);\n            left += 1;\n        }\n        while right > end {\n            right -= 1;\n            change(&mut counts, &mut distinct, values[right], false);\n        }\n        out[i] = distinct;\n    }\n    out\n}\n\nfn main() {\n    let result = csv(distinct_queries(\n        &[1, 1, 1, 1, 1, 1],\n        &[(0, 3), (2, 5), (0, 5)],\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"distinct_queries","statement":"let block = (values.len() as f64).sqrt().max(1.0) as usize;"},{"line":9,"function":"distinct_queries","statement":"let mut order: Vec<_> = (0..queries.len()).collect();"},{"line":10,"function":"distinct_queries","statement":"order.sort_by_key(|&i| {"},{"line":21,"function":"distinct_queries","statement":"let mut counts = std::collections::HashMap::<i32, usize>::new();"},{"line":22,"function":"distinct_queries","statement":"let (mut left, mut right, mut distinct) = (0, 0, 0);"},{"line":23,"function":"distinct_queries","statement":"let mut out = vec![0; queries.len()];"},{"line":43,"function":"distinct_queries","statement":"for i in order {"},{"line":44,"function":"distinct_queries","statement":"let (l, r) = queries[i];"},{"line":45,"function":"distinct_queries","statement":"let end = r + 1;"},{"line":46,"function":"distinct_queries","statement":"while left > l {"},{"line":47,"function":"distinct_queries","statement":"left -= 1;"},{"line":48,"function":"distinct_queries","statement":"change(&mut counts, &mut distinct, values[left], true);"},{"line":49,"function":"distinct_queries","statement":"}"},{"line":50,"function":"distinct_queries","statement":"while right < end {"},{"line":51,"function":"distinct_queries","statement":"change(&mut counts, &mut distinct, values[right], true);"},{"line":52,"function":"distinct_queries","statement":"right += 1;"},{"line":53,"function":"distinct_queries","statement":"}"},{"line":54,"function":"distinct_queries","statement":"while left < l {"},{"line":55,"function":"distinct_queries","statement":"change(&mut counts, &mut distinct, values[left], false);"},{"line":56,"function":"distinct_queries","statement":"left += 1;"},{"line":57,"function":"distinct_queries","statement":"}"},{"line":58,"function":"distinct_queries","statement":"while right > end {"},{"line":59,"function":"distinct_queries","statement":"right -= 1;"},{"line":60,"function":"distinct_queries","statement":"change(&mut counts, &mut distinct, values[right], false);"},{"line":61,"function":"distinct_queries","statement":"}"},{"line":62,"function":"distinct_queries","statement":"out[i] = distinct;"},{"line":63,"function":"distinct_queries","statement":"}"},{"line":64,"function":"distinct_queries","statement":"out"},{"line":11,"function":"closure · line 10","statement":"let (l, r) = queries[i];"},{"line":12,"function":"closure · line 10","statement":"("},{"line":15,"function":"closure · line 10","statement":"r as isize"},{"line":17,"function":"closure · line 10","statement":"-(r as isize)"},{"line":30,"function":"change","statement":"let count = counts.entry(x).or_default();"},{"line":31,"function":"change","statement":"if add {"},{"line":32,"function":"change","statement":"if *count == 0 {"},{"line":33,"function":"change","statement":"*distinct += 1;"},{"line":34,"function":"change","statement":"}"},{"line":35,"function":"change","statement":"*count += 1;"},{"line":36,"function":"change","statement":"}"},{"line":37,"function":"change","statement":"*count -= 1;"},{"line":38,"function":"change","statement":"if *count == 0 {"},{"line":39,"function":"change","statement":"*distinct -= 1;"},{"line":40,"function":"change","statement":"}"},{"line":68,"function":"main","statement":"let result = csv(distinct_queries("},{"line":72,"function":"main","statement":"println!(\"{result}\");"},{"line":73,"function":"main","statement":"}"}],"version":1,"input":"[1,1,1,1,1,1]","stdout":"1,1,1\n","values":[{"type":"