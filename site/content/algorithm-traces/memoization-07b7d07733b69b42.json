{"key":"memoization-07b7d07733b69b42","sourceHash":"07b7d07733b69b429f552d874cfa3a80769da452c5c9e9f5ed6c388fb81b1531","pattern":"memoization","category":"dynamic-1d","title":"Top-Down Memoization: Mental Model","idea":"Cache a recursive state the first time it is solved so overlapping subproblems run once.","complexity":"O(n) time · O(n) memo and recursion depth","source":"fn fibonacci(n: usize) -> u64 {\n    fn compute(n: usize, memo: &mut [Option<u64>]) -> u64 {\n        if let Some(answer) = memo[n] {\n            return answer;\n        }\n        let answer = if n < 2 {\n            n as u64\n        } else {\n            compute(n - 1, memo) + compute(n - 2, memo)\n        };\n        memo[n] = Some(answer);\n        answer\n    }\n    assert!(n <= 93);\n    compute(n, &mut vec![None; n + 1])\n}\n\nfn main() {\n    let result = fibonacci(12).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":14,"function":"fibonacci","statement":"assert!(n <= 93);"},{"line":15,"function":"fibonacci","statement":"compute(n, &mut vec![None; n + 1])"},{"line":3,"function":"compute","statement":"if let Some(answer) = memo[n] {"},{"line":4,"function":"compute","statement":"return answer;"},{"line":6,"function":"compute","statement":"let answer = if n < 2 {"},{"line":7,"function":"compute","statement":"n as u64"},{"line":9,"function":"compute","statement":"compute(n - 1, memo) + compute(n - 2, memo)"},{"line":11,"function":"compute","statement":"memo[n] = Some(answer);"},{"line":12,"function":"compute","statement":"answer"},{"line":19,"function":"main","statement":"let result = fibonacci(12).to_string();"},{"line":20,"function":"main","statement":"println!(\"{result}\");"},{"line":21,"function":"main","statement":"}"}],"version":1,"input":"n=12","stdout":"144\n","values":[{"type":"usize","data":{"kind":"scalar","text":"12"}},{"type":"&mut [core::option::Option<u64>]","data":{"kind":"list","items":[{"kind":"scalar","text":"None"},{"kind":"scalar","text":"None"},{"kind":