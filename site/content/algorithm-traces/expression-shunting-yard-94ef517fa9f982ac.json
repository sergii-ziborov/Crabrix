{"key":"expression-shunting-yard-94ef517fa9f982ac","sourceHash":"94ef517fa9f982acc2a1fb7edec9e939a04771f23270d32af972f2b67fae5c87","pattern":"expression-shunting-yard","category":"stacks-queues","title":"Shunting-Yard Parsing: Mental Model","idea":"Use an operator stack to emit operations only when precedence and associativity allow.","complexity":"O(n) time · O(n) space","source":"fn to_postfix(expression: &str) -> String {\n    fn precedence(op: &str) -> u8 {\n        match op {\n            \"+\" | \"-\" => 1,\n            \"*\" | \"/\" => 2,\n            _ => 0,\n        }\n    }\n    let (mut out, mut stack) = (Vec::new(), Vec::new());\n    for token in expression.split_whitespace() {\n        if token.parse::<i32>().is_ok() {\n            out.push(token);\n        } else if token == \"(\" {\n            stack.push(token);\n        } else if token == \")\" {\n            while stack.last() != Some(&\"(\") {\n                out.push(stack.pop().expect(\"matching parenthesis\"));\n            }\n            stack.pop();\n        } else {\n            while stack\n                .last()\n                .is_some_and(|&op| op != \"(\" && precedence(op) >= precedence(token))\n            {\n                out.push(stack.pop().unwrap());\n            }\n            stack.push(token);\n        }\n    }\n    out.extend(stack.into_iter().rev());\n    out.join(\" \")\n}\n\nfn main() {\n    let result = to_postfix(\"3 + 4 * 2\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":9,"function":"to_postfix","statement":"let (mut out, mut stack) = (Vec::new(), Vec::new());"},{"line":10,"function":"to_postfix","statement":"for token in expression.split_whitespace() {"},{"line":11,"function":"to_postfix","statement":"if token.parse::<i32>().is_ok() {"},{"line":12,"function":"to_postfix","statement":"out.push(token);"},{"line":13,"function":"to_postfix","statement":"}"},{"line":14,"function":"to_postfix","statement":"stack.push(token);"},{"line":15,"function":"t