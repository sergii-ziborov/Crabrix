{"key":"bidirectional-bfs-ced54e6e2601d2ca","sourceHash":"ced54e6e2601d2ca9c7915e8fed4837e90580473d9ccedb03b1270ba67b541c6","pattern":"bidirectional-bfs","category":"weighted-graphs","title":"Challenge: Bidirectional BFS","idea":"Expand the smaller frontier from each endpoint until the visited sets meet.","complexity":"O(b^(d/2)) frontier typical · O(V) space","source":"fn ladder_length(start: &str, goal: &str, words: &[&str]) -> usize {\n    use std::collections::{HashMap, HashSet};\n    let mut front = HashSet::from([start.to_owned()]);\n    let mut back = HashSet::from([goal.to_owned()]);\n    let mut left = HashMap::from([(start.to_owned(), 1)]);\n    let mut right = HashMap::from([(goal.to_owned(), 1)]);\n    while !front.is_empty() && !back.is_empty() {\n        if front.len() > back.len() {\n            std::mem::swap(&mut front, &mut back);\n            std::mem::swap(&mut left, &mut right);\n        }\n        let mut next = HashSet::new();\n        let mut best = usize::MAX;\n        for word in &front {\n            if let Some(&d) = right.get(word) {\n                best = best.min(left[word] + d - 1);\n            }\n            for &candidate in words {\n                if candidate.len() != word.len()\n                    || word\n                        .bytes()\n                        .zip(candidate.bytes())\n                        .filter(|(a, b)| a != b)\n                        .count()\n                        != 1\n                {\n                    continue;\n                }\n                let d = left[word] + 1;\n                if let Some(&other) = right.get(candidate) {\n                    best = best.min(d + other - 1);\n                }\n                if !left.contains_key(candidate) {\n                    left.insert(candidate.to_owned(), d);\n                    next.insert(candidate.to_owned());\n                }\n            }\n        }\n        if best != usize::MAX {\n            return best;\n        }\n        front = next;\n    }\n    0\n}\n\nfn main() {\n    let result = ladder_length(\"hit\", \"hot\", &[\"hot\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":3,"function":"ladder_length","statement":"let mut front = HashSet::from([start.to_owned()]);"},{"line":4,"function":"ladder_length","statement":"let mut back = HashSet::from([goal.to_owned()]);"},{"line":5,"function":"ladder_length","statement":"let mut left = HashMap::from([(start.to_owned(), 1)]);"},{"line":6,"function":"ladder_length","statement":"let mut right = HashMap::from([(goal.to_owned(), 1)]);"},{"line":7,"function":"ladder_length","statement":"while !front.is_empty() && !back.is_empty() {"},{"line":8,"function":"ladder_length","statement":"if front.len() > back.len() {"},{"line":9,"function":"ladder_length","statement":"std::mem::swap(&mut front, &mut back);"},{"line":10,"function":"ladder_length","statement":"std::mem::swap(&mut left, &mut right);"},{"line":11,"function":"ladder_length","statement":"}"},{"line":12,"function":"ladder_length","statement":"let mut next = HashSet::new();"},{"line":13,"function":"ladder_length","statement":"let mut best = usize::MAX;"},{"line":14,"function":"ladder_length","statement":"for word in &front {"},{"line":15,"function":"ladder_length","statement":"if let Some(&d) = right.get(word) {"},{"line":16,"function":"ladder_length","statement":"best = best.min(left[word] + d - 1);"},{"line":17,"function":"ladder_length","statement":"}"},{"line":18,"function":"ladder_length","statement":"for &candidate in words {"},{"line":19,"function":"ladder_length","statement":"if candidate.len() != word.len()"},{"line":27,"function":"ladder_length","statement":"continue;"},{"line":29,"function":"ladder_length","statement":"let d = left[word] + 1;"},{"line":30,"function":"ladder_length","statement":"if let Some(&other) = right.get(candidate) {"},{"line":31,"function":"ladder_length","statement":"best = best.min(d + other - 1);"},{"line":32,"function":"ladder_length","st