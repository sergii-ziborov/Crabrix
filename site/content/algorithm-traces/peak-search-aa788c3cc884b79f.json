{"key":"peak-search-aa788c3cc884b79f","sourceHash":"aa788c3cc884b79f7c7a6bc4e625333d7f81619caa0d701814cedcc40bc51732","pattern":"peak-search","category":"binary-search","title":"Challenge: Peak Binary Search","idea":"Compare adjacent slopes; one side is guaranteed to contain a peak.","complexity":"O(log n) time · O(1) space","source":"fn peak_index(a: &[i32]) -> usize {\n    assert!(!a.is_empty());\n    let (mut lo, mut hi) = (0, a.len() - 1);\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] < a[mid + 1] {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    lo // Adjacent values differ; outside endpoints are negative infinity.\n}\n\nfn main() {\n    let result = peak_index(&[3, 2, 1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"peak_index","statement":"assert!(!a.is_empty());"},{"line":3,"function":"peak_index","statement":"let (mut lo, mut hi) = (0, a.len() - 1);"},{"line":4,"function":"peak_index","statement":"while lo < hi {"},{"line":5,"function":"peak_index","statement":"let mid = lo + (hi - lo) / 2;"},{"line":6,"function":"peak_index","statement":"if a[mid] < a[mid + 1] {"},{"line":7,"function":"peak_index","statement":"lo = mid + 1;"},{"line":8,"function":"peak_index","statement":"}"},{"line":9,"function":"peak_index","statement":"hi = mid;"},{"line":10,"function":"peak_index","statement":"}"},{"line":12,"function":"peak_index","statement":"lo"},{"line":16,"function":"main","statement":"let result = peak_index(&[3, 2, 1]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"[3,2,1]","stdout":"0\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},