{"key":"tree-height-balance-c144ef3bb9132705","sourceHash":"c144ef3bb9132705f487a0b2054cd2c1709edac1f1357763d1b480f01b879819","pattern":"tree-height-balance","category":"trees","title":"Challenge: Height with Balance Sentinel","idea":"Return height normally but propagate a sentinel immediately when a subtree is already unbalanced.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn is_balanced(root: &Tree) -> bool {\n    fn height(root: &Tree) -> Option<usize> {\n        match root {\n            None => Some(0),\n            Some(n) => {\n                let (left, right) = (height(&n.left)?, height(&n.right)?);\n                (left.abs_diff(right) <= 1).then_some(1 + left.max(right))\n            }\n        }\n    }\n    height(root).is_some()\n}\n\nfn main() {\n    let result = is_balanced(&node(1, node(2, node(3, None, None), None), None)).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":20,"function":"is_balanced","statement":"height(root).is_some()"},{"line":12,"function":"height","statement":"match root {"},{"line":15,"function":"height","statement":"let (left, right) = (height(&n.left)?, height(&n.right)?);"},{"line":16,"function":"height","statement":"(left.abs_diff(right) <= 1).then_some(1 + left.max(right))"},{"line":24,"function":"main","statement":"let result = is_balanced(&node(1, node(2, node(3, None, None), None), None)).to_string();"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"[1,2,null,3]","stdout":"false\n","values":[{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"s