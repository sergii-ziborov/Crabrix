{"key":"median-of-medians-0620f1bc9ef9aeab","sourceHash":"0620f1bc9ef9aeabbd4d270787b7a6f086f4470d784d18372d8735fe8f114fe5","pattern":"median-of-medians","category":"sorting-selection","title":"Challenge: Median of Medians","idea":"Choose a guaranteed-good pivot from medians of small groups before selecting one side.","complexity":"O(n) worst-case time · O(n) or in-place variants","source":"fn deterministic_select(a: &[i32], k: usize) -> i32 {\n    assert!(k < a.len());\n    if a.len() <= 5 {\n        let mut small = a.to_vec();\n        small.sort_unstable();\n        return small[k];\n    }\n    let medians: Vec<_> = a\n        .chunks(5)\n        .map(|group| {\n            let mut g = group.to_vec();\n            g.sort_unstable();\n            g[g.len() / 2]\n        })\n        .collect();\n    let pivot = deterministic_select(&medians, medians.len() / 2);\n    let smaller: Vec<_> = a.iter().copied().filter(|&x| x < pivot).collect();\n    let equal = a.iter().filter(|&&x| x == pivot).count();\n    if k < smaller.len() {\n        deterministic_select(&smaller, k)\n    } else if k < smaller.len() + equal {\n        pivot\n    } else {\n        let greater: Vec<_> = a.iter().copied().filter(|&x| x > pivot).collect();\n        deterministic_select(&greater, k - smaller.len() - equal)\n    }\n}\n\nfn main() {\n    let result = deterministic_select(&[9, 8, 7, 6, 5], 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"deterministic_select","statement":"assert!(k < a.len());"},{"line":3,"function":"deterministic_select","statement":"if a.len() <= 5 {"},{"line":4,"function":"deterministic_select","statement":"let mut small = a.to_vec();"},{"line":5,"function":"deterministic_select","statement":"small.sort_unstable();"},{"line":6,"function":"deterministic_select","statement":"return small[k];"},{"line":8,"function":"deterministic_select","statement":"let medians: Vec<_> = a"},{"line":16,"function":"deterministic_select","statement":"let pivot = deterministic_select(&medians, medians.len() / 2);"},{"line":17,"function":"deterministic_select","statement":"let smaller: Vec<_> = a.iter().copied().filter(|&x| x < pivot).collect();"},{"line":18,"function":"deterministic_select","statement":"let equal = a.iter().filter(|&&x| x == pivot).count();"},{"line":19,"function":"deterministic_select","statement":"if k < smaller.len() {"},{"line":20,"function":"deterministic_select","statement":"deterministic_select(&smaller, k)"},{"line":22,"function":"deterministic_select","statement":"pivot"},{"line":24,"function":"deterministic_select","statement":"let greater: Vec<_> = a.iter().copied().filter(|&x| x > pivot).collect();"},{"line":25,"function":"deterministic_select","statement":"deterministic_select(&greater, k - smaller.len() - equal)"},{"line":11,"function":"closure · line 10","statement":"let mut g = group.to_vec();"},{"line":12,"function":"closure · line 10","statement":"g.sort_unstable();"},{"line":13,"function":"closure · line 10","statement":"g[g.len() / 2]"},{"line":17,"function":"closure · line 17","statement":"x < pivot"},{"line":18,"function":"closure · line 18","statement":"x == pivot"},{"line":24,"function":"closure · line 24","statement":"x > pivot"},{"line":30,"function":"main","statement":"let result = deterministic_select(&[9, 8, 7, 6, 5], 4).to_string();"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"[9,8,7,6,5]","stdout":"9\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"9\""}}],"frames":[{"site":20,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["deterministic_select",2]],"locals":[["a",0],["k",1]]},{"site":1,"stack":[["main",1],["deterministic_select",2]],"locals":[["a",0],["k",1]]},{"site":2,"stack":[["main",1],["deterministic_select",2]],"locals":[["a",0],["k",1]]},{"site":3,"stack":[["main",1],["deterministic_select",2]],"locals":[["a",0],["k",1],["small",2]]},{"site":4,"stack":[["main",1],["deterministic_select",2]],"locals":[["a",0],["k",1],["small",3]]},{"site":21,"stack":[["main",1]],"locals":[["result",4]]},{"site":22,"stack":[["main",1]],"locals":[["result",4]]}],"verification":{"stdoutMatchesOriginal":true,"independentOracle":true,"omittedCaptures":0}}
