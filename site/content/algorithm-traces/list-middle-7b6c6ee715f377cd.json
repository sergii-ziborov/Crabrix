{"key":"list-middle-7b6c6ee715f377cd","sourceHash":"7b6c6ee715f377cdf4f6cfa8204ce54ba62250738d06d887f22c2ebec73ae057","pattern":"list-middle","category":"linked-lists","title":"Challenge: Middle by Slow/Fast","idea":"Move one pointer once and another twice so the slow pointer reaches the middle.","complexity":"O(n) time · O(1) space","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn list_middle(head: &Link) -> i32 {\n    let (mut slow, mut fast) = (head.as_deref(), head.as_deref());\n    while let Some(next) = fast.and_then(|n| n.next.as_deref()) {\n        slow = slow.unwrap().next.as_deref();\n        fast = next.next.as_deref();\n    }\n    slow.expect(\"nonempty list\").value\n}\n\nfn main() {\n    let result = list_middle(&list(&[1, 2])).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":21,"function":"list_middle","statement":"let (mut slow, mut fast) = (head.as_deref(), head.