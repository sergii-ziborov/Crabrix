{"key":"tree-height-balance-97eee57e3c929e19","sourceHash":"97eee57e3c929e19100400e7e51c8c6def5d9898d7c2fee52214145d7ad2335c","pattern":"tree-height-balance","category":"trees","title":"Height with Balance Sentinel: Mental Model","idea":"Return height normally but propagate a sentinel immediately when a subtree is already unbalanced.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn is_balanced(root: &Tree) -> bool {\n    fn height(root: &Tree) -> Option<usize> {\n        match root {\n            None => Some(0),\n            Some(n) => {\n                let (left, right) = (height(&n.left)?, height(&n.right)?);\n                (left.abs_diff(right) <= 1).then_some(1 + left.max(right))\n            }\n        }\n    }\n    height(root).is_some()\n}\n\nfn main() {\n    let result = is_balanced(&node(\n        3,\n        node(9, None, None),\n        node(20, node(15, None, None), node(7, None, None)),\n    ))\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":20,"function":"is_balanced","statement":"height(root).is_some()"},{"line":12,"function":"height","statement":"match root {"},{"line":15,"function":"height","statement":"let (left, right) = (height(&n.left)?, height(&n.right)?);"},{"line":16,"function":"height","statement":"(left.abs_diff(right) <= 1).then_some(1 + left.max(right))"},{"line":24,"function":"main","statement":"let result = is_balanced(&node("},{"line":30,"function":"main","statement":"println!(\"{result}\");"},{"line":31,"function":"main","statement":"}"}],"version":1,"input":"[3,9,20,null,null,15,7]","stdout":"true\n","values":[{"type":"i32","data":{"kind":"scalar","text":"9"}},{"type":"core::option::Option<alloc::boxed::Box<trace