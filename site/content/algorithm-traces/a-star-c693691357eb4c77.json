{"key":"a-star-c693691357eb4c77","sourceHash":"c693691357eb4c7722e48fdb189d2abe08b882747e0ebf0e162e3030e11e4178","pattern":"a-star","category":"weighted-graphs","title":"Challenge: A* Search","idea":"Prioritize distance-so-far plus an admissible estimate that never overstates remaining cost.","complexity":"O((V+E) log V) on this finite four-neighbor grid with consistent heuristic","source":"fn grid_a_star(\n    rows: usize,\n    cols: usize,\n    start: (usize, usize),\n    goal: (usize, usize),\n    walls: &[(usize, usize)],\n) -> Option<usize> {\n    let heuristic = |(r, c): (usize, usize)| r.abs_diff(goal.0) + c.abs_diff(goal.1);\n    let mut distance = vec![vec![usize::MAX; cols]; rows];\n    distance[start.0][start.1] = 0;\n    let mut heap =\n        std::collections::BinaryHeap::from([std::cmp::Reverse((heuristic(start), 0, start))]);\n    while let Some(std::cmp::Reverse((_, cost, (r, c)))) = heap.pop() {\n        if cost != distance[r][c] {\n            continue;\n        }\n        if (r, c) == goal {\n            return Some(cost);\n        }\n        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {\n            let (nr, nc) = (r as isize + dr, c as isize + dc);\n            if nr < 0 || nc < 0 || nr >= rows as isize || nc >= cols as isize {\n                continue;\n            }\n            let next = (nr as usize, nc as usize);\n            if walls.contains(&next) {\n                continue;\n            }\n            if cost + 1 < distance[next.0][next.1] {\n                distance[next.0][next.1] = cost + 1;\n                heap.push(std::cmp::Reverse((\n                    cost + 1 + heuristic(next),\n                    cost + 1,\n                    next,\n                )));\n            }\n        }\n    }\n    None\n}\n\nfn main() {\n    let result = grid_a_star(4, 4, (0, 0), (1, 1), &[]).map_or(\"-1\".to_string(), |d| d.to_string());\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"grid_a_star","statement":"let he