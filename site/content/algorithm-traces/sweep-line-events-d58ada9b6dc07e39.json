{"key":"sweep-line-events-d58ada9b6dc07e39","sourceHash":"d58ada9b6dc07e397bf1937197b13e2926679e8a2b42f432b278c5f15ae4b9ec","pattern":"sweep-line-events","category":"greedy-intervals","title":"Challenge: Sweep-Line Events","idea":"Sort starts and ends as signed events and integrate active state across coordinates.","complexity":"O(n log n) time · O(n) events","source":"fn maximum_sessions(intervals: &[(i32, i32)]) -> i32 {\n    let mut events = Vec::new();\n    for &(start, end) in intervals {\n        assert!(start < end);\n        events.push((start, 1));\n        events.push((end, -1));\n    }\n    events.sort_unstable(); // -1 precedes +1: half-open intervals\n    let (mut active, mut peak) = (0, 0);\n    for (_, delta) in events {\n        active += delta;\n        peak = peak.max(active);\n    }\n    peak\n}\n\nfn main() {\n    let result = maximum_sessions(&[(1, 2), (2, 3)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"maximum_sessions","statement":"let mut events = Vec::new();"},{"line":3,"function":"maximum_sessions","statement":"for &(start, end) in intervals {"},{"line":4,"function":"maximum_sessions","statement":"assert!(start < end);"},{"line":5,"function":"maximum_sessions","statement":"events.push((start, 1));"},{"line":6,"function":"maximum_sessions","statement":"events.push((end, -1));"},{"line":7,"function":"maximum_sessions","statement":"}"},{"line":8,"function":"maximum_sessions","statement":"events.sort_unstable();"},{"line":9,"function":"maximum_sessions","statement":"let (mut active, mut peak) = (0, 0);"},{"line":10,"function":"maximum_sessions","statement":"for (_, delta) in events {"},{"line":11,"function":"maximum_sessions","statement":"active += delta;"},{"line":12,"function":"maximum_sessions","statement":"peak = peak.max(active);"},{"line":13,"function":"maximum_sessions","statement":"}"},{"line":14,"function":"maximum_sessions","statement":"peak"},{"line":18,"function":"main","statement":"let result = m