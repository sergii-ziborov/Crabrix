{"key":"stable-compaction-e9a4b055a7ae8ae4","sourceHash":"e9a4b055a7ae8ae4cabef0c484d092a797da6a896167f078254134fd07beac0b","pattern":"stable-compaction","category":"scans","title":"Stable Compaction: Mental Model","idea":"Write kept elements forward so their relative order survives removal.","complexity":"O(n) time · O(1) extra space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn compact_nonzero(values: &mut Vec<i32>) {\n    let mut write = 0;\n    for read in 0..values.len() {\n        if values[read] != 0 {\n            values[write] = values[read];\n            write += 1;\n        }\n    }\n    values.truncate(write);\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![0, 4, 0, 2, 7, 0];\n        compact_nonzero(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"compact_nonzero","statement":"let mut write = 0;"},{"line":9,"function":"compact_nonzero","statement":"for read in 0..values.len() {"},{"line":10,"function":"compact_nonzero","statement":"if values[read] != 0 {"},{"line":11,"function":"compact_nonzero","statement":"values[write] = values[read];"},{"line":12,"function":"compact_nonzero","statement":"write += 1;"},{"line":13,"function":"compact_nonzero","statement":"}"},{"line":15,"function":"compact_nonzero","statement":"values.truncate(write);"},{"line":16,"function":"compact_nonzero","statement":"}"},{"line":19,"function":"main","statement":"let result = {"},{"line":20,"function":"main","statement":"let mut values = vec![0, 4, 0, 2, 7, 0];"},{"line":21,"function":"main","statement":"compact_nonzero(&mut values);"},{"line":22,"function":"main","statement":"csv(values)"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"[0, 4, 0, 2, 7, 0]","stdout":"4