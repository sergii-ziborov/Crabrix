{"key":"bellman-ford-5a6cf766d6f56e01","sourceHash":"5a6cf766d6f56e017f01c85d7ad24bd1bea9b96ecf35d2e7b223c38cb67b2f58","pattern":"bellman-ford","category":"weighted-graphs","title":"Challenge: Bellman–Ford","idea":"Relax every edge V-1 times; an improvement on the next pass proves a reachable negative cycle.","complexity":"O(VE) time · O(V) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn bellman_ford(n: usize, edges: &[(usize, usize, i64)], start: usize) -> Vec<i64> {\n    let mut distance = vec![i64::MAX; n];\n    distance[start] = 0;\n    for _ in 1..n {\n        let mut changed = false;\n        for &(a, b, w) in edges {\n            if distance[a] != i64::MAX && distance[a] + w < distance[b] {\n                distance[b] = distance[a] + w;\n                changed = true;\n            }\n        }\n        if !changed {\n            break;\n        }\n    }\n    for &(a, b, w) in edges {\n        assert!(\n            distance[a] == i64::MAX || distance[a] + w >= distance[b],\n            \"negative cycle\"\n        );\n    }\n    distance\n        .into_iter()\n        .map(|d| if d == i64::MAX { -1 } else { d })\n        .collect()\n}\n\nfn main() {\n    let result = csv(bellman_ford(3, &[(0, 1, 2), (1, 2, 3)], 0));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"bellman_ford","statement":"let mut distance = vec![i64::MAX; n];"},{"line":9,"function":"bellman_ford","statement":"distance[start] = 0;"},{"line":10,"function":"bellman_ford","statement":"for _ in 1..n {"},{"line":11,"function":"bellman_ford","statement":"let mut changed = false;"},{"line":12,"function":"bellman_ford","statement":"for &(a, b, w) in edges {"},{"line":13,"function":"bellman_ford","statement":"if distance[a] != i64::MAX && distance[a] + w < distance[b] {"},{"line":14,"function":"bellman_ford","statement":"distance[b] = distance[a] + w;"},{"line":15,"function":"bellman_ford","statement":"changed = true;"},{"line":16,"function":"bellman_ford","statement":"}"},{"line":18,"function":"bellman_ford","statement":"if !changed {"},{"line":19,"function":"bellman_ford","statement":"break;"},{"line":22,"function":"bellman_ford","statement":"for &(a, b, w) in edges {"},{"line":23,"function":"bellman_ford","statement":"assert!("},{"line":27,"function":"bellman_ford","statement":"}"},{"line":28,"function":"bellman_ford","statement":"distance"},{"line":30,"function":"closure · line 30","statement":"if d == i64::MAX { -1 } else { d }"},{"line":35,"function":"main","statement":"let result = csv(bellman_ford(3, &[(0, 1, 2), (1, 2, 3)], 0));"},{"line":36,"function":"main","statement":"println!(\"{result}\");"},{"line":37,"function":"main","statement":"}"}],"version":1,"input":"edges=0->1:2,1->2:3","stdout":"0,2,5\n","values":[{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"&[(usize, usize, i64)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":true}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"9223372036854775807"},{"kind":"scalar","text":"9223372036854775807"},{"kind":"scalar","text":"9223372036854775807"}],"tuple":false}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"9223372036854775807"},{"kind":"scalar","text":"9223372036854775807"}],"tuple":false}},{"type":"bool","data":{"kind":"scalar","text":"false"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i64","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"s