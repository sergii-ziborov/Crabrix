{"key":"exponential-search-09d9f553a0900ee3","sourceHash":"09d9f553a0900ee31bd2a37f94a8d63687ae3aaa0b27caf985fb3a6894974fdc","pattern":"exponential-search","category":"binary-search","title":"Exponential Search: Mental Model","idea":"Double the search boundary until it brackets the target, then binary-search that finite range.","complexity":"O(log position) probes · O(1) space","source":"fn exponential_index(a: &[i32], target: i32) -> i32 {\n    if a.first() == Some(&target) {\n        return 0;\n    }\n    let mut bound = 1;\n    while bound < a.len() && a[bound] < target {\n        bound = bound.saturating_mul(2);\n    }\n    let (mut lo, mut hi) = (bound / 2, a.len().min(bound.saturating_add(1)));\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    if a.get(lo) == Some(&target) {\n        lo as i32\n    } else {\n        -1\n    }\n}\n\nfn main() {\n    let result = exponential_index(&[1, 3, 5, 7, 9, 12, 15, 18, 21, 24], 21).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"exponential_index","statement":"if a.first() == Some(&target) {"},{"line":3,"function":"exponential_index","statement":"return 0;"},{"line":5,"function":"exponential_index","statement":"let mut bound = 1;"},{"line":6,"function":"exponential_index","statement":"while bound < a.len() && a[bound] < target {"},{"line":7,"function":"exponential_index","statement":"bound = bound.saturating_mul(2);"},{"line":8,"function":"exponential_index","statement":"}"},{"line":9,"function":"exponential_index","statement":"let (mut lo, mut hi) = (bound / 2, a.len().min(bound.saturating_add(1)));"},{"line":10,"function":"exponential_index","statement":"while lo < hi {"},{"line":11,"function":"exponential_index","statement":"let mid = lo + (hi - lo) / 2;"},{"line":12,"function":"exponential_index","statement":"if a[mid] < target {"},{"line":13,"function":"exponential_index","statement":"lo = mid + 1;"},{"line":14,"function":"exponential_index","statement":"}"},{"line":15,"function":"exponential_index","statement":"hi = mid;"},{"line":16,"function":"exponential_index","statement":"}"},{"line":18,"function":"exponential_index","statement":"if a.get(lo) == Some(&target) {"},{"line":19,"function":"exponential_index","statement":"lo as i32"},{"line":21,"function":"exponential_index","statement":"-1"},{"line":26,"function":"main","statement":"let result = exponential_index(&[1, 3, 5, 7, 9, 12, 15, 18, 21, 24], 21).to_string();"},{"line":27,"function":"main","statement":"println!(\"{result}\");"},{"line":28,"function":"main","statement":"}"}],"version":1,"input":"[1,3,5,7,9,12,15,18,21,24]","stdout":"8\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"9"},{"kind":"scalar","text":"12"},{"kind":"scalar","text":"15"},{"kind":"scalar","text":"18"},{"kind":"scalar","text":"21"},{"kind":"scalar","text":"24"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"21"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"8"}},{"type":"usize","data":{"kind":"scalar","text":"9"}},{"type":"usize","data":{"kind":"scalar","text":"6"}},{"type":"usize","data":{"kind":"scalar","text":"7"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"8\""}}],"frames":[{"site":17,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["exponential_index",2]],"locals":[["a",0],["target",1]]},{"site":2,"stack":[["main",1],["exponential_index",2]],"locals":[["a",0],["target",1]]},{"site":3,"stack":[["main",1],["exponential_index",2]],"locals":[["a",0],["target",1],["bound",2]]},{"site":4,"stack":[["main",1],["exponential_inde