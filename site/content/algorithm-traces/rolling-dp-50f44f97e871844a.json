{"key":"rolling-dp-50f44f97e871844a","sourceHash":"50f44f97e871844a79901d8fc55bb54b1303ec17a1f51eee9c960cd62eedf250","pattern":"rolling-dp","category":"dynamic-1d","title":"Rolling-State DP: Mental Model","idea":"Discard table entries once no future transition can read them.","complexity":"O(n) time · O(1) space","source":"fn stair_cost(cost: &[i32]) -> i32 {\n    let (mut two_back, mut one_back) = (0, 0);\n    for &price in cost {\n        let current = price + two_back.min(one_back);\n        two_back = one_back;\n        one_back = current;\n    }\n    two_back.min(one_back)\n}\n\nfn main() {\n    let result = stair_cost(&[10, 15, 20]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"stair_cost","statement":"let (mut two_back, mut one_back) = (0, 0);"},{"line":3,"function":"stair_cost","statement":"for &price in cost {"},{"line":4,"function":"stair_cost","statement":"let current = price + two_back.min(one_back);"},{"line":5,"function":"stair_cost","statement":"two_back = one_back;"},{"line":6,"function":"stair_cost","statement":"one_back = current;"},{"line":7,"function":"stair_cost","statement":"}"},{"line":8,"function":"stair_cost","statement":"two_back.min(one_back)"},{"line":12,"function":"main","statement":"let result = stair_cost(&[10, 15, 20]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"cost=[10,15,20]","stdout":"15\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"10"},{"kind":"scalar","text":"15"},{"kind":"scalar","text":"20"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"10"}},{"type":"i32","data":{"kind":"scalar","text":"15"}},{"type":"i32","data":{"kind":"scalar","text":"20"}},{"type":"i32","data":{"kind":"scalar","text":"30"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"15\""}}],"frames":[{"s