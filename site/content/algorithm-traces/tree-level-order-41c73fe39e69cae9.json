{"key":"tree-level-order-41c73fe39e69cae9","sourceHash":"41c73fe39e69cae9ae79d0691d88d65c9dbc9ccf366eda3f079c1ad65fc92ec4","pattern":"tree-level-order","category":"trees","title":"Challenge: Level-Order BFS","idea":"Queue nodes and process exactly the current queue length to preserve level boundaries.","complexity":"O(n) time · O(w) queue","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn level_sums(root: &Tree) -> Vec<i32> {\n    let mut queue = std::collections::VecDeque::new();\n    let mut out = Vec::new();\n    if let Some(n) = root {\n        queue.push_back(n.as_ref());\n    }\n    while !queue.is_empty() {\n        let mut sum = 0;\n        for _ in 0..queue.len() {\n            let n = queue.pop_front().unwrap();\n            sum += n.value;\n            if let Some(left) = &n.left {\n                queue.push_back(left);\n            }\n            if let Some(right) = &n.right {\n                queue.push_back(right);\n            }\n        }\n        out.push(sum);\n    }\n    out\n}\n\nfn main() {\n    let result = csv(level_sums(&node(\n        2,\n        node(3, None, None),\n        node(4, None, None),\n    )));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":17,"function":"level_sums","statement":"let mut queue = std::collections::VecDeque::new();"},{"line":18,"function":"level_sums","statement":"let mut out = Vec::new();"},{"line":19,"function":"level_sums","statement":"if let Some(n) = root {"},{"line":20,"function":"level_sums","statement":"queue.push_back(n.as_ref());"},{"line":21,"function":"level_sums","statement":"}"},{"line":22,"function":"level_sums","statement":"while !queue.is_empty() {"},{"line":23,"function":"level_sums","statement":"let mut sum = 0;"},{"line":24,"function":"level_sums","statement":"for _ in 0..queue.len() {"},{"line":25,"function":"level_sums","statement":"let n = queue.pop_front().unwrap();"},{"line":26,"function":"level_sums","statement":"sum += n.value;"},{"line":27,"function":"level_sums","statement":"if let Some(left) = &n.left {"},{"line":28,"function":"level_sums","statement":"queue.push_back(left);"},{"line":29,"function":"level_sums","statement":"}"},{"line":30,"function":"level_sums","statement":"if let Some(right) = &n.right {"},{"line":31,"function":"level_sums","statement":"queue.push_back(right);"},{"line":32,"function":"level_sums","statement":"}"},{"line":34,"function":"level_sums","statement":"out.push(sum);"},{"line":35,"function":"level_sums","statement":"}"},{"line":36,"function":"level_sums","statement":"out"},{"line":40,"function":"main","statement":"let result = csv(level_sums(&node("},{"line":45,"function":"main","statement":"println!(\"{result}\");"},{"line":46,"function":"main","statement":"}"}],"version":1,"input":"[2,3,4]","stdout":"2,7\n","values":[{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"3"}]]}}],"tuple":true}}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","valu