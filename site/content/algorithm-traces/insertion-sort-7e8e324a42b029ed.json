{"key":"insertion-sort-7e8e324a42b029ed","sourceHash":"7e8e324a42b029edecb6c61625db251b559e00419f8c636185831b10e06663c8","pattern":"insertion-sort","category":"sorting-selection","title":"Insertion Sort: Mental Model","idea":"Grow a sorted prefix by shifting each new item to its insertion position.","complexity":"O(n^2) worst · O(n) best · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn insertion_sort(values: &mut [i32]) {\n    for i in 1..values.len() {\n        let value = values[i];\n        let mut j = i;\n        while j > 0 && values[j - 1] > value {\n            values[j] = values[j - 1];\n            j -= 1;\n        }\n        values[j] = value;\n    }\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![5, 2, 4, 6, 1, 3];\n        insertion_sort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"insertion_sort","statement":"for i in 1..values.len() {"},{"line":9,"function":"insertion_sort","statement":"let value = values[i];"},{"line":10,"function":"insertion_sort","statement":"let mut j = i;"},{"line":11,"function":"insertion_sort","statement":"while j > 0 && values[j - 1] > value {"},{"line":12,"function":"insertion_sort","statement":"values[j] = values[j - 1];"},{"line":13,"function":"insertion_sort","statement":"j -= 1;"},{"line":14,"function":"insertion_sort","statement":"}"},{"line":15,"function":"insertion_sort","statement":"values[j] = value;"},{"line":16,"function":"insertion_sort","statement":"}"},{"line":20,"function":"main","statement":"let result = {"},{"line":21,"function":"main","statement":"let mut values = vec![5, 2, 4, 6, 1, 3];"},{"line":22,"function":"main","statement":"insertion_sort(&mut values);"},{"line":23,"function":"main","statement":"csv(values)"},{"line":25,"function":"main","statement":"println!(\"{