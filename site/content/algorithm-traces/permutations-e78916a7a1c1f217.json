{"key":"permutations-e78916a7a1c1f217","sourceHash":"e78916a7a1c1f217ae576af29bf9cb397ce92836cdb1878f59a3f4e2ef835c08","pattern":"permutations","category":"backtracking","title":"Challenge: Permutation Backtracking","idea":"Choose one unused item for the next position, recurse, then mark it unused again.","complexity":"O(n*n!) time · O(n) state excluding output","source":"fn permutations(values: &[i32]) -> Vec<Vec<i32>> {\n    fn choose(values: &[i32], used: &mut [bool], path: &mut Vec<i32>, out: &mut Vec<Vec<i32>>) {\n        if path.len() == values.len() {\n            out.push(path.clone());\n            return;\n        }\n        for i in 0..values.len() {\n            if !used[i] {\n                used[i] = true;\n                path.push(values[i]);\n                choose(values, used, path, out);\n                path.pop();\n                used[i] = false;\n            }\n        }\n    }\n    let mut out = Vec::new();\n    choose(\n        values,\n        &mut vec![false; values.len()],\n        &mut Vec::new(),\n        &mut out,\n    );\n    out\n}\nfn permutation_count(values: &[i32]) -> usize {\n    permutations(values).len()\n}\n\nfn main() {\n    let result = permutation_count(&[1, 2, 3]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":17,"function":"permutations","statement":"let mut out = Vec::new();"},{"line":18,"function":"permutations","statement":"choose("},{"line":24,"function":"permutations","statement":"out"},{"line":3,"function":"choose","statement":"if path.len() == values.len() {"},{"line":4,"function":"choose","statement":"out.push(path.clone());"},{"line":5,"function":"choose","statement":"return;"},{"line":7,"function":"choose","statement":"for i in 0..values.len() {"},{"line":8,"function":"choose","statement":"if !used[i] {"},{"line":9,"function":"choose","statement":"used[i] = true;"},{"line":10,"function":"choose","statement":"path.push(values[i]);"},{"line":11,"function":"choose","statement":"choose(values, used, path, out);"},{"line":12,"function":"choose","statement":"path.pop();"},{"line":13,"function":"choose","statement":"used[i] = false;"},{"line":14,"function":"choose","statement":"}"},{"line":27,"function":"permutation_count","statement":"permutations(values).len()"},{"line":31,"function":"main","statement":"let result = permutation_count(&[1, 2, 3]).to_string();"},{"line":32,"function":"main","statement":"println!(\"{result}\");"},{"line":33,"function":"main","statement":"}"}],"version":1,"input":"[1,2,3]","stdout":"6\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&mut [bool]","data":{"kind":"list","items":[{"kind":"scalar","text":"false"},{"kind":"scalar","text":"false"},{"kind":"scalar","text":"false"}],"tuple":false}},{"type":"&mut alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&mut alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"&mut [bool]","data":{"kind":"list","items":[{"kind":"scalar","text":"true"},{"kind":"scalar","text":"false"},{"kind":"scalar","text":"false"}],"tuple":false}},{"type":"&mut alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&mut [bool]","data":{"kind":"list","items":[{"kind":"scalar","text":"true"},{"kind":"scalar","text":"true"},{"kind":"scalar","text":"false"}],"tuple":false}},{"type":"&mut alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"&mut [bool]","data":{"kind":"list","items":[{"kind":"scalar","text":"true"},{"kind":"scalar","te