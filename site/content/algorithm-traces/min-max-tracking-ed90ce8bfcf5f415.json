{"key":"min-max-tracking-ed90ce8bfcf5f415","sourceHash":"ed90ce8bfcf5f415dd204d87ac79860fc2f691fffa3e395c194ebb33e1698351","pattern":"min-max-tracking","category":"scans","title":"Challenge: Min/Max Tracking","idea":"Carry the best value seen so far and update it from each element.","complexity":"O(n) time · O(1) extra space","source":"fn spread(values: &[i32]) -> i32 {\n    assert!(!values.is_empty());\n    let (mut low, mut high) = (values[0], values[0]);\n    for &x in &values[1..] {\n        low = low.min(x);\n        high = high.max(x);\n    }\n    high - low\n}\n\nfn main() {\n    let result = spread(&[5, 5]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"spread","statement":"assert!(!values.is_empty());"},{"line":3,"function":"spread","statement":"let (mut low, mut high) = (values[0], values[0]);"},{"line":4,"function":"spread","statement":"for &x in &values[1..] {"},{"line":5,"function":"spread","statement":"low = low.min(x);"},{"line":6,"function":"spread","statement":"high = high.max(x);"},{"line":7,"function":"spread","statement":"}"},{"line":8,"function":"spread","statement":"high - low"},{"line":12,"function":"main","statement":"let result = spread(&[5, 5]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[5, 5]","stdout":"0\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0\""}}],"frames":[{"site":7,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["spread",2]],"locals":[["values",0]]},{"site":1,"stack":[["main",1],["spread",2]],"locals":[["values",0]]},{"site":2,"stack":[["main",1],["spread",2]],"locals":[["values",0],["low",1],["high",1]]},{"site":3,"stack":[["main",1],["spread",2]],"locals":[["values",0