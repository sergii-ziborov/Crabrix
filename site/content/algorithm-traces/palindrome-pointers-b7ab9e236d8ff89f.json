{"key":"palindrome-pointers-b7ab9e236d8ff89f","sourceHash":"b7ab9e236d8ff89f17a4952ba5c3a8c009227ac9de5051364491ff6242045ddc","pattern":"palindrome-pointers","category":"two-pointers","title":"Palindrome Pointers: Mental Model","idea":"Compare normalized symbols from the outside inward and skip irrelevant input.","complexity":"O(n) time · O(1) space","source":"fn ascii_palindrome(text: &str) -> bool {\n    assert!(text.is_ascii());\n    let bytes = text.as_bytes();\n    let (mut left, mut right) = (0, bytes.len());\n    while left < right {\n        if !bytes[left].is_ascii_alphanumeric() {\n            left += 1;\n            continue;\n        }\n        if !bytes[right - 1].is_ascii_alphanumeric() {\n            right -= 1;\n            continue;\n        }\n        if !bytes[left].eq_ignore_ascii_case(&bytes[right - 1]) {\n            return false;\n        }\n        left += 1;\n        right -= 1;\n    }\n    true\n}\n\nfn main() {\n    let result = ascii_palindrome(\"Never odd or even\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"ascii_palindrome","statement":"assert!(text.is_ascii());"},{"line":3,"function":"ascii_palindrome","statement":"let bytes = text.as_bytes();"},{"line":4,"function":"ascii_palindrome","statement":"let (mut left, mut right) = (0, bytes.len());"},{"line":5,"function":"ascii_palindrome","statement":"while left < right {"},{"line":6,"function":"ascii_palindrome","statement":"if !bytes[left].is_ascii_alphanumeric() {"},{"line":7,"function":"ascii_palindrome","statement":"left += 1;"},{"line":8,"function":"ascii_palindrome","statement":"continue;"},{"line":10,"function":"ascii_palindrome","statement":"if !bytes[right - 1].is_ascii_alphanumeric() {"},{"line":11,"function":"ascii_palindrome","statement":"right -= 1;"},{"line":12,"function":"ascii_palindrome","statement":"continue;"},{"line":14,"function":"ascii_palindrome","statement":"if !bytes[left].eq_ignore_ascii_case(&bytes[right - 1]) {"},{"line":15,"