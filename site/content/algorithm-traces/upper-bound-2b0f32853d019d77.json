{"key":"upper-bound-2b0f32853d019d77","sourceHash":"2b0f32853d019d7721655a11fbc49e4382d1c47d865a54b2eb5fce4b11b4a428","pattern":"upper-bound","category":"binary-search","title":"Challenge: Upper Bound","idea":"Maintain the first position whose value is strictly greater than target.","complexity":"O(log n) time · O(1) space","source":"fn upper_bound(a: &[i32], target: i32) -> usize {\n    let (mut lo, mut hi) = (0, a.len());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] <= target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    lo\n}\n\nfn main() {\n    let result = upper_bound(&[1, 4, 4], 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"upper_bound","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":3,"function":"upper_bound","statement":"while lo < hi {"},{"line":4,"function":"upper_bound","statement":"let mid = lo + (hi - lo) / 2;"},{"line":5,"function":"upper_bound","statement":"if a[mid] <= target {"},{"line":6,"function":"upper_bound","statement":"lo = mid + 1;"},{"line":7,"function":"upper_bound","statement":"}"},{"line":8,"function":"upper_bound","statement":"hi = mid;"},{"line":9,"function":"upper_bound","statement":"}"},{"line":11,"function":"upper_bound","statement":"lo"},{"line":15,"function":"main","statement":"let result = upper_bound(&[1, 4, 4], 4).to_string();"},{"line":16,"function":"main","statement":"println!(\"{result}\");"},{"line":17,"function":"main","statement":"}"}],"version":1,"input":"[1,4,4]","stdout":"3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}