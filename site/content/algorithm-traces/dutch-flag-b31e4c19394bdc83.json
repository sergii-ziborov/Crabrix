{"key":"dutch-flag-b31e4c19394bdc83","sourceHash":"b31e4c19394bdc8385c224271e6659a570f6d8f022f924aa9d36be368e7e189e","pattern":"dutch-flag","category":"two-pointers","title":"Dutch National Flag: Mental Model","idea":"Maintain less-than, unknown, and greater-than regions with three boundaries.","complexity":"O(n) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn sort_three(values: &mut [i32]) {\n    let (mut low, mut scan, mut high) = (0, 0, values.len());\n    while scan < high {\n        match values[scan] {\n            0 => {\n                values.swap(low, scan);\n                low += 1;\n                scan += 1;\n            }\n            1 => scan += 1,\n            2 => {\n                high -= 1;\n                values.swap(scan, high);\n            }\n            _ => panic!(\"only 0, 1 and 2 are allowed\"),\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![2, 0, 2, 1, 1, 0];\n        sort_three(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"sort_three","statement":"let (mut low, mut scan, mut high) = (0, 0, values.len());"},{"line":9,"function":"sort_three","statement":"while scan < high {"},{"line":10,"function":"sort_three","statement":"match values[scan] {"},{"line":12,"function":"sort_three","statement":"values.swap(low, scan);"},{"line":13,"function":"sort_three","statement":"low += 1;"},{"line":14,"function":"sort_three","statement":"scan += 1;"},{"line":15,"function":"sort_three","statement":"}"},{"line":18,"function":"sort_three","statement":"high -= 1;"},{"line":19,"function":"sort_three","statement":"values.swap(scan, high);"},{"line":20,"function":"sort_three","statement":"}"},{"line":27,"function":"main","statement":"let result = {"},{"line":28,"function":"main","statement":"l