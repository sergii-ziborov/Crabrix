{"key":"difference-array-0e085dd28ed29f49","sourceHash":"0e085dd28ed29f498b709ece7bb3305a0d687d71655eeb2f23e620c03c53b92d","pattern":"difference-array","category":"ranges","title":"Difference Array: Mental Model","idea":"Mark only where a range update starts and stops, then integrate once.","complexity":"O(n + q) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn apply_updates(n: usize, updates: &[(usize, usize, i64)]) -> Vec<i64> {\n    let mut difference = vec![0; n + 1];\n    for &(left, right, delta) in updates {\n        difference[left] += delta;\n        difference[right + 1] -= delta;\n    }\n    let mut current = 0;\n    difference[..n]\n        .iter()\n        .map(|&d| {\n            current += d;\n            current\n        })\n        .collect()\n}\n\nfn main() {\n    let result = csv(apply_updates(5, &[(1, 3, 3), (2, 4, 2)]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"apply_updates","statement":"let mut difference = vec![0; n + 1];"},{"line":9,"function":"apply_updates","statement":"for &(left, right, delta) in updates {"},{"line":10,"function":"apply_updates","statement":"difference[left] += delta;"},{"line":11,"function":"apply_updates","statement":"difference[right + 1] -= delta;"},{"line":12,"function":"apply_updates","statement":"}"},{"line":13,"function":"apply_updates","statement":"let mut current = 0;"},{"line":14,"function":"apply_updates","statement":"difference[..n]"},{"line":17,"function":"closure · line 16","statement":"current += d;"},{"line":18,"function":"closure · line 16","statement":"current"},{"line":24,"function":"main","statement":"let result = csv(apply_updates(5, &[(1, 3, 3), (2, 4, 2)]));"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"n=5 updates=(1,3,3),(2,4,2)","stdout":"0,3,5,5,2\n","values":[{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"&[(usize, usize, i64)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"3"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"2"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i64","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-3"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i64","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-3"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-3"},{"kind":"scalar","text":"-2"}],"tu