{"key":"binary-search-answer-ff7a6a341c93188f","sourceHash":"ff7a6a341c93188fc65b9f8026ef24d77134bfd10112a91c2698682ad41fc7c2","pattern":"binary-search-answer","category":"binary-search","title":"Challenge: Binary Search on the Answer","idea":"Search a numeric answer space whose feasibility predicate changes only once.","complexity":"O(log range * predicate) time","source":"fn shipping_capacity(weights: &[i32], days: usize) -> i32 {\n    assert!(!weights.is_empty() && days > 0);\n    let (mut lo, mut hi) = (*weights.iter().max().unwrap(), weights.iter().sum());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        let (mut used, mut load) = (1, 0);\n        for &x in weights {\n            if load + x > mid {\n                used += 1;\n                load = 0;\n            }\n            load += x;\n        }\n        if used <= days {\n            hi = mid;\n        } else {\n            lo = mid + 1;\n        }\n    }\n    lo\n}\n\nfn main() {\n    let result = shipping_capacity(&[1, 2, 3], 3).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"shipping_capacity","statement":"assert!(!weights.is_empty() && days > 0);"},{"line":3,"function":"shipping_capacity","statement":"let (mut lo, mut hi) = (*weights.iter().max().unwrap(), weights.iter().sum());"},{"line":4,"function":"shipping_capacity","statement":"while lo < hi {"},{"line":5,"function":"shipping_capacity","statement":"let mid = lo + (hi - lo) / 2;"},{"line":6,"function":"shipping_capacity","statement":"let (mut used, mut load) = (1, 0);"},{"line":7,"function":"shipping_capacity","statement":"for &x in weights {"},{"line":8,"function":"shipping_capacity","statement":"if load + x > mid {"},{"line":9,"function":"shipping_capacity","statement":"used += 1;"},{"line":10,"function":"shipping_capacity","statement":"load = 0;"},{"line":11,"function":"shipping_capacity","statement":"}"},{"line":12,"function":"shipping_capacity","statement":"load += x;"},{"line":13,"function":"shipping_capacity","statement":"}"},{"line":14,"function":"shipping_capacity","statement":"if used <= days {"},{"line":15,"function":"shipping_capacity","statement":"hi = mid;"},{"line":16,"function":"shipping_capacity","statement":"}"},{"line":17,"function":"shipping_capacity","statement":"lo = mid + 1;"},{"line":18,"function":"shipping_capacity","statement":"}"},{"line":20,"function":"shipping_capacity","statement":"lo"},{"line":24,"function":"main","statement":"let result = shipping_capacity(&[1, 2, 3], 3).to_string();"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"weights=[1,2,3] days=3","stdout":"3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"3\""}}],"frames":[{"site":18,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["shipping_capacity",2]],"locals":[["weights",0],["days",1]]},{"site":1,"stack":[["main",1],["shipping_capacity",2]],"locals":[["weights",0],["days",1]]},{"site":2,"stack":[["main",1],["shipping_capacity",2]],"locals":[["weights",0],["days",1],["lo",2],["hi",3]]},{"site":3,"stack":[["main",1],["shipping_capacity",2]],"locals":[["weights",0],["days",1],["lo",2],["hi",3]]},{"site":4,"stack":[["main",1],["shipping_capacity",2]],"locals":[["weights",0],["days",1],["lo",2],["hi",3],["mid",4]]},{"site":5,"