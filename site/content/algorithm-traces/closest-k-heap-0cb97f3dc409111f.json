{"key":"closest-k-heap-0cb97f3dc409111f","sourceHash":"0cb97f3dc409111f05900b82f4ead388039b8308c3c1b7362b2d967d99db98bd","pattern":"closest-k-heap","category":"heaps-streaming","title":"Bounded Heap for K Closest: Mental Model","idea":"Keep the worst current winner at the root so a better candidate replaces it.","complexity":"O(n log k) time · O(k) space","source":"fn closest(points: &[(i32, i32)], k: usize) -> Vec<(i32, i32)> {\n    let mut heap = std::collections::BinaryHeap::new();\n    for &(x, y) in points {\n        let distance = i64::from(x) * i64::from(x) + i64::from(y) * i64::from(y);\n        heap.push((distance, x, y));\n        if heap.len() > k {\n            heap.pop();\n        }\n    }\n    let mut selected = heap.into_vec();\n    selected.sort_unstable();\n    selected.into_iter().map(|(_, x, y)| (x, y)).collect()\n}\n\nfn main() {\n    let result = closest(&[(1, 3), (-2, 2), (2, -2), (5, 1)], 2)\n        .iter()\n        .map(|(x, y)| format!(\"{x}:{y}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"closest","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":3,"function":"closest","statement":"for &(x, y) in points {"},{"line":4,"function":"closest","statement":"let distance = i64::from(x) * i64::from(x) + i64::from(y) * i64::from(y);"},{"line":5,"function":"closest","statement":"heap.push((distance, x, y));"},{"line":6,"function":"closest","statement":"if heap.len() > k {"},{"line":7,"function":"closest","statement":"heap.pop();"},{"line":8,"function":"closest","statement":"}"},{"line":10,"function":"closest","statement":"let mut selected = heap.into_vec();"},{"line":11,"function":"closest","statement":"selected.sort_unstable();"},{"line":12,"function":"closest","statement":"selected.into_iter().map(|(_, x, y)| (x, y)).collect()"},{"line":12,"function":"closure · line 12","statement":"(x, y)"},{"line":16,"function":"main","statement":"let result = c