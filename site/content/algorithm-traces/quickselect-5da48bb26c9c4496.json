{"key":"quickselect-5da48bb26c9c4496","sourceHash":"5da48bb26c9c44964779a555a39834b7d5c498a7ad07482397c5926712c26ffe","pattern":"quickselect","category":"sorting-selection","title":"Challenge: Quickselect","idea":"Partition like quicksort but recurse only into the side containing the requested rank.","complexity":"O(n) average / O(n^2) worst time; O(log n) average / O(n) worst recursion stack","source":"fn quickselect(a: &mut [i32], k: usize) -> i32 {\n    assert!(k < a.len());\n    let pivot = a[a.len() / 2];\n    let (mut low, mut i, mut high) = (0, 0, a.len());\n    while i < high {\n        if a[i] < pivot {\n            a.swap(i, low);\n            low += 1;\n            i += 1;\n        } else if a[i] > pivot {\n            high -= 1;\n            a.swap(i, high);\n        } else {\n            i += 1;\n        }\n    }\n    if k < low {\n        quickselect(&mut a[..low], k)\n    } else if k >= high {\n        quickselect(&mut a[high..], k - high)\n    } else {\n        pivot\n    }\n}\n\nfn main() {\n    let result = {\n        let mut a = vec![9, 1, 5];\n        quickselect(&mut a, 2).to_string()\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"quickselect","statement":"assert!(k < a.len());"},{"line":3,"function":"quickselect","statement":"let pivot = a[a.len() / 2];"},{"line":4,"function":"quickselect","statement":"let (mut low, mut i, mut high) = (0, 0, a.len());"},{"line":5,"function":"quickselect","statement":"while i < high {"},{"line":6,"function":"quickselect","statement":"if a[i] < pivot {"},{"line":7,"function":"quickselect","statement":"a.swap(i, low);"},{"line":8,"function":"quickselect","statement":"low += 1;"},{"line":9,"function":"quickselect","statement":"i += 1;"},{"line":10,"function":"quickselect","statement":"}"},{"line":11,"function":"quickselect","statement":"high -= 1;"},{"line":12,"function":"quickselect","statement":"a.swap(i, high);"},{"line":13,"function":"quickselect","statement":"}"},{"line":14,"function":"quickselect","statement":"i += 1;"},{"line":15,"function":"quickselect","statement":"}"},{"line":17,"function":"quickselect","statement":"if k < low {"},{"line":18,"function":"quickselect","statement":"quickselect(&mut a[..low], k)"},{"line":20,"function":"quickselect","statement":"quickselect(&mut a[high..], k - high)"},{"line":22,"function":"quickselect","statement":"pivot"},{"line":27,"function":"main","statement":"let result = {"},{"line":28,"function":"main","statement":"let mut a = vec![9, 1, 5];"},{"line":29,"function":"main","statement":"quickselect(&mut a, 2).to_string()"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"[9,1,5]","stdout":"9\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"9"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"9\""}}],"frames":[{"site":18,"stack":[["main",1]],"locals":[]},{"site":19,"stack":[["main",1]],"l