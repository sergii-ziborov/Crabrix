{"key":"lazy-heap-deletion-8c183776b6f421f8","sourceHash":"8c183776b6f421f8e9678854c4bf6cac03f9a48e3387f6fac4503fde3f0191db","pattern":"lazy-heap-deletion","category":"heaps-streaming","title":"Challenge: Lazy Heap Deletion","idea":"Record invalidated values separately and discard stale roots only when they surface.","complexity":"O(log n) amortised operation · O(n) space","source":"fn valid_min(ops: &[&str]) -> i32 {\n    let mut heap = std::collections::BinaryHeap::new();\n    let mut deleted = std::collections::HashMap::<i32, usize>::new();\n    for op in ops {\n        if let Some(raw) = op.strip_prefix(\"push\") {\n            heap.push(std::cmp::Reverse(raw.parse::<i32>().unwrap()));\n        }\n        if let Some(raw) = op.strip_prefix(\"delete\") {\n            *deleted.entry(raw.parse().unwrap()).or_default() += 1;\n        }\n        while let Some(&std::cmp::Reverse(x)) = heap.peek() {\n            let count = deleted.entry(x).or_default();\n            if *count == 0 {\n                break;\n            }\n            *count -= 1;\n            heap.pop();\n        }\n    }\n    heap.peek().unwrap().0\n}\n\nfn main() {\n    let result = valid_min(&[\"push5\", \"push1\", \"delete1\", \"min\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"valid_min","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":3,"function":"valid_min","statement":"let mut deleted = std::collections::HashMap::<i32, usize>::new();"},{"line":4,"function":"valid_min","statement":"for op in ops {"},{"line":5,"function":"valid_min","statement":"if let Some(raw) = op.strip_prefix(\"push\") {"},{"line":6,"function":"valid_min","statement":"heap.push(std::cmp::Reverse(raw.parse::<i32>().unwrap()));"},{"line":7,"function":"valid_min","statement":"}"},{"line":8,"function":"valid_min","statement":"if let Some(raw) = op.strip_prefix(\"delete\") {"},{"line":9,"function":"valid_min","statement":"*deleted.entry(raw.parse().unwrap()).or_defa