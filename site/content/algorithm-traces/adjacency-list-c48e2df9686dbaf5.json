{"key":"adjacency-list-c48e2df9686dbaf5","sourceHash":"c48e2df9686dbaf52618c5d429a11b866a17d9e332866f85e415108505492b3a","pattern":"adjacency-list","category":"graph-traversal","title":"Adjacency List: Mental Model","idea":"Store only existing neighbors so traversal cost follows vertices plus edges.","complexity":"O(V+E) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn neighbors(n: usize, edges: &[(usize, usize)], query: usize) -> Vec<usize> {\n    let mut graph = vec![Vec::new(); n];\n    for &(a, b) in edges {\n        graph[a].push(b);\n        graph[b].push(a);\n    }\n    graph[query].sort_unstable();\n    graph[query].clone()\n}\n\nfn main() {\n    let result = csv(neighbors(5, &[(0, 2), (1, 2), (2, 4)], 2));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"neighbors","statement":"let mut graph = vec![Vec::new(); n];"},{"line":9,"function":"neighbors","statement":"for &(a, b) in edges {"},{"line":10,"function":"neighbors","statement":"graph[a].push(b);"},{"line":11,"function":"neighbors","statement":"graph[b].push(a);"},{"line":12,"function":"neighbors","statement":"}"},{"line":13,"function":"neighbors","statement":"graph[query].sort_unstable();"},{"line":14,"function":"neighbors","statement":"graph[query].clone()"},{"line":18,"function":"main","statement":"let result = csv(neighbors(5, &[(0, 2), (1, 2), (2, 4)], 2));"},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"}],"version":1,"input":"n=5 edges=(0,2),(1,2),(2,4)","stdout":"0,1,4\n","values":[{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"&[(usize, usize)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"