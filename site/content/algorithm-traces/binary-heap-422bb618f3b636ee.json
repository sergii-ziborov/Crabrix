{"key":"binary-heap-422bb618f3b636ee","sourceHash":"422bb618f3b636ee98dae187bb7858d50557c9abc75aa9deef724360886eb7f7","pattern":"binary-heap","category":"heaps-streaming","title":"Challenge: Binary Heap","idea":"Maintain a complete tree where every parent outranks its children.","complexity":"O(log n) push/pop · O(1) peek · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn heap_order(values: &[i32]) -> Vec<i32> {\n    let mut heap = std::collections::BinaryHeap::new();\n    for &x in values {\n        heap.push(std::cmp::Reverse(x));\n    }\n    let mut out = Vec::new();\n    while let Some(std::cmp::Reverse(x)) = heap.pop() {\n        out.push(x);\n    }\n    out\n}\n\nfn main() {\n    let result = csv(heap_order(&[3, 1]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"heap_order","statement":"let mut heap = std::collections::BinaryHeap::new();"},{"line":9,"function":"heap_order","statement":"for &x in values {"},{"line":10,"function":"heap_order","statement":"heap.push(std::cmp::Reverse(x));"},{"line":11,"function":"heap_order","statement":"}"},{"line":12,"function":"heap_order","statement":"let mut out = Vec::new();"},{"line":13,"function":"heap_order","statement":"while let Some(std::cmp::Reverse(x)) = heap.pop() {"},{"line":14,"function":"heap_order","statement":"out.push(x);"},{"line":15,"function":"heap_order","statement":"}"},{"line":16,"function":"heap_order","statement":"out"},{"line":20,"function":"main","statement":"let result = csv(heap_order(&[3, 1]));"},{"line":21,"function":"main","statement":"println!(\"{result}\");"},{"line":22,"function":"main","statement":"}"}],"version":1,"input":"[3,1]","stdout":"1,3\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"alloc::collections::binary_he