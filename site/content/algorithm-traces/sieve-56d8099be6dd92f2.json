{"key":"sieve-56d8099be6dd92f2","sourceHash":"56d8099be6dd92f2e69d02035b798abb88ec76fe84281879690bb1ad07856bd8","pattern":"sieve","category":"math-bits","title":"Challenge: Sieve of Eratosthenes","idea":"Mark multiples beginning at p squared for each still-prime p.","complexity":"O(n log log n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn primes_to(n: usize) -> Vec<usize> {\n    let mut prime = vec![true; n + 1];\n    prime[0] = false;\n    if n >= 1 {\n        prime[1] = false;\n    }\n    let mut p = 2;\n    while p <= n / p {\n        if prime[p] {\n            for multiple in (p * p..=n).step_by(p) {\n                prime[multiple] = false;\n            }\n        }\n        p += 1;\n    }\n    (2..=n).filter(|&i| prime[i]).collect()\n}\n\nfn main() {\n    let result = csv(primes_to(10));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"primes_to","statement":"let mut prime = vec![true; n + 1];"},{"line":9,"function":"primes_to","statement":"prime[0] = false;"},{"line":10,"function":"primes_to","statement":"if n >= 1 {"},{"line":11,"function":"primes_to","statement":"prime[1] = false;"},{"line":12,"function":"primes_to","statement":"}"},{"line":13,"function":"primes_to","statement":"let mut p = 2;"},{"line":14,"function":"primes_to","statement":"while p <= n / p {"},{"line":15,"function":"primes_to","statement":"if prime[p] {"},{"line":16,"function":"primes_to","statement":"for multiple in (p * p..=n).step_by(p) {"},{"line":17,"function":"primes_to","statement":"prime[multiple] = false;"},{"line":18,"function":"primes_to","statement":"}"},{"line":20,"function":"primes_to","statement":"p += 1;"},{"line":21,"function":"primes_to","statement":"}"},{"line":22,"function":"primes_to","statement":"(2..=n).filter(|&i| prime[i]).collect()"},{"line":22,"function":"closure · line 22","state