{"key":"tree-inorder-669e521939e4d614","sourceHash":"669e521939e4d614ba55abbc2bfb36d4325711dc1ac571f0d93ea4a2efe81de9","pattern":"tree-inorder","category":"trees","title":"Challenge: Inorder DFS","idea":"Visit left, node, then right; in a BST this emits sorted keys.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn inorder(root: &Tree) -> Vec<i32> {\n    fn visit(root: &Tree, out: &mut Vec<i32>) {\n        if let Some(n) = root {\n            visit(&n.left, out);\n            out.push(n.value);\n            visit(&n.right, out);\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(inorder(&node(2, node(1, None, None), node(3, None, None))));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":24,"function":"inorder","statement":"let mut out = Vec::new();"},{"line":25,"function":"inorder","statement":"visit(root, &mut out);"},{"line":26,"function":"inorder","statement":"out"},{"line":18,"function":"visit","statement":"if let Some(n) = root {"},{"line":19,"function":"visit","statement":"visit(&n.left, out);"},{"line":20,"function":"visit","statement":"out.push(n.value);"},{"line":21,"function":"visit","statement":"visit(&n.right, out);"},{"line":22,"function":"visit","statement":"}"},{"line":30,"function":"main","statement":"let result = csv(inorder(&node(2, node(1, None, None), node(3, None, None))));"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version