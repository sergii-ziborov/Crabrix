{"key":"meeting-rooms-heap-cbe32b70546d595d","sourceHash":"cbe32b70546d595dd3c4055e6bb47c45835ae3f3dd66519452bd8501612c3059","pattern":"meeting-rooms-heap","category":"heaps-streaming","title":"Meeting Rooms Heap: Mental Model","idea":"Sort by start time and reuse the room whose end time is smallest.","complexity":"O(n log n) time · O(n) space","source":"fn rooms(intervals: &[(i32, i32)]) -> usize {\n    let mut sorted = intervals.to_vec();\n    sorted.sort_unstable();\n    let mut ends = std::collections::BinaryHeap::new();\n    let mut best = 0;\n    for (start, end) in sorted {\n        while ends.peek().is_some_and(|&std::cmp::Reverse(e)| e <= start) {\n            ends.pop();\n        }\n        ends.push(std::cmp::Reverse(end));\n        best = best.max(ends.len());\n    }\n    best\n}\n\nfn main() {\n    let result = rooms(&[(0, 30), (5, 10), (15, 20)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"rooms","statement":"let mut sorted = intervals.to_vec();"},{"line":3,"function":"rooms","statement":"sorted.sort_unstable();"},{"line":4,"function":"rooms","statement":"let mut ends = std::collections::BinaryHeap::new();"},{"line":5,"function":"rooms","statement":"let mut best = 0;"},{"line":6,"function":"rooms","statement":"for (start, end) in sorted {"},{"line":7,"function":"rooms","statement":"while ends.peek().is_some_and(|&std::cmp::Reverse(e)| e <= start) {"},{"line":8,"function":"rooms","statement":"ends.pop();"},{"line":9,"function":"rooms","statement":"}"},{"line":10,"function":"rooms","statement":"ends.push(std::cmp::Reverse(end));"},{"line":11,"function":"rooms","statement":"best = best.max(ends.len());"},{"line":12,"function":"rooms","statement":"}"},{"line":13,"function":"rooms","statement":"best"},{"line":7,"function":"closure · line 7","statement":"e <= start"},{"line":17,"function":"main","statement":"let result = rooms(&[(0, 30), (5, 10), (15, 20)]).to_string();"},{"line":18,"function":"main","statement":"println!(\