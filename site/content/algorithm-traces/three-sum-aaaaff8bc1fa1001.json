{"key":"three-sum-aaaaff8bc1fa1001","sourceHash":"aaaaff8bc1fa1001e756bfc57a8ef5d3892749e82df37c0e7731af93feec7bc2","pattern":"three-sum","category":"two-pointers","title":"Challenge: Three-Sum Reduction","idea":"Sort, fix one value, and solve the remaining target with two pointers while skipping duplicates.","complexity":"O(n^2) time · O(n) owned sorted copy in this example","source":"fn zero_triples(values: &[i32]) -> usize {\n    let mut a = values.to_vec();\n    a.sort_unstable();\n    let mut count = 0;\n    for i in 0..a.len().saturating_sub(2) {\n        if i > 0 && a[i] == a[i - 1] {\n            continue;\n        }\n        let (mut left, mut right) = (i + 1, a.len() - 1);\n        while left < right {\n            let sum = a[i] + a[left] + a[right];\n            if sum < 0 {\n                left += 1;\n            } else if sum > 0 {\n                right -= 1;\n            } else {\n                count += 1;\n                let x = a[left];\n                let y = a[right];\n                while left < right && a[left] == x {\n                    left += 1;\n                }\n                while left < right && a[right] == y {\n                    right -= 1;\n                }\n            }\n        }\n    }\n    count\n}\n\nfn main() {\n    let result = zero_triples(&[0, 0, 0]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"zero_triples","statement":"let mut a = values.to_vec();"},{"line":3,"function":"zero_triples","statement":"a.sort_unstable();"},{"line":4,"function":"zero_triples","statement":"let mut count = 0;"},{"line":5,"function":"zero_triples","statement":"for i in 0..a.len().saturating_sub(2) {"},{"line":6,"function":"zero_triples","statement":"if i > 0 && a[i] == a[i - 1] {"},{"line":7,"function":"zero_triples","statement":"continue;"},{"line":9,"function":"zero_triples","statement":"let (mut left, mut right) = (i + 1, a.len() - 1);"},{"line":10,"function":"zero_triples","statement":"while left < 