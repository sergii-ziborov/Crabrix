{"key":"huffman-greedy-heap-80d074ef0493792a","sourceHash":"80d074ef0493792ab075063724c79c08451c7402bc337641cd0cf797e08cefd9","pattern":"huffman-greedy-heap","category":"heaps-streaming","title":"Huffman Merge Heap: Mental Model","idea":"Repeatedly merge the two lightest items; the accumulated merge cost is optimal.","complexity":"O(n log n) time · O(n) space","source":"fn merge_cost(weights: &[i64]) -> i64 {\n    let mut heap: std::collections::BinaryHeap<_> =\n        weights.iter().map(|&x| std::cmp::Reverse(x)).collect();\n    let mut cost = 0;\n    while heap.len() > 1 {\n        let merged = heap.pop().unwrap().0 + heap.pop().unwrap().0;\n        cost += merged;\n        heap.push(std::cmp::Reverse(merged));\n    }\n    cost\n}\n\nfn main() {\n    let result = merge_cost(&[5, 9, 12, 13, 16, 45]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"merge_cost","statement":"let mut heap: std::collections::BinaryHeap<_> ="},{"line":4,"function":"merge_cost","statement":"let mut cost = 0;"},{"line":5,"function":"merge_cost","statement":"while heap.len() > 1 {"},{"line":6,"function":"merge_cost","statement":"let merged = heap.pop().unwrap().0 + heap.pop().unwrap().0;"},{"line":7,"function":"merge_cost","statement":"cost += merged;"},{"line":8,"function":"merge_cost","statement":"heap.push(std::cmp::Reverse(merged));"},{"line":9,"function":"merge_cost","statement":"}"},{"line":10,"function":"merge_cost","statement":"cost"},{"line":3,"function":"closure · line 3","statement":"std::cmp::Reverse(x)"},{"line":14,"function":"main","statement":"let result = merge_cost(&[5, 9, 12, 13, 16, 45]).to_string();"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"input":"weights=[5,9,12,13,16,45]","stdout":"224\n","values":[{"type":"&[i64]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"9"},{"kind":"scalar","text":"12"},{"kind":"scalar","t