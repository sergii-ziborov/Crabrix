{"key":"dijkstra-56815d669b808ffc","sourceHash":"56815d669b808ffcfeade37920749a57d2f263706a368cd536db139b386eb370","pattern":"dijkstra","category":"weighted-graphs","title":"Challenge: Dijkstra","idea":"Finalize the smallest tentative distance and relax its non-negative outgoing edges.","complexity":"O((V+E) log V) time · O(V+E) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn dijkstra(graph: &[Vec<(usize, i64)>], start: usize) -> Vec<i64> {\n    let mut distance = vec![i64::MAX; graph.len()];\n    distance[start] = 0;\n    let mut heap = std::collections::BinaryHeap::from([std::cmp::Reverse((0, start))]);\n    while let Some(std::cmp::Reverse((cost, v))) = heap.pop() {\n        if cost != distance[v] {\n            continue;\n        }\n        for &(u, w) in &graph[v] {\n            assert!(w >= 0);\n            let next = cost.checked_add(w).expect(\"distance fits i64\");\n            if next < distance[u] {\n                distance[u] = next;\n                heap.push(std::cmp::Reverse((next, u)));\n            }\n        }\n    }\n    for d in &mut distance {\n        if *d == i64::MAX {\n            *d = -1;\n        }\n    }\n    distance\n}\n\nfn main() {\n    let result = csv(dijkstra(\n        &[\n            vec![(1, 2), (2, 5)],\n            vec![(0, 2), (2, 1)],\n            vec![(0, 5), (1, 1)],\n        ],\n        0,\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"dijkstra","statement":"let mut distance = vec![i64::MAX; graph.len()];"},{"line":9,"function":"dijkstra","statement":"distance[start] = 0;"},{"line":10,"function":"dijkstra","statement":"let mut heap = std::collections::BinaryHeap::from([std::cmp::Reverse((0, start))]);"},{"line":11,"function":"dijkstra","statement":"while let Some(std::cmp::Reverse((cost, v))) = heap.pop() {"},{"line":12,"function":"dijkstra","statement":"if cost != distance[v] {"},{"line":13,"function":"dijkstra","statement":"continue;"},{"line":15,"function":"dijkstra","statement":"for &(u, w) in &graph[v] {"},{"line":16,"function":"dijkstra","statement":"assert!(w >= 0);","edge":{"collection":"graph","from":"v","to":"u"}},{"line":17,"function":"dijkstra","statement":"let next = cost.checked_add(w).expect(\"distance fits i64\");","edge":{"collection":"graph","from":"v","to":"u"}},{"line":18,"function":"dijkstra","statement":"if next < distance[u] {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":19,"function":"dijkstra","statement":"distance[u] = next;","edge":{"collection":"graph","from":"v","to":"u"}},{"line":20,"function":"dijkstra","statement":"heap.push(std::cmp::Reverse((next, u)));","edge":{"collection":"graph","from":"v","to":"u"}},{"line":21,"function":"dijkstra","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":24,"function":"dijkstra","statement":"for d in &mut distance {"},{"line":25,"function":"dijkstra","statement":"if *d == i64::MAX {"},{"line":26,"function":"dijkstra","statement":"*d = -1;"},{"line":27,"function":"dijkstra","statement":"}"},{"line":29,"function":"dijkstra","statement":"distance"},{"line":33,"function":"main","statement":"let result = csv(dijkstra("},{"line":41,"function":"main","statement":"println!(\"{result}\");"},{"line":42,"function":"main","statement":"}"}],"version":1,"input":"edges=0-1:2,0-2:5,1-2:1","stdout":"0,2,3\n","values":[{"type":"&[alloc::vec::Vec<(usize, i64)>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"}],"tuple":true}],"tuple":false},{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"