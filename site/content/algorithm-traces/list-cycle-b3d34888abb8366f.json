{"key":"list-cycle-b3d34888abb8366f","sourceHash":"b3d34888abb8366f122dda85909a894dbd47b852cad04ae72babe9c1523e4134","pattern":"list-cycle","category":"linked-lists","title":"Linked Cycle Detection: Mental Model","idea":"Different pointer speeds meet inside a cycle but never in a finite acyclic list.","complexity":"O(n) time · O(1) space","source":"fn contains_cycle(next: &[Option<usize>]) -> bool {\n    // Arena indexes preserve node identity; None terminates a list.\n    let head = (!next.is_empty()).then_some(0);\n    let (mut slow, mut fast) = (head, head);\n    loop {\n        slow = slow.and_then(|i| next[i]);\n        fast = fast.and_then(|i| next[i]).and_then(|i| next[i]);\n        if fast.is_none() {\n            return false;\n        }\n        if slow == fast {\n            return true;\n        }\n    }\n}\n\nfn main() {\n    let result = contains_cycle(&[Some(1), Some(2), Some(3), Some(1)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":3,"function":"contains_cycle","statement":"let head = (!next.is_empty()).then_some(0);"},{"line":4,"function":"contains_cycle","statement":"let (mut slow, mut fast) = (head, head);"},{"line":5,"function":"contains_cycle","statement":"loop {"},{"line":6,"function":"contains_cycle","statement":"slow = slow.and_then(|i| next[i]);"},{"line":7,"function":"contains_cycle","statement":"fast = fast.and_then(|i| next[i]).and_then(|i| next[i]);"},{"line":8,"function":"contains_cycle","statement":"if fast.is_none() {"},{"line":9,"function":"contains_cycle","statement":"return false;"},{"line":11,"function":"contains_cycle","statement":"if slow == fast {"},{"line":12,"function":"contains_cycle","statement":"return true;"},{"line":6,"function":"closure · line 6","statement":"next[i]"},{"line":7,"function":"closure · line 7","statement":"next[i]"},{"line":7,"function":"closure · line 7","statement":"next[i]"},{"line":18,"function":"main","statement":"let result = contains_cycle(&[Some(1), Some(2), Some(3), Some(1)])