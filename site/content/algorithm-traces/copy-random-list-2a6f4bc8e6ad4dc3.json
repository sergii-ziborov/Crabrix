{"key":"copy-random-list-2a6f4bc8e6ad4dc3","sourceHash":"2a6f4bc8e6ad4dc3b29a37a20c11a965adafa71c208e76801621e1f48bd857ba","pattern":"copy-random-list","category":"linked-lists","title":"Copy with Random Links: Mental Model","idea":"Map old nodes to new nodes or interleave copies so arbitrary links can be reconstructed.","complexity":"O(n) time · O(n) separate index-arena storage","source":"#[derive(Clone, Debug, PartialEq)]\nstruct RandomNode {\n    value: i32,\n    next: Option<usize>,\n    random: Option<usize>,\n}\nfn deep_copy(arena: &[RandomNode]) -> Vec<RandomNode> {\n    // Index edges refer within this arena. Cloning all records allocates a\n    // separate arena; identical indexes now refer to the copied nodes.\n    arena.to_vec()\n}\nfn copied_pairs(values: &[i32], random: &[Option<usize>]) -> String {\n    let original: Vec<_> = values\n        .iter()\n        .enumerate()\n        .map(|(i, &value)| RandomNode {\n            value,\n            next: (i + 1 < values.len()).then_some(i + 1),\n            random: random[i],\n        })\n        .collect();\n    let mut copy = deep_copy(&original);\n    assert_eq!(original, copy);\n    let out = copy\n        .iter()\n        .map(|n| {\n            format!(\n                \"{}:{}\",\n                n.value,\n                n.random.map_or(\"null\".into(), |i| i.to_string())\n            )\n        })\n        .collect::<Vec<_>>()\n        .join(\",\");\n    if !copy.is_empty() {\n        copy[0].value += 1;\n        assert_ne!(original[0].value, copy[0].value);\n    }\n    out\n}\n\nfn main() {\n    let result = copied_pairs(&[7, 13, 11], &[None, Some(0), Some(1)]);\n    println!(\"{result}\");\n}\n","sites":[{"line":10,"function":"deep_copy","statement":"arena.to_vec()"},{"line":13,"function":"copied_pairs","statement":"let original: Vec<_> = values"},{"line":22,"function":"copied_pairs","statement":"let mut copy = deep_copy(&original);"},{"line":23,"function":"copied_pairs","statement":"assert_eq!(original, copy);"},{"line":24,"function":"copied_pairs","statement":"let out = copy"},{"line":35,"function":"copied_pairs","statement":"if !copy.is_empty() {"},{"line":36,"function":"copied_pairs","statement":"copy[0].value += 1;"},{"line":37,"function":"copied_pairs","statement":"assert_ne!(original[0].value, copy[0].value);"},{"line":38,"function":"copied_pairs","statement":"}"},{"line":39,"function":"copied_pairs","statement":"out"},{"line":16,"function":"closure · line 16","statement":"RandomNode {"},{"line":27,"function":"closure · line 26","statement":"format!("},{"line":43,"function":"main","statement":"let result = copied_pairs(&[7, 13, 11], &[None, Some(0), Some(1)]);"},{"line":44,"function":"main","statement":"println!(\"{result}\");"},{"line":45,"function":"main","statement":"}"}],"version":1,"input":"values=[7,13,11] random=[null,0,1]","stdout":"7:null,13:0,11:1\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"7"},{"kind":"scalar","text":"13"},{"kind":"scalar","text":"11"}],"tuple":false}},{"type":"&[core::option::Option<usize>]","data":{"kind":"list","items":[{"kind":"scalar","text":"None"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":true}},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":true}}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"7"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"13"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"11"}},{"type":"alloc::vec::Vec<traced::RandomNode>","data":{"kind":"list","items":[{"kind":"named","name":"RandomNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":true}}],[{"kind":"