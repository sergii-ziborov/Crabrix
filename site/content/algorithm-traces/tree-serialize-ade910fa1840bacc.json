{"key":"tree-serialize-ade910fa1840bacc","sourceHash":"ade910fa1840bacc8ce7dd6fe7a1b4bc9628820315c20c9672cc0690decd7492","pattern":"tree-serialize","category":"trees","title":"Tree Serialize/Deserialize: Mental Model","idea":"Emit null markers as well as values so structure is reconstructible, not only traversal order.","complexity":"O(n) time · O(n) output","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\n\nfn serialize(root: &Tree) -> String {\n    fn visit(root: &Tree, out: &mut Vec<String>) {\n        match root {\n            None => out.push(\"#\".into()),\n            Some(n) => {\n                out.push(n.value.to_string());\n                visit(&n.left, out);\n                visit(&n.right, out);\n            }\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out.join(\",\")\n}\nfn deserialize(text: &str) -> Tree {\n    // Tokens arrive in the same preorder, so each # closes exactly one child.\n    fn build<'a>(tokens: &mut impl Iterator<Item = &'a str>) -> Tree {\n        match tokens.next() {\n            None | Some(\"#\") => None,\n            Some(token) => {\n                let value = token.parse().unwrap();\n                let left = build(tokens);\n                let right = build(tokens);\n                node(value, left, right)\n            }\n        }\n    }\n    build(&mut text.split(','))\n}\nfn round_trip(root: &Tree) -> String {\n    let text = serialize(root);\n    assert_eq!(serialize(&deserialize(&text)), text);\n    text\n}\nfn inorder_values(root: &Tree) -> Vec<i32> {\n    match root {\n        None => Vec::new(),\n        Some(n) => {\n            let mut out = inorder_values(&n.left);\n            out.push(n.value);\n            out.extend(inorder_values(&n.right));\n            out\n        }\n    }\n}\n\nfn main() {\n    let result = round_trip(&node(\n        1,\n        node(2, None, None),\n        node(3, node(4, None, None), node(5, None, None)),\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":22,"function":"serialize","statement":"let mut out = Vec::new();"},{"line":23,"function":"serialize","statement":"visit(root, &mut out);"},{"line":24,"function":"serialize","statement":"out.join(\",\")"},{"line":13,"function":"visit","statement":"match root {"},{"line":16,"function":"visit","statement":"out.push(n.value.to_string());"},{"line":17,"function":"visit","statement":"visit(&n.left, out);"},{"line":18,"function":"visit","statement":"visit(&n.right, out);"},{"line":19,"function":"visit","statement":"}"},{"line":39,"function":"deserialize","statement":"build(&mut text.split(','))"},{"line":29,"function":"build","statement":"match tokens.next() {"},{"line":32,"function":"build","statement":"let value = token.parse().unwrap();"},{"line":33,"function":"build","statement":"let left = build(tokens);"},{"line":34,"function":"build","statement":"let right = build(tokens);"},{"line":35,"function":"build","statement":"node(value, left, right)"},{"line":42,"function":"round_trip","statement":"let text = serialize(root);"},{"line":43,"function":"round_trip","statement":"assert_eq!(serialize(&deserialize(&text)), text);"},{"line":44,"function":"round_trip","statement":"text"},{"line":47,"function":"inorder_values","statement":"match root {"},{"line":50,"function":"inorder_values","statement":"let mut out = inorder_values(&n.left);"},{"line":51,"function":"inorder_values","statement":"out.push(n.value);"},{"line":52,"function":"inorder_values","statement":"out.extend(inorder_values(&n.right));"},{"line":53,"function":"inorder_values","statement":"out"},{"line":59,"function":"main","statement":"let result = round_trip(&node("},{"line":64,"function":"main","statement":"println!(\"{result}\");"},{"line":65,"function":"main","statement":"}"}],"version":1,"input":"tree=[1,2,3,null,null,4,5]","stdout":"1,2,#,#,3,4,#,#,5,#,#\n","values":[{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"4"}]]}}],"tuple":true}}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"5"}]]}}],"tuple":true}}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"2"}]]}}],"tuple":true}}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"named","name":"Some","valu