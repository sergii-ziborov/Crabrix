{"key":"list-intersection-e16673f9ba895707","sourceHash":"e16673f9ba8957076e7d74caf80aa21f416e2c876c9ef2196214758c19359c6b","pattern":"list-intersection","category":"linked-lists","title":"Pointer-Switch Intersection: Mental Model","idea":"Switch each pointer to the other head so both traverse equal combined distance.","complexity":"O(n+m) time · O(1) space","source":"type SharedLink = Option<std::rc::Rc<SharedNode>>;\nstruct SharedNode {\n    value: i32,\n    next: SharedLink,\n}\nfn shared_list(prefix: &[i32], tail: SharedLink) -> SharedLink {\n    prefix.iter().rev().fold(tail, |next, &value| {\n        Some(std::rc::Rc::new(SharedNode { value, next }))\n    })\n}\nfn intersection(a: &SharedLink, b: &SharedLink) -> Option<i32> {\n    fn equal(a: &SharedLink, b: &SharedLink) -> bool {\n        match (a, b) {\n            (None, None) => true,\n            (Some(x), Some(y)) => std::rc::Rc::ptr_eq(x, y),\n            _ => false,\n        }\n    }\n    let (mut p, mut q) = (a.clone(), b.clone());\n    while !equal(&p, &q) {\n        p = match p {\n            Some(n) => n.next.clone(),\n            None => b.clone(),\n        };\n        q = match q {\n            Some(n) => n.next.clone(),\n            None => a.clone(),\n        };\n    }\n    p.map(|n| n.value)\n}\n\nfn main() {\n    let result = {\n        let tail = shared_list(&[8, 4, 5], None);\n        let a = shared_list(&[4, 1], tail.clone());\n        let b = shared_list(&[5, 6, 1], tail);\n        intersection(&a, &b).map_or(\"none\".into(), |x| x.to_string())\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"shared_list","statement":"prefix.iter().rev().fold(tail, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(std::rc::Rc::new(SharedNode { value, next }))"},{"line":19,"function":"intersection","statement":"let (mut p, mut q) = (a.clone(), b.clone());"},{"line":20,"function":"intersection","statement":"while !equal(&p, &q) {"},{"line":21,"function":"intersection","statement":"p = match p {"},{"line":25,"function":"intersection","statement":"q = match q {"},{"line":29,"function":"intersection","statement":"}"},{"line":30,"function":"intersection","statement":"p.map(|n| n.value)"},{"line":13,"function":"equal","statement":"match (a, b) {"},{"line":30,"function":"closure · line 30","statement":"n.value"},{"line":34,"function":"main","statement":"let result = {"},{"line":35,"function":"main","statement":"let tail = shared_list(&[8, 4, 5], None);"},{"line":36,"function":"main","statement":"let a = shared_list(&[4, 1], tail.clone());"},{"line":37,"function":"main","statement":"let b = shared_list(&[5, 6, 1], tail);"},{"line":38,"function":"main","statement":"intersection(&a, &b).map_or(\"none\".into(), |x| x.to_string())"},{"line":40,"function":"main","statement":"println!(\"{result}\");"},{"line":41,"function":"main","statement":"}"},{"line":38,"function":"closure · line 38","statement":"x.to_string()"}],"version":1,"input":"a_prefix=[4,1]; b_prefix=[5,6,1]; shared=[8,4,5]","stdout":"8\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"8"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"core::option::Option<alloc::rc::Rc<traced::SharedNode>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"core::option::Option<alloc::rc::Rc<traced::SharedNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"SharedNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"5"}]]}}],"tuple":true}}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"core::option::Option<alloc::rc::Rc<traced::SharedNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"SharedNode","value":{"kind":"map","entries":[[{"kind":"scalar",