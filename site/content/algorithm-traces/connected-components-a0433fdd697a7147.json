{"key":"connected-components-a0433fdd697a7147","sourceHash":"a0433fdd697a714751b5280e745410c69c21d0bec887b9552588a94f78e2277b","pattern":"connected-components","category":"graph-traversal","title":"Connected Components: Mental Model","idea":"Start a traversal from every still-unseen node and count starts.","complexity":"O(V+E) time · O(V) space","source":"fn component_count(graph: &[Vec<usize>]) -> usize {\n    let mut seen = vec![false; graph.len()];\n    let mut count = 0;\n    for start in 0..graph.len() {\n        if seen[start] {\n            continue;\n        }\n        count += 1;\n        seen[start] = true;\n        let mut stack = vec![start];\n        while let Some(v) = stack.pop() {\n            for &u in &graph[v] {\n                if !seen[u] {\n                    seen[u] = true;\n                    stack.push(u);\n                }\n            }\n        }\n    }\n    count\n}\n\nfn main() {\n    let result =\n        component_count(&[vec![1], vec![0, 2], vec![1], vec![4], vec![3], vec![]]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"component_count","statement":"let mut seen = vec![false; graph.len()];"},{"line":3,"function":"component_count","statement":"let mut count = 0;"},{"line":4,"function":"component_count","statement":"for start in 0..graph.len() {"},{"line":5,"function":"component_count","statement":"if seen[start] {"},{"line":6,"function":"component_count","statement":"continue;"},{"line":8,"function":"component_count","statement":"count += 1;"},{"line":9,"function":"component_count","statement":"seen[start] = true;"},{"line":10,"function":"component_count","statement":"let mut stack = vec![start];"},{"line":11,"function":"component_count","statement":"while let Some(v) = stack.pop() {"},{"line":12,"function":"component_count","statement":"for &u in &graph[v] {"},{"line":13,"function":"component_count","statement":"if !seen[u] {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":14,"functio