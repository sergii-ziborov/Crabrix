{"key":"gas-station-8d65bf94365113ff","sourceHash":"8d65bf94365113ffb9925ef787294ceca215215d0e24d390974b82df220481aa","pattern":"gas-station","category":"greedy-intervals","title":"Challenge: Gas Station Reset","idea":"When running fuel becomes negative, no station in that failed segment can be a valid start.","complexity":"O(n) time · O(1) space","source":"fn starting_station(gas: &[i32], cost: &[i32]) -> i32 {\n    assert_eq!(gas.len(), cost.len());\n    let (mut total, mut tank, mut start) = (0, 0, 0);\n    for i in 0..gas.len() {\n        let net = gas[i] - cost[i];\n        total += net;\n        tank += net;\n        if tank < 0 {\n            tank = 0;\n            start = i + 1;\n        }\n    }\n    if total < 0 || gas.is_empty() {\n        -1\n    } else {\n        start as i32\n    }\n}\n\nfn main() {\n    let result = starting_station(&[2], &[1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"starting_station","statement":"assert_eq!(gas.len(), cost.len());"},{"line":3,"function":"starting_station","statement":"let (mut total, mut tank, mut start) = (0, 0, 0);"},{"line":4,"function":"starting_station","statement":"for i in 0..gas.len() {"},{"line":5,"function":"starting_station","statement":"let net = gas[i] - cost[i];"},{"line":6,"function":"starting_station","statement":"total += net;"},{"line":7,"function":"starting_station","statement":"tank += net;"},{"line":8,"function":"starting_station","statement":"if tank < 0 {"},{"line":9,"function":"starting_station","statement":"tank = 0;"},{"line":10,"function":"starting_station","statement":"start = i + 1;"},{"line":11,"function":"starting_station","statement":"}"},{"line":13,"function":"starting_station","statement":"if total < 0 || gas.is_empty() {"},{"line":14,"function":"starting_station","statement":"-1"},{"line":16,"function":"starting_station","statement":"start as i32"},{"line":21,"function":"main","statement":"let result = starting_station(&[2], &[1]).to_string();"