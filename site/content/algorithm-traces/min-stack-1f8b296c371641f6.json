{"key":"min-stack-1f8b296c371641f6","sourceHash":"1f8b296c371641f68623c9721acbe341b43de6c486760f1f0774414b7eb43c20","pattern":"min-stack","category":"stacks-queues","title":"Min Stack: Mental Model","idea":"Store each value together with the minimum at the moment it is pushed.","complexity":"O(1) per operation · O(n) space","source":"fn stack_min(operations: &[&str]) -> i32 {\n    let mut stack: Vec<(i32, i32)> = Vec::new();\n    for op in operations {\n        if let Some(value) = op.strip_prefix(\"push\") {\n            let x = value.parse().unwrap();\n            let minimum = stack.last().map_or(x, |&(_, m)| m.min(x));\n            stack.push((x, minimum));\n        } else if *op == \"pop\" {\n            stack.pop().unwrap();\n        }\n    }\n    stack.last().unwrap().1\n}\n\nfn main() {\n    let result = stack_min(&[\"push5\", \"push2\", \"push4\", \"pop\", \"min\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"stack_min","statement":"let mut stack: Vec<(i32, i32)> = Vec::new();"},{"line":3,"function":"stack_min","statement":"for op in operations {"},{"line":4,"function":"stack_min","statement":"if let Some(value) = op.strip_prefix(\"push\") {"},{"line":5,"function":"stack_min","statement":"let x = value.parse().unwrap();"},{"line":6,"function":"stack_min","statement":"let minimum = stack.last().map_or(x, |&(_, m)| m.min(x));"},{"line":7,"function":"stack_min","statement":"stack.push((x, minimum));"},{"line":8,"function":"stack_min","statement":"}"},{"line":9,"function":"stack_min","statement":"stack.pop().unwrap();"},{"line":10,"function":"stack_min","statement":"}"},{"line":12,"function":"stack_min","statement":"stack.last().unwrap().1"},{"line":6,"function":"closure · line 6","statement":"m.min(x)"},{"line":16,"function":"main","statement":"let result = stack_min(&[\"push5\", \"push2\", \"push4\", \"pop\", \"min\"]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"m