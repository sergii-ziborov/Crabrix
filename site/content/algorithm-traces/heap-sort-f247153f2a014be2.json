{"key":"heap-sort-f247153f2a014be2","sourceHash":"f247153f2a014be2553e627990c8b7145b86ee75ccf0cce498d1a9dd186fd5d3","pattern":"heap-sort","category":"sorting-selection","title":"Challenge: Heap Sort","idea":"Build a max heap and repeatedly move the maximum into its final suffix position.","complexity":"O(n log n) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn heap_sort(a: &mut [i32]) {\n    fn sift(a: &mut [i32], mut root: usize, end: usize) {\n        while 2 * root + 1 < end {\n            let mut child = 2 * root + 1;\n            if child + 1 < end && a[child] < a[child + 1] {\n                child += 1;\n            }\n            if a[root] >= a[child] {\n                break;\n            }\n            a.swap(root, child);\n            root = child;\n        }\n    }\n    let n = a.len();\n    for i in (0..n / 2).rev() {\n        sift(a, i, n);\n    }\n    for end in (1..n).rev() {\n        a.swap(0, end);\n        sift(a, 0, end);\n    }\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![0, -1];\n        heap_sort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":21,"function":"heap_sort","statement":"let n = a.len();"},{"line":22,"function":"heap_sort","statement":"for i in (0..n / 2).rev() {"},{"line":23,"function":"heap_sort","statement":"sift(a, i, n);"},{"line":24,"function":"heap_sort","statement":"}"},{"line":25,"function":"heap_sort","statement":"for end in (1..n).rev() {"},{"line":26,"function":"heap_sort","statement":"a.swap(0, end);"},{"line":27,"function":"heap_sort","statement":"sift(a, 0, end);"},{"line":28,"function":"heap_sort","statement":"}"},{"line":9,"function":"sift","statement":"while 2 * root + 1 < end {"},{"line":10,"function":"sift","statement":"let mut child = 2 * root + 1;"},{"line":11,"function":"sift","statement":"if child + 1 < end && a[child] < a[child + 1] {"},{"line":12,"function":"sift","statement":"child += 1;"},{"line":13,"function":"sift","statement":"}"},{"line":14,"function":"sift","statement":"if a[root] >= a[child] {"},{"line":15,"function":"sift","statement":"break;"},{"line":17,"function":"sift","statement":"a.swap(root, child);"},{"line":18,"function":"sift","statement":"root = child;"},{"line":19,"function":"sift","statement":"}"},{"line":32,"function":"main","statement":"let result = {"},{"line":33,"function":"main","statement":"let mut values = vec![0, -1];"},{"line":34,"function":"main","statement":"heap_sort(&mut values);"},{"line":35,"function":"main","statement":"csv(values)"},{"line":37,"function":"main","statement":"println!(\"{result}\");"},{"line":38,"function":"main","statement":"}"}],"version":1,"input":"[0,-1]","stdout":"-1,0\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-1"}],"tuple":false}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-1"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"&mut [i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"-1,0\""}}],"frames":[{"site":18,"stack":[["main",1]],"locals":[]},{"site":19,"stack":[["main",1]],"locals":[]},{"site":20,"stack":[["main",1]],"locals":[["values",0]]},{"site":0,"stack":[["main",1],["heap_sort",2]],"locals":[["a",1]]},{"site":1,"stack":[["main",1],["heap_sort",2]],"locals":[["a",1],["n",2]]},{"site":2,"stack":[["main",1],["heap_sort",2]],"lo