{"key":"digit-dp-4bf32e2102772cd1","sourceHash":"4bf32e2102772cd1be07c7e11a64e4b46a9d08ee983690cfaf53b462189d598e","pattern":"digit-dp","category":"dynamic-2d","title":"Digit DP: Mental Model","idea":"Process digits with position, tight-bound, leading-zero, and property state.","complexity":"O(digits * states * base) time","source":"fn digit_sum_count(bound: u64, target: usize) -> u64 {\n    fn count(\n        pos: usize,\n        left: usize,\n        tight: bool,\n        digits: &[u8],\n        memo: &mut [Vec<Option<u64>>],\n    ) -> u64 {\n        if pos == digits.len() {\n            return u64::from(left == 0);\n        }\n        if !tight {\n            if let Some(answer) = memo[pos][left] {\n                return answer;\n            }\n        }\n        let limit = if tight { digits[pos] } else { 9 };\n        let mut answer = 0;\n        for digit in 0..=limit {\n            if digit as usize <= left {\n                answer += count(\n                    pos + 1,\n                    left - digit as usize,\n                    tight && digit == limit,\n                    digits,\n                    memo,\n                );\n            }\n        }\n        if !tight {\n            memo[pos][left] = Some(answer);\n        }\n        answer\n    }\n    let digits: Vec<_> = bound.to_string().bytes().map(|c| c - b'0').collect();\n    count(\n        0,\n        target,\n        true,\n        &digits,\n        &mut vec![vec![None; target + 1]; digits.len()],\n    )\n}\n\nfn main() {\n    let result = digit_sum_count(25, 5).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":35,"function":"digit_sum_count","statement":"let digits: Vec<_> = bound.to_string().bytes().map(|c| c - b'0').collect();"},{"line":36,"function":"digit_sum_count","statement":"count("},{"line":9,"function":"count","statement":"if pos == digits.len() {"},{"line":10,"function":"count","statement":"return u64::from(left == 0);"},{"line":12,"function":"count","statement"