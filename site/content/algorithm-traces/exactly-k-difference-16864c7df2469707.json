{"key":"exactly-k-difference-16864c7df2469707","sourceHash":"16864c7df246970735ef5d1c1f850a53ea7cc541de60dc8fccef97efce8ddfdf","pattern":"exactly-k-difference","category":"sliding-window","title":"Exactly-K by Difference: Mental Model","idea":"Count windows with at most k and subtract those with at most k-1.","complexity":"O(n) expected time · O(k) space","source":"fn exactly_k(values: &[i32], k: usize) -> usize {\n    fn at_most(a: &[i32], k: usize) -> usize {\n        let mut counts = std::collections::HashMap::new();\n        let (mut left, mut total) = (0, 0);\n        for (right, &x) in a.iter().enumerate() {\n            *counts.entry(x).or_insert(0) += 1;\n            while counts.len() > k {\n                let count = counts.get_mut(&a[left]).unwrap();\n                *count -= 1;\n                if *count == 0 {\n                    counts.remove(&a[left]);\n                }\n                left += 1;\n            }\n            total += right + 1 - left;\n        }\n        total\n    }\n    if k == 0 {\n        0\n    } else {\n        at_most(values, k) - at_most(values, k - 1)\n    }\n}\n\nfn main() {\n    let result = exactly_k(&[1, 2, 1, 2, 3], 2).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":19,"function":"exactly_k","statement":"if k == 0 {"},{"line":20,"function":"exactly_k","statement":"0"},{"line":22,"function":"exactly_k","statement":"at_most(values, k) - at_most(values, k - 1)"},{"line":3,"function":"at_most","statement":"let mut counts = std::collections::HashMap::new();"},{"line":4,"function":"at_most","statement":"let (mut left, mut total) = (0, 0);"},{"line":5,"function":"at_most","statement":"for (right, &x) in a.iter().enumerate() {"},{"line":6,"function":"at_most","statement":"*counts.entry(x).or_insert(0) += 1;"},{"line":7,"function":"at_most","statement":"while counts.len() > k {"},{"line":8,"function":"at_most","statement":"let count = counts.get_mut(&a[left]).unwrap();"},{"line":9,"function":"at_most","statem