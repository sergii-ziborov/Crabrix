{"key":"boyer-moore-majority-c389a2d0f014e8ad","sourceHash":"c389a2d0f014e8adb653a75d6095eb9aca0b5d7ec5749934eb8ebd77a56a7e0b","pattern":"boyer-moore-majority","category":"scans","title":"Boyer–Moore Majority Vote: Mental Model","idea":"Cancel different values in pairs so a strict majority remains as the candidate.","complexity":"O(n) time · O(1) space","source":"fn majority(values: &[i32]) -> i32 {\n    // Contract: a strict majority exists. Without it, verify the candidate.\n    let (mut candidate, mut balance) = (0, 0);\n    for &x in values {\n        if balance == 0 {\n            candidate = x;\n        }\n        balance += if x == candidate { 1 } else { -1 };\n    }\n    candidate\n}\n\nfn main() {\n    let result = majority(&[2, 1, 2, 3, 2, 2, 4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":3,"function":"majority","statement":"let (mut candidate, mut balance) = (0, 0);"},{"line":4,"function":"majority","statement":"for &x in values {"},{"line":5,"function":"majority","statement":"if balance == 0 {"},{"line":6,"function":"majority","statement":"candidate = x;"},{"line":7,"function":"majority","statement":"}"},{"line":8,"function":"majority","statement":"balance += if x == candidate { 1 } else { -1 };"},{"line":8,"function":"majority","statement":"1"},{"line":8,"function":"majority","statement":"-1"},{"line":9,"function":"majority","statement":"}"},{"line":10,"function":"majority","statement":"candidate"},{"line":14,"function":"main","statement":"let result = majority(&[2, 1, 2, 3, 2, 2, 4]).to_string();"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"input":"[2, 1, 2, 3, 2, 2, 4]","stdout":"2\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"}],"tup