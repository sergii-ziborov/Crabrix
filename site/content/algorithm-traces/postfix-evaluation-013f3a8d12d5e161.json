{"key":"postfix-evaluation-013f3a8d12d5e161","sourceHash":"013f3a8d12d5e1612621ded6313725fc59bfc78011f3d671ce2be63e06dd7324","pattern":"postfix-evaluation","category":"stacks-queues","title":"Challenge: Postfix Evaluation","idea":"Push operands and reduce the latest operands whenever an operator arrives.","complexity":"O(n) time · O(n) space","source":"fn postfix(expression: &str) -> i32 {\n    let mut stack = Vec::new();\n    for token in expression.split_whitespace() {\n        if let Ok(value) = token.parse::<i32>() {\n            stack.push(value);\n            continue;\n        }\n        let right = stack.pop().unwrap();\n        let left = stack.pop().unwrap();\n        stack.push(match token {\n            \"+\" => left + right,\n            \"-\" => left - right,\n            \"*\" => left * right,\n            \"/\" => left / right,\n            _ => panic!(\"operator\"),\n        });\n    }\n    assert_eq!(stack.len(), 1);\n    stack[0]\n}\n\nfn main() {\n    let result = postfix(\"5 2 -\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"postfix","statement":"let mut stack = Vec::new();"},{"line":3,"function":"postfix","statement":"for token in expression.split_whitespace() {"},{"line":4,"function":"postfix","statement":"if let Ok(value) = token.parse::<i32>() {"},{"line":5,"function":"postfix","statement":"stack.push(value);"},{"line":6,"function":"postfix","statement":"continue;"},{"line":8,"function":"postfix","statement":"let right = stack.pop().unwrap();"},{"line":9,"function":"postfix","statement":"let left = stack.pop().unwrap();"},{"line":10,"function":"postfix","statement":"stack.push(match token {"},{"line":17,"function":"postfix","statement":"}"},{"line":18,"function":"postfix","statement":"assert_eq!(stack.len(), 1);"},{"line":19,"function":"postfix","statement":"stack[0]"},{"line":23,"function":"main","statement":"let result = postfix(\"5 2 -\").to_string();"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"5 2 -","stdout":"3\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"5 2 -\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"5\""}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"2\""}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"-\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"3\""}}],"frames":[{"site":11,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["postfix",2]],"locals":[["expression",0]]},{"site":1,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",1]]},{"site":2,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",1],["token",2]]},{"site":3,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",1],["token",2],["value",3]]},{"site":4,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",4],["token",2],["value",3]]},{"site":2,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",4],["token",5]]},{"site":3,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",4],["token",5],["value",6]]},{"site":4,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",7],["token",5],["value",6]]},{"site":2,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",7],["token",8]]},{"site":5,"stack":[["main",1],["postfix",2]],"locals":[["expression",0],["stack",7],["token",8]]}