{"key":"frequency-balanced-window-7bef54220156bcec","sourceHash":"7bef54220156bcec4f666a150de4fe5ac6d3ddbbd3f5a2b213528fa1f40e0fc6","pattern":"frequency-balanced-window","category":"sliding-window","title":"Challenge: Frequency-Balanced Window","idea":"Track the dominant count so replacements needed equal window length minus that count.","complexity":"O(n) time · O(alphabet) space","source":"fn replacement_length(text: &str, replacements: usize) -> usize {\n    assert!(text.bytes().all(|c| c.is_ascii_uppercase()));\n    let a = text.as_bytes();\n    let mut counts = [0; 26];\n    let (mut left, mut best) = (0, 0);\n    for right in 0..a.len() {\n        counts[(a[right] - b'A') as usize] += 1;\n        while right + 1 - left - counts.iter().max().unwrap() > replacements {\n            counts[(a[left] - b'A') as usize] -= 1;\n            left += 1;\n        }\n        best = best.max(right + 1 - left);\n    }\n    best\n}\n\nfn main() {\n    let result = replacement_length(\"ABC\", 1).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"replacement_length","statement":"assert!(text.bytes().all(|c| c.is_ascii_uppercase()));"},{"line":3,"function":"replacement_length","statement":"let a = text.as_bytes();"},{"line":4,"function":"replacement_length","statement":"let mut counts = [0; 26];"},{"line":5,"function":"replacement_length","statement":"let (mut left, mut best) = (0, 0);"},{"line":6,"function":"replacement_length","statement":"for right in 0..a.len() {"},{"line":7,"function":"replacement_length","statement":"counts[(a[right] - b'A') as usize] += 1;"},{"line":8,"function":"replacement_length","statement":"while right + 1 - left - counts.iter().max().unwrap() > replacements {"},{"line":9,"function":"replacement_length","statement":"counts[(a[left] - b'A') as usize] -= 1;"},{"line":10,"function":"replacement_length","statement":"left += 1;"},{"line":11,"function":"replacement_length","statement":"}"},{"line":12,"function":"replacement_lengt