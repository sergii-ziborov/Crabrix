{"key":"zero-one-knapsack-3a3bd79c26cdf4de","sourceHash":"3a3bd79c26cdf4deb87253021a1cabdb0054f1a70410d18e8c2e7a63f35d2236","pattern":"zero-one-knapsack","category":"dynamic-1d","title":"0/1 Knapsack: Mental Model","idea":"Update capacities backward so each item contributes at most once.","complexity":"O(items*capacity) time · O(capacity) space","source":"fn knapsack(weights: &[usize], values: &[i32], capacity: usize) -> i32 {\n    assert_eq!(weights.len(), values.len());\n    let mut dp = vec![0; capacity + 1];\n    for (&weight, &value) in weights.iter().zip(values) {\n        for c in (weight..=capacity).rev() {\n            dp[c] = dp[c].max(dp[c - weight] + value);\n        }\n    }\n    dp[capacity]\n}\n\nfn main() {\n    let result = knapsack(&[1, 3, 4, 5], &[1, 4, 5, 7], 7).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"knapsack","statement":"assert_eq!(weights.len(), values.len());"},{"line":3,"function":"knapsack","statement":"let mut dp = vec![0; capacity + 1];"},{"line":4,"function":"knapsack","statement":"for (&weight, &value) in weights.iter().zip(values) {"},{"line":5,"function":"knapsack","statement":"for c in (weight..=capacity).rev() {"},{"line":6,"function":"knapsack","statement":"dp[c] = dp[c].max(dp[c - weight] + value);"},{"line":7,"function":"knapsack","statement":"}"},{"line":9,"function":"knapsack","statement":"dp[capacity]"},{"line":13,"function":"main","statement":"let result = knapsack(&[1, 3, 4, 5], &[1, 4, 5, 7], 7).to_string();"},{"line":14,"function":"main","statement":"println!(\"{result}\");"},{"line":15,"function":"main","statement":"}"}],"version":1,"input":"weights=[1,3,4,5] values=[1,4,5,7]","stdout":"9\n","values":[{"type":"&[usize]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4