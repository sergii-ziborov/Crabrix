{"key":"insert-interval-dd39910bfe96b5c9","sourceHash":"dd39910bfe96b5c9b0204569429c39559a51bbbe4e37a4bb1932008cddc9b58f","pattern":"insert-interval","category":"greedy-intervals","title":"Challenge: Insert into Sorted Intervals","idea":"Copy intervals before, merge every overlap, then copy intervals after.","complexity":"O(n) time · O(n) output","source":"fn inserted_interval(intervals: &[(i32, i32)], mut new: (i32, i32)) -> Vec<(i32, i32)> {\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < intervals.len() && intervals[i].1 < new.0 {\n        out.push(intervals[i]);\n        i += 1;\n    }\n    while i < intervals.len() && intervals[i].0 <= new.1 {\n        new.0 = new.0.min(intervals[i].0);\n        new.1 = new.1.max(intervals[i].1);\n        i += 1;\n    }\n    out.push(new);\n    out.extend_from_slice(&intervals[i..]);\n    out\n}\n\nfn main() {\n    let result = inserted_interval(&[(1, 3), (9, 10)], (4, 8))\n        .iter()\n        .map(|(a, b)| format!(\"{a}-{b}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"inserted_interval","statement":"let mut out = Vec::new();"},{"line":3,"function":"inserted_interval","statement":"let mut i = 0;"},{"line":4,"function":"inserted_interval","statement":"while i < intervals.len() && intervals[i].1 < new.0 {"},{"line":5,"function":"inserted_interval","statement":"out.push(intervals[i]);"},{"line":6,"function":"inserted_interval","statement":"i += 1;"},{"line":7,"function":"inserted_interval","statement":"}"},{"line":8,"function":"inserted_interval","statement":"while i < intervals.len() && intervals[i].0 <= new.1 {"},{"line":9,"function":"inserted_interval","statement":"new.0 = new.0.min(intervals[i].0);"},{"line":10,"function":"inserted_interval","statement":"new.1 = new.1.max(intervals[i].1);"},{"line":11,"function":"inserted_interval","statement":"i += 1;"},{"line":12,"function":"inserted_interval","statement":"}"},{"line":13,"fun