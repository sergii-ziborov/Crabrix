{"key":"fenwick-tree-72aebf6c06be00fb","sourceHash":"72aebf6c06be00fbb733c650f0cffc94356a35d173147ec644e046feb7da232e","pattern":"fenwick-tree","category":"ranges","title":"Fenwick Tree: Mental Model","idea":"Store partial sums in power-of-two ranges and move indexes by their lowest set bit.","complexity":"O(log n) update/query · O(n) space","source":"fn fenwick_prefix(n: usize, adds: &[(usize, i64)], query: usize) -> i64 {\n    let mut bit = vec![0; n + 1];\n    for &(index, value) in adds {\n        assert!(index > 0);\n        let mut i = index;\n        while i <= n {\n            bit[i] += value;\n            i += i & i.wrapping_neg();\n        }\n    }\n    let (mut i, mut sum) = (query, 0);\n    while i > 0 {\n        sum += bit[i];\n        i &= i - 1;\n    }\n    sum\n}\n\nfn main() {\n    let result = fenwick_prefix(5, &[(1, 5), (3, 2), (4, 4)], 3).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"fenwick_prefix","statement":"let mut bit = vec![0; n + 1];"},{"line":3,"function":"fenwick_prefix","statement":"for &(index, value) in adds {"},{"line":4,"function":"fenwick_prefix","statement":"assert!(index > 0);"},{"line":5,"function":"fenwick_prefix","statement":"let mut i = index;"},{"line":6,"function":"fenwick_prefix","statement":"while i <= n {"},{"line":7,"function":"fenwick_prefix","statement":"bit[i] += value;"},{"line":8,"function":"fenwick_prefix","statement":"i += i & i.wrapping_neg();"},{"line":9,"function":"fenwick_prefix","statement":"}"},{"line":11,"function":"fenwick_prefix","statement":"let (mut i, mut sum) = (query, 0);"},{"line":12,"function":"fenwick_prefix","statement":"while i > 0 {"},{"line":13,"function":"fenwick_prefix","statement":"sum += bit[i];"},{"line":14,"function":"fenwick_prefix","statement":"i &= i - 1;"},{"line":15,"function":"fenwick_prefix","statement":"}"},{"line":16,"function":"fenwick_prefix","statement":"sum"},{"line":20,"function":"main","statement":"let result = fenwick_prefix(5, &[(1, 5), (3, 2), (4, 4)], 3).to_string();"},{"line":21,"function":"main","statement":"println!(\"{result}\");"},{"line":22,"function":"main","statement":"}"}],"version":1,"input":"n=5 adds=(1,5),(3,2),(4,4) query=3","stdout":"7\n","values":[{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"&[(usize, i64)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"4"}],"tuple":true}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i64","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"8"}},{"type":"i64","data":