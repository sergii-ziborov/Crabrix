{"key":"tree-diameter-eb1217f0befd6319","sourceHash":"eb1217f0befd631909359f88dea369c60863371dd3c0116ebc884b4a4199636f","pattern":"tree-diameter","category":"trees","title":"Challenge: Tree Diameter","idea":"At each node combine the two deepest child paths while returning only the deepest one upward.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn diameter(root: &Tree) -> usize {\n    fn height(root: &Tree, best: &mut usize) -> usize {\n        match root {\n            None => 0,\n            Some(n) => {\n                let left = height(&n.left, best);\n                let right = height(&n.right, best);\n                *best = (*best).max(left + right);\n                1 + left.max(right)\n            }\n        }\n    }\n    let mut best = 0;\n    height(root, &mut best);\n    best\n}\n\nfn main() {\n    let result = diameter(&node(1, node(2, None, None), None)).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":22,"function":"diameter","statement":"let mut best = 0;"},{"line":23,"function":"diameter","statement":"height(root, &mut best);"},{"line":24,"function":"diameter","statement":"best"},{"line":12,"function":"height","statement":"match root {"},{"line":15,"function":"height","statement":"let left = height(&n.left, best);"},{"line":16,"function":"height","statement":"let right = height(&n.right, best);"},{"line":17,"function":"height","statement":"*best = (*best).max(left + right);"},{"line":18,"function":"height","statement":"1 + left.max(right)"},{"line":28,"function":"main","statement":"let result = diameter(&node(1, node(2, None, None), None)).to_string();"},{"line":29,"function":"main","statement":"println!(\"{result}\");"},{"line":30,"fun