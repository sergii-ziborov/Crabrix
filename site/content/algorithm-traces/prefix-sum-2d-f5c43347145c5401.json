{"key":"prefix-sum-2d-f5c43347145c5401","sourceHash":"f5c43347145c5401ea1197ee6af7a7f0096732a91635170bb73fc214e3969f7b","pattern":"prefix-sum-2d","category":"ranges","title":"2D Prefix Sum: Mental Model","idea":"Store each rectangle from the origin and use inclusion-exclusion for any subrectangle.","complexity":"O(rows*cols) build · O(1) query","source":"fn rectangle_sum(a: &[Vec<i64>], r1: usize, c1: usize, r2: usize, c2: usize) -> i64 {\n    let (rows, cols) = (a.len(), a[0].len());\n    let mut p = vec![vec![0; cols + 1]; rows + 1];\n    for r in 0..rows {\n        for c in 0..cols {\n            p[r + 1][c + 1] = a[r][c] + p[r][c + 1] + p[r + 1][c] - p[r][c];\n        }\n    }\n    p[r2 + 1][c2 + 1] - p[r1][c2 + 1] - p[r2 + 1][c1] + p[r1][c1]\n}\n\nfn main() {\n    let result =\n        rectangle_sum(&[vec![1, 2, 3], vec![4, 5, 6], vec![7, 8, 9]], 1, 0, 2, 1).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"rectangle_sum","statement":"let (rows, cols) = (a.len(), a[0].len());"},{"line":3,"function":"rectangle_sum","statement":"let mut p = vec![vec![0; cols + 1]; rows + 1];"},{"line":4,"function":"rectangle_sum","statement":"for r in 0..rows {"},{"line":5,"function":"rectangle_sum","statement":"for c in 0..cols {"},{"line":6,"function":"rectangle_sum","statement":"p[r + 1][c + 1] = a[r][c] + p[r][c + 1] + p[r + 1][c] - p[r][c];"},{"line":7,"function":"rectangle_sum","statement":"}"},{"line":9,"function":"rectangle_sum","statement":"p[r2 + 1][c2 + 1] - p[r1][c2 + 1] - p[r2 + 1][c1] + p[r1][c1]"},{"line":13,"function":"main","statement":"let result ="},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"input":"[[1,2,3],[4,5,6],[7,8,9]]","stdout":"24\n","values":[{"type":"&[alloc::vec::Vec<i64>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"}],"tuple":false},{"kind":"