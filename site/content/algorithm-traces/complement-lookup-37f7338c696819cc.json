{"key":"complement-lookup-37f7338c696819cc","sourceHash":"37f7338c696819cc876b77bd175f0dea8831618d0d37ca34504324d29f2eea2c","pattern":"complement-lookup","category":"hashing","title":"Challenge: Complement Lookup","idea":"For each number, ask whether target - number has already appeared.","complexity":"O(n) expected time · O(n) space","source":"fn two_sum(values: &[i32], target: i32) -> Option<(usize, usize)> {\n    let mut seen = std::collections::HashMap::new();\n    for (j, &x) in values.iter().enumerate() {\n        if let Some(&i) = seen.get(&(target - x)) {\n            return Some((i, j));\n        }\n        seen.entry(x).or_insert(j);\n    }\n    None\n}\n\nfn main() {\n    let result = two_sum(&[2, 8], 10).map_or(\"-1,-1\".into(), |(i, j)| format!(\"{i},{j}\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"two_sum","statement":"let mut seen = std::collections::HashMap::new();"},{"line":3,"function":"two_sum","statement":"for (j, &x) in values.iter().enumerate() {"},{"line":4,"function":"two_sum","statement":"if let Some(&i) = seen.get(&(target - x)) {"},{"line":5,"function":"two_sum","statement":"return Some((i, j));"},{"line":7,"function":"two_sum","statement":"seen.entry(x).or_insert(j);"},{"line":8,"function":"two_sum","statement":"}"},{"line":9,"function":"two_sum","statement":"None"},{"line":13,"function":"main","statement":"let result = two_sum(&[2, 8], 10).map_or(\"-1,-1\".into(), |(i, j)| format!(\"{i},{j}\"));"},{"line":14,"function":"main","statement":"println!(\"{result}\");"},{"line":15,"function":"main","statement":"}"},{"line":13,"function":"closure · line 13","statement":"format!(\"{i},{j}\")"}],"version":1,"input":"[2, 8] target=10","stdout":"0,1\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"8"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"10"}},{"type":"std::collections::hash::map::HashMap<i32, usize>","data":{"kind":"map","entries":