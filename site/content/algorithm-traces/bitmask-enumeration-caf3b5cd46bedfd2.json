{"key":"bitmask-enumeration-caf3b5cd46bedfd2","sourceHash":"caf3b5cd46bedfd218681d2e0c0cfef9133de3a4dd2fe1dbc40d70a614b5c930","pattern":"bitmask-enumeration","category":"math-bits","title":"Bitmask Enumeration: Mental Model","idea":"Use each bit as an include/exclude choice for one item.","complexity":"O(2^n*n) time · O(1) state excluding output","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn matching_masks(values: &[i32], target: i32) -> Vec<usize> {\n    assert!(values.len() < usize::BITS as usize);\n    (0..1_usize << values.len())\n        .filter(|&mask| {\n            values\n                .iter()\n                .enumerate()\n                .filter(|(i, _)| mask >> i & 1 == 1)\n                .map(|(_, x)| x)\n                .sum::<i32>()\n                == target\n        })\n        .collect()\n}\n\nfn main() {\n    let result = csv(matching_masks(&[1, 2, 4], 5));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"matching_masks","statement":"assert!(values.len() < usize::BITS as usize);"},{"line":9,"function":"matching_masks","statement":"(0..1_usize << values.len())"},{"line":11,"function":"closure · line 10","statement":"values"},{"line":14,"function":"closure · line 14","statement":"mask >> i & 1 == 1"},{"line":15,"function":"closure · line 15","statement":"x"},{"line":23,"function":"main","statement":"let result = csv(matching_masks(&[1, 2, 4], 5));"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"values=[1,2,4]","stdout":"5\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"&