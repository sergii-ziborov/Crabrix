{"key":"edit-distance-2e454ba7032f5ac9","sourceHash":"2e454ba7032f5ac967819f126d5b14a62233fe2b1e4365020b0603ac5ee6bcc4","pattern":"edit-distance","category":"dynamic-2d","title":"Edit Distance: Mental Model","idea":"Each state chooses insert, delete, or replace from adjacent smaller prefixes.","complexity":"O(n*m) time · O(m) row state in this example","source":"fn edit_distance(a: &str, b: &str) -> usize {\n    assert!(a.is_ascii() && b.is_ascii());\n    let mut dp: Vec<_> = (0..=b.len()).collect();\n    for (i, x) in a.bytes().enumerate() {\n        let mut next = vec![i + 1];\n        for (j, y) in b.bytes().enumerate() {\n            next.push(\n                (next[j] + 1)\n                    .min(dp[j + 1] + 1)\n                    .min(dp[j] + usize::from(x != y)),\n            );\n        }\n        dp = next;\n    }\n    dp[b.len()]\n}\n\nfn main() {\n    let result = edit_distance(\"horse\", \"ros\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"edit_distance","statement":"assert!(a.is_ascii() && b.is_ascii());"},{"line":3,"function":"edit_distance","statement":"let mut dp: Vec<_> = (0..=b.len()).collect();"},{"line":4,"function":"edit_distance","statement":"for (i, x) in a.bytes().enumerate() {"},{"line":5,"function":"edit_distance","statement":"let mut next = vec![i + 1];"},{"line":6,"function":"edit_distance","statement":"for (j, y) in b.bytes().enumerate() {"},{"line":7,"function":"edit_distance","statement":"next.push("},{"line":12,"function":"edit_distance","statement":"}"},{"line":13,"function":"edit_distance","statement":"dp = next;"},{"line":14,"function":"edit_distance","statement":"}"},{"line":15,"function":"edit_distance","statement":"dp[b.len()]"},{"line":19,"function":"main","statement":"let result = edit_distance(\"horse\", \"ros\").to_string();"},{"line":20,"function":"main","statement":"println!(\"{result}\");"},{"line":21,"function":"main","statement":"}"}],"version":1,"input":"horse -> ros","stdout":"3\