{"key":"zero-one-bfs-db987290aec05c1a","sourceHash":"db987290aec05c1a2c5fa22393ebc965a58844e96008ac53cddd87b85c87d95f","pattern":"zero-one-bfs","category":"weighted-graphs","title":"0–1 BFS: Mental Model","idea":"Push zero-cost edges to the deque front and unit-cost edges to the back.","complexity":"O(V+E) time · O(V) space","source":"fn zero_one_distance(graph: &[Vec<(usize, i64)>], start: usize, goal: usize) -> i64 {\n    let mut distance = vec![i64::MAX; graph.len()];\n    distance[start] = 0;\n    let mut deque = std::collections::VecDeque::from([(start, 0)]);\n    while let Some((v, cost)) = deque.pop_front() {\n        if distance[v] != cost {\n            continue;\n        }\n        for &(u, w) in &graph[v] {\n            assert!(w == 0 || w == 1);\n            if cost + w < distance[u] {\n                distance[u] = cost + w;\n                if w == 0 {\n                    deque.push_front((u, cost));\n                } else {\n                    deque.push_back((u, cost + 1));\n                }\n            }\n        }\n    }\n    if distance[goal] == i64::MAX {\n        -1\n    } else {\n        distance[goal]\n    }\n}\n\nfn main() {\n    let result = zero_one_distance(\n        &[\n            vec![(1, 0), (2, 1)],\n            vec![(0, 0), (2, 0)],\n            vec![(0, 1), (1, 0), (3, 1)],\n            vec![(2, 1)],\n        ],\n        0,\n        3,\n    )\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"zero_one_distance","statement":"let mut distance = vec![i64::MAX; graph.len()];"},{"line":3,"function":"zero_one_distance","statement":"distance[start] = 0;"},{"line":4,"function":"zero_one_distance","statement":"let mut deque = std::collections::VecDeque::from([(start, 0)]);"},{"line":5,"function":"zero_one_distance","statement":"while let Some((v, cost)) = deque.pop_front() {"},{"line":6,"function":"zero_one_distance","statement":"if distance[v] != cost {"},{"line":7,"function":"zero_one_distance","state