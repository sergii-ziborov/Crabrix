{"key":"graph-dfs-04f71f052676c55f","sourceHash":"04f71f052676c55f4c57998f945e770b08c41d34553d123fe69b19cd56389343","pattern":"graph-dfs","category":"graph-traversal","title":"Graph DFS: Mental Model","idea":"Explore one branch fully while marking nodes before following outgoing edges.","complexity":"O(V+E) traversal; neighbor sorting adds sum(deg log deg) · O(V+E) copied graph","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn dfs_order(graph: &[Vec<usize>], start: usize) -> Vec<usize> {\n    fn visit(v: usize, g: &[Vec<usize>], seen: &mut [bool], out: &mut Vec<usize>) {\n        seen[v] = true;\n        out.push(v);\n        for &u in &g[v] {\n            if !seen[u] {\n                visit(u, g, seen, out);\n            }\n        }\n    }\n    let mut sorted = graph.to_vec();\n    for ns in &mut sorted {\n        ns.sort_unstable();\n    }\n    let mut out = Vec::new();\n    visit(start, &sorted, &mut vec![false; graph.len()], &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(dfs_order(\n        &[vec![1, 2], vec![0, 3], vec![0, 4], vec![1], vec![2]],\n        0,\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":17,"function":"dfs_order","statement":"let mut sorted = graph.to_vec();"},{"line":18,"function":"dfs_order","statement":"for ns in &mut sorted {"},{"line":19,"function":"dfs_order","statement":"ns.sort_unstable();"},{"line":20,"function":"dfs_order","statement":"}"},{"line":21,"function":"dfs_order","statement":"let mut out = Vec::new();"},{"line":22,"function":"dfs_order","statement":"visit(start, &sorted, &mut vec![false; graph.len()], &mut out);"},{"line":23,"function":"dfs_order","statement":"out"},{"line":9,"function":"visit","statement":"seen[v] = true;"},{"line":10,"function":"visit","statement":"out.push(v);"},{"line":11,"function":"visit","statement":"for &u in &g[v] {"},{"line":12,