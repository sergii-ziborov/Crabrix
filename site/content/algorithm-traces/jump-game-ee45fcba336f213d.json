{"key":"jump-game-ee45fcba336f213d","sourceHash":"ee45fcba336f213d042130c87b6d21d820268d83254f573a6c2b696e5ca2f0b5","pattern":"jump-game","category":"greedy-intervals","title":"Challenge: Greedy Reach Frontier","idea":"Maintain the farthest reachable index and fail only when the scan moves beyond it.","complexity":"O(n) time · O(1) space","source":"fn can_reach(values: &[usize]) -> bool {\n    if values.is_empty() {\n        return false;\n    }\n    let mut farthest = 0;\n    for (i, &jump) in values.iter().enumerate() {\n        if i > farthest {\n            return false;\n        }\n        farthest = farthest.max(i + jump);\n        if farthest >= values.len() - 1 {\n            return true;\n        }\n    }\n    false\n}\n\nfn main() {\n    let result = can_reach(&[3, 2, 1, 0, 4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"can_reach","statement":"if values.is_empty() {"},{"line":3,"function":"can_reach","statement":"return false;"},{"line":5,"function":"can_reach","statement":"let mut farthest = 0;"},{"line":6,"function":"can_reach","statement":"for (i, &jump) in values.iter().enumerate() {"},{"line":7,"function":"can_reach","statement":"if i > farthest {"},{"line":8,"function":"can_reach","statement":"return false;"},{"line":10,"function":"can_reach","statement":"farthest = farthest.max(i + jump);"},{"line":11,"function":"can_reach","statement":"if farthest >= values.len() - 1 {"},{"line":12,"function":"can_reach","statement":"return true;"},{"line":15,"function":"can_reach","statement":"false"},{"line":19,"function":"main","statement":"let result = can_reach(&[3, 2, 1, 0, 4]).to_string();"},{"line":20,"function":"main","statement":"println!(\"{result}\");"},{"line":21,"function":"main","statement":"}"}],"version":1,"input":"[3,2,1,0,4]","stdout":"false\n","values":[{"type":"&[usize]","data":{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"1"},{"kind":"scalar","text