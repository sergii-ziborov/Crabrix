{"key":"slow-fast-e319704e354fb924","sourceHash":"e319704e354fb924ba80429bccdfc95463e15a316f28bab6ed9d8f6bd9ac0d52","pattern":"slow-fast","category":"two-pointers","title":"Slow/Fast Pointers: Mental Model","idea":"Advance pointers at different rates so relative motion reveals a midpoint or cycle.","complexity":"O(n) time · O(1) space","source":"fn middle_value(values: &[i32]) -> i32 {\n    assert!(!values.is_empty());\n    let (mut slow, mut fast) = (0, 0);\n    while fast + 1 < values.len() {\n        slow += 1;\n        fast += 2;\n    }\n    values[slow] // second middle for an even-length sequence\n}\n\nfn main() {\n    let result = middle_value(&[4, 8, 15, 16, 23, 42]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"middle_value","statement":"assert!(!values.is_empty());"},{"line":3,"function":"middle_value","statement":"let (mut slow, mut fast) = (0, 0);"},{"line":4,"function":"middle_value","statement":"while fast + 1 < values.len() {"},{"line":5,"function":"middle_value","statement":"slow += 1;"},{"line":6,"function":"middle_value","statement":"fast += 2;"},{"line":7,"function":"middle_value","statement":"}"},{"line":8,"function":"middle_value","statement":"values[slow]"},{"line":12,"function":"main","statement":"let result = middle_value(&[4, 8, 15, 16, 23, 42]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[4,8,15,16,23,42]","stdout":"16\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"15"},{"kind":"scalar","text":"16"},{"kind":"scalar","text":"23"},{"kind":"scalar","text":"42"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"