{"key":"kmp-b31f164eca10e9f5","sourceHash":"b31f164eca10e9f501206b88b76c822912e70236e95017f75beaa30db1610914","pattern":"kmp","category":"strings-tries","title":"Challenge: Knuth–Morris–Pratt","idea":"Use the pattern's border table to reuse matched-prefix knowledge after a mismatch.","complexity":"O(n+m) time · O(m) space","source":"fn kmp_first(text: &str, pattern: &str) -> i32 {\n    let (a, p) = (text.as_bytes(), pattern.as_bytes());\n    if p.is_empty() {\n        return 0;\n    }\n    let mut prefix = vec![0; p.len()];\n    for i in 1..p.len() {\n        let mut j = prefix[i - 1];\n        while j > 0 && p[i] != p[j] {\n            j = prefix[j - 1];\n        }\n        if p[i] == p[j] {\n            j += 1;\n        }\n        prefix[i] = j;\n    }\n    let mut matched = 0;\n    for (i, &c) in a.iter().enumerate() {\n        while matched > 0 && c != p[matched] {\n            matched = prefix[matched - 1];\n        }\n        if c == p[matched] {\n            matched += 1;\n        }\n        if matched == p.len() {\n            return (i + 1 - p.len()) as i32;\n        }\n    }\n    -1 // byte offset; exercises use ASCII\n}\n\nfn main() {\n    let result = kmp_first(\"aaaa\", \"aa\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"kmp_first","statement":"let (a, p) = (text.as_bytes(), pattern.as_bytes());"},{"line":3,"function":"kmp_first","statement":"if p.is_empty() {"},{"line":4,"function":"kmp_first","statement":"return 0;"},{"line":6,"function":"kmp_first","statement":"let mut prefix = vec![0; p.len()];"},{"line":7,"function":"kmp_first","statement":"for i in 1..p.len() {"},{"line":8,"function":"kmp_first","statement":"let mut j = prefix[i - 1];"},{"line":9,"function":"kmp_first","statement":"while j > 0 && p[i] != p[j] {"},{"line":10,"function":"kmp_first","statement":"j = prefix[j - 1];"},{"line":11,"function":"kmp_first","statement":"}"},{"line":12,"function":"kmp_first","statement":"if p[i] == p[j] {"},{"line":13,"funct