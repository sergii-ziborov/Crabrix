{"key":"delimiter-stack-81e91de150de6261","sourceHash":"81e91de150de626158494a45ce7e4d4b7ba0c70b36ffe35e44f185e832c5682d","pattern":"delimiter-stack","category":"stacks-queues","title":"Challenge: Delimiter Stack","idea":"Push open delimiters and require every close to match the most recent open.","complexity":"O(n) time · O(n) space","source":"fn balanced(text: &str) -> bool {\n    let mut stack = Vec::new();\n    for c in text.chars() {\n        match c {\n            '(' | '[' | '{' => stack.push(c),\n            ')' | ']' | '}' => {\n                let expected = match c {\n                    ')' => '(',\n                    ']' => '[',\n                    _ => '{',\n                };\n                if stack.pop() != Some(expected) {\n                    return false;\n                }\n            }\n            _ => {}\n        }\n    }\n    stack.is_empty()\n}\n\nfn main() {\n    let result = balanced(\"([)]\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"balanced","statement":"let mut stack = Vec::new();"},{"line":3,"function":"balanced","statement":"for c in text.chars() {"},{"line":4,"function":"balanced","statement":"match c {"},{"line":7,"function":"balanced","statement":"let expected = match c {"},{"line":12,"function":"balanced","statement":"if stack.pop() != Some(expected) {"},{"line":13,"function":"balanced","statement":"return false;"},{"line":16,"function":"balanced","statement":"}"},{"line":19,"function":"balanced","statement":"stack.is_empty()"},{"line":23,"function":"main","statement":"let result = balanced(\"([)]\").to_string();"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"([)]","stdout":"false\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"([)]\""}},{"type":"alloc::vec::Vec<char>","data":{"kind":"list","items":[],"tuple":false}},{"type":"char","data":{"kind":"scalar","text":"'('"}},{"type":"alloc: