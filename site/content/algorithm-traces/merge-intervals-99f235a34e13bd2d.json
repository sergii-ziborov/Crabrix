{"key":"merge-intervals-99f235a34e13bd2d","sourceHash":"99f235a34e13bd2d317027e1e3afc4476932048de3f9e8f6263397c83a35da1a","pattern":"merge-intervals","category":"greedy-intervals","title":"Merge Intervals: Mental Model","idea":"Sort by start and extend the current interval while the next one overlaps.","complexity":"O(n log n) time · O(n) output","source":"fn merged_intervals(intervals: &[(i32, i32)]) -> Vec<(i32, i32)> {\n    let mut sorted = intervals.to_vec();\n    sorted.sort_unstable();\n    let mut out: Vec<(i32, i32)> = Vec::new();\n    for (s, e) in sorted {\n        if let Some(last) = out.last_mut() {\n            if s <= last.1 {\n                last.1 = last.1.max(e);\n                continue;\n            }\n        }\n        out.push((s, e));\n    }\n    out\n}\n\nfn main() {\n    let result = merged_intervals(&[(1, 3), (2, 6), (8, 10), (9, 12)])\n        .iter()\n        .map(|(a, b)| format!(\"{a}-{b}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"merged_intervals","statement":"let mut sorted = intervals.to_vec();"},{"line":3,"function":"merged_intervals","statement":"sorted.sort_unstable();"},{"line":4,"function":"merged_intervals","statement":"let mut out: Vec<(i32, i32)> = Vec::new();"},{"line":5,"function":"merged_intervals","statement":"for (s, e) in sorted {"},{"line":6,"function":"merged_intervals","statement":"if let Some(last) = out.last_mut() {"},{"line":7,"function":"merged_intervals","statement":"if s <= last.1 {"},{"line":8,"function":"merged_intervals","statement":"last.1 = last.1.max(e);"},{"line":9,"function":"merged_intervals","statement":"continue;"},{"line":12,"function":"merged_intervals","statement":"out.push((s, e));"},{"line":13,"function":"merged_intervals","statement":"}"},{"line":14,"function":"merged_intervals","statement":"out"},{"line":18,"function":"main","statement":"let result = merged_intervals(&[(1, 3), (2, 6), (8, 10), (9, 12)])"},{"line"