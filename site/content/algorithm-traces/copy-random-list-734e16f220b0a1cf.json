{"key":"copy-random-list-734e16f220b0a1cf","sourceHash":"734e16f220b0a1cfedbbd9d8677d23795f9cdd24e5fe12445f510b3a35a2f6d9","pattern":"copy-random-list","category":"linked-lists","title":"Challenge: Copy with Random Links","idea":"Map old nodes to new nodes or interleave copies so arbitrary links can be reconstructed.","complexity":"O(n) time · O(n) separate index-arena storage","source":"#[derive(Clone, Debug, PartialEq)]\nstruct RandomNode {\n    value: i32,\n    next: Option<usize>,\n    random: Option<usize>,\n}\nfn deep_copy(arena: &[RandomNode]) -> Vec<RandomNode> {\n    // Index edges refer within this arena. Cloning all records allocates a\n    // separate arena; identical indexes now refer to the copied nodes.\n    arena.to_vec()\n}\nfn copied_pairs(values: &[i32], random: &[Option<usize>]) -> String {\n    let original: Vec<_> = values\n        .iter()\n        .enumerate()\n        .map(|(i, &value)| RandomNode {\n            value,\n            next: (i + 1 < values.len()).then_some(i + 1),\n            random: random[i],\n        })\n        .collect();\n    let mut copy = deep_copy(&original);\n    assert_eq!(original, copy);\n    let out = copy\n        .iter()\n        .map(|n| {\n            format!(\n                \"{}:{}\",\n                n.value,\n                n.random.map_or(\"null\".into(), |i| i.to_string())\n            )\n        })\n        .collect::<Vec<_>>()\n        .join(\",\");\n    if !copy.is_empty() {\n        copy[0].value += 1;\n        assert_ne!(original[0].value, copy[0].value);\n    }\n    out\n}\n\nfn main() {\n    let result = copied_pairs(&[1], &[None]);\n    println!(\"{result}\");\n}\n","sites":[{"line":10,"function":"deep_copy","statement":"arena.to_vec()"},{"line":13,"function":"copied_pairs","statement":"let original: Vec<_> = values"},{"line":22,"function":"copied_pairs","statement":"let mut copy = deep_copy(&original);"},{"line":23,"function":"copied_pairs","statement":"assert_eq!(original, copy);"},{"line":24,"function":"copied_pairs","statement":"let out = copy"},{"line":35,"function":"copied_pairs","statement":"if !copy.is_empty() {"},{"line":36,"function":"copied_pairs","statement":"copy[0].value += 1;"},{"line":37,"function":"copied_pairs","statement":"assert_ne!(original[0].value, copy[0].value);"},{"line":38,"function":"copied_pairs","statement":"}"},{"line":39,"function":"copied_pairs","statement":"out"},{"line":16,"function":"closure · line 16","statement":"RandomNode {"},{"line":27,"function":"closure · line 26","statement":"format!("},{"line":43,"function":"main","statement":"let result = copied_pairs(&[1], &[None]);"},{"line":44,"function":"main","statement":"println!(\"{result}\");"},{"line":45,"function":"main","statement":"}"}],"version":1,"input":"values=[1] random=[null]","stdout":"1:null\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"&[core::option::Option<usize>]","data":{"kind":"list","items":[{"kind":"scalar","text":"None"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"alloc::vec::Vec<traced::RandomNode>","data":{"kind":"list","items":[{"kind":"named","name":"RandomNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"random"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":false}},{"type":"&[traced::RandomNode]","data":{"kind":"list","items":[{"kind":"named","name":"RandomNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"random"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":false}},{"type":"&traced::RandomNode","data":{"kind":"named","name":"RandomNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"random"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1:null\""}},{"type":"alloc::vec::Vec<traced::RandomNode>","data":{"kind":"list","items":[{"kind":"named","name":"RandomNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"random"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"2"}]]}}],"tuple":false}}],"frames":[{"site":12,"stack":[["main",1]],"locals":[]},{"site":1,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1]]},{"site":10,"stack":[["main",1],["copied_pairs",2],["closure · line 16",3]],"locals":[["i",2],["value",3],["values",0],["random",1]]},{"site":2,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4]]},{"site":0,"stack":[["main",1],["copied_pairs",2],["deep_copy",4]],"locals":[["arena",5]]},{"site":3,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",4]]},{"site":4,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",4]]},{"site":11,"stack":[["main",1],["copied_pairs",2],["closure · line 26",5]],"locals":[["n",6],["original",4],["copy",4],["values",0],["random",1]]},{"site":5,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",4],["out",7]]},{"site":6,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",4],["out",7]]},{"site":7,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",8],["out",7]]},{"site":8,"stack":[["main",1],["copied_pairs",2]],"locals":[["values",0],["random",1],["original",4],["copy",8],["out",7]]},{"site":9,"stack":[["main",1],["copied_pairs",2]],"