{"key":"delimiter-stack-258781d78d01f218","sourceHash":"258781d78d01f218676283127ab182a41230f891263eb03ba074644ae84504e7","pattern":"delimiter-stack","category":"stacks-queues","title":"Delimiter Stack: Mental Model","idea":"Push open delimiters and require every close to match the most recent open.","complexity":"O(n) time · O(n) space","source":"fn balanced(text: &str) -> bool {\n    let mut stack = Vec::new();\n    for c in text.chars() {\n        match c {\n            '(' | '[' | '{' => stack.push(c),\n            ')' | ']' | '}' => {\n                let expected = match c {\n                    ')' => '(',\n                    ']' => '[',\n                    _ => '{',\n                };\n                if stack.pop() != Some(expected) {\n                    return false;\n                }\n            }\n            _ => {}\n        }\n    }\n    stack.is_empty()\n}\n\nfn main() {\n    let result = balanced(\"{[()()]}[]\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"balanced","statement":"let mut stack = Vec::new();"},{"line":3,"function":"balanced","statement":"for c in text.chars() {"},{"line":4,"function":"balanced","statement":"match c {"},{"line":7,"function":"balanced","statement":"let expected = match c {"},{"line":12,"function":"balanced","statement":"if stack.pop() != Some(expected) {"},{"line":13,"function":"balanced","statement":"return false;"},{"line":16,"function":"balanced","statement":"}"},{"line":19,"function":"balanced","statement":"stack.is_empty()"},{"line":23,"function":"main","statement":"let result = balanced(\"{[()()]}[]\").to_string();"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"{[()()]}[]","stdout":"true\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"{[()()]}[]\""}},{"type":"alloc::vec::Vec<char>","data":{"kind":"list","items":[],"tuple":false}},{"type":"char","data":{"kind":"scalar","tex