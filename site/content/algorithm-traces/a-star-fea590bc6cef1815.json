{"key":"a-star-fea590bc6cef1815","sourceHash":"fea590bc6cef1815dc917467da9d8513de282789c554c6d512c153588fe197b8","pattern":"a-star","category":"weighted-graphs","title":"Challenge: A* Search","idea":"Prioritize distance-so-far plus an admissible estimate that never overstates remaining cost.","complexity":"O((V+E) log V) on this finite four-neighbor grid with consistent heuristic","source":"fn grid_a_star(rows: usize, cols: usize, start: (usize, usize), goal: (usize, usize)) -> usize {\n    let heuristic = |(r, c): (usize, usize)| r.abs_diff(goal.0) + c.abs_diff(goal.1);\n    let mut distance = vec![vec![usize::MAX; cols]; rows];\n    distance[start.0][start.1] = 0;\n    let mut heap =\n        std::collections::BinaryHeap::from([std::cmp::Reverse((heuristic(start), 0, start))]);\n    while let Some(std::cmp::Reverse((_, cost, (r, c)))) = heap.pop() {\n        if cost != distance[r][c] {\n            continue;\n        }\n        if (r, c) == goal {\n            return cost;\n        }\n        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {\n            let (nr, nc) = (r as isize + dr, c as isize + dc);\n            if nr < 0 || nc < 0 || nr >= rows as isize || nc >= cols as isize {\n                continue;\n            }\n            let next = (nr as usize, nc as usize);\n            if cost + 1 < distance[next.0][next.1] {\n                distance[next.0][next.1] = cost + 1;\n                heap.push(std::cmp::Reverse((\n                    cost + 1 + heuristic(next),\n                    cost + 1,\n                    next,\n                )));\n            }\n        }\n    }\n    unreachable!(\"empty grid has a path\")\n}\n\nfn main() {\n    let result = grid_a_star(4, 4, (0, 0), (1, 1)).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"grid_a_star","statement":"let heuristic = |(r, c): (usize, usize)| r.abs_diff(goal.0) + c.abs_diff(goal.1);"},{"line":3,"function":"grid_a_star","statement":"let mut distance = vec![vec![