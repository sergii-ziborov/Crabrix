{"key":"bucket-sort-14ba0d4e757ef825","sourceHash":"14ba0d4e757ef825b6e764ce4527316d576ddb928407584e0e7de0890f608221","pattern":"bucket-sort","category":"sorting-selection","title":"Challenge: Bucket Sort","idea":"Distribute values into range buckets, sort locally, and concatenate in bucket order.","complexity":"O(n+k) average · O(n^2) worst · O(n+k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn bucket_sort(values: &[f64]) -> Vec<f64> {\n    if values.is_empty() {\n        return Vec::new();\n    }\n    let n = values.len();\n    let mut buckets = vec![Vec::new(); n];\n    for &x in values {\n        assert!((0.0..1.0).contains(&x));\n        buckets[(x * n as f64) as usize].push(x);\n    }\n    for bucket in &mut buckets {\n        for i in 1..bucket.len() {\n            let mut j = i;\n            while j > 0 && bucket[j] < bucket[j - 1] {\n                bucket.swap(j, j - 1);\n                j -= 1;\n            }\n        }\n    }\n    buckets.into_iter().flatten().collect()\n}\n\nfn main() {\n    let result = csv(bucket_sort(&[0.9, 0.1]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"bucket_sort","statement":"if values.is_empty() {"},{"line":9,"function":"bucket_sort","statement":"return Vec::new();"},{"line":11,"function":"bucket_sort","statement":"let n = values.len();"},{"line":12,"function":"bucket_sort","statement":"let mut buckets = vec![Vec::new(); n];"},{"line":13,"function":"bucket_sort","statement":"for &x in values {"},{"line":14,"function":"bucket_sort","statement":"assert!((0.0..1.0).contains(&x));"},{"line":15,"function":"bucket_sort","statement":"buckets[(x * n as f64) as usize].push(x);"},{"line":16,"function":"bucket_sort","statement":"}"},{"line":17,"function":"bucket_sort","statement":"for bucket in &mut buckets {"},{"line":18,"function":"bucket_sort","statement":"fo