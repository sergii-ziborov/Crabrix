{"key":"tree-postorder-c42314b1cd8c025d","sourceHash":"c42314b1cd8c025d7714549e680af3d31f3dc1b0d43e2ec2581f3f97dffaf399","pattern":"tree-postorder","category":"trees","title":"Challenge: Postorder DFS","idea":"Process children before the node so child results are complete when combined.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn postorder(root: &Tree) -> Vec<i32> {\n    fn visit(root: &Tree, out: &mut Vec<i32>) {\n        if let Some(n) = root {\n            visit(&n.left, out);\n            visit(&n.right, out);\n            out.push(n.value);\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(postorder(&node(\n        1,\n        node(2, None, None),\n        node(3, None, None),\n    )));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":24,"function":"postorder","statement":"let mut out = Vec::new();"},{"line":25,"function":"postorder","statement":"visit(root, &mut out);"},{"line":26,"function":"postorder","statement":"out"},{"line":18,"function":"visit","statement":"if let Some(n) = root {"},{"line":19,"function":"visit","statement":"visit(&n.left, out);"},{"line":20,"function":"visit","statement":"visit(&n.right, out);"},{"line":21,"function":"visit","statement":"out.push(n.value);"},{"line":22,"function":"visit","statement":"}"},{"line":30,"function":"main","statement":"let result = csv(postorder(&node("},{"line":35,"function":"main","statement":"println!(\"{result}\");"},{"line":36,"function":"main","stat