{"key":"palindrome-pointers-f2aac9617e8fa811","sourceHash":"f2aac9617e8fa811c9556bf852b4a2b182a3b6d1ac4691f44a20f91ba0f4945a","pattern":"palindrome-pointers","category":"two-pointers","title":"Challenge: Palindrome Pointers","idea":"Compare normalized symbols from the outside inward and skip irrelevant input.","complexity":"O(n) time · O(1) space","source":"fn ascii_palindrome(text: &str) -> bool {\n    assert!(text.is_ascii());\n    let bytes = text.as_bytes();\n    let (mut left, mut right) = (0, bytes.len());\n    while left < right {\n        if !bytes[left].is_ascii_alphanumeric() {\n            left += 1;\n            continue;\n        }\n        if !bytes[right - 1].is_ascii_alphanumeric() {\n            right -= 1;\n            continue;\n        }\n        if !bytes[left].eq_ignore_ascii_case(&bytes[right - 1]) {\n            return false;\n        }\n        left += 1;\n        right -= 1;\n    }\n    true\n}\n\nfn main() {\n    let result = ascii_palindrome(\"Rust\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"ascii_palindrome","statement":"assert!(text.is_ascii());"},{"line":3,"function":"ascii_palindrome","statement":"let bytes = text.as_bytes();"},{"line":4,"function":"ascii_palindrome","statement":"let (mut left, mut right) = (0, bytes.len());"},{"line":5,"function":"ascii_palindrome","statement":"while left < right {"},{"line":6,"function":"ascii_palindrome","statement":"if !bytes[left].is_ascii_alphanumeric() {"},{"line":7,"function":"ascii_palindrome","statement":"left += 1;"},{"line":8,"function":"ascii_palindrome","statement":"continue;"},{"line":10,"function":"ascii_palindrome","statement":"if !bytes[right - 1].is_ascii_alphanumeric() {"},{"line":11,"function":"ascii_palindrome","statement":"right -= 1;"},{"line":12,"function":"ascii_palindrome","statement":"continue;"},{"line":14,"function":"ascii_palindrome","statement":"if !bytes[left].eq_ignore_ascii_case(&bytes[right - 1]) {"},{"line":15,"function":"ascii_palindrome","statement":"return false;"},{"line":17,"function":"ascii_palindrome","statement":"left += 1;"},{"line":18,"function":"ascii_palindrome","statement":"right -= 1;"},{"line":19,"function":"ascii_palindrome","statement":"}"},{"line":20,"function":"ascii_palindrome","statement":"true"},{"line":24,"function":"main","statement":"let result = ascii_palindrome(\"Rust\").to_string();"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"Rust","stdout":"false\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"Rust\""}},{"type":"&[u8]","data":{"kind":"list","items":[{"kind":"scalar","text":"82"},{"kind":"scalar","text":"117"},{"kind":"scalar","text":"115"},{"kind":"scalar","text":"116"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"false\""}}],"frames":[{"site":16,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0]]},{"site":1,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0]]},{"site":2,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1]]},{"site":3,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1],["left",2],["right",3]]},{"site":4,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1],["left",2],["right",3]]},{"site":7,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1],["left",2],["right",3]]},{"site":10,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1],["left",2],["right",3]]},{"site":11,"stack":[["main",1],["ascii_palindrome",2]],"locals":[["text",0],["bytes",1],["left",2],["right",3]]},{"site":17,"stack":[["main",1]],"locals":[["result",4]]},{"site":18,"stack":[["main",1]],"locals":[["result",4]]}],"verification":{"stdoutMatchesO