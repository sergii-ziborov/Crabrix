{"key":"first-last-position-d4e879e1575074f1","sourceHash":"d4e879e1575074f15f92048ed4fb9a446b2fb2e588df05633a2bae9d9625d608","pattern":"first-last-position","category":"binary-search","title":"First and Last Position: Mental Model","idea":"Run two boundary searches instead of expanding linearly from one match.","complexity":"O(log n) time · O(1) space","source":"fn first_last(a: &[i32], target: i32) -> (i32, i32) {\n    let bound = |upper: bool| {\n        let (mut lo, mut hi) = (0, a.len());\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            if a[mid] < target || (upper && a[mid] == target) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    };\n    let first = bound(false);\n    if a.get(first) != Some(&target) {\n        (-1, -1)\n    } else {\n        (first as i32, bound(true) as i32 - 1)\n    }\n}\n\nfn main() {\n    let result = {\n        let (a, b) = first_last(&[5, 7, 7, 8, 8, 10], 8);\n        format!(\"{a},{b}\")\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"first_last","statement":"let bound = |upper: bool| {"},{"line":14,"function":"first_last","statement":"let first = bound(false);"},{"line":15,"function":"first_last","statement":"if a.get(first) != Some(&target) {"},{"line":16,"function":"first_last","statement":"(-1, -1)"},{"line":18,"function":"first_last","statement":"(first as i32, bound(true) as i32 - 1)"},{"line":3,"function":"closure · line 2","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":4,"function":"closure · line 2","statement":"while lo < hi {"},{"line":5,"function":"closure · line 2","statement":"let mid = lo + (hi - lo) / 2;"},{"line":6,"function":"closure · line 2","statement":"if a[mid] < target || (upper && a[mid] == target) {"},{"line":7,"function":"closure · line 2","statement":"lo = mid + 1;"},{"line":8,"function":"closure · line 2","statement":"}"},{"line":9,"function":"closure · line 2","statement":"hi = mid;"},{"line":10,"function":"closure · line 2","statement":"}"},{"line":12,"function":"closure · line 2","statement":"lo"},{"line":23,"function":"main","statement":"let result = {"},{"line":24,"function":"main","statement":"let (a, b) = first_last(&[5, 7, 7, 8, 8, 10], 8);"},{"line":25,"function":"main","statement":"format!(\"{a},{b}\")"},{"line":27,"function":"main","statement":"println!(\"{result}\");"},{"line":28,"function":"main","statement":"}"}],"version":1,"input":"[5,7,7,8,8,10]","stdout":"3,4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"10"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"8"}},{"type":"bool","data":{"kind":"scalar","text":"false"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"6"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"bool","data":{"kind":"scalar","text":"true"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"3,4\""}}],"frames":[{"site":14,"stack":[["main",1]],"locals":[]},{"site":15,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["first_last",2]],"locals":[["a",0],["target",1]]},{"site":1,"stack":[["main",1],["first_last",2]],"locals":[["a",0],["target",1]]},{"site":5,"stack":[["main",1],["first_last",2],["closure · line 2",3]],"locals":[["upper",2],["a",0],["target",1]]},{"site":6,"stack":[["main",1],["first_last",2],["closure · line 2",3]],"locals":[["upper",2],["a",0],["target",1],["lo",3],["hi",4