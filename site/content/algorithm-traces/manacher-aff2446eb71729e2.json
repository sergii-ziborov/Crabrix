{"key":"manacher-aff2446eb71729e2","sourceHash":"aff2446eb71729e22f9ed2b8affc32971669d702fc7582ab6ef6617b00dda0ab","pattern":"manacher","category":"strings-tries","title":"Challenge: Manacher Palindrome Radii","idea":"Mirror known radii inside the rightmost palindrome and expand only beyond its boundary.","complexity":"O(n) time · O(n) space","source":"fn longest_palindrome(text: &str) -> &str {\n    assert!(text.is_ascii());\n    let mut symbols = vec![0_u16];\n    for b in text.bytes() {\n        symbols.push(b as u16 + 1);\n        symbols.push(0);\n    }\n    let n = symbols.len();\n    let mut radius = vec![0; n];\n    let (mut center, mut right) = (0, 0);\n    let (mut start, mut length) = (0, 0);\n    for i in 0..n {\n        if i < right {\n            radius[i] = radius[2 * center - i].min(right - i);\n        }\n        while radius[i] < i\n            && i + radius[i] + 1 < n\n            && symbols[i - radius[i] - 1] == symbols[i + radius[i] + 1]\n        {\n            radius[i] += 1;\n        }\n        if i + radius[i] > right {\n            center = i;\n            right = i + radius[i];\n        }\n        let candidate = (i - radius[i]) / 2;\n        if radius[i] > length || radius[i] == length && candidate < start {\n            start = candidate;\n            length = radius[i];\n        }\n    }\n    &text[start..start + length]\n}\n\nfn main() {\n    let result = longest_palindrome(\"cbbd\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"longest_palindrome","statement":"assert!(text.is_ascii());"},{"line":3,"function":"longest_palindrome","statement":"let mut symbols = vec![0_u16];"},{"line":4,"function":"longest_palindrome","statement":"for b in text.bytes() {"},{"line":5,"function":"longest_palindrome","statement":"symbols.push(b as u16 + 1);"},{"line":6,"function":"longest_palindrome","statement":"symbols.push(0);"},{"line":7,"function":"longest_palindrome","statement":"}"},{"line":8,"function":"longest_palindrome","statement":"let n = symbols.len();"},{"line":9,"function":"longest_palindrome","statement":"let mut radius = vec![0; n];"},{"line":10,"function":"longest_palindrome","statement":"let (mut center, mut right) = (0, 0);"},{"line":11,"function":"longest_palindrome","statement":"let (mut start, mut length) = (0, 0);"},{"line":12,"function":"longest_palindrome","statement":"for i in 0..n {"},{"line":13,"function":"longest_palindrome","statement":"if i < right {"},{"line":14,"function":"longest_palindrome","statement":"radius[i] = radius[2 * center - i].min(right - i);"},{"line":15,"function":"longest_palindrome","statement":"}"},{"line":16,"function":"longest_palindrome","statement":"while radius[i] < i"},{"line":20,"function":"longest_palindrome","statement":"radius[i] += 1;"},{"line":21,"function":"longest_palindrome","statement":"}"},{"line":22,"function":"longest_palindrome","statement":"if i + radius[i] > right {"},{"line":23,"function":"longest_palindrome","statement":"center = i;"},{"line":24,"function":"longest_palindrome","statement":"right = i + radius[i];"},{"line":25,"function":"longest_palindrome","statement":"}"},{"line":26,"function":"longest_palindrome","statement":"let candidate = (i - radius[i]) / 2;"},{"line":27,"function":"longest_palindrome","statement":"if radius[i] > length || radius[i] == length && candidate < start {"},{"line":28,"function":"longest_palindrome","statement":"start = candidate;"},{"line":29,"function":"longest_palindrome","statement":"length = radius[i];"},{"line":30,"function":"longest_palindrome","statement":"}"},{"line":32,"function":"longest_palindrome","statement":"&text[start..start + length]"},{"line":36,"function":"main","statement":"let result = longest_palindrome(\"cbbd\").to_string();"},{"line":37,"function":"main","statement":"println!(\"{result}\");"},{"line":38,"function":"main","statement":"}"}],"version":1,"input":"cbbd","stdout":"bb\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"cbbd\""}},{"typ