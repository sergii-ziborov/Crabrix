{"key":"subsets-83e190cf1b827b79","sourceHash":"83e190cf1b827b79fb3e1197a1dfcfd0bf085e8235e68b37436712e2b7501a03","pattern":"subsets","category":"backtracking","title":"Challenge: Subset Generation","idea":"At each item branch on exclude or include, or extend every current subset.","complexity":"O(n*2^n) time · O(n*2^n) materialized output","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn semicolon<T: std::fmt::Display>(a: Vec<Vec<T>>) -> String {\n    a.into_iter().map(csv).collect::<Vec<_>>().join(\";\")\n}\nfn subsets_in_mask_order(values: &[i32]) -> Vec<Vec<i32>> {\n    assert!(values.len() < usize::BITS as usize);\n    (0..1_usize << values.len())\n        .map(|mask| {\n            values\n                .iter()\n                .enumerate()\n                .filter_map(|(i, &x)| (mask >> i & 1 == 1).then_some(x))\n                .collect()\n        })\n        .collect()\n}\n\nfn main() {\n    let result = semicolon(subsets_in_mask_order(&[9]));\n    println!(\"{result}\");\n}\n","sites":[{"line":11,"function":"subsets_in_mask_order","statement":"assert!(values.len() < usize::BITS as usize);"},{"line":12,"function":"subsets_in_mask_order","statement":"(0..1_usize << values.len())"},{"line":14,"function":"closure · line 13","statement":"values"},{"line":17,"function":"closure · line 17","statement":"(mask >> i & 1 == 1).then_some(x)"},{"line":24,"function":"main","statement":"let result = semicolon(subsets_in_mask_order(&[9]));"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"[9]","stdout":";9\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"9"}},{"type":"usize","data":{"kin