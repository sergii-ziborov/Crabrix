{"key":"z-algorithm-a37772f427979f43","sourceHash":"a37772f427979f43a7d4e2e84b4b2d7320f3b517cc39de1464dc7ed2bc4175d9","pattern":"z-algorithm","category":"strings-tries","title":"Challenge: Z Algorithm","idea":"Reuse the rightmost prefix-matching box to compute how much of the prefix matches at every position.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn z_values(text: &str) -> Vec<usize> {\n    let a = text.as_bytes();\n    let n = a.len();\n    let mut z = vec![0; n];\n    let (mut left, mut right) = (0, 0);\n    for i in 1..n {\n        if i < right {\n            z[i] = z[i - left].min(right - i);\n        }\n        while i + z[i] < n && a[z[i]] == a[i + z[i]] {\n            z[i] += 1;\n        }\n        if i + z[i] > right {\n            left = i;\n            right = i + z[i];\n        }\n    }\n    z // convention: z[0] is zero\n}\n\nfn main() {\n    let result = csv(z_values(\"aaaa\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"z_values","statement":"let a = text.as_bytes();"},{"line":9,"function":"z_values","statement":"let n = a.len();"},{"line":10,"function":"z_values","statement":"let mut z = vec![0; n];"},{"line":11,"function":"z_values","statement":"let (mut left, mut right) = (0, 0);"},{"line":12,"function":"z_values","statement":"for i in 1..n {"},{"line":13,"function":"z_values","statement":"if i < right {"},{"line":14,"function":"z_values","statement":"z[i] = z[i - left].min(right - i);"},{"line":15,"function":"z_values","statement":"}"},{"line":16,"function":"z_values","statement":"while i + z[i] < n && a[z[i]] == a[i + z[i]] {"},{"line":17,"function":"z_values","statement":"z[i] += 1;"},{"line":18,"function":"z_values","statement":"}"},{"line":19,"function":"z_values","statement":"if i + z[i] > right {"},{"line":20,"function":"z_values","statement":"left = i;"},{"line":21,"function":"z_values","statement":"right = i + z[i];"},{"line":22,"function":"z_values","statement":"}"},{"line":24,"function":"z_values","statement":"z"},{"line":28,"function":"main","statement":"let result = csv(z_values(\"aaaa\"));"},{"line":29,"function":"main","statement":"println!(\"{result}\");"},{"line":30,"function":"main","statement":"}"}],"version":1,"input":"aaaa","stdout":"0,3,2,1\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"aaaa\""}},{"type":"&[u8]","data":{"kind":"list","items":[{"kind":"scalar","text":"97"},{"kind":"scalar","text":"97"},{"kind":"scalar","text":"97"},{"kind":"scalar","text":"97"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<usize>","data":{"kind":"list","items