{"key":"matrix-chain-3cb898a3969407a6","sourceHash":"3cb898a3969407a62a57f10f70537e5162a0777ed3491cfeae5ffbe4c2460531","pattern":"matrix-chain","category":"dynamic-2d","title":"Matrix Chain DP: Mental Model","idea":"Try every final split of an interval and combine left cost, right cost, and multiplication cost.","complexity":"O(n^3) time · O(n^2) space","source":"fn matrix_chain(dimensions: &[i64]) -> i64 {\n    assert!(dimensions.len() >= 2);\n    let n = dimensions.len() - 1;\n    let mut dp = vec![vec![0; n]; n];\n    for length in 2..=n {\n        for i in 0..=n - length {\n            let j = i + length - 1;\n            dp[i][j] = i64::MAX;\n            for k in i..j {\n                dp[i][j] = dp[i][j].min(\n                    dp[i][k] + dp[k + 1][j] + dimensions[i] * dimensions[k + 1] * dimensions[j + 1],\n                );\n            }\n        }\n    }\n    dp[0][n - 1]\n}\n\nfn main() {\n    let result = matrix_chain(&[10, 30, 5, 60]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"matrix_chain","statement":"assert!(dimensions.len() >= 2);"},{"line":3,"function":"matrix_chain","statement":"let n = dimensions.len() - 1;"},{"line":4,"function":"matrix_chain","statement":"let mut dp = vec![vec![0; n]; n];"},{"line":5,"function":"matrix_chain","statement":"for length in 2..=n {"},{"line":6,"function":"matrix_chain","statement":"for i in 0..=n - length {"},{"line":7,"function":"matrix_chain","statement":"let j = i + length - 1;"},{"line":8,"function":"matrix_chain","statement":"dp[i][j] = i64::MAX;"},{"line":9,"function":"matrix_chain","statement":"for k in i..j {"},{"line":10,"function":"matrix_chain","statement":"dp[i][j] = dp[i][j].min("},{"line":13,"function":"matrix_chain","statement":"}"},{"line":16,"function":"matrix_chain","statement":"dp[0][n - 1]"},{"line":20,"function":"main","statement":"let result = matrix_chain(&[10, 30, 5, 60]).to_string();"},{"line":21,"function":"main","statement":"println!(\"{result}\");"}