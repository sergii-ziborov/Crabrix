{"key":"dfs-topological-5fb077d758bc1cc0","sourceHash":"5fb077d758bc1cc0a959d7ea1e8f4d24fe58ace07a0bf495d87677b3f4b2d987","pattern":"dfs-topological","category":"graph-traversal","title":"DFS Topological Sort: Mental Model","idea":"Append a node after all descendants; a gray-to-gray edge proves a directed cycle.","complexity":"O(V+E) traversal; neighbor sorting adds sum(deg log deg) · O(V+E) copied graph","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn dfs_topological(graph: &[Vec<usize>]) -> Vec<usize> {\n    fn visit(v: usize, g: &[Vec<usize>], color: &mut [u8], out: &mut Vec<usize>) {\n        assert_ne!(color[v], 1, \"cycle\");\n        if color[v] == 2 {\n            return;\n        }\n        color[v] = 1;\n        for &u in &g[v] {\n            visit(u, g, color, out);\n        }\n        color[v] = 2;\n        out.push(v);\n    }\n    let mut sorted = graph.to_vec();\n    for ns in &mut sorted {\n        ns.sort_unstable();\n    }\n    let mut color = vec![0; graph.len()];\n    let mut out = Vec::new();\n    for v in 0..graph.len() {\n        if color[v] == 0 {\n            visit(v, &sorted, &mut color, &mut out);\n        }\n    }\n    out.reverse();\n    out\n}\n\nfn main() {\n    let result = csv(dfs_topological(&[vec![2], vec![2], vec![3], vec![]]));\n    println!(\"{result}\");\n}\n","sites":[{"line":20,"function":"dfs_topological","statement":"let mut sorted = graph.to_vec();"},{"line":21,"function":"dfs_topological","statement":"for ns in &mut sorted {"},{"line":22,"function":"dfs_topological","statement":"ns.sort_unstable();"},{"line":23,"function":"dfs_topological","statement":"}"},{"line":24,"function":"dfs_topological","statement":"let mut color = vec![0; graph.len()];"},{"line":25,"function":"dfs_topological","statement":"let mut out = Vec::new();"},{"line":26,"function":"dfs_topological","statement":"for v in 0..graph.len() {"},{"line":27,"function":"dfs_topological","statement":"if color[v] == 0 {"},{"line":28,"function":"dfs_topological","statement":"visit(v, &sorted, &mut color, &mut out);"},{"line":29,"function":"dfs_topological","statement":"}"},{"line":31,"function":"dfs_topological","statement":"out.reverse();"},{"line":32,"function":"dfs_topological","statement":"out"},{"line":9,"function":"visit","statement":"assert_ne!(color[v], 1, \"cycle\");"},{"line":10,"function":"visit","statement":"if color[v] == 2 {"},{"line":11,"function":"visit","statement":"return;"},{"line":13,"function":"visit","statement":"color[v] = 1;"},{"line":14,"function":"visit","statement":"for &u in &g[v] {"},{"line":15,"function":"visit","statement":"visit(u, g, color, out);","edge":{"collection":"g","from":"v","to":"u"}},{"line":16,"function":"visit","statement":"}","edge":{"collection":"g","from":"v","to":"u"}},{"line":17,"function":"visit","statement":"color[v] = 2;"},{"line":18,"function":"visit","statement":"out.push(v);"},{"line":19,"function":"visit","statement":"}"},{"line":36,"function":"main","statement":"let result = csv(dfs_topological(&[vec![2], vec![2], vec![3], vec![]]));"},{"line":37,"function":"main","statement":"println!(\"{result}\");"},{"line":38,"function":"main","statement":"}"}],"version":1,"input":"n=4 edges=0->2,1->2,2->3","stdout":"1,0,2,3\n","values":[{"type":"&[alloc::vec::Vec<usize>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"3"}],"tuple":false},{"kind":"list","items":[],"tuple":false}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::vec::Vec<usize>>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"3"}],"tuple":f