{"key":"heap-sort-0925ae89469bbad4","sourceHash":"0925ae89469bbad4df2338ba253d0e195c732884c58e86b061823abd49391966","pattern":"heap-sort","category":"sorting-selection","title":"Heap Sort: Mental Model","idea":"Build a max heap and repeatedly move the maximum into its final suffix position.","complexity":"O(n log n) time · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn heap_sort(a: &mut [i32]) {\n    fn sift(a: &mut [i32], mut root: usize, end: usize) {\n        while 2 * root + 1 < end {\n            let mut child = 2 * root + 1;\n            if child + 1 < end && a[child] < a[child + 1] {\n                child += 1;\n            }\n            if a[root] >= a[child] {\n                break;\n            }\n            a.swap(root, child);\n            root = child;\n        }\n    }\n    let n = a.len();\n    for i in (0..n / 2).rev() {\n        sift(a, i, n);\n    }\n    for end in (1..n).rev() {\n        a.swap(0, end);\n        sift(a, 0, end);\n    }\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![4, 10, 3, 5, 1];\n        heap_sort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":21,"function":"heap_sort","statement":"let n = a.len();"},{"line":22,"function":"heap_sort","statement":"for i in (0..n / 2).rev() {"},{"line":23,"function":"heap_sort","statement":"sift(a, i, n);"},{"line":24,"function":"heap_sort","statement":"}"},{"line":25,"function":"heap_sort","statement":"for end in (1..n).rev() {"},{"line":26,"function":"heap_sort","statement":"a.swap(0, end);"},{"line":27,"function":"heap_sort","statement":"sift(a, 0, end);"},{"line":28,"function":"heap_sort","statement":"}"},{"line":9,"function":"sift","statement":"while 2 * root + 1 < end {"},{"line":10,"function":"sift","statement":"let mut child = 2 * root + 1;"},{"line":11,"funct