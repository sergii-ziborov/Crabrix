{"key":"list-intersection-eff8c39214abec6f","sourceHash":"eff8c39214abec6f9dc776d877075b564782a34202257f6da62a7dffa944a136","pattern":"list-intersection","category":"linked-lists","title":"Challenge: Pointer-Switch Intersection","idea":"Switch each pointer to the other head so both traverse equal combined distance.","complexity":"O(n+m) time · O(1) space","source":"type SharedLink = Option<std::rc::Rc<SharedNode>>;\nstruct SharedNode {\n    value: i32,\n    next: SharedLink,\n}\nfn shared_list(prefix: &[i32], tail: SharedLink) -> SharedLink {\n    prefix.iter().rev().fold(tail, |next, &value| {\n        Some(std::rc::Rc::new(SharedNode { value, next }))\n    })\n}\nfn intersection(a: &SharedLink, b: &SharedLink) -> Option<i32> {\n    fn equal(a: &SharedLink, b: &SharedLink) -> bool {\n        match (a, b) {\n            (None, None) => true,\n            (Some(x), Some(y)) => std::rc::Rc::ptr_eq(x, y),\n            _ => false,\n        }\n    }\n    let (mut p, mut q) = (a.clone(), b.clone());\n    while !equal(&p, &q) {\n        p = match p {\n            Some(n) => n.next.clone(),\n            None => b.clone(),\n        };\n        q = match q {\n            Some(n) => n.next.clone(),\n            None => a.clone(),\n        };\n    }\n    p.map(|n| n.value)\n}\n\nfn main() {\n    let result = {\n        let tail = shared_list(&[9], None);\n        let a = shared_list(&[1], tail.clone());\n        let b = shared_list(&[2], tail);\n        intersection(&a, &b).map_or(\"none\".into(), |x| x.to_string())\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"shared_list","statement":"prefix.iter().rev().fold(tail, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(std::rc::Rc::new(SharedNode { value, next }))"},{"line":19,"function":"intersection","statement":"let (mut p, mut q) = (a.clone(), b.clone());"},{"line":20,"function":"intersection","statement":"while !equal(&p, &q) {"},{"line":21,"function":"intersection","stat