{"key":"imos-sweep-91025cdd310e9b97","sourceHash":"91025cdd310e9b9769bd57797ba1c86e9d55ce1e516953609a4d44254d487aeb","pattern":"imos-sweep","category":"ranges","title":"Imos Sweep: Mental Model","idea":"Record interval starts and ends, then sweep a running active count.","complexity":"O(n+q) time on discrete coordinates · O(n) space","source":"fn peak_load(n: usize, updates: &[(usize, usize, i64)]) -> i64 {\n    let mut events = vec![0; n + 1];\n    for &(left, right, delta) in updates {\n        events[left] += delta;\n        events[right + 1] -= delta;\n    }\n    let (mut active, mut peak) = (0, 0);\n    for &delta in &events[..n] {\n        active += delta;\n        peak = peak.max(active);\n    }\n    peak\n}\n\nfn main() {\n    let result = peak_load(5, &[(0, 2, 2), (1, 3, 3), (3, 4, 1)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"peak_load","statement":"let mut events = vec![0; n + 1];"},{"line":3,"function":"peak_load","statement":"for &(left, right, delta) in updates {"},{"line":4,"function":"peak_load","statement":"events[left] += delta;"},{"line":5,"function":"peak_load","statement":"events[right + 1] -= delta;"},{"line":6,"function":"peak_load","statement":"}"},{"line":7,"function":"peak_load","statement":"let (mut active, mut peak) = (0, 0);"},{"line":8,"function":"peak_load","statement":"for &delta in &events[..n] {"},{"line":9,"function":"peak_load","statement":"active += delta;"},{"line":10,"function":"peak_load","statement":"peak = peak.max(active);"},{"line":11,"function":"peak_load","statement":"}"},{"line":12,"function":"peak_load","statement":"peak"},{"line":16,"function":"main","statement":"let result = peak_load(5, &[(0, 2, 2), (1, 3, 3), (3, 4, 1)]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"n=5 updates=(0,2,2),(1,3,3),(3,4,1)","stdout":"5\n","values":[{"type":"usize","data":{"kind":"scalar","text":"