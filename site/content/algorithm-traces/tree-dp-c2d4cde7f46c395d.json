{"key":"tree-dp-c2d4cde7f46c395d","sourceHash":"c2d4cde7f46c395d680c69b0b01f48733dbcb190bf9df037173c74d69aa35fd1","pattern":"tree-dp","category":"dynamic-2d","title":"Tree DP: Mental Model","idea":"Return a compact choice summary from each subtree and combine children at their parent.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn tree_independent_sum(root: &Tree) -> i32 {\n    fn states(root: &Tree) -> (i32, i32) {\n        match root {\n            None => (0, 0),\n            Some(n) => {\n                let (li, le) = states(&n.left);\n                let (ri, re) = states(&n.right);\n                (n.value + le + re, li.max(le) + ri.max(re))\n            }\n        }\n    }\n    let (included, excluded) = states(root);\n    included.max(excluded)\n}\n\nfn main() {\n    let result = tree_independent_sum(&node(\n        3,\n        node(2, None, node(3, None, None)),\n        node(3, None, node(1, None, None)),\n    ))\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":21,"function":"tree_independent_sum","statement":"let (included, excluded) = states(root);"},{"line":22,"function":"tree_independent_sum","statement":"included.max(excluded)"},{"line":12,"function":"states","statement":"match root {"},{"line":15,"function":"states","statement":"let (li, le) = states(&n.left);"},{"line":16,"function":"states","statement":"let (ri, re) = states(&n.right);"},{"line":17,"function":"states","statement":"(n.value + le + re, li.max(le) + ri.max(re))"},{"line":26,"function":"main","statement":"let result = tree_independent_sum(&node("},{"line":32,"function":"main","statement":"println!(\"{result}\");"},{"line":33,"function":"main","statement":"}"}],"vers