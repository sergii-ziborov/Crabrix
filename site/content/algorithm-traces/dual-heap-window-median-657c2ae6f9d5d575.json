{"key":"dual-heap-window-median-657c2ae6f9d5d575","sourceHash":"657c2ae6f9d5d57593ea5f4d16a9ea6b58d3b2959e4a7da45139e0b45a5a49fc","pattern":"dual-heap-window-median","category":"sliding-window","title":"Challenge: Sliding Median with Two Heaps","idea":"Balance lower and upper heaps while lazily deleting values that leave the window.","complexity":"O(n log k) time · O(k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nuse std::{\n    cmp::Reverse,\n    collections::{BinaryHeap, HashMap},\n};\n#[derive(Default)]\nstruct MedianWindow {\n    low: BinaryHeap<i32>,\n    high: BinaryHeap<Reverse<i32>>,\n    deleted: HashMap<i32, usize>,\n    low_size: usize,\n    high_size: usize,\n}\nimpl MedianWindow {\n    fn prune(&mut self) {\n        while let Some(&x) = self.low.peek() {\n            let count = self.deleted.get(&x).copied().unwrap_or(0);\n            if count == 0 {\n                break;\n            }\n            if count == 1 {\n                self.deleted.remove(&x);\n            } else {\n                self.deleted.insert(x, count - 1);\n            }\n            self.low.pop();\n        }\n        while let Some(&Reverse(x)) = self.high.peek() {\n            let count = self.deleted.get(&x).copied().unwrap_or(0);\n            if count == 0 {\n                break;\n            }\n            if count == 1 {\n                self.deleted.remove(&x);\n            } else {\n                self.deleted.insert(x, count - 1);\n            }\n            self.high.pop();\n        }\n    }\n    fn balance(&mut self) {\n        self.prune();\n        while self.low_size > self.high_size + 1 {\n            let x = self.low.pop().unwrap();\n            self.low_size -= 1;\n            self.high_size += 1;\n            self.high.push(Reverse(x));\n            self.prune();\n        }\n        while self.low_size < self.high_size {\n            let Reverse(x) = self.high.pop().unwrap();\n            self.high_size -= 1;\n            self.low_size += 1;\n            self.low.push(x);\n            self.prune();\n        }\n    }\n    fn add(&mut self, x: i32) {\n        self.prune();\n        if self.low.peek().is_none_or(|&m| x <= m) {\n            self.low.push(x);\n            self.low_size += 1;\n        } else {\n            self.high.push(Reverse(x));\n            self.high_size += 1;\n        }\n        self.balance();\n    }\n    fn remove(&mut self, x: i32) {\n        self.prune();\n        if x <= *self.low.peek().unwrap() {\n            self.low_size -= 1;\n        } else {\n            self.high_size -= 1;\n        }\n        *self.deleted.entry(x).or_default() += 1;\n        self.balance();\n    }\n}\nfn sliding_medians(values: &[i32], k: usize) -> Vec<i32> {\n    assert!(k > 0 && k % 2 == 1 && k <= values.len());\n    let mut state = MedianWindow::default();\n    let mut out = Vec::new();\n    for i in 0..values.len() {\n        state.add(values[i]);\n        if i >= k {\n            state.remove(values[i - k]);\n        }\n        // Lazy deletion alone can retain O(n) stale entries. Periodic rebuild\n        // bounds storage by O(k), with amortised O(log k) update cost.\n        if state.low.len() + state.high.len() > 4 * k {\n            state = MedianWindow::default();\n            for &x in &values[i + 1 - k..=i] {\n                state.add(x);\n            }\n        }\n        if i + 1 >= k {\n            state.prune();\n            out.push(*state.low.peek().unwrap());\n        }\n    }\n    out\n}\n\nfn main() {\n    let result = csv(sliding_medians(&[2, 1, 4], 3));\n    println!(\"{result}\");\n}\n","sites":[{"line":21,"function":"prune","statement":"while let Some(&x) = self.low.peek() {"},{"line":22,"function":"prune","statement":"let count = self.deleted.get(&x).copied().unwrap_or(0);"},{"line":23,"function":"prune","statement":"if count == 0 {"},{"li