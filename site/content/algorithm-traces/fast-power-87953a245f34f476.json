{"key":"fast-power-87953a245f34f476","sourceHash":"87953a245f34f476c12ab1f3943d7cee6291022681fb3615ba67cb75d147d102","pattern":"fast-power","category":"math-bits","title":"Challenge: Binary Exponentiation","idea":"Square the base and consume exponent bits so only logarithmically many multiplications occur.","complexity":"O(log exponent) time · O(1) space","source":"fn mod_power(mut base: u64, mut exponent: u64, modulus: u64) -> u64 {\n    assert!(modulus > 0);\n    let mut result = 1 % modulus;\n    base %= modulus;\n    while exponent > 0 {\n        if exponent & 1 == 1 {\n            result = (result as u128 * base as u128 % modulus as u128) as u64;\n        }\n        base = (base as u128 * base as u128 % modulus as u128) as u64;\n        exponent >>= 1;\n    }\n    result\n}\n\nfn main() {\n    let result = mod_power(2, 5, 13).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"mod_power","statement":"assert!(modulus > 0);"},{"line":3,"function":"mod_power","statement":"let mut result = 1 % modulus;"},{"line":4,"function":"mod_power","statement":"base %= modulus;"},{"line":5,"function":"mod_power","statement":"while exponent > 0 {"},{"line":6,"function":"mod_power","statement":"if exponent & 1 == 1 {"},{"line":7,"function":"mod_power","statement":"result = (result as u128 * base as u128 % modulus as u128) as u64;"},{"line":8,"function":"mod_power","statement":"}"},{"line":9,"function":"mod_power","statement":"base = (base as u128 * base as u128 % modulus as u128) as u64;"},{"line":10,"function":"mod_power","statement":"exponent >>= 1;"},{"line":11,"function":"mod_power","statement":"}"},{"line":12,"function":"mod_power","statement":"result"},{"line":16,"function":"main","statement":"let result = mod_power(2, 5, 13).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"base=2 exp=5 mod=13","stdout":"6\n","values":[{"type":"u64","data":{"kind":"scalar","text":"2"}},{"type":"u64","data":{"kind":"scalar","text":"5"}},{"type":"u64","data":{"kind":"scalar","text":"13"}},{"type":"u64","data":{"kind":"scalar","text":"1"}},{"type":"u64","data":{"kind":"scalar","text":"4"}},{"type":"u64","data":{"kind":"scalar","text":"3"}},{"type":"u64","data":{"kind":"scalar","text":"6"}},{"type":"u64","data":{"kind":"scalar","text":"9"}},{"type":"u64","data":{"kind":"scalar","text":"0"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"6\""}}],"frames":[{"site":11,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2]]},{"site":1,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2]]},{"site":2,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",3]]},{"site":3,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",3]]},{"site":4,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",3]]},{"site":5,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",3]]},{"site":6,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",0]]},{"site":7,"stack":[["main",1],["mod_power",2]],"locals":[["base",0],["exponent",1],["modulus",2],["result",0]]},{"site":8,"stack":[["main",1],["mod_power",2]],"locals":[["base",4],["exponent",1],["modulus",2],["result",0]]},{"site":9,"stack":[["main",1],["mod_power",2]],"locals":[["base",4],["exponent",0],["modulus",2],["result",0]]},{"site":4,"stack":[["main",1],["mod_power",2]],"locals":[["base",4],["exponent",0],["modulus",2],["result",0]]},{"site":7,"stack":[["main",1],["mod_power",2]],"locals":[["base",4],["exponent",0],["modulus",2],["result",0]]},{"site":8,"stack":[["main",1],["mod_power",2]],"locals":[["base",5],["exponent",0],["modulus",2],["result",0]]},{"site":