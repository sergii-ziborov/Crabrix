{"key":"list-middle-0cca2ca7169fa9f8","sourceHash":"0cca2ca7169fa9f85ce20854826b0e9a02fdaff5146e6cfbfcfbfef38a1e2ec4","pattern":"list-middle","category":"linked-lists","title":"Middle by Slow/Fast: Mental Model","idea":"Move one pointer once and another twice so the slow pointer reaches the middle.","complexity":"O(n) time · O(1) space","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn list_middle(head: &Link) -> i32 {\n    let (mut slow, mut fast) = (head.as_deref(), head.as_deref());\n    while let Some(next) = fast.and_then(|n| n.next.as_deref()) {\n        slow = slow.unwrap().next.as_deref();\n        fast = next.next.as_deref();\n    }\n    slow.expect(\"nonempty list\").value\n}\n\nfn main() {\n    let result = list_middle(&list(&[1, 2, 3, 4, 5, 6])).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":21,"function":"list_middle","statement":"let (mut slow, mut fast) = (head.as_deref(), head.as_deref());"},{"line":22,"function":"list_middle","statement":"while let Some(next) = fast.and_then(|n| n.next.as_deref()) {"},{"line":23,"function":"list_middle","statement":"slow = slow.unwrap().next.as_deref();"},{"line":24,"function":"list_middle","statement":"fast = next.next.as_deref();"},{"line":25,"function":"list_middle","statement":"}"},{"line":26,"function":"list_middle","statement":"slow.expect(\"nonempty list\").value"},{"line":22,"function":"closure · line 22","statement":"n.next.as_deref()"},{"line":30,"function":"main","statement":"let result = list_middle(&list(&[1, 2, 3, 4, 5, 6])).to_string();"},{"line":31,"function":"main","statement":"println!(\"{result}\");"},{"line":32,"function":"main","statement":"}"}],"version":1,"input":"1->2->3->4->5->6","stdout":"4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"}],"tuple":false}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"6"}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"6"}]]}}],"tuple":true}}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scal