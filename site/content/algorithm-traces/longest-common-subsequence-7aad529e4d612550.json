{"key":"longest-common-subsequence-7aad529e4d612550","sourceHash":"7aad529e4d61255086e266f6518c2f717464cff7f507a4514b9745d7530a1a44","pattern":"longest-common-subsequence","category":"dynamic-2d","title":"Challenge: Longest Common Subsequence","idea":"Match equal symbols diagonally; otherwise discard one suffix boundary and keep the better result.","complexity":"O(n*m) time · O(n*m) table in this example","source":"fn lcs(a: &str, b: &str) -> usize {\n    assert!(a.is_ascii() && b.is_ascii());\n    let mut dp = vec![vec![0; b.len() + 1]; a.len() + 1];\n    for (i, x) in a.bytes().enumerate() {\n        for (j, y) in b.bytes().enumerate() {\n            dp[i + 1][j + 1] = if x == y {\n                dp[i][j] + 1\n            } else {\n                dp[i][j + 1].max(dp[i + 1][j])\n            };\n        }\n    }\n    dp[a.len()][b.len()]\n}\n\nfn main() {\n    let result = lcs(\"abc\", \"def\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"lcs","statement":"assert!(a.is_ascii() && b.is_ascii());"},{"line":3,"function":"lcs","statement":"let mut dp = vec![vec![0; b.len() + 1]; a.len() + 1];"},{"line":4,"function":"lcs","statement":"for (i, x) in a.bytes().enumerate() {"},{"line":5,"function":"lcs","statement":"for (j, y) in b.bytes().enumerate() {"},{"line":6,"function":"lcs","statement":"dp[i + 1][j + 1] = if x == y {"},{"line":7,"function":"lcs","statement":"dp[i][j] + 1"},{"line":9,"function":"lcs","statement":"dp[i][j + 1].max(dp[i + 1][j])"},{"line":11,"function":"lcs","statement":"}"},{"line":13,"function":"lcs","statement":"dp[a.len()][b.len()]"},{"line":17,"function":"main","statement":"let result = lcs(\"abc\", \"def\").to_string();"},{"line":18,"function":"main","statement":"println!(\"{result}\");"},{"line":19,"function":"main","statement":"}"}],"version":1,"input":"abc and def","stdout":"0\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"abc\""}},{"type":"&str","data":{"kind":"scalar","text":"\"def\""}},{"ty