{"key":"tree-diameter-3a122493c2762630","sourceHash":"3a122493c2762630e9adfb9ec87537570381645149d606322cd721e67aa98d94","pattern":"tree-diameter","category":"trees","title":"Tree Diameter: Mental Model","idea":"At each node combine the two deepest child paths while returning only the deepest one upward.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn diameter(root: &Tree) -> usize {\n    fn height(root: &Tree, best: &mut usize) -> usize {\n        match root {\n            None => 0,\n            Some(n) => {\n                let left = height(&n.left, best);\n                let right = height(&n.right, best);\n                *best = (*best).max(left + right);\n                1 + left.max(right)\n            }\n        }\n    }\n    let mut best = 0;\n    height(root, &mut best);\n    best\n}\n\nfn main() {\n    let result = diameter(&node(\n        1,\n        node(2, node(4, None, None), node(5, None, None)),\n        node(3, None, None),\n    ))\n    .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":22,"function":"diameter","statement":"let mut best = 0;"},{"line":23,"function":"diameter","statement":"height(root, &mut best);"},{"line":24,"function":"diameter","statement":"best"},{"line":12,"function":"height","statement":"match root {"},{"line":15,"function":"height","statement":"let left = height(&n.left, best);"},{"line":16,"function":"height","statement":"let right = height(&n.right, best);"},{"line":17,"function":"height","statement":"*best = (*best).max(left + right);"},{"line":18,"function":"height","statement":"1 + left.max(right)"},{"line":28,"function":"main","statement":"let result = diameter(&node("},{"line":34,"function":"main","stateme