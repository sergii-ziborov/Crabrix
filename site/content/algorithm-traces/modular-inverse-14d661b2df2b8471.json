{"key":"modular-inverse-14d661b2df2b8471","sourceHash":"14d661b2df2b84717afe398e075270a3c5e8e55d770671bc58fb40f91beaaff6","pattern":"modular-inverse","category":"math-bits","title":"Challenge: Modular Inverse","idea":"Use extended Euclid when gcd is one, or Fermat under a known prime modulus.","complexity":"O(log modulus) time · O(1) space","source":"fn modular_inverse(a: i64, modulus: i64) -> Option<i64> {\n    assert!(modulus > 1);\n    let (mut old_r, mut r) = (a.rem_euclid(modulus), modulus);\n    let (mut old_s, mut s) = (1_i128, 0_i128);\n    while r != 0 {\n        let q = old_r / r;\n        (old_r, r) = (r, old_r - q * r);\n        (old_s, s) = (s, old_s - q as i128 * s);\n    }\n    (old_r == 1).then(|| old_s.rem_euclid(modulus as i128) as i64)\n}\n\nfn main() {\n    let result = modular_inverse(2, 5).unwrap().to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"modular_inverse","statement":"assert!(modulus > 1);"},{"line":3,"function":"modular_inverse","statement":"let (mut old_r, mut r) = (a.rem_euclid(modulus), modulus);"},{"line":4,"function":"modular_inverse","statement":"let (mut old_s, mut s) = (1_i128, 0_i128);"},{"line":5,"function":"modular_inverse","statement":"while r != 0 {"},{"line":6,"function":"modular_inverse","statement":"let q = old_r / r;"},{"line":7,"function":"modular_inverse","statement":"(old_r, r) = (r, old_r - q * r);"},{"line":8,"function":"modular_inverse","statement":"(old_s, s) = (s, old_s - q as i128 * s);"},{"line":9,"function":"modular_inverse","statement":"}"},{"line":10,"function":"modular_inverse","statement":"(old_r == 1).then(|| old_s.rem_euclid(modulus as i128) as i64)"},{"line":10,"function":"closure · line 10","statement":"old_s.rem_euclid(modulus as i128) as i64"},{"line":14,"function":"main","statement":"let result = modular_inverse(2, 5).unwrap().to_string();"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"}],"version":1,"