{"key":"remove-nth-from-end-5edb55d3359cbbb7","sourceHash":"5edb55d3359cbbb7bee53c31ba5f0831f076cb65679429604a5876b73e5ee557","pattern":"remove-nth-from-end","category":"linked-lists","title":"Gap Pointer Removal: Mental Model","idea":"Keep a fixed gap so the leading pointer reaching the end positions the trailing pointer before the target.","complexity":"O(n) time · O(1) space","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn remove_from_end(mut head: Link, n: usize) -> Link {\n    let mut length: usize = 0;\n    let mut scan = head.as_deref();\n    while let Some(node) = scan {\n        length += 1;\n        scan = node.next.as_deref();\n    }\n    assert!(n > 0 && n <= length);\n    let mut link = &mut head;\n    for _ in 0..length - n {\n        link = &mut link.as_mut().unwrap().next;\n    }\n    let next = link.as_mut().unwrap().next.take();\n    *link = next;\n    head\n}\n\nfn main() {\n    let result = csv(list_values(&remove_from_end(list(&[1, 2, 3, 4, 5]), 2)));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"remove_from_end","statement":"let mut length: usize = 0;"},{"line":28,"function":"remove_from_end","statement":"let mut scan = head.as_deref();"},{"line":29,"function":"remove_from_end","statement":"while let Some(node) = scan {"},{"line":30,"function":"remove_from_end","statement":"length += 1;"},{"line":31,"function":"remove_from_end","statement":"scan = node.next.as_deref();"},{"line":32,"function":"remove_from_end","statement":"}"},{"line":33,"function":"remove_from_end","statement":"assert!(n > 0 && n <= length);"},{"line":34,"function":"remove_from_end","statement":"let mut link = &mut head;"},{"line":35,"function":"remove_from_end","statement":"for _ in 0..length - n {"},{"line":36,"function":"remove_from_end","statement":"link = &mut link.as_mut().unwrap().next;"},{"line":37,"function":"remove_from_end","statement":"}"},{"line":38,"function":"remove_from_end","statement":"let next = link.as_mut().unwrap().next.take();"},{"line":39,"function":"remove_from_end","statement":"*link = next;"},{"line":40,"function":"remove_from_end","statement":"head"},{"line":44,"function":"main","statement":"let result = csv(list_values(&remove_from_end(list(&[1, 2, 3, 4, 5]), 2)));"},{"line":45,"function":"main","statement":"println!(\"{result}\");"},{"line":46,"function":"main","statement":"}"}],"version":1,"input":"1->2->3->4->5","stdout":"1,2,3,5\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"}],"tuple":false}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"scala