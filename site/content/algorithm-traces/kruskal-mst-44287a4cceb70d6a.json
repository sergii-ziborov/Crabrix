{"key":"kruskal-mst-44287a4cceb70d6a","sourceHash":"44287a4cceb70d6a5cef9f26c753f19212447af83aa6316ba17c43355060857b","pattern":"kruskal-mst","category":"weighted-graphs","title":"Kruskal Minimum Spanning Tree: Mental Model","idea":"Sort edges and add one only when union-find says it joins different components.","complexity":"O(E log E) time · O(V) DSU space","source":"struct Dsu {\n    parent: Vec<usize>,\n    size: Vec<usize>,\n    count: usize,\n}\nimpl Dsu {\n    fn new(n: usize) -> Self {\n        Self {\n            parent: (0..n).collect(),\n            size: vec![1; n],\n            count: n,\n        }\n    }\n    fn root(&mut self, mut x: usize) -> usize {\n        while x != self.parent[x] {\n            self.parent[x] = self.parent[self.parent[x]];\n            x = self.parent[x];\n        }\n        x\n    }\n    fn join(&mut self, a: usize, b: usize) -> bool {\n        let (mut a, mut b) = (self.root(a), self.root(b));\n        if a == b {\n            return false;\n        }\n        if self.size[a] < self.size[b] {\n            std::mem::swap(&mut a, &mut b);\n        }\n        self.parent[b] = a;\n        self.size[a] += self.size[b];\n        self.count -= 1;\n        true\n    }\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn kruskal_weights(n: usize, edges: &[(usize, usize, i64)]) -> Vec<i64> {\n    let mut sorted = edges.to_vec();\n    sorted.sort_by_key(|&(a, b, w)| (w, a, b));\n    let mut dsu = Dsu::new(n);\n    let mut out = Vec::new();\n    for (a, b, w) in sorted {\n        if dsu.join(a, b) {\n            out.push(w);\n        }\n    }\n    assert!(n == 0 || out.len() == n - 1, \"connected graph required\");\n    out\n}\n\nfn main() {\n    let result = csv(kruskal_weights(\n        4,\n        &[(0, 1, 1), (0, 2, 4), (1, 2, 2), (1, 3, 5), (2, 3, 3)],\n    ));\n    println!(\"{result}\");\n}\n","site