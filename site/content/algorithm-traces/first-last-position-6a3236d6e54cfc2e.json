{"key":"first-last-position-6a3236d6e54cfc2e","sourceHash":"6a3236d6e54cfc2e0a6fc489ea9eb4451934da88b64977aa01fdd414181a7410","pattern":"first-last-position","category":"binary-search","title":"Challenge: First and Last Position","idea":"Run two boundary searches instead of expanding linearly from one match.","complexity":"O(log n) time · O(1) space","source":"fn first_last(a: &[i32], target: i32) -> (i32, i32) {\n    let bound = |upper: bool| {\n        let (mut lo, mut hi) = (0, a.len());\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            if a[mid] < target || (upper && a[mid] == target) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    };\n    let first = bound(false);\n    if a.get(first) != Some(&target) {\n        (-1, -1)\n    } else {\n        (first as i32, bound(true) as i32 - 1)\n    }\n}\n\nfn main() {\n    let result = {\n        let (a, b) = first_last(&[8], 8);\n        format!(\"{a},{b}\")\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"first_last","statement":"let bound = |upper: bool| {"},{"line":14,"function":"first_last","statement":"let first = bound(false);"},{"line":15,"function":"first_last","statement":"if a.get(first) != Some(&target) {"},{"line":16,"function":"first_last","statement":"(-1, -1)"},{"line":18,"function":"first_last","statement":"(first as i32, bound(true) as i32 - 1)"},{"line":3,"function":"closure · line 2","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":4,"function":"closure · line 2","statement":"while lo < hi {"},{"line":5,"function":"closure · line 2","statement":"let mid = lo + (hi - lo) / 2;"},{"line":6,"function":"closure · line 2","statement":"if a[mid] < target || (upper && a[mid] == target) {"},{"line":7,"function":"closure · line 2","statement":"lo = mid + 1;"},{"line":8,"function":"closure · line 2","statement":"}"},{"line":9,"function":"closure · line 2","statement":"hi =