{"key":"lowest-common-ancestor-4f5125c5aaa2a31d","sourceHash":"4f5125c5aaa2a31d06a42b6e92560d7fef7cdc51b0af17487a219a52ebddac9f","pattern":"lowest-common-ancestor","category":"trees","title":"Challenge: Lowest Common Ancestor","idea":"Combine child evidence; the first node reached from both targets is their lowest shared ancestor.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn ancestor(root: &Tree, a: i32, b: i32) -> Option<i32> {\n    // Contract: both distinct target values exist in the tree and are unique.\n    match root {\n        None => None,\n        Some(n) if n.value == a || n.value == b => Some(n.value),\n        Some(n) => match (ancestor(&n.left, a, b), ancestor(&n.right, a, b)) {\n            (Some(_), Some(_)) => Some(n.value),\n            (left, right) => left.or(right),\n        },\n    }\n}\n\nfn main() {\n    let result = ancestor(&node(5, node(1, None, None), None), 5, 1)\n        .unwrap()\n        .to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":12,"function":"ancestor","statement":"match root {"},{"line":23,"function":"main","statement":"let result = ancestor(&node(5, node(1, None, None), None), 5, 1)"},{"line":26,"function":"main","statement":"println!(\"{result}\");"},{"line":27,"function":"main","statement":"}"}],"version":1,"input":"tree=[5,1]","stdout":"5\n","values":[{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":true}}},{"type":"&core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":true}}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"5"}]]}}],"tuple":true}}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"5\""}}],"frames":[{"site":2,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["node",2]],"locals":[["value",0],["left",1],["right",1]]},{"site":0,"stack":[["main",1],["node",3]],"locals":[["value",2],["left",3],["right",1]]},{"site":1,"stack":[["main",1],["ancestor",4]],"locals":[["root",4],["a",2],["b",0]]},{"site":3,"stack":[["main",1]],"locals":[["result",5]]},{"site":4,"stack":[["main",1]],"locals":[["result",5]]}],"verification":{"stdoutMatchesOriginal":true,"independentOracle":true,"omittedCaptures":0}}
