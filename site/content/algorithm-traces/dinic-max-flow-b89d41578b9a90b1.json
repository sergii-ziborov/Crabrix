{"key":"dinic-max-flow-b89d41578b9a90b1","sourceHash":"b89d41578b9a90b18cb0bd41155cd7e27e772a2ca6d6c68095ae0e4c6ea6705b","pattern":"dinic-max-flow","category":"weighted-graphs","title":"Challenge: Dinic Maximum Flow","idea":"Build a level graph with BFS and send blocking flows through level-respecting edges.","complexity":"O(V^2 E) general bound · O(V+E) space","source":"#[derive(Clone)]\nstruct FlowEdge {\n    to: usize,\n    reverse: usize,\n    capacity: i64,\n}\nfn max_flow(n: usize, edges: &[(usize, usize, i64)], source: usize, sink: usize) -> i64 {\n    fn send(\n        v: usize,\n        t: usize,\n        pushed: i64,\n        g: &mut [Vec<FlowEdge>],\n        level: &[i32],\n        next: &mut [usize],\n    ) -> i64 {\n        if v == t {\n            return pushed;\n        }\n        while next[v] < g[v].len() {\n            let i = next[v];\n            let edge = g[v][i].clone();\n            if edge.capacity > 0 && level[edge.to] == level[v] + 1 {\n                let sent = send(edge.to, t, pushed.min(edge.capacity), g, level, next);\n                if sent > 0 {\n                    g[v][i].capacity -= sent;\n                    g[edge.to][edge.reverse].capacity += sent;\n                    return sent;\n                }\n            }\n            next[v] += 1;\n        }\n        0\n    }\n    let mut graph = vec![Vec::new(); n];\n    for &(a, b, capacity) in edges {\n        assert!(a != b && capacity >= 0);\n        let (ra, rb) = (graph[a].len(), graph[b].len());\n        graph[a].push(FlowEdge {\n            to: b,\n            reverse: rb,\n            capacity,\n        });\n        graph[b].push(FlowEdge {\n            to: a,\n            reverse: ra,\n            capacity: 0,\n        });\n    }\n    let mut total = 0;\n    loop {\n        let mut level = vec![-1; n];\n        level[source] = 0;\n        let mut queue = std::collections::VecDeque::from([source]);\n        while let Some(v) = queue.pop_front() {\n            for edge in &graph[v] {\n                if edge.capacity > 0 && level[edge.to] < 0 {\n                    level[edge.to] = level[v] + 1;\n                    queue.push_back(edge.to);\n                }\n            }\n        }\n        if level[sink] < 0 {\n            return total;\n        }\n        let mut next = vec![0; n];\n        loop {\n            let sent = send(source, sink, i64::MAX, &mut graph, &level, &mut next);\n            if sent == 0 {\n                break;\n            }\n            total += sent;\n        }\n    }\n}\n\nfn main() {\n    let result = max_flow(4, &[(0, 3, 7)], 0, 3).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":34,"function":"max_flow","statement":"let mut graph = vec![Vec::new(); n];"},{"line":35,"function":"max_flow","statement":"for &(a, b, capacity) in edges {"},{"line":36,"function":"max_flow","statement":"assert!(a != b && capacity >= 0);"},{"line":37,"function":"max_flow","statement":"let (ra, rb) = (graph[a].len(), graph[b].len());"},{"line":38,"function":"max_flow","statement":"graph[a].push(FlowEdge {"},{"line":43,"function":"max_flow","statement":"graph[b].push(FlowEdge {"},{"line":48,"function":"max_flow","statement":"}"},{"line":49,"function":"max_flow","statement":"let mut total = 0;"},{"line":50,"function":"max_flow","statement":"loop {"},{"line":51,"function":"max_flow","statement":"let mut level = vec![-1; n];"},{"line":52,"function":"max_flow","statement":"level[source] = 0;"},{"line":53,"function":"max_flow","statement":"let mut queue = std::collections::VecDeque::from([source]);"},{"line":54,"function":"max_flow","statement":"while let Some(v) = queue.pop_front() {"},{"line":55,"function":"max_flow","statement":"for edge in &graph[v] {"},{"line":56,"function":"max_flow","statement":"if edge.capacity > 0 && level[edge.to] < 0 {","edge":{"collection":"graph","from":"v","to":"edge"}},{"line":57,"function":"max_flow","statement":"level[edge.to] = level[v] + 1;","edge":{"collection":"graph","from":"v",