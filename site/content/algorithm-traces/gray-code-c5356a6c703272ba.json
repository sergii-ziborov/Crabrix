{"key":"gray-code-c5356a6c703272ba","sourceHash":"c5356a6c703272ba68ca2c7be6e18d17382ca7d9c6a9e4142b720763fdf9eb70","pattern":"gray-code","category":"math-bits","title":"Challenge: Gray Code","idea":"Map i to i xor (i shifted right) so neighboring codes differ by one bit.","complexity":"O(2^n) time · O(2^n) output","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn gray_codes(bits: usize) -> Vec<usize> {\n    assert!(bits < usize::BITS as usize);\n    (0..1_usize << bits).map(|i| i ^ (i >> 1)).collect()\n}\n\nfn main() {\n    let result = csv(gray_codes(2));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"gray_codes","statement":"assert!(bits < usize::BITS as usize);"},{"line":9,"function":"gray_codes","statement":"(0..1_usize << bits).map(|i| i ^ (i >> 1)).collect()"},{"line":9,"function":"closure · line 9","statement":"i ^ (i >> 1)"},{"line":13,"function":"main","statement":"let result = csv(gray_codes(2));"},{"line":14,"function":"main","statement":"println!(\"{result}\");"},{"line":15,"function":"main","statement":"}"}],"version":1,"input":"n=2","stdout":"0,1,3,2\n","values":[{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0,1,3,2\""}}],"frames":[{"site":3,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["gray_codes",2]],"locals":[["bits",0]]},{"site":1,"stack":[["main",1],["gray_codes",2]],"locals":[["bits",0]]},{"site":2,"stack":[["main",1],["gray_codes",2],["closure · line 9",3]],"locals":[["i",1],["bits",0]]},{"site":2,"stack":[["main",1],["gray_codes",2],["closure · line 9",4]],"locals":[["i",2],["bits",0]]},{"site":2,"stack":[["main",1],["gray_codes",2],["c