{"key":"difference-array-743e3ea2fce70a18","sourceHash":"743e3ea2fce70a182063546d4ddc8a5b72568425a5ad00be15b847ba8d2313c6","pattern":"difference-array","category":"ranges","title":"Challenge: Difference Array","idea":"Mark only where a range update starts and stops, then integrate once.","complexity":"O(n + q) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn apply_updates(n: usize, updates: &[(usize, usize, i64)]) -> Vec<i64> {\n    let mut difference = vec![0; n + 1];\n    for &(left, right, delta) in updates {\n        difference[left] += delta;\n        difference[right + 1] -= delta;\n    }\n    let mut current = 0;\n    difference[..n]\n        .iter()\n        .map(|&d| {\n            current += d;\n            current\n        })\n        .collect()\n}\n\nfn main() {\n    let result = csv(apply_updates(4, &[(0, 1, 2), (2, 3, 1)]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"apply_updates","statement":"let mut difference = vec![0; n + 1];"},{"line":9,"function":"apply_updates","statement":"for &(left, right, delta) in updates {"},{"line":10,"function":"apply_updates","statement":"difference[left] += delta;"},{"line":11,"function":"apply_updates","statement":"difference[right + 1] -= delta;"},{"line":12,"function":"apply_updates","statement":"}"},{"line":13,"function":"apply_updates","statement":"let mut current = 0;"},{"line":14,"function":"apply_updates","statement":"difference[..n]"},{"line":17,"function":"closure · line 16","statement":"current += d;"},{"line":18,"function":"closure · line 16","statement":"current"},{"line":24,"function":"main","statement":"let result = csv(apply_updates(4, &[(0, 1, 2), (2, 3, 1)]));"},{"line":25,"function":"main","statement":"println!(\"{result}\");"},{"line":26,"function":"main","statement":"}"}],"version":1,"input":"n=4 updates=(0,1,2),(