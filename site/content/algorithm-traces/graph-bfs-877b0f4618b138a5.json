{"key":"graph-bfs-877b0f4618b138a5","sourceHash":"877b0f4618b138a5b5619184d27e3316fa98b88ab39a7a315d6e80b2e2548e7b","pattern":"graph-bfs","category":"graph-traversal","title":"Challenge: Graph BFS","idea":"Process the frontier in queue order so first discovery has minimum edge count.","complexity":"O(V+E) time · O(V) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn edge_distances(graph: &[Vec<usize>], start: usize) -> Vec<i32> {\n    let mut distance = vec![-1; graph.len()];\n    let mut queue = std::collections::VecDeque::from([start]);\n    distance[start] = 0;\n    while let Some(v) = queue.pop_front() {\n        for &u in &graph[v] {\n            if distance[u] == -1 {\n                distance[u] = distance[v] + 1;\n                queue.push_back(u);\n            }\n        }\n    }\n    distance\n}\n\nfn main() {\n    let result = csv(edge_distances(&[vec![1], vec![0], vec![], vec![]], 0));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"edge_distances","statement":"let mut distance = vec![-1; graph.len()];"},{"line":9,"function":"edge_distances","statement":"let mut queue = std::collections::VecDeque::from([start]);"},{"line":10,"function":"edge_distances","statement":"distance[start] = 0;"},{"line":11,"function":"edge_distances","statement":"while let Some(v) = queue.pop_front() {"},{"line":12,"function":"edge_distances","statement":"for &u in &graph[v] {"},{"line":13,"function":"edge_distances","statement":"if distance[u] == -1 {","edge":{"collection":"graph","from":"v","to":"u"}},{"line":14,"function":"edge_distances","statement":"distance[u] = distance[v] + 1;","edge":{"collection":"graph","from":"v","to":"u"}},{"line":15,"function":"edge_distances","statement":"queue.push_back(u);","edge":{"collection":"graph","from":"v","to":"u"}},{"line":16,"function":"edge_distances","statement":"}","edge":{"collection":"graph","from":"v","to":"u"}},{"line":19,"function":"edge_distances","statement":"distance"},{"line":23,"function":"main","statement":"let result = csv(edge_distances(&[vec![1], vec![0], vec![], vec![]], 0));"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"n=4 edges=(0,1)","stdout":"0,1,-1,-1\n","values":[{"type":"&[alloc::vec::Vec<usize>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false},{"kind":"list","items":[],"tuple":false},{"kind":"list","items":[],"tuple":false}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"}],"tuple":false}},{"type":"alloc::collections::vec_deque::VecDeque<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"}],"tuple":false}},{"type":"alloc::collections::vec_deque::VecDeque<usize>","data":{"kind":"list","items":[],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"-1"},{"kind":"scalar","text":"-1"}],"tuple":false}},{"type":"alloc::collections::vec_deque::VecDeque<usize>","data":{"kind":"list","items":[{"kind":"scalar","text":"1"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0,1,-1,-1\""}}],"frames":[{"site":10,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["edge_distances",2]],"locals":[["gra