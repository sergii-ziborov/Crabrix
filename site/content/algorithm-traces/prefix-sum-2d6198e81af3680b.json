{"key":"prefix-sum-2d6198e81af3680b","sourceHash":"2d6198e81af3680b4ae1873b5d74dc58e61f6aec7b71aef04f8425545c4accee","pattern":"prefix-sum","category":"ranges","title":"Prefix Sum: Mental Model","idea":"Store the sum before every boundary so a range is one subtraction.","complexity":"O(n) build · O(1) query · O(n) space","source":"fn range_sum(values: &[i64], left: usize, right: usize) -> i64 {\n    let mut prefix = vec![0; values.len() + 1];\n    for (i, &x) in values.iter().enumerate() {\n        prefix[i + 1] = prefix[i] + x;\n    }\n    prefix[right + 1] - prefix[left] // inclusive [left, right]\n}\n\nfn main() {\n    let result = range_sum(&[5, 2, 7, 1, 4], 1, 3).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"range_sum","statement":"let mut prefix = vec![0; values.len() + 1];"},{"line":3,"function":"range_sum","statement":"for (i, &x) in values.iter().enumerate() {"},{"line":4,"function":"range_sum","statement":"prefix[i + 1] = prefix[i] + x;"},{"line":5,"function":"range_sum","statement":"}"},{"line":6,"function":"range_sum","statement":"prefix[right + 1] - prefix[left]"},{"line":10,"function":"main","statement":"let result = range_sum(&[5, 2, 7, 1, 4], 1, 3).to_string();"},{"line":11,"function":"main","statement":"println!(\"{result}\");"},{"line":12,"function":"main","statement":"}"}],"version":1,"input":"[5, 2, 7, 1, 4]","stdout":"10\n","values":[{"type":"&[i64]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"tuple":false}},{"type":"usize","data