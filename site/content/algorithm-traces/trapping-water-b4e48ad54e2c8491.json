{"key":"trapping-water-b4e48ad54e2c8491","sourceHash":"b4e48ad54e2c8491158d8626317a894606685bbe364efbaf6dd8976217568e39","pattern":"trapping-water","category":"two-pointers","title":"Two-Pointer Rainwater: Mental Model","idea":"The smaller side has a settled bound; accumulate its deficit before moving inward.","complexity":"O(n) time · O(1) space","source":"fn trapped(heights: &[i32]) -> i32 {\n    let (mut left, mut right) = (0, heights.len());\n    let (mut left_max, mut right_max, mut water) = (0, 0, 0);\n    while left < right {\n        if left_max <= right_max {\n            left_max = left_max.max(heights[left]);\n            water += left_max - heights[left];\n            left += 1;\n        } else {\n            right -= 1;\n            right_max = right_max.max(heights[right]);\n            water += right_max - heights[right];\n        }\n    }\n    water\n}\n\nfn main() {\n    let result = trapped(&[0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"trapped","statement":"let (mut left, mut right) = (0, heights.len());"},{"line":3,"function":"trapped","statement":"let (mut left_max, mut right_max, mut water) = (0, 0, 0);"},{"line":4,"function":"trapped","statement":"while left < right {"},{"line":5,"function":"trapped","statement":"if left_max <= right_max {"},{"line":6,"function":"trapped","statement":"left_max = left_max.max(heights[left]);"},{"line":7,"function":"trapped","statement":"water += left_max - heights[left];"},{"line":8,"function":"trapped","statement":"left += 1;"},{"line":9,"function":"trapped","statement":"}"},{"line":10,"function":"trapped","statement":"right -= 1;"},{"line":11,"function":"trapped","statement":"right_max = right_max.max(heights[right]);"},{"line":12,"function":"trapped","statement":"water += right_max - heights[right];"},{"line":13,"function":"trapped","statement":"}"},{"line":15,"function":"trapped","statement":"water"},{"line":19,"function":"main","stateme