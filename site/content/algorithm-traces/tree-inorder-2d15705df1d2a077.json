{"key":"tree-inorder-2d15705df1d2a077","sourceHash":"2d15705df1d2a0775c3cbf455b6ae2c0dc4154c336c834d64efd2ad7b81311fa","pattern":"tree-inorder","category":"trees","title":"Inorder DFS: Mental Model","idea":"Visit left, node, then right; in a BST this emits sorted keys.","complexity":"O(n) time · O(h) stack","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn inorder(root: &Tree) -> Vec<i32> {\n    fn visit(root: &Tree, out: &mut Vec<i32>) {\n        if let Some(n) = root {\n            visit(&n.left, out);\n            out.push(n.value);\n            visit(&n.right, out);\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out\n}\n\nfn main() {\n    let result = csv(inorder(&node(\n        4,\n        node(2, node(1, None, None), node(3, None, None)),\n        node(6, node(5, None, None), node(7, None, None)),\n    )));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":24,"function":"inorder","statement":"let mut out = Vec::new();"},{"line":25,"function":"inorder","statement":"visit(root, &mut out);"},{"line":26,"function":"inorder","statement":"out"},{"line":18,"function":"visit","statement":"if let Some(n) = root {"},{"line":19,"function":"visit","statement":"visit(&n.left, out);"},{"line":20,"function":"visit","statement":"out.push(n.value);"},{"line":21,"function":"visit","statement":"visit(&n.right, out);"},{"line":22,"function":"visit","statement":"}"},{"line":30,"function":"main","statement":"let result = csv(inorder(&node("},{"line":35,"function":"main","statement":"println!(\"{result}\");"},{"li