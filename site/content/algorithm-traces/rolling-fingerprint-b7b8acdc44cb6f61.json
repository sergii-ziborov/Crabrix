{"key":"rolling-fingerprint-b7b8acdc44cb6f61","sourceHash":"b7b8acdc44cb6f617174f824586369ae44a0f6c2327571a441bf63e8e7c3869e","pattern":"rolling-fingerprint","category":"hashing","title":"Challenge: Rolling Fingerprint","idea":"Update a window hash by removing the outgoing contribution and adding the incoming one.","complexity":"O(n) time · O(1) rolling state","source":"const BASE: u64 = 10;\nconst MODULUS: u64 = 101;\nfn window_hash(digits: &[u64], k: usize) -> u64 {\n    assert!(k > 0);\n    // Weight of the oldest digit once the window holds k digits.\n    let oldest_weight = (1..k).fold(1, |weight, _| weight * BASE % MODULUS);\n    let mut hash = 0;\n    for (i, &digit) in digits.iter().enumerate() {\n        assert!(digit < 10);\n        if i >= k {\n            // Remove the outgoing digit's contribution, then shift in the new one.\n            let outgoing = digits[i - k] * oldest_weight % MODULUS;\n            hash = (hash + MODULUS - outgoing) % MODULUS;\n        }\n        hash = (hash * BASE + digit) % MODULUS;\n    }\n    hash // A fingerprint is not a collision-free identity.\n}\n\nfn main() {\n    let result = window_hash(&[9, 9], 3).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":4,"function":"window_hash","statement":"assert!(k > 0);"},{"line":6,"function":"window_hash","statement":"let oldest_weight = (1..k).fold(1, |weight, _| weight * BASE % MODULUS);"},{"line":7,"function":"window_hash","statement":"let mut hash = 0;"},{"line":8,"function":"window_hash","statement":"for (i, &digit) in digits.iter().enumerate() {"},{"line":9,"function":"window_hash","statement":"assert!(digit < 10);"},{"line":10,"function":"window_hash","statement":"if i >= k {"},{"line":12,"function":"window_hash","statement":"let outgoing = digits[i - k] * oldest_weight % MODULUS;"},{"line":13,"function":"window_hash","statement":"hash = (hash + MODULUS - outgoing) % MODULUS;"},{"line":14,"function":"window_hash","statement":"}"},{"line":15,"function":"window_hash","statement":"hash = (hash * BASE + digit) % MODULUS;"},{"line":16,"function":"window_hash","statement":"}"},{"line":17,"function":"window_hash","statement":"hash"},{"line":6,"function":"closure · line 6","statement":"weight * BASE % MODULUS"},{"line":21,"function":"main","statement":"let result = window_hash(&[9, 9], 3).to_string();"},{"line":22,"function":"main","statement":"println!(\"{result}\");"},{"line":23,"function":"main","statement":"}"}],"version":1,"input":"digits=[9,9]","stdout":"99\n","values":[{"type":"&[u64]","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"u64","data":{"kind":"scalar","text":"1"}},{"type":"u64","data":{"kind":"scalar","text":"10"}},{"type":"u64","data":{"kind":"scalar","text":"100"}},{"type":"u64","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"u64","data":{"kind":"scalar","text":"9"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"u64","data":{"kind":"scalar","text":"99"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"99\""}}],"frames":[{"site":13,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["window_hash",2]],"locals":[["digits",0],["k",1]]},{"site":1,"stack":[["main",1],["window_hash",2]],"locals":[["digits",0],["k",1]]},{"site":12,"stack":[["main",1],["window_hash",2],["closure · line 6",3]],"locals":[["weight",2],["digits",0],["k",1]]},{"site":12,"stack":[["main",1],["window_hash",2],["closure · line 6",4]],"locals":[["weight",3],["digits",0],["k",1]]},{"site":2,"stack":[["main",1],["window_hash",2]],"locals":[["digits",0],["k",1],["oldest_weight",4]]},{"site":3,"stack":[["main",1],["window_hash",2]],"locals":[["digits",0],["k",1],["oldest_weight",4],["hash",5]]},{"site":4,"stack":[["main",1],["window_hash",2]],"locals":[["digits",0],["k",1],["oldest_weight",4],["hash",5],["i",6],["digit",7]]},{"site":5,"