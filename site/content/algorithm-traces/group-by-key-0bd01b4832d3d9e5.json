{"key":"group-by-key-0bd01b4832d3d9e5","sourceHash":"0bd01b4832d3d9e5ad5cd63b3846a26830afd66c811d90f3d603a361eba87b47","pattern":"group-by-key","category":"hashing","title":"Challenge: Group by Canonical Key","idea":"Transform each item to a stable key and collect items sharing that key.","complexity":"O(sum of L log L) letter-key sorting · O(total symbols) space","source":"fn largest_anagram_group(words: &[&str]) -> usize {\n    let mut groups = std::collections::HashMap::new();\n    for word in words {\n        let mut key: Vec<char> = word.chars().collect();\n        key.sort_unstable();\n        *groups.entry(key).or_insert(0) += 1;\n    }\n    groups.values().copied().max().unwrap_or(0)\n}\n\nfn main() {\n    let result = largest_anagram_group(&[\"abc\", \"bca\", \"foo\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"largest_anagram_group","statement":"let mut groups = std::collections::HashMap::new();"},{"line":3,"function":"largest_anagram_group","statement":"for word in words {"},{"line":4,"function":"largest_anagram_group","statement":"let mut key: Vec<char> = word.chars().collect();"},{"line":5,"function":"largest_anagram_group","statement":"key.sort_unstable();"},{"line":6,"function":"largest_anagram_group","statement":"*groups.entry(key).or_insert(0) += 1;"},{"line":7,"function":"largest_anagram_group","statement":"}"},{"line":8,"function":"largest_anagram_group","statement":"groups.values().copied().max().unwrap_or(0)"},{"line":12,"function":"main","statement":"let result = largest_anagram_group(&[\"abc\", \"bca\", \"foo\"]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[abc,bca,foo]","stdout":"2\n","values":[{"type":"&[&str]","data":{"kind":"list","items":[{"kind":"scalar","text":"\"abc\""},{"kind":"scalar","text":"\"bca\""},{"kind":"scalar","text":"\"foo\""}],"tuple":false}},{"type":"std::collections::hash::map::Ha