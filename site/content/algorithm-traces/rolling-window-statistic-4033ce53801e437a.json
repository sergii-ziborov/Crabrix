{"key":"rolling-window-statistic-4033ce53801e437a","sourceHash":"4033ce53801e437a326c5c6e4bbacfec1f6a7615ab0c45dfca3017a335e953c2","pattern":"rolling-window-statistic","category":"sliding-window","title":"Rolling Mean and Variance: Mental Model","idea":"Update sufficient statistics as samples enter and leave rather than retaining every computation.","complexity":"O(n) time · O(1) extra state over a borrowed slice; a stream needs an eviction buffer","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn window_means(values: &[i64], k: usize) -> Vec<i64> {\n    assert!(k > 0 && k <= values.len());\n    let mut sum: i64 = values[..k].iter().sum();\n    let mut result = vec![sum / k as i64];\n    for i in k..values.len() {\n        sum += values[i] - values[i - k];\n        result.push(sum / k as i64);\n    }\n    result // The fixtures use nonnegative integers; division truncates.\n}\n\nfn main() {\n    let result = csv(window_means(&[2, 4, 6, 8, 10], 3));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"window_means","statement":"assert!(k > 0 && k <= values.len());"},{"line":9,"function":"window_means","statement":"let mut sum: i64 = values[..k].iter().sum();"},{"line":10,"function":"window_means","statement":"let mut result = vec![sum / k as i64];"},{"line":11,"function":"window_means","statement":"for i in k..values.len() {"},{"line":12,"function":"window_means","statement":"sum += values[i] - values[i - k];"},{"line":13,"function":"window_means","statement":"result.push(sum / k as i64);"},{"line":14,"function":"window_means","statement":"}"},{"line":15,"function":"window_means","statement":"result"},{"line":19,"function":"main","statement":"let result = csv(window_means(&[2, 4, 6, 8, 10], 3));"},{"line":20,"function":"main","statement":"println!(\"{result}\");"},{"line":21,"function":"main","statement":"}"}],"version":1,"input":"[2,4,6,8,10]","stdout":"4,6,8\n","values":[{"type":"&[i64]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"8"},{"kind":"scalar","text":"10"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"i64","data":{"kind":"scalar","text":"12"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"i64","data":{"kind":"scalar","text":"18"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i64","data":{"kind":"scalar","text":"24"}},{"type":"alloc::vec::Vec<i64>","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"8"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"4,6,8\""}}],"frames":[{"site":8,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1]]},{"site":1,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1]]},{"site":2,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",2]]},{"site":3,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",2],["result",3]]},{"site":4,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",2],["result",3],["i",1]]},{"site":5,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",4],["result",3],["i",1]]},{"site":6,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",4],["result",5],["i",1]]},{"site":4,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",4],["result",5],["i",6]]},{"site":5,"stack":[["main",1],["window_means",2]],"locals":[["values",0],["k",1],["sum",7],["result",