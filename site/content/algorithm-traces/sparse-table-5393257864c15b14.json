{"key":"sparse-table-5393257864c15b14","sourceHash":"5393257864c15b14b97cf05b156e5d27f84b12b86b8e888b780782cca47f0e78","pattern":"sparse-table","category":"advanced-structures","title":"Challenge: Sparse Table","idea":"Precompute answers for power-of-two blocks and combine two blocks for idempotent queries.","complexity":"O(n log n) build · O(1) query · O(n log n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn sparse_minima(values: &[i32], queries: &[(usize, usize)]) -> Vec<i32> {\n    assert!(!values.is_empty());\n    let n = values.len();\n    let mut levels = vec![values.to_vec()];\n    let mut width = 2;\n    while width <= n {\n        let previous = levels.last().unwrap();\n        let half = width / 2;\n        levels.push(\n            (0..=n - width)\n                .map(|i| previous[i].min(previous[i + half]))\n                .collect(),\n        );\n        width *= 2;\n    }\n    queries\n        .iter()\n        .map(|&(left, right)| {\n            let length = right - left + 1;\n            let level = length.ilog2() as usize;\n            let width = 1 << level;\n            levels[level][left].min(levels[level][right + 1 - width])\n        })\n        .collect()\n}\n\nfn main() {\n    let result = csv(sparse_minima(\n        &[1, 2, 3, 4, 5, 6, 7],\n        &[(0, 3), (2, 5), (4, 6)],\n    ));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"sparse_minima","statement":"assert!(!values.is_empty());"},{"line":9,"function":"sparse_minima","statement":"let n = values.len();"},{"line":10,"function":"sparse_minima","statement":"let mut levels = vec![values.to_vec()];"},{"line":11,"function":"sparse_minima","statement":"let mut width = 2;"},{"line":12,"function":"sparse_minima","statement":"while width <= n {"},{"line":13,"function":"sparse_minima","statement":"let previous = levels.last().unwrap();"},{"line":14,"function":"sparse_minima","statement":"let half = width / 2;"},{"line":15,"function":"sparse_minima","statement":"levels.push("},{"line":20,"function":"sparse_minima","statement":"width *= 2;"},{"line":21,"function":"sparse_minima","statement":"}"},{"line":22,"function":"sparse_minima","statement":"queries"},{"line":17,"function":"closure · line 17","statement":"previous[i].min(previous[i + half])"},{"line":25,"function":"closure · line 24","statement":"let length = right - left + 1;"},{"line":26,"function":"closure · line 24","statement":"let level = length.ilog2() as usize;"},{"line":27,"function":"closure · line 24","statement":"let width = 1 << level;"},{"line":28,"function":"closure · line 24","statement":"levels[level][left].min(levels[level][right + 1 - width])"},{"line":34,"function":"main","statement":"let result = csv(sparse_minima("},{"line":38,"function":"main","statement":"println!(\"{result}\");"},{"line":39,"function":"main","statement":"}"}],"version":1,"input":"[1,2,3,4,5,6,7]","stdout":"1,3,5\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"6"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"&[(usize, usize)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"3"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"6"}],"tuple":true}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"7"}},{"type":"alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"},{"kind":"scalar","text":"5"}