{"key":"segment-tree-d6dc81e52fd5e317","sourceHash":"d6dc81e52fd5e3170421014c8bcf49544787b03ee57f701ea022b39b07fe97f9","pattern":"segment-tree","category":"ranges","title":"Segment Tree: Mental Model","idea":"Represent intervals as a binary tree so a query visits only canonical covering nodes.","complexity":"O(log n) update/query · O(n) space","source":"fn updated_min(values: &[i32], update: (usize, i32), range: (usize, usize)) -> i32 {\n    let n = values.len().next_power_of_two();\n    let mut tree = vec![i32::MAX; 2 * n];\n    tree[n..n + values.len()].copy_from_slice(values);\n    for i in (1..n).rev() {\n        tree[i] = tree[2 * i].min(tree[2 * i + 1]);\n    }\n    let mut i = n + update.0;\n    tree[i] = update.1;\n    while i > 1 {\n        i /= 2;\n        tree[i] = tree[2 * i].min(tree[2 * i + 1]);\n    }\n    let (mut left, mut right) = (range.0 + n, range.1 + n + 1);\n    let mut result = i32::MAX;\n    while left < right {\n        if left % 2 == 1 {\n            result = result.min(tree[left]);\n            left += 1;\n        }\n        if right % 2 == 1 {\n            right -= 1;\n            result = result.min(tree[right]);\n        }\n        left /= 2;\n        right /= 2;\n    }\n    result\n}\n\nfn main() {\n    let result = updated_min(&[5, 4, 7, 2], (2, 0), (1, 3)).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"updated_min","statement":"let n = values.len().next_power_of_two();"},{"line":3,"function":"updated_min","statement":"let mut tree = vec![i32::MAX; 2 * n];"},{"line":4,"function":"updated_min","statement":"tree[n..n + values.len()].copy_from_slice(values);"},{"line":5,"function":"updated_min","statement":"for i in (1..n).rev() {"},{"line":6,"function":"updated_min","statement":"tree[i] = tree[2 * i].min(tree[2 * i + 1]);"},{"line":7,"function":"updated_min","statement":"}"},{"line":8,"function":"updated_min","statement":"let mut i = n + update.0;"},{"line":9,"function":"updated_min","statement":"tree[i]