{"key":"merge-intervals-a66ad8fcd904daeb","sourceHash":"a66ad8fcd904daebb8bd87aafb4d3443d60f77cd033afa6bd0ac9bca6ce7a7c2","pattern":"merge-intervals","category":"greedy-intervals","title":"Challenge: Merge Intervals","idea":"Sort by start and extend the current interval while the next one overlaps.","complexity":"O(n log n) time · O(n) output","source":"fn merged_intervals(intervals: &[(i32, i32)]) -> Vec<(i32, i32)> {\n    let mut sorted = intervals.to_vec();\n    sorted.sort_unstable();\n    let mut out: Vec<(i32, i32)> = Vec::new();\n    for (s, e) in sorted {\n        if let Some(last) = out.last_mut() {\n            if s <= last.1 {\n                last.1 = last.1.max(e);\n                continue;\n            }\n        }\n        out.push((s, e));\n    }\n    out\n}\n\nfn main() {\n    let result = merged_intervals(&[(1, 2), (3, 4)])\n        .iter()\n        .map(|(a, b)| format!(\"{a}-{b}\"))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"merged_intervals","statement":"let mut sorted = intervals.to_vec();"},{"line":3,"function":"merged_intervals","statement":"sorted.sort_unstable();"},{"line":4,"function":"merged_intervals","statement":"let mut out: Vec<(i32, i32)> = Vec::new();"},{"line":5,"function":"merged_intervals","statement":"for (s, e) in sorted {"},{"line":6,"function":"merged_intervals","statement":"if let Some(last) = out.last_mut() {"},{"line":7,"function":"merged_intervals","statement":"if s <= last.1 {"},{"line":8,"function":"merged_intervals","statement":"last.1 = last.1.max(e);"},{"line":9,"function":"merged_intervals","statement":"continue;"},{"line":12,"function":"merged_intervals","statement":"out.push((s, e));"},{"line":13,"function":"merged_intervals","statement":"}"},{"line":14,"function":"merged_intervals","statement":"out"},{"line":18,"function":"main","statement":"let result = merged_intervals(&[(1, 2), (3, 4)])"},{"line":23,"function":"main","statement":"println!(\"{result}\");"},{"line":24,"function":"main","statement":"}"},{"line":20,"function":"closure · line 20","statement":"format!(\"{a}-{b}\")"}],"version":1,"input":"[(1,2),(3,4)]","stdout":"1-2,3-4\n","values":[{"type":"&[(i32, i32)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<(i32, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":true}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"&i32","data":{"kind":"scalar","text":"1"}},{"type":"&i32","data":{"kind":"scalar","text":"2"}},{"type":"&i32","data":{"kind":"scalar","text":"3"}},{"type":"&i32","data":{"kind":"scalar","text":"4"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1-2,3-4\""}}],"frames":[{"site":11,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["merged_intervals",2]],"locals":[["intervals",0]]},{"site":1,"stack":[["main",1],["merged_intervals",2]],"locals":[["intervals",0],["sorted",1]]},{"site":2,"stack":[["main",1],["merged_intervals",2]],"locals":[["intervals",0],["sorted",1]]},{"site":3,"stack":[["main",1],["merged_intervals",2]],"locals":[["intervals",0],["sorted",1],["out",2]]},{"site":4,"stack":[["main",1],["merged_interva