{"key":"randomized-set-1bb0e0eb0795110f","sourceHash":"1bb0e0eb0795110f11c7a33dc5459f822d9d321ba144596dcc9ab695012e1356","pattern":"randomized-set","category":"hashing","title":"Challenge: Indexed Randomized Set","idea":"Combine a dense vector with a value-to-index map; delete by swapping with the last item.","complexity":"O(1) expected per operation · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\n#[derive(Default)]\nstruct DenseSet {\n    values: Vec<i32>,\n    index: std::collections::HashMap<i32, usize>,\n}\nimpl DenseSet {\n    fn insert(&mut self, x: i32) {\n        if self.index.contains_key(&x) {\n            return;\n        }\n        self.index.insert(x, self.values.len());\n        self.values.push(x);\n    }\n    fn remove(&mut self, x: i32) {\n        if let Some(i) = self.index.remove(&x) {\n            self.values.swap_remove(i);\n            if i < self.values.len() {\n                self.index.insert(self.values[i], i);\n            }\n        }\n    }\n    // A caller-supplied uniform index gives a uniform stored element.\n    fn sample(&self, uniform_index: usize) -> Option<i32> {\n        self.values.get(uniform_index).copied()\n    }\n}\nfn dense_operations(ops: &[(bool, i32)]) -> Vec<i32> {\n    let mut set = DenseSet::default();\n    for &(insert, x) in ops {\n        if insert {\n            set.insert(x);\n        } else {\n            set.remove(x);\n        }\n    }\n    let _ = set.sample(0);\n    set.values.sort_unstable();\n    set.values\n}\n\nfn main() {\n    let result = csv(dense_operations(&[\n        (true, 1),\n        (true, 2),\n        (false, 2),\n        (true, 3),\n    ]));\n    println!(\"{result}\");\n}\n","sites":[{"line":14,"function":"insert","statement":"if self.index.contains_key(&x) {"},{"line":15,"function":"insert","statement":"return;"},{"line":17,"function"