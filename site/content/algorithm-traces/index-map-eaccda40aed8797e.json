{"key":"index-map-eaccda40aed8797e","sourceHash":"eaccda40aed8797e5f88092c40aa3c6f21d9de8f14cfcb9315228f61b4739a22","pattern":"index-map","category":"hashing","title":"Challenge: Value-to-Index Map","idea":"Remember the latest or earliest position associated with each value.","complexity":"O(n) expected time · O(k) space","source":"fn nearest_repeat(values: &[i32]) -> Option<usize> {\n    let mut last = std::collections::HashMap::new();\n    let mut best = None;\n    for (i, &x) in values.iter().enumerate() {\n        if let Some(j) = last.insert(x, i) {\n            best = Some(best.map_or(i - j, |old: usize| old.min(i - j)));\n        }\n    }\n    best\n}\n\nfn main() {\n    let result = nearest_repeat(&[1, 2, 3, 2]).map_or(\"-1\".into(), |i| i.to_string());\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"nearest_repeat","statement":"let mut last = std::collections::HashMap::new();"},{"line":3,"function":"nearest_repeat","statement":"let mut best = None;"},{"line":4,"function":"nearest_repeat","statement":"for (i, &x) in values.iter().enumerate() {"},{"line":5,"function":"nearest_repeat","statement":"if let Some(j) = last.insert(x, i) {"},{"line":6,"function":"nearest_repeat","statement":"best = Some(best.map_or(i - j, |old: usize| old.min(i - j)));"},{"line":7,"function":"nearest_repeat","statement":"}"},{"line":9,"function":"nearest_repeat","statement":"best"},{"line":6,"function":"closure · line 6","statement":"old.min(i - j)"},{"line":13,"function":"main","statement":"let result = nearest_repeat(&[1, 2, 3, 2]).map_or(\"-1\".into(), |i| i.to_string());"},{"line":14,"function":"main","statement":"println!(\"{result}\");"},{"line":15,"function":"main","statement":"}"},{"line":13,"function":"closure · line 13","statement":"i.to_string()"}],"version":1,"input":"[1, 2, 3, 2]","stdout":"2\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scala