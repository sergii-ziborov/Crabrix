{"key":"lower-bound-e09a977ebe612a41","sourceHash":"e09a977ebe612a419d9bc569bb0f45fd5dd4411efead9f8396f9c744c9ac0eed","pattern":"lower-bound","category":"binary-search","title":"Challenge: Lower Bound","idea":"Maintain the first position that may still hold a value greater than or equal to target.","complexity":"O(log n) time · O(1) space","source":"fn lower_bound(a: &[i32], target: i32) -> usize {\n    let (mut lo, mut hi) = (0, a.len());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if a[mid] < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    lo\n}\n\nfn main() {\n    let result = lower_bound(&[4, 4], 4).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"lower_bound","statement":"let (mut lo, mut hi) = (0, a.len());"},{"line":3,"function":"lower_bound","statement":"while lo < hi {"},{"line":4,"function":"lower_bound","statement":"let mid = lo + (hi - lo) / 2;"},{"line":5,"function":"lower_bound","statement":"if a[mid] < target {"},{"line":6,"function":"lower_bound","statement":"lo = mid + 1;"},{"line":7,"function":"lower_bound","statement":"}"},{"line":8,"function":"lower_bound","statement":"hi = mid;"},{"line":9,"function":"lower_bound","statement":"}"},{"line":11,"function":"lower_bound","statement":"lo"},{"line":15,"function":"main","statement":"let result = lower_bound(&[4, 4], 4).to_string();"},{"line":16,"function":"main","statement":"println!(\"{result}\");"},{"line":17,"function":"main","statement":"}"}],"version":1,"input":"[4,4]","stdout":"0\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"4"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"0\""}}],