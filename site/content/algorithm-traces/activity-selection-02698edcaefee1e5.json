{"key":"activity-selection-02698edcaefee1e5","sourceHash":"02698edcaefee1e52be6e841f3246aa697d10e37bf3d1aa6401f7d4e331c4ea9","pattern":"activity-selection","category":"greedy-intervals","title":"Activity Selection: Mental Model","idea":"Choose the compatible interval that finishes earliest, leaving maximum room for the future.","complexity":"O(n log n) time · O(n) owned sorted copy; O(1) greedy state","source":"fn maximum_meetings(intervals: &[(i32, i32)]) -> usize {\n    let mut sorted = intervals.to_vec();\n    sorted.sort_by_key(|&(s, e)| (e, s));\n    let mut end = i32::MIN;\n    let mut kept = 0;\n    for (s, e) in sorted {\n        if s >= end {\n            kept += 1;\n            end = e;\n        }\n    }\n    kept\n}\n\nfn main() {\n    let result = maximum_meetings(&[(1, 2), (3, 4), (0, 6), (5, 7), (8, 9), (5, 9)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"maximum_meetings","statement":"let mut sorted = intervals.to_vec();"},{"line":3,"function":"maximum_meetings","statement":"sorted.sort_by_key(|&(s, e)| (e, s));"},{"line":4,"function":"maximum_meetings","statement":"let mut end = i32::MIN;"},{"line":5,"function":"maximum_meetings","statement":"let mut kept = 0;"},{"line":6,"function":"maximum_meetings","statement":"for (s, e) in sorted {"},{"line":7,"function":"maximum_meetings","statement":"if s >= end {"},{"line":8,"function":"maximum_meetings","statement":"kept += 1;"},{"line":9,"function":"maximum_meetings","statement":"end = e;"},{"line":10,"function":"maximum_meetings","statement":"}"},{"line":12,"function":"maximum_meetings","statement":"kept"},{"line":3,"function":"closure · line 3","statement":"(e, s)"},{"line":16,"function":"main","statement":"let result = maximum_meetings(&[(1, 2), (3, 4), (0, 6), (5, 7), (8, 9), (5, 9)]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"[(1,2),(3,4),(0,6),(5,7),(8,9),(5,9)