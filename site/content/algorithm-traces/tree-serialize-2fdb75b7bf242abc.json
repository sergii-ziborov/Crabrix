{"key":"tree-serialize-2fdb75b7bf242abc","sourceHash":"2fdb75b7bf242abcf31a424d6fe42f01f396613e74657059af51babd52d5cb40","pattern":"tree-serialize","category":"trees","title":"Challenge: Tree Serialize/Deserialize","idea":"Emit null markers as well as values so structure is reconstructible, not only traversal order.","complexity":"O(n) time · O(n) output","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn serialize(root: &Tree) -> String {\n    fn visit(root: &Tree, out: &mut Vec<String>) {\n        match root {\n            None => out.push(\"#\".into()),\n            Some(n) => {\n                out.push(n.value.to_string());\n                visit(&n.left, out);\n                visit(&n.right, out);\n            }\n        }\n    }\n    let mut out = Vec::new();\n    visit(root, &mut out);\n    out.join(\",\")\n}\n\nfn main() {\n    let result = serialize(&node(1, None, None));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":21,"function":"serialize","statement":"let mut out = Vec::new();"},{"line":22,"function":"serialize","statement":"visit(root, &mut out);"},{"line":23,"function":"serialize","statement":"out.join(\",\")"},{"line":12,"function":"visit","statement":"match root {"},{"line":15,"function":"visit","statement":"out.push(n.value.to_string());"},{"line":16,"function":"visit","statement":"visit(&n.left, out);"},{"line":17,"function":"visit","statement":"visit(&n.right, out);"},{"line":18,"function":"visit","statement":"}"},{"line":27,"function":"main","statement":"let result = serialize(&node(1, None, None));"},{"line":28,"function":"main","statement":"println!(\"{result}\");"},{"line":29,"function":"main","statement":"}"}],"version":1,"input":"tree=[1]","stdout":"1,#,#\n","values":[{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"&core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}],"tuple":true}}},{"type":"alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&mut alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&alloc::boxed::Box<traced::Node>","data":{"kind":"named","name":"Node","value":{"kind":"map","entries":[[{"kind":"scalar","text":"left"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"right"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"1"}]]}}},{"type":"&mut alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[{"kind":"scalar","text":"\"1\""}],"tuple":false}},{"type":"&core::option::Option<alloc::boxed::Box<traced::Node>>","data":{"kind":"scalar","text":"None"}},{"type":"&mut alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[{"kind":"scalar","text":"\"1\""},{"kind":"scalar","text":"\"#\""}],"tuple":false}},{"type":"&mut alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[{"kind":"scalar","text":"\"1\""},{"kind":"scalar","text":"\"#\""},{"kind":"scalar","text":"\"#\""}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::string::String>","data":{"kind":"list","items":[{"kind":"scalar","text":"\"1\""},{"kind":"scalar","text":"\"#\""},{"kind":"scalar","text":"\"#\""}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1,#,#\""}}],"frames":[{"site":9,"stack":[["main",1]],"l