{"key":"bst-search-insert-2e56d83a4d34b4a2","sourceHash":"2e56d83a4d34b4a2d17bed2a88cfd8bd425d5d2d5a2ef0ced8d56951bfb7ee9a","pattern":"bst-search-insert","category":"trees","title":"BST Search and Insert: Mental Model","idea":"Use the ordering invariant to follow one child and preserve it at insertion.","complexity":"O(h) time · O(h) stack or O(1) iterative","source":"type Tree = Option<Box<Node>>;\nstruct Node {\n    value: i32,\n    left: Tree,\n    right: Tree,\n}\nfn node(value: i32, left: Tree, right: Tree) -> Tree {\n    Some(Box::new(Node { value, left, right }))\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn insert_bst(root: &mut Tree, value: i32) {\n    match root {\n        None => *root = node(value, None, None),\n        Some(n) if value < n.value => insert_bst(&mut n.left, value),\n        Some(n) => insert_bst(&mut n.right, value), // duplicates go right\n    }\n}\nfn bst_values(root: &Tree) -> Vec<i32> {\n    match root {\n        None => Vec::new(),\n        Some(n) => {\n            let mut out = bst_values(&n.left);\n            out.push(n.value);\n            out.extend(bst_values(&n.right));\n            out\n        }\n    }\n}\n\nfn main() {\n    let result = {\n        let mut root = node(\n            4,\n            node(2, node(1, None, None), node(3, None, None)),\n            node(7, None, None),\n        );\n        insert_bst(&mut root, 5);\n        csv(bst_values(&root))\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"node","statement":"Some(Box::new(Node { value, left, right }))"},{"line":17,"function":"insert_bst","statement":"match root {"},{"line":24,"function":"bst_values","statement":"match root {"},{"line":27,"function":"bst_values","statement":"let mut out = bst_values(&n.left);"},{"line":28,"function":"bst_values","statement":"out.push(n.value);"},{"line":29,"fun