{"key":"disjoint-set-union-7e46e15a10d0f147","sourceHash":"7e46e15a10d0f147262740e5b2dfaeabc0127eb404cf8d4a44264c99c86ef8d2","pattern":"disjoint-set-union","category":"advanced-structures","title":"Disjoint Set Union: Mental Model","idea":"Compress find paths and attach smaller trees beneath larger roots.","complexity":"Almost O(1) amortised · O(n) space","source":"struct Dsu {\n    parent: Vec<usize>,\n    size: Vec<usize>,\n    count: usize,\n}\nimpl Dsu {\n    fn new(n: usize) -> Self {\n        Self {\n            parent: (0..n).collect(),\n            size: vec![1; n],\n            count: n,\n        }\n    }\n    fn root(&mut self, mut x: usize) -> usize {\n        while x != self.parent[x] {\n            self.parent[x] = self.parent[self.parent[x]];\n            x = self.parent[x];\n        }\n        x\n    }\n    fn join(&mut self, a: usize, b: usize) -> bool {\n        let (mut a, mut b) = (self.root(a), self.root(b));\n        if a == b {\n            return false;\n        }\n        if self.size[a] < self.size[b] {\n            std::mem::swap(&mut a, &mut b);\n        }\n        self.parent[b] = a;\n        self.size[a] += self.size[b];\n        self.count -= 1;\n        true\n    }\n}\nfn components_after_unions(n: usize, unions: &[(usize, usize)]) -> usize {\n    let mut sets = Dsu::new(n);\n    for &(a, b) in unions {\n        sets.join(a, b);\n    }\n    sets.count\n}\n\nfn main() {\n    let result = components_after_unions(5, &[(0, 1), (1, 2), (3, 4)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"new","statement":"Self {"},{"line":15,"function":"root","statement":"while x != self.parent[x] {"},{"line":16,"function":"root","statement":"self.parent[x] = self.parent[self.parent[x]];"},{"line":17,"function":"root","statement":"x = self.parent[x];"},{"line":18,"function":"root","statement":"}"},{"line":19,"function":"root","statement":"x"},{"line":22,"function":"join","statement":"let (mut a, mut b) = (self.root(a), sel