{"key":"prefix-sum-2d-d2354737401318f3","sourceHash":"d2354737401318f3fd0d2930e7ad1e8ac303fce3fb32886d7b33e3af020eda99","pattern":"prefix-sum-2d","category":"ranges","title":"Challenge: 2D Prefix Sum","idea":"Store each rectangle from the origin and use inclusion-exclusion for any subrectangle.","complexity":"O(rows*cols) build · O(1) query","source":"fn rectangle_sum(a: &[Vec<i64>], r1: usize, c1: usize, r2: usize, c2: usize) -> i64 {\n    let (rows, cols) = (a.len(), a[0].len());\n    let mut p = vec![vec![0; cols + 1]; rows + 1];\n    for r in 0..rows {\n        for c in 0..cols {\n            p[r + 1][c + 1] = a[r][c] + p[r][c + 1] + p[r + 1][c] - p[r][c];\n        }\n    }\n    p[r2 + 1][c2 + 1] - p[r1][c2 + 1] - p[r2 + 1][c1] + p[r1][c1]\n}\n\nfn main() {\n    let result = rectangle_sum(&[vec![0, 0], vec![1, 2], vec![3, 4]], 1, 0, 2, 1).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"rectangle_sum","statement":"let (rows, cols) = (a.len(), a[0].len());"},{"line":3,"function":"rectangle_sum","statement":"let mut p = vec![vec![0; cols + 1]; rows + 1];"},{"line":4,"function":"rectangle_sum","statement":"for r in 0..rows {"},{"line":5,"function":"rectangle_sum","statement":"for c in 0..cols {"},{"line":6,"function":"rectangle_sum","statement":"p[r + 1][c + 1] = a[r][c] + p[r][c + 1] + p[r + 1][c] - p[r][c];"},{"line":7,"function":"rectangle_sum","statement":"}"},{"line":9,"function":"rectangle_sum","statement":"p[r2 + 1][c2 + 1] - p[r1][c2 + 1] - p[r2 + 1][c1] + p[r1][c1]"},{"line":13,"function":"main","statement":"let result = rectangle_sum(&[vec![0, 0], vec![1, 2], vec![3, 4]], 1, 0, 2, 1).to_string();"},{"line":14,"function":"main","statement":"println!(\"{result}\");"},{"line":15,"function":"main","statement":"}"}],"version":1,"input":"[[0,0],[1,2],[3,4]]","stdout":"10\n","values":[{"type":"&[alloc::vec::Vec<i64>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"0"}],"t