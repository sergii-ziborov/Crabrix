{"key":"next-greater-stack-8edd872dc91d8ffd","sourceHash":"8edd872dc91d8ffd31f22375c96519bac2c525d10adc9a6b7e573044528f988d","pattern":"next-greater-stack","category":"stacks-queues","title":"Challenge: Next Greater Element","idea":"Keep unresolved indexes in decreasing value order and resolve them when a larger value appears.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn next_greater(values: &[i32]) -> Vec<i32> {\n    let mut result = vec![-1; values.len()];\n    let mut unresolved = Vec::new();\n    for (i, &x) in values.iter().enumerate() {\n        while unresolved.last().is_some_and(|&j| values[j] < x) {\n            result[unresolved.pop().unwrap()] = x;\n        }\n        unresolved.push(i);\n    }\n    result\n}\n\nfn main() {\n    let result = csv(next_greater(&[1, 3, 2]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"next_greater","statement":"let mut result = vec![-1; values.len()];"},{"line":9,"function":"next_greater","statement":"let mut unresolved = Vec::new();"},{"line":10,"function":"next_greater","statement":"for (i, &x) in values.iter().enumerate() {"},{"line":11,"function":"next_greater","statement":"while unresolved.last().is_some_and(|&j| values[j] < x) {"},{"line":12,"function":"next_greater","statement":"result[unresolved.pop().unwrap()] = x;"},{"line":13,"function":"next_greater","statement":"}"},{"line":14,"function":"next_greater","statement":"unresolved.push(i);"},{"line":15,"function":"next_greater","statement":"}"},{"line":16,"function":"next_greater","statement":"result"},{"line":11,"function":"closure · line 11","statement":"values[j] < x"},{"line":20,"function":"main","statement":"let result = csv(next_greater(&[1, 3, 2]));"},{"line":21,"function":"main","statement":"println!(\"{result}\");"},{"line":22,"function":"main","statem