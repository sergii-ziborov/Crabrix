{"key":"minimum-arrows-92251d91dfc7d28c","sourceHash":"92251d91dfc7d28c96239a0a851cae4bf16efb8a16be0d022d1118faaf778957","pattern":"minimum-arrows","category":"greedy-intervals","title":"Interval Stabbing: Mental Model","idea":"Sort by interval end and place a point only when the next interval starts after the current point.","complexity":"O(n log n) time · O(n) owned sorted copy; O(1) greedy state","source":"fn arrows(intervals: &[(i32, i32)]) -> usize {\n    let mut sorted = intervals.to_vec();\n    sorted.sort_by_key(|&(a, b)| (b, a));\n    let mut last = None;\n    let mut count = 0;\n    for (start, end) in sorted {\n        if last.is_none_or(|x| start > x) {\n            count += 1;\n            last = Some(end);\n        }\n    }\n    count\n}\n\nfn main() {\n    let result = arrows(&[(10, 16), (2, 8), (1, 6), (7, 12)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"arrows","statement":"let mut sorted = intervals.to_vec();"},{"line":3,"function":"arrows","statement":"sorted.sort_by_key(|&(a, b)| (b, a));"},{"line":4,"function":"arrows","statement":"let mut last = None;"},{"line":5,"function":"arrows","statement":"let mut count = 0;"},{"line":6,"function":"arrows","statement":"for (start, end) in sorted {"},{"line":7,"function":"arrows","statement":"if last.is_none_or(|x| start > x) {"},{"line":8,"function":"arrows","statement":"count += 1;"},{"line":9,"function":"arrows","statement":"last = Some(end);"},{"line":10,"function":"arrows","statement":"}"},{"line":12,"function":"arrows","statement":"count"},{"line":3,"function":"closure · line 3","statement":"(b, a)"},{"line":7,"function":"closure · line 7","statement":"start > x"},{"line":16,"function":"main","statement":"let result = arrows(&[(10, 16), (2, 8), (1, 6), (7, 12)]).to_string();"},{"line":17,"function":"main","statement":"println!(\"{result}\");"},{"line":18,"function":"main","statement":"}"}],"version":1,"input":"[(10,16),(2,8),(1,6),(7,12)]","stdout":"2\n","values":[