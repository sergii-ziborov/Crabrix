{"key":"parentheses-generation-beba9519bc6269e2","sourceHash":"beba9519bc6269e2fe0bf2c068df87bc789dca3b76304fe915f9abdaba83c378","pattern":"parentheses-generation","category":"backtracking","title":"Valid Parentheses Generation: Mental Model","idea":"Add an open symbol while available and a close only when it cannot exceed opens used.","complexity":"O(Catalan(n)*n) time · O(n) depth","source":"fn parentheses(n: usize) -> Vec<String> {\n    fn visit(n: usize, open: usize, closed: usize, text: &mut String, out: &mut Vec<String>) {\n        if closed == n {\n            out.push(text.clone());\n            return;\n        }\n        if open < n {\n            text.push('(');\n            visit(n, open + 1, closed, text, out);\n            text.pop();\n        }\n        if closed < open {\n            text.push(')');\n            visit(n, open, closed + 1, text, out);\n            text.pop();\n        }\n    }\n    let mut out = Vec::new();\n    visit(n, 0, 0, &mut String::new(), &mut out);\n    out\n}\n\nfn main() {\n    let result = parentheses(3).join(\";\");\n    println!(\"{result}\");\n}\n","sites":[{"line":18,"function":"parentheses","statement":"let mut out = Vec::new();"},{"line":19,"function":"parentheses","statement":"visit(n, 0, 0, &mut String::new(), &mut out);"},{"line":20,"function":"parentheses","statement":"out"},{"line":3,"function":"visit","statement":"if closed == n {"},{"line":4,"function":"visit","statement":"out.push(text.clone());"},{"line":5,"function":"visit","statement":"return;"},{"line":7,"function":"visit","statement":"if open < n {"},{"line":8,"function":"visit","statement":"text.push('(');"},{"line":9,"function":"visit","statement":"visit(n, open + 1, closed, text, out);"},{"line":10,"function":"visit","statement":"text.pop();"},{"line":11,"function":"visit","statement":"}"},{"line":12,"function":"visit","statement":"if closed < open {"},{"line":13,"function":"visit","statement":"text.push(')');"},{"line":14,"function":"visit","statemen