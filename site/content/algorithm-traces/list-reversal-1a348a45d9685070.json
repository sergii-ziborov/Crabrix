{"key":"list-reversal-1a348a45d9685070","sourceHash":"1a348a45d968507005e19e32b3f9f52b671b9c8775eb63e86a452ca2c5188211","pattern":"list-reversal","category":"linked-lists","title":"Challenge: Iterative List Reversal","idea":"Detach the next link before redirecting the current node toward the reversed prefix.","complexity":"O(n) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn reverse(mut head: Link) -> Link {\n    let mut reversed = None;\n    while let Some(mut node) = head {\n        head = node.next.take();\n        node.next = reversed;\n        reversed = Some(node);\n    }\n    reversed\n}\n\nfn main() {\n    let result = csv(list_values(&reverse(list(&[9, 8]))));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","sta