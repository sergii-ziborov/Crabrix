{"key":"circular-monotonic-stack-6427ed67364aa337","sourceHash":"6427ed67364aa3374f54bd6596e33e9671fd40b383ba3b388cf6fd89dd1033f7","pattern":"circular-monotonic-stack","category":"stacks-queues","title":"Circular Monotonic Stack: Mental Model","idea":"Traverse indexes twice while storing each unresolved position only once.","complexity":"O(n) time · O(n) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn circular_greater(values: &[i32]) -> Vec<i32> {\n    let n = values.len();\n    let mut out = vec![-1; n];\n    let mut stack = Vec::new();\n    for step in 0..2 * n {\n        let i = step % n;\n        while stack.last().is_some_and(|&j| values[j] < values[i]) {\n            out[stack.pop().unwrap()] = values[i];\n        }\n        if step < n {\n            stack.push(i);\n        }\n    }\n    out\n}\n\nfn main() {\n    let result = csv(circular_greater(&[1, 2, 1]));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"circular_greater","statement":"let n = values.len();"},{"line":9,"function":"circular_greater","statement":"let mut out = vec![-1; n];"},{"line":10,"function":"circular_greater","statement":"let mut stack = Vec::new();"},{"line":11,"function":"circular_greater","statement":"for step in 0..2 * n {"},{"line":12,"function":"circular_greater","statement":"let i = step % n;"},{"line":13,"function":"circular_greater","statement":"while stack.last().is_some_and(|&j| values[j] < values[i]) {"},{"line":14,"function":"circular_greater","statement":"out[stack.pop().unwrap()] = values[i];"},{"line":15,"function":"circular_greater","statement":"}"},{"line":16,"function":"circular_greater","statement":"if step < n {"},{"line":17,"function":"circular_greater","statement":"stack.push(i);"},{"line":18,"function":"circular_greater","statement":"}"},{"line":20,"function":"circular_greater","statement":"out