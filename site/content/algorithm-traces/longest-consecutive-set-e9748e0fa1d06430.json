{"key":"longest-consecutive-set-e9748e0fa1d06430","sourceHash":"e9748e0fa1d06430e190e3859030ae3837b89a6f8b207b1093a91387162e96b1","pattern":"longest-consecutive-set","category":"hashing","title":"Longest Consecutive Set Run: Mental Model","idea":"Start only at values with no predecessor, then walk each consecutive run once.","complexity":"O(n) expected time · O(n) space","source":"fn longest_run(values: &[i32]) -> usize {\n    let set: std::collections::HashSet<_> = values.iter().copied().collect();\n    let mut best = 0;\n    for &start in &set {\n        if start.checked_sub(1).is_some_and(|x| set.contains(&x)) {\n            continue;\n        }\n        let mut length = 1;\n        while start\n            .checked_add(length as i32)\n            .is_some_and(|x| set.contains(&x))\n        {\n            length += 1;\n        }\n        best = best.max(length);\n    }\n    best\n}\n\nfn main() {\n    let result = longest_run(&[100, 4, 200, 1, 3, 2]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"longest_run","statement":"let set: std::collections::HashSet<_> = values.iter().copied().collect();"},{"line":3,"function":"longest_run","statement":"let mut best = 0;"},{"line":4,"function":"longest_run","statement":"for &start in &set {"},{"line":5,"function":"longest_run","statement":"if start.checked_sub(1).is_some_and(|x| set.contains(&x)) {"},{"line":6,"function":"longest_run","statement":"continue;"},{"line":8,"function":"longest_run","statement":"let mut length = 1;"},{"line":9,"function":"longest_run","statement":"while start"},{"line":13,"function":"longest_run","statement":"length += 1;"},{"line":14,"function":"longest_run","statement":"}"},{"line":15,"function":"longest_run","statement":"best = best.max(length);"},{"line":16,"function":"longest_run","statement":"}"},{"line":17,"function":"longest_run","statement":"best"},{"line":5,"function":"closure · line 5","statement":"set.contains(&x)"},{"line":11,"function":"closure · lin