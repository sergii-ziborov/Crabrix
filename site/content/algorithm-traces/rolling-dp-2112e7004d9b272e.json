{"key":"rolling-dp-2112e7004d9b272e","sourceHash":"2112e7004d9b272e4474a595b9636a29d7645070aadbfaf5dfb9a5ccd0423b36","pattern":"rolling-dp","category":"dynamic-1d","title":"Challenge: Rolling-State DP","idea":"Discard table entries once no future transition can read them.","complexity":"O(n) time · O(1) space","source":"fn stair_cost(cost: &[i32]) -> i32 {\n    let (mut two_back, mut one_back) = (0, 0);\n    for &price in cost {\n        let current = price + two_back.min(one_back);\n        two_back = one_back;\n        one_back = current;\n    }\n    two_back.min(one_back)\n}\n\nfn main() {\n    let result = stair_cost(&[1, 2]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"stair_cost","statement":"let (mut two_back, mut one_back) = (0, 0);"},{"line":3,"function":"stair_cost","statement":"for &price in cost {"},{"line":4,"function":"stair_cost","statement":"let current = price + two_back.min(one_back);"},{"line":5,"function":"stair_cost","statement":"two_back = one_back;"},{"line":6,"function":"stair_cost","statement":"one_back = current;"},{"line":7,"function":"stair_cost","statement":"}"},{"line":8,"function":"stair_cost","statement":"two_back.min(one_back)"},{"line":12,"function":"main","statement":"let result = stair_cost(&[1, 2]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"cost=[1,2]","stdout":"1\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1\""}}],"frames":[{"site":7,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["stair_cost",2]],"locals":[["cost",0]]},{"site":1,"stack":[["main",1],["stair_cost",2]],