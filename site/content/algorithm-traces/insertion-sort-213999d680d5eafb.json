{"key":"insertion-sort-213999d680d5eafb","sourceHash":"213999d680d5eafb5841bdf9dd84e6b090b62a0ab947a330b967f6379d49f276","pattern":"insertion-sort","category":"sorting-selection","title":"Challenge: Insertion Sort","idea":"Grow a sorted prefix by shifting each new item to its insertion position.","complexity":"O(n^2) worst · O(n) best · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\n\nfn insertion_sort_by_key<T: Clone, K: Ord>(values: &mut [T], key: impl Fn(&T) -> K) {\n    for i in 1..values.len() {\n        let value = values[i].clone();\n        let mut j = i;\n        // A strict comparison leaves an equal earlier key in front.\n        while j > 0 && key(&values[j - 1]) > key(&value) {\n            values[j] = values[j - 1].clone();\n            j -= 1;\n        }\n        values[j] = value;\n    }\n}\nfn insertion_sort(values: &mut [i32]) {\n    insertion_sort_by_key(values, |x| *x);\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![3, 1];\n        insertion_sort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":9,"function":"insertion_sort_by_key","statement":"for i in 1..values.len() {"},{"line":10,"function":"insertion_sort_by_key","statement":"let value = values[i].clone();"},{"line":11,"function":"insertion_sort_by_key","statement":"let mut j = i;"},{"line":13,"function":"insertion_sort_by_key","statement":"while j > 0 && key(&values[j - 1]) > key(&value) {"},{"line":14,"function":"insertion_sort_by_key","statement":"values[j] = values[j - 1].clone();"},{"line":15,"function":"insertion_sort_by_key","statement":"j -= 1;"},{"line":16,"function":"insertion_sort_by_key","statement":"}"},{"line":17,"function":"insertion_sort_by_key","statement":"values[j] = value;"},{"line":18,"function":"insertion_sort_by_key","statement":"}"},{"line":21,"func