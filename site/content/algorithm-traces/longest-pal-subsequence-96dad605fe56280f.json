{"key":"longest-pal-subsequence-96dad605fe56280f","sourceHash":"96dad605fe56280fa8e5007a8b0053284b7903018940d52a57bd176b2cb5d66b","pattern":"longest-pal-subsequence","category":"dynamic-2d","title":"Challenge: Longest Palindromic Subsequence","idea":"Equal interval ends add two; unequal ends discard one boundary and keep the better interval.","complexity":"O(n^2) time · O(n^2) space","source":"fn palindromic_subsequence(text: &str) -> usize {\n    assert!(text.is_ascii());\n    let a = text.as_bytes();\n    let n = a.len();\n    if n == 0 {\n        return 0;\n    }\n    let mut dp = vec![vec![0; n]; n];\n    for i in (0..n).rev() {\n        dp[i][i] = 1;\n        for j in i + 1..n {\n            dp[i][j] = if a[i] == a[j] {\n                2 + if j == i + 1 { 0 } else { dp[i + 1][j - 1] }\n            } else {\n                dp[i + 1][j].max(dp[i][j - 1])\n            };\n        }\n    }\n    dp[0][n - 1]\n}\n\nfn main() {\n    let result = palindromic_subsequence(\"abc\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"palindromic_subsequence","statement":"assert!(text.is_ascii());"},{"line":3,"function":"palindromic_subsequence","statement":"let a = text.as_bytes();"},{"line":4,"function":"palindromic_subsequence","statement":"let n = a.len();"},{"line":5,"function":"palindromic_subsequence","statement":"if n == 0 {"},{"line":6,"function":"palindromic_subsequence","statement":"return 0;"},{"line":8,"function":"palindromic_subsequence","statement":"let mut dp = vec![vec![0; n]; n];"},{"line":9,"function":"palindromic_subsequence","statement":"for i in (0..n).rev() {"},{"line":10,"function":"palindromic_subsequence","statement":"dp[i][i] = 1;"},{"line":11,"function":"palindromic_subsequence","statement":"for j in i + 1..n {"},{"line":12,"function":"palindromic_subsequence","statement":"dp[i][j] = if a[i] == a[j] {"},{"line":13,"function":"palindromic_subsequence","statement":"2 + if j == i + 1 { 0 } else { dp[i + 1][j - 1] }"},{"l