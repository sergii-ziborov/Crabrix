{"key":"kadane-088fb94c52f12895","sourceHash":"088fb94c52f12895f697fe30dd4c7b1cdc959d328d443cced18ea051a2036281","pattern":"kadane","category":"dynamic-1d","title":"Challenge: Kadane Maximum Subarray","idea":"At each item choose whether to extend the current segment or start a new one.","complexity":"O(n) time · O(1) space","source":"fn maximum_subarray(values: &[i32]) -> i32 {\n    assert!(!values.is_empty());\n    let (mut ending, mut best) = (values[0], values[0]);\n    for &x in &values[1..] {\n        ending = x.max(ending + x);\n        best = best.max(ending);\n    }\n    best\n}\n\nfn main() {\n    let result = maximum_subarray(&[-5, -2]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"maximum_subarray","statement":"assert!(!values.is_empty());"},{"line":3,"function":"maximum_subarray","statement":"let (mut ending, mut best) = (values[0], values[0]);"},{"line":4,"function":"maximum_subarray","statement":"for &x in &values[1..] {"},{"line":5,"function":"maximum_subarray","statement":"ending = x.max(ending + x);"},{"line":6,"function":"maximum_subarray","statement":"best = best.max(ending);"},{"line":7,"function":"maximum_subarray","statement":"}"},{"line":8,"function":"maximum_subarray","statement":"best"},{"line":12,"function":"main","statement":"let result = maximum_subarray(&[-5, -2]).to_string();"},{"line":13,"function":"main","statement":"println!(\"{result}\");"},{"line":14,"function":"main","statement":"}"}],"version":1,"input":"[-5,-2]","stdout":"-2\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"-5"},{"kind":"scalar","text":"-2"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"-5"}},{"type":"i32","data":{"kind":"scalar","text":"-2"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"-2\""}}],"frames":[{"site":7,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["maximum_subarray",2]],"locals":[["values",0]]},{"site":1,"stack":[["main",1],