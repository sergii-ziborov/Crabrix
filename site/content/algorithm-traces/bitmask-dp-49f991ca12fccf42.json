{"key":"bitmask-dp-49f991ca12fccf42","sourceHash":"49f991ca12fccf42a714460e53c8de130028cdbe99b7eea3ec8ef9338c53ca2a","pattern":"bitmask-dp","category":"dynamic-2d","title":"Challenge: Bitmask DP","idea":"Encode the chosen subset in bits and transition by adding one unused item.","complexity":"O(2^n * n^2) typical · O(2^n*n) space","source":"fn travelling_salesman(cost: &[Vec<i32>]) -> i32 {\n    let n = cost.len();\n    assert!(n > 0 && n <= 16);\n    let states = 1 << n;\n    let infinity = i32::MAX / 4;\n    let mut dp = vec![vec![infinity; n]; states];\n    dp[1][0] = 0;\n    for mask in 1..states {\n        for last in 0..n {\n            if dp[mask][last] == infinity {\n                continue;\n            }\n            for next in 0..n {\n                if mask >> next & 1 == 0 {\n                    let new = mask | 1 << next;\n                    dp[new][next] = dp[new][next].min(dp[mask][last] + cost[last][next]);\n                }\n            }\n        }\n    }\n    (0..n)\n        .map(|last| dp[states - 1][last] + cost[last][0])\n        .min()\n        .unwrap()\n}\n\nfn main() {\n    let result = travelling_salesman(&[vec![0, 1, 10], vec![1, 0, 2], vec![10, 2, 0]]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"travelling_salesman","statement":"let n = cost.len();"},{"line":3,"function":"travelling_salesman","statement":"assert!(n > 0 && n <= 16);"},{"line":4,"function":"travelling_salesman","statement":"let states = 1 << n;"},{"line":5,"function":"travelling_salesman","statement":"let infinity = i32::MAX / 4;"},{"line":6,"function":"travelling_salesman","statement":"let mut dp = vec![vec![infinity; n]; states];"},{"line":7,"function":"travelling_salesman","statement":"dp[1][0] = 0;"},{"line":8,"function":"travelling_salesman","statement":"for mask in 1..states {"},{"line":9,"function":"travelling_salesman","statement":"for last in 0..n {"},{"line":10,"function":"travelling_salesman","statement":"if dp[mask][last] == infinity {"},{"line":11,"function":"travelling_salesman","statement":"continue;"},{"line":13,"function":"travelling_salesman","statement":"for next in 0..n {"},{"line":14,"function":"travelling_salesman","statement":"if mask >> next & 1 == 0 {"},{"line":15,"function":"travelling_salesman","statement":"let new = mask | 1 << next;"},{"line":16,"function":"travelling_salesman","statement":"dp[new][next] = dp[new][next].min(dp[mask][last] + cost[last][next]);"},{"line":17,"function":"travelling_salesman","statement":"}"},{"line":21,"function":"travelling_salesman","statement":"(0..n)"},{"line":22,"function":"closure · line 22","statement":"dp[states - 1][last] + cost[last][0]"},{"line":28,"function":"main","statement":"let result = travelling_salesman(&[vec![0, 1, 10], vec![1, 0, 2], vec![10, 2, 0]]).to_string();"},{"line":29,"function":"main","statement":"println!(\"{result}\");"},{"line":30,"function":"main","statement":"}"}],"version":1,"input":"matrix=[[0,1,10],[1,0,2],[10,2,0]]","stdout":"13\n","values":[{"type":"&[alloc::vec::Vec<i32>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"0"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"10"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"0"},{"kind":"scalar","text":"2"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"10"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"0"}],"tuple":false}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"3"}},{"type":"usize","data":{"kind":"scalar","text":"8"}},{"type":"i32","data":{"kind":"scalar","text":"536870911"}},{"type":"alloc::vec::Vec<alloc::vec::Vec<i32>>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"536870911"},{"kind":"scalar","text":"536870911"},{"kind":"scalar","text":"536870911"}],"tuple":false},{"kind":"list","items":[{"kind":"scalar","text":"536870911"},{"kind":"scalar","text":"536870911"},{"kind":"scalar",