{"key":"reservoir-sampling-48565caa085f443a","sourceHash":"48565caa085f443a524a3ada1155e3b7ef60251287cffd6e19e6fa4f39df916c","pattern":"reservoir-sampling","category":"scans","title":"Challenge: Reservoir Sampling","idea":"Replace a fixed reservoir with decreasing probability while streaming unknown-length input.","complexity":"O(n) time · O(1) reservoir state for k=1","source":"fn reservoir(values: &[i32], choices: &[usize]) -> Option<i32> {\n    assert_eq!(values.len(), choices.len());\n    let mut selected = None;\n    for (i, (&value, &choice)) in values.iter().zip(choices).enumerate() {\n        assert!(choice <= i); // choice is uniform in 0..=i in a random run\n        if choice == i {\n            selected = Some(value);\n        }\n    }\n    selected\n}\n\nfn main() {\n    let result = reservoir(&[5, 6, 7], &[0, 0, 2]).map_or(\"none\".into(), |x| x.to_string());\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"reservoir","statement":"assert_eq!(values.len(), choices.len());"},{"line":3,"function":"reservoir","statement":"let mut selected = None;"},{"line":4,"function":"reservoir","statement":"for (i, (&value, &choice)) in values.iter().zip(choices).enumerate() {"},{"line":5,"function":"reservoir","statement":"assert!(choice <= i);"},{"line":6,"function":"reservoir","statement":"if choice == i {"},{"line":7,"function":"reservoir","statement":"selected = Some(value);"},{"line":8,"function":"reservoir","statement":"}"},{"line":10,"function":"reservoir","statement":"selected"},{"line":14,"function":"main","statement":"let result = reservoir(&[5, 6, 7], &[0, 0, 2]).map_or(\"none\".into(), |x| x.to_string());"},{"line":15,"function":"main","statement":"println!(\"{result}\");"},{"line":16,"function":"main","statement":"}"},{"line":14,"function":"closure · line 14","statement":"x.to_string()"}],"version":1,"input":"values=[5,6,7]; choices=[0,0,2]","stdout":"7\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"5"