{"key":"interval-dp-2e6288f9a48be7b3","sourceHash":"2e6288f9a48be7b3c2f322401741ad9b1e407cf0892fe584523ebae7d089dcf9","pattern":"interval-dp","category":"dynamic-2d","title":"Interval DP: Mental Model","idea":"Solve increasing interval lengths and choose the last or first action inside each interval.","complexity":"O(n^3) typical · O(n^2) space","source":"fn balloon_coins(values: &[i32]) -> i32 {\n    let mut a = vec![1];\n    a.extend_from_slice(values);\n    a.push(1);\n    let n = a.len();\n    let mut dp = vec![vec![0; n]; n];\n    for width in 2..n {\n        for left in 0..n - width {\n            let right = left + width;\n            for last in left + 1..right {\n                dp[left][right] = dp[left][right]\n                    .max(dp[left][last] + dp[last][right] + a[left] * a[last] * a[right]);\n            }\n        }\n    }\n    dp[0][n - 1]\n}\n\nfn main() {\n    let result = balloon_coins(&[3, 1, 5, 8]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"balloon_coins","statement":"let mut a = vec![1];"},{"line":3,"function":"balloon_coins","statement":"a.extend_from_slice(values);"},{"line":4,"function":"balloon_coins","statement":"a.push(1);"},{"line":5,"function":"balloon_coins","statement":"let n = a.len();"},{"line":6,"function":"balloon_coins","statement":"let mut dp = vec![vec![0; n]; n];"},{"line":7,"function":"balloon_coins","statement":"for width in 2..n {"},{"line":8,"function":"balloon_coins","statement":"for left in 0..n - width {"},{"line":9,"function":"balloon_coins","statement":"let right = left + width;"},{"line":10,"function":"balloon_coins","statement":"for last in left + 1..right {"},{"line":11,"function":"balloon_coins","statement":"dp[left][right] = dp[left][right]"},{"line":13,"function":"balloon_coins","statement":"}"},{"line":16,"function":"balloon_coins","statement":"dp[0][n - 1]"},{"line":20,"function":"main","statement":"let result = balloon_coins(&[3, 1, 5, 8]).to_string();"},{"line":21,"f