{"key":"list-reversal-424aa043b6b37009","sourceHash":"424aa043b6b370095017c425029cb01b5781a93d37427698c33efadc20ac271d","pattern":"list-reversal","category":"linked-lists","title":"Iterative List Reversal: Mental Model","idea":"Detach the next link before redirecting the current node toward the reversed prefix.","complexity":"O(n) time · O(1) links","source":"type Link = Option<Box<ListNode>>;\nstruct ListNode {\n    value: i32,\n    next: Link,\n}\nfn list(values: &[i32]) -> Link {\n    values.iter().rev().fold(None, |next, &value| {\n        Some(Box::new(ListNode { value, next }))\n    })\n}\nfn list_values(head: &Link) -> Vec<i32> {\n    let mut out = Vec::new();\n    let mut p = head.as_deref();\n    while let Some(n) = p {\n        out.push(n.value);\n        p = n.next.as_deref();\n    }\n    out\n}\nfn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn reverse(mut head: Link) -> Link {\n    let mut reversed = None;\n    while let Some(mut node) = head {\n        head = node.next.take();\n        node.next = reversed;\n        reversed = Some(node);\n    }\n    reversed\n}\n\nfn main() {\n    let result = csv(list_values(&reverse(list(&[1, 2, 3, 4]))));\n    println!(\"{result}\");\n}\n","sites":[{"line":7,"function":"list","statement":"values.iter().rev().fold(None, |next, &value| {"},{"line":8,"function":"closure · line 7","statement":"Some(Box::new(ListNode { value, next }))"},{"line":12,"function":"list_values","statement":"let mut out = Vec::new();"},{"line":13,"function":"list_values","statement":"let mut p = head.as_deref();"},{"line":14,"function":"list_values","statement":"while let Some(n) = p {"},{"line":15,"function":"list_values","statement":"out.push(n.value);"},{"line":16,"function":"list_values","statement":"p = n.next.as_deref();"},{"line":17,"function":"list_values","statement":"}"},{"line":18,"function":"list_values","statement":"out"},{"line":27,"function":"reverse","statement":"let mut reversed = None;"},{"line":28,"function":"reverse","statement":"while let Some(mut node) = head {"},{"line":29,"function":"reverse","statement":"head = node.next.take();"},{"line":30,"function":"reverse","statement":"node.next = reversed;"},{"line":31,"function":"reverse","statement":"reversed = Some(node);"},{"line":32,"function":"reverse","statement":"}"},{"line":33,"function":"reverse","statement":"reversed"},{"line":37,"function":"main","statement":"let result = csv(list_values(&reverse(list(&[1, 2, 3, 4]))));"},{"line":38,"function":"main","statement":"println!(\"{result}\");"},{"line":39,"function":"main","statement":"}"}],"version":1,"input":"1->2->3->4","stdout":"4,3,2,1\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"scalar","text":"None"}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"scalar","text":"4"}]]}}],"tuple":true}}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"core::option::Option<alloc::boxed::Box<traced::ListNode>>","data":{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"named","name":"Some","value":{"kind":"list","items":[{"kind":"named","name":"ListNode","value":{"kind":"map","entries":[[{"kind":"scalar","text":"next"},{"kind":"scalar","text":"None"}],[{"kind":"scalar","text":"value"},{"kind":"sc