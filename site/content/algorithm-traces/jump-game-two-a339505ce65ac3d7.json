{"key":"jump-game-two-a339505ce65ac3d7","sourceHash":"a339505ce65ac3d7b0dc850e5c7f27a989c6eeba606620819ebbdcc5fa1df4a4","pattern":"jump-game-two","category":"greedy-intervals","title":"Greedy Layered Jumps: Mental Model","idea":"Treat the current reach as a BFS layer and commit a jump when the scan reaches its boundary.","complexity":"O(n) time · O(1) space","source":"fn minimum_jumps(values: &[usize]) -> i32 {\n    if values.is_empty() {\n        return -1;\n    }\n    let (mut end, mut farthest, mut jumps) = (0, 0, 0);\n    for i in 0..values.len() - 1 {\n        if i > farthest {\n            return -1;\n        }\n        farthest = farthest.max(i + values[i]);\n        if i == end {\n            if farthest == end {\n                return -1;\n            }\n            jumps += 1;\n            end = farthest;\n            if end >= values.len() - 1 {\n                break;\n            }\n        }\n    }\n    jumps\n}\n\nfn main() {\n    let result = minimum_jumps(&[2, 3, 1, 1, 4]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"minimum_jumps","statement":"if values.is_empty() {"},{"line":3,"function":"minimum_jumps","statement":"return -1;"},{"line":5,"function":"minimum_jumps","statement":"let (mut end, mut farthest, mut jumps) = (0, 0, 0);"},{"line":6,"function":"minimum_jumps","statement":"for i in 0..values.len() - 1 {"},{"line":7,"function":"minimum_jumps","statement":"if i > farthest {"},{"line":8,"function":"minimum_jumps","statement":"return -1;"},{"line":10,"function":"minimum_jumps","statement":"farthest = farthest.max(i + values[i]);"},{"line":11,"function":"minimum_jumps","statement":"if i == end {"},{"line":12,"function":"minimum_jumps","statement":"if farthest == end {"},{"line":13,"function":"minimum_jumps","statement":"return -1;"},{"line":15,"function":"minimum_jumps","statement":"jumps += 1;"},{"line":16,"function":"minimum_jumps","statement":"end = farthest;"},{"line":17,"function":"minimum_jumps","statement":"if end >= values.len() - 1 {"},{"line":18,"function":"minimum_jumps","statement":"break;"},{"line":22,"function":"minimum_jumps","statement":"jumps"},{"line":26,"function":"main","statement":"let result = minimum_jumps(&[2, 3, 1, 1, 4]).to_string();"},{"line":27,"function":"main","statement":"println!(\"{result}\");"},{"line":28,"function":"main","statement":"}"}],"version":1,"input":"[2,3,1,1,4]","stdout":"2\n","values":[{"type":"&[usize]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"1"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"i32","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"i32","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"2\""}}],"frames":[{"site":15,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0]]},{"site":2,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0]]},{"site":3,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",1],["jumps",2]]},{"site":4,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",1],["jumps",2],["i",1]]},{"site":6,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",1],["jumps",2],["i",1]]},{"site":7,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",3],["jumps",2],["i",1]]},{"site":8,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",3],["jumps",2],["i",1]]},{"site":10,"stack":[["main",1],["minimum_jumps",2]],"locals":[["values",0],["end",1],["farthest",3],["jumps",2],["i