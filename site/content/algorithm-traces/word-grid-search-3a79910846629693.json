{"key":"word-grid-search-3a79910846629693","sourceHash":"3a79910846629693787986644f7b8a33d876031a3f9439f61a3df13b1fd05ba1","pattern":"word-grid-search","category":"backtracking","title":"Challenge: Grid Word Search","idea":"Walk matching neighbors while temporarily marking the current cell unavailable in this path.","complexity":"O(rows*cols*4^L) worst · O(L) depth","source":"fn word_exists(grid: &[Vec<u8>], word: &[u8]) -> bool {\n    fn search(\n        g: &[Vec<u8>],\n        w: &[u8],\n        r: usize,\n        c: usize,\n        i: usize,\n        seen: &mut [Vec<bool>],\n    ) -> bool {\n        if seen[r][c] || g[r][c] != w[i] {\n            return false;\n        }\n        if i + 1 == w.len() {\n            return true;\n        }\n        seen[r][c] = true;\n        let mut found = false;\n        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {\n            let (a, b) = (r as isize + dr, c as isize + dc);\n            if a >= 0\n                && b >= 0\n                && a < g.len() as isize\n                && b < g[0].len() as isize\n                && search(g, w, a as usize, b as usize, i + 1, seen)\n            {\n                found = true;\n                break;\n            }\n        }\n        seen[r][c] = false;\n        found\n    }\n    if word.is_empty() {\n        return true;\n    }\n    if grid.is_empty() {\n        return false;\n    }\n    let mut seen = vec![vec![false; grid[0].len()]; grid.len()];\n    (0..grid.len()).any(|r| (0..grid[r].len()).any(|c| search(grid, word, r, c, 0, &mut seen)))\n}\n\nfn main() {\n    let result = word_exists(&[\"A\".as_bytes().to_vec()], \"B\".as_bytes()).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":33,"function":"word_exists","statement":"if word.is_empty() {"},{"line":34,"function":"word_exists","statement":"return true;"},{"line":36,"function":"word_exists","statement":"if grid.is_empty() {"},{"line":37,"function":"word_exists","statement":"return false;"},{"line":39,"function":"word_exists","statement":"let mut seen = vec![vec![false; grid[0].len()]; grid.len()];"},{"line":40,"function":"word_exists","statement":"(0..grid.len()).any(|r| (0..grid[r].len()).any(|c| search(grid, word, r, c, 0, &mut seen)))"},{"line":10,"function":"search","statement":"if seen[r][c] || g[r][c] != w[i] {"},{"line":11,"function":"search","statement":"return false;"},{"line":13,"function":"search","statement":"if i + 1 == w.len() {"},{"line":14,"function":"search","statement":"return true;"},{"line":16,"function":"search","statement":"seen[r][c] = true;"},{"line":17,"function":"search","statement":"let mut found = false;"},{"line":18,"function":"search","statement":"for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {"},{"line":19,"function":"search","statement":"let (a, b) = (r as isize + dr, c as isize + dc);"},{"line":20,"function":"search","statement":"if a >= 0"},{"line":26,"function":"search","statement":"found = true;"},{"line":27,"function":"search","statement":"break;"},{"line":30,"function":"search","statement":"seen[r][c] = false;"},{"line":31,"function":"search","statement":"found"},{"line":40,"function":"closure · line 40","statement":"(0..grid[r].len()).any(|c| search(grid, word, r, c, 0, &mut seen))"},{"line":40,"function":"closure · line 40","statement":"search(grid, word, r, c, 0, &mut seen)"},{"line":44,"function":"main","statement":"let result = word_exists(&[\"A\".as_bytes().to_vec()], \"B\".as_bytes()).to_string();"},{"line":45,"function":"main","statement":"println!(\"{result}\");"},{"line":46,"function":"main","statement":"}"}],"version":1,"input":"grid=A word=B","stdout":"false\n","values":[{"type":"&[alloc::vec::Vec<u8>]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"65"}],"tuple":false}],"tuple":false}},{"type":"&[u8]","data":{"kind":"list","items":[{"kind":"scalar","text":"66"}],"tuple":false}},{"type":"alloc::vec::Vec<alloc::vec::Vec<bool>>","data":{"kind":"list","items":[{"kind":"list","item