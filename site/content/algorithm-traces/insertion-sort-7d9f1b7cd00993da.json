{"key":"insertion-sort-7d9f1b7cd00993da","sourceHash":"7d9f1b7cd00993da65e2efedc41616e411107872477851c066aaf83f077ba0fa","pattern":"insertion-sort","category":"sorting-selection","title":"Insertion Sort: Mental Model","idea":"Grow a sorted prefix by shifting each new item to its insertion position.","complexity":"O(n^2) worst · O(n) best · O(1) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\n\nfn insertion_sort_by_key<T: Clone, K: Ord>(values: &mut [T], key: impl Fn(&T) -> K) {\n    for i in 1..values.len() {\n        let value = values[i].clone();\n        let mut j = i;\n        // A strict comparison leaves an equal earlier key in front.\n        while j > 0 && key(&values[j - 1]) > key(&value) {\n            values[j] = values[j - 1].clone();\n            j -= 1;\n        }\n        values[j] = value;\n    }\n}\nfn insertion_sort(values: &mut [i32]) {\n    insertion_sort_by_key(values, |x| *x);\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![5, 2, 4, 6, 1, 3];\n        insertion_sort(&mut values);\n        csv(values)\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":9,"function":"insertion_sort_by_key","statement":"for i in 1..values.len() {"},{"line":10,"function":"insertion_sort_by_key","statement":"let value = values[i].clone();"},{"line":11,"function":"insertion_sort_by_key","statement":"let mut j = i;"},{"line":13,"function":"insertion_sort_by_key","statement":"while j > 0 && key(&values[j - 1]) > key(&value) {"},{"line":14,"function":"insertion_sort_by_key","statement":"values[j] = values[j - 1].clone();"},{"line":15,"function":"insertion_sort_by_key","statement":"j -= 1;"},{"line":16,"function":"insertion_sort_by_key","statement":"}"},{"line":17,"function":"insertion_sort_by_key","statement":"values[j] = value;"},{"line":18,"function":"insertion_sort_by_key","statement":"}"},{