{"key":"counting-sort-27efd6752d9570eb","sourceHash":"27efd6752d9570ebbc7162dd15883158487fe008e2c13e55ecfc74fb2e60dd2e","pattern":"counting-sort","category":"sorting-selection","title":"Counting Sort: Mental Model","idea":"Count every key in a small known range and emit keys by frequency.","complexity":"O(n+k) time · O(k) space","source":"fn csv<T: std::fmt::Display>(a: impl IntoIterator<Item = T>) -> String {\n    a.into_iter()\n        .map(|x| x.to_string())\n        .collect::<Vec<_>>()\n        .join(\",\")\n}\nfn counting_sort(values: &[usize], maximum: usize) -> Vec<usize> {\n    let mut counts = vec![0; maximum + 1];\n    for &x in values {\n        counts[x] += 1;\n    }\n    let mut out = Vec::with_capacity(values.len());\n    for (x, &count) in counts.iter().enumerate() {\n        out.extend(std::iter::repeat_n(x, count));\n    }\n    out\n}\n\nfn main() {\n    let result = csv(counting_sort(&[4, 2, 2, 5, 0, 1, 4], 5));\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"counting_sort","statement":"let mut counts = vec![0; maximum + 1];"},{"line":9,"function":"counting_sort","statement":"for &x in values {"},{"line":10,"function":"counting_sort","statement":"counts[x] += 1;"},{"line":11,"function":"counting_sort","statement":"}"},{"line":12,"function":"counting_sort","statement":"let mut out = Vec::with_capacity(values.len());"},{"line":13,"function":"counting_sort","statement":"for (x, &count) in counts.iter().enumerate() {"},{"line":14,"function":"counting_sort","statement":"out.extend(std::iter::repeat_n(x, count));"},{"line":15,"function":"counting_sort","statement":"}"},{"line":16,"function":"counting_sort","statement":"out"},{"line":20,"function":"main","statement":"let result = csv(counting_sort(&[4, 2, 2, 5, 0, 1, 4], 5));"},{"line":21,"function":"main","statement":"println!(\"{result}\");"},{"line":22,"function":"main","statement":"}"}],"version":1,"input":"[4,2,2,5,0,1,4]","stdout":"0,1,2,2,4,4,5\n","values":[{"type":"&[usize]","da