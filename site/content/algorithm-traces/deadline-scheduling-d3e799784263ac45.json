{"key":"deadline-scheduling-d3e799784263ac45","sourceHash":"d3e799784263ac452303d0fe3d4de90f92432ba9337b66b37ebcef5bbe772d69","pattern":"deadline-scheduling","category":"greedy-intervals","title":"Challenge: Deadline Profit Scheduling","idea":"Process jobs by deadline while a heap keeps only the best feasible set.","complexity":"O(n log n) time · O(n) space","source":"fn maximum_profit(jobs: &[(usize, i32)]) -> i32 {\n    fn free(parent: &mut [usize], x: usize) -> usize {\n        if parent[x] != x {\n            parent[x] = free(parent, parent[x]);\n        }\n        parent[x]\n    }\n    let mut sorted = jobs.to_vec();\n    sorted.sort_by_key(|&(d, p)| (std::cmp::Reverse(p), d));\n    let n = jobs.len();\n    let mut parent: Vec<_> = (0..=n).collect();\n    let mut profit = 0;\n    for (deadline, value) in sorted {\n        if value <= 0 {\n            continue;\n        }\n        let slot = free(&mut parent, deadline.min(n));\n        if slot > 0 {\n            profit += value;\n            parent[slot] = free(&mut parent, slot - 1);\n        }\n    }\n    profit\n}\n\nfn main() {\n    let result = maximum_profit(&[(1, 5), (1, 10)]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":8,"function":"maximum_profit","statement":"let mut sorted = jobs.to_vec();"},{"line":9,"function":"maximum_profit","statement":"sorted.sort_by_key(|&(d, p)| (std::cmp::Reverse(p), d));"},{"line":10,"function":"maximum_profit","statement":"let n = jobs.len();"},{"line":11,"function":"maximum_profit","statement":"let mut parent: Vec<_> = (0..=n).collect();"},{"line":12,"function":"maximum_profit","statement":"let mut profit = 0;"},{"line":13,"function":"maximum_profit","statement":"for (deadline, value) in sorted {"},{"line":14,"function":"maximum_profit","statement":"if value <= 0 {"},{"line":15,"function":"maximum_profit","statement":"continue;"},{"line":17,"function":"maximum_profit","statement":"let slot = free(&mut parent, deadline.min(n));"},{"line":18,"function":"maximum_profit","statement":"if slot > 0 {"},{"line":19,"function":"maximum_profit","statement":"profit += value;"},{"line":20,"function":"maximum_profit","statement":"parent[slot] = free(&mut parent, slot - 1);"},{"line":21,"function":"maximum_profit","statement":"}"},{"line":23,"function":"maximum_profit","statement":"profit"},{"line":3,"function":"free","statement":"if parent[x] != x {"},{"line":4,"function":"free","statement":"parent[x] = free(parent, parent[x]);"},{"line":5,"function":"free","statement":"}"},{"line":6,"function":"free","statement":"parent[x]"},{"line":9,"function":"closure · line 9","statement":"(std::cmp::Reverse(p), d)"},{"line":27,"function":"main","statement":"let result = maximum_profit(&[(1, 5), (1, 10)]).to_string();"},{"line":28,"function":"main","statement":"println!(\"{result}\");"},{"line":29,"function":"main","statement":"}"}],"version":1,"input":"jobs=(d1,p5),(d1,p10)","stdout":"10\n","values":[{"type":"&[(usize, i32)]","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"10"}],"tuple":true}],"tuple":false}},{"type":"alloc::vec::Vec<(usize, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"10"}],"tuple":true}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"i32","data":{"kind":"scalar","text":"10"}},{"type":"i32","data":{"kind":"scalar","text":"5"}},{"type":"alloc::vec::Vec<(usize, i32)>","data":{"kind":"list","items":[{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"10"}],"tuple":true},{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"5"}],"tuple":true}],"tuple":false}},{"type":"usize","data":{"kind":"scalar","text":"2"}},{"type":"allo