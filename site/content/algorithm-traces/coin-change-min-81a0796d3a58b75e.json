{"key":"coin-change-min-81a0796d3a58b75e","sourceHash":"81a0796d3a58b75e7534548f682a772c211b7a57b08ff21627ba1fece3c8b2a0","pattern":"coin-change-min","category":"dynamic-1d","title":"Challenge: Coin Change Minimum","idea":"Let each amount state choose one coin plus the best smaller reachable amount.","complexity":"O(amount * coins) time · O(amount) space","source":"fn fewest_coins(coins: &[usize], amount: usize) -> i32 {\n    assert!(coins.iter().all(|&c| c > 0));\n    let mut dp = vec![amount + 1; amount + 1];\n    dp[0] = 0;\n    for total in 1..=amount {\n        for &coin in coins {\n            if coin <= total {\n                dp[total] = dp[total].min(dp[total - coin] + 1);\n            }\n        }\n    }\n    if dp[amount] > amount {\n        -1\n    } else {\n        dp[amount] as i32\n    }\n}\n\nfn main() {\n    let result = fewest_coins(&[11], 11).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"fewest_coins","statement":"assert!(coins.iter().all(|&c| c > 0));"},{"line":3,"function":"fewest_coins","statement":"let mut dp = vec![amount + 1; amount + 1];"},{"line":4,"function":"fewest_coins","statement":"dp[0] = 0;"},{"line":5,"function":"fewest_coins","statement":"for total in 1..=amount {"},{"line":6,"function":"fewest_coins","statement":"for &coin in coins {"},{"line":7,"function":"fewest_coins","statement":"if coin <= total {"},{"line":8,"function":"fewest_coins","statement":"dp[total] = dp[total].min(dp[total - coin] + 1);"},{"line":9,"function":"fewest_coins","statement":"}"},{"line":12,"function":"fewest_coins","statement":"if dp[amount] > amount {"},{"line":13,"function":"fewest_coins","statement":"-1"},{"line":15,"function":"fewest_coins","statement":"dp[amount] as i32"},{"line":20,"function":"main","statement":"let result = fewest_coins(&[11], 11).to_string();"},{"line":21,"function":"main","statement":"println!(\"{result}\");"},{"line":22,"function":"main","statement":"}"}],"version":1,"input":"coins=[11]","stdou