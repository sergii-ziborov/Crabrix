{"key":"postfix-evaluation-5f65af9c32e3ba36","sourceHash":"5f65af9c32e3ba36ab984d0c45a4aef04a4361a79fcd1aa1f3c35088c1131185","pattern":"postfix-evaluation","category":"stacks-queues","title":"Postfix Evaluation: Mental Model","idea":"Push operands and reduce the latest operands whenever an operator arrives.","complexity":"O(n) time · O(n) space","source":"fn postfix(expression: &str) -> i32 {\n    let mut stack = Vec::new();\n    for token in expression.split_whitespace() {\n        if let Ok(value) = token.parse::<i32>() {\n            stack.push(value);\n            continue;\n        }\n        let right = stack.pop().unwrap();\n        let left = stack.pop().unwrap();\n        stack.push(match token {\n            \"+\" => left + right,\n            \"-\" => left - right,\n            \"*\" => left * right,\n            \"/\" => left / right,\n            _ => panic!(\"operator\"),\n        });\n    }\n    assert_eq!(stack.len(), 1);\n    stack[0]\n}\n\nfn main() {\n    let result = postfix(\"2 7 + 3 * 4 -\").to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"postfix","statement":"let mut stack = Vec::new();"},{"line":3,"function":"postfix","statement":"for token in expression.split_whitespace() {"},{"line":4,"function":"postfix","statement":"if let Ok(value) = token.parse::<i32>() {"},{"line":5,"function":"postfix","statement":"stack.push(value);"},{"line":6,"function":"postfix","statement":"continue;"},{"line":8,"function":"postfix","statement":"let right = stack.pop().unwrap();"},{"line":9,"function":"postfix","statement":"let left = stack.pop().unwrap();"},{"line":10,"function":"postfix","statement":"stack.push(match token {"},{"line":17,"function":"postfix","statement":"}"},{"line":18,"function":"postfix","statement":"assert_eq!(stack.len(), 1);"},{"line":19,"function":"postfix","statement":"stack[0]"},{"line":23,"function":"main","statement":"let result = postfix(\"2 7 + 3 * 4 -\").to_string();"},{"line":24,"function":"main","statement":"println!(\"{result}\");"},{"line":25,"function":"main","statement":"}"}],"version":1,"input":"2 7 + 3 * 4 -","stdout":"23\n","values":[{"type":"&str","data":{"kind":"scalar","text":"\"2 7 + 3 * 4 -\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"2\""}},{"type":"i32","data":{"kind":"scalar","text":"2"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"7\""}},{"type":"i32","data":{"kind":"scalar","text":"7"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"7"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"+\""}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"9"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"3\""}},{"type":"i32","data":{"kind":"scalar","text":"3"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"9"},{"kind":"scalar","text":"3"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"*\""}},{"type":"i32","data":{"kind":"scalar","text":"9"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"27"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"4\""}},{"type":"i32","data":{"kind":"scalar","text":"4"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"27"},{"kind":"scalar","text":"4"}],"tuple":false}},{"type":"&str","data":{"kind":"scalar","text":"\"-\""}},{"type":"i32","data":{"kind":"scalar","text":"27"}},{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scalar","text":"23"}],"tuple":false}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"23\""}}],"frames":[{"site":11,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["