{"key":"bidirectional-map-39332d771594de5d","sourceHash":"39332d771594de5dc717487064d3025553d6966ca5790f0ee4429d883201e420","pattern":"bidirectional-map","category":"hashing","title":"Bidirectional Mapping: Mental Model","idea":"Maintain both key-to-value and value-to-key constraints to enforce a bijection.","complexity":"O(n) expected time · O(k) space","source":"fn follows_pattern(pattern: &str, words: &[&str]) -> bool {\n    let letters: Vec<_> = pattern.chars().collect();\n    if letters.len() != words.len() {\n        return false;\n    }\n    let (mut forward, mut reverse) = (\n        std::collections::HashMap::new(),\n        std::collections::HashMap::new(),\n    );\n    for (&letter, &word) in letters.iter().zip(words) {\n        if forward.get(&letter).is_some_and(|&old| old != word)\n            || reverse.get(word).is_some_and(|&old| old != letter)\n        {\n            return false;\n        }\n        forward.insert(letter, word);\n        reverse.insert(word, letter);\n    }\n    true\n}\n\nfn main() {\n    let result = follows_pattern(\"abba\", &[\"red\", \"blue\", \"blue\", \"red\"]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"follows_pattern","statement":"let letters: Vec<_> = pattern.chars().collect();"},{"line":3,"function":"follows_pattern","statement":"if letters.len() != words.len() {"},{"line":4,"function":"follows_pattern","statement":"return false;"},{"line":6,"function":"follows_pattern","statement":"let (mut forward, mut reverse) = ("},{"line":10,"function":"follows_pattern","statement":"for (&letter, &word) in letters.iter().zip(words) {"},{"line":11,"function":"follows_pattern","statement":"if forward.get(&letter).is_some_and(|&old| old != word)"},{"line":14,"function":"follows_pattern","statement":"return false;"},{"line":16,"function":"follows_pattern","statement":"forward.insert(letter, word);"},{"line":17,"function":"follows_pattern","statement":"reverse.insert(word, letter);"},{"line":18,"funct