{"key":"selection-sort-6268d48fbd9c02d9","sourceHash":"6268d48fbd9c02d939d5b5dceb0a3d573871b5d150db880ed46d829e8947ea6c","pattern":"selection-sort","category":"sorting-selection","title":"Challenge: Selection Sort","idea":"Select the minimum remaining value and place it at the next boundary.","complexity":"O(n^2) time · O(1) space","source":"fn selection_swaps(values: &mut [i32]) -> usize {\n    let mut swaps = 0;\n    for i in 0..values.len() {\n        let minimum = (i..values.len()).min_by_key(|&j| values[j]).unwrap();\n        if minimum != i {\n            values.swap(i, minimum);\n            swaps += 1;\n        }\n    }\n    swaps // self-swaps are not counted\n}\n\nfn main() {\n    let result = {\n        let mut values = vec![1, 2, 3];\n        selection_swaps(&mut values).to_string()\n    };\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"selection_swaps","statement":"let mut swaps = 0;"},{"line":3,"function":"selection_swaps","statement":"for i in 0..values.len() {"},{"line":4,"function":"selection_swaps","statement":"let minimum = (i..values.len()).min_by_key(|&j| values[j]).unwrap();"},{"line":5,"function":"selection_swaps","statement":"if minimum != i {"},{"line":6,"function":"selection_swaps","statement":"values.swap(i, minimum);"},{"line":7,"function":"selection_swaps","statement":"swaps += 1;"},{"line":8,"function":"selection_swaps","statement":"}"},{"line":10,"function":"selection_swaps","statement":"swaps"},{"line":4,"function":"closure · line 4","statement":"values[j]"},{"line":14,"function":"main","statement":"let result = {"},{"line":15,"function":"main","statement":"let mut values = vec![1, 2, 3];"},{"line":16,"function":"main","statement":"selection_swaps(&mut values).to_string()"},{"line":18,"function":"main","statement":"println!(\"{result}\");"},{"line":19,"function":"main","statement":"}"}],"version":1,"input":"[1,2,3]","stdout":"0\n","values":[{"type":"alloc::vec::Vec<i32>","data":{"kind":"list","items":[{"kind":"scala