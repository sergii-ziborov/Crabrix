{"key":"binary-exact-92fbd43271c6bbce","sourceHash":"92fbd43271c6bbce6b42f44fb8f300eecda120ff0e2dd26aee407ed77fe21bc0","pattern":"binary-exact","category":"binary-search","title":"Challenge: Exact Binary Search","idea":"Discard the half that cannot contain the target after comparing the midpoint.","complexity":"O(log n) time · O(1) space","source":"fn exact_index(values: &[i32], target: i32) -> i32 {\n    let (mut lo, mut hi) = (0, values.len());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        if values[mid] < target {\n            lo = mid + 1;\n        } else {\n            hi = mid;\n        }\n    }\n    if values.get(lo) == Some(&target) {\n        lo as i32\n    } else {\n        -1\n    }\n}\n\nfn main() {\n    let result = exact_index(&[1, 3, 9], 9).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"exact_index","statement":"let (mut lo, mut hi) = (0, values.len());"},{"line":3,"function":"exact_index","statement":"while lo < hi {"},{"line":4,"function":"exact_index","statement":"let mid = lo + (hi - lo) / 2;"},{"line":5,"function":"exact_index","statement":"if values[mid] < target {"},{"line":6,"function":"exact_index","statement":"lo = mid + 1;"},{"line":7,"function":"exact_index","statement":"}"},{"line":8,"function":"exact_index","statement":"hi = mid;"},{"line":9,"function":"exact_index","statement":"}"},{"line":11,"function":"exact_index","statement":"if values.get(lo) == Some(&target) {"},{"line":12,"function":"exact_index","statement":"lo as i32"},{"line":14,"function":"exact_index","statement":"-1"},{"line":19,"function":"main","statement":"let result = exact_index(&[1, 3, 9], 9).to_string();"},{"line":20,"function":"main","statement":"println!(\"{result}\");"},{"line":21,"function":"main","statement":"}"}],"version":1,"input":"[1,3,9]","stdout":"2\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"1"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"9"}],"tuple