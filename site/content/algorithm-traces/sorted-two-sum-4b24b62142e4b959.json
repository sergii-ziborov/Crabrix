{"key":"sorted-two-sum-4b24b62142e4b959","sourceHash":"4b24b62142e4b9590f05caaf54014cbce3394128a34ce381e440806861755bdc","pattern":"sorted-two-sum","category":"two-pointers","title":"Sorted Two-Sum: Mental Model","idea":"Compare the end-pair sum with the target and discard one impossible endpoint.","complexity":"O(n) time · O(1) space","source":"fn sorted_pair(values: &[i32], target: i32) -> Option<(usize, usize)> {\n    if values.len() < 2 {\n        return None;\n    }\n    let (mut left, mut right) = (0, values.len() - 1);\n    while left < right {\n        match (values[left] + values[right]).cmp(&target) {\n            std::cmp::Ordering::Equal => return Some((left + 1, right + 1)),\n            std::cmp::Ordering::Less => left += 1,\n            std::cmp::Ordering::Greater => right -= 1,\n        }\n    }\n    None\n}\n\nfn main() {\n    let result =\n        sorted_pair(&[2, 3, 7, 11, 15], 17).map_or(\"-1,-1\".into(), |(a, b)| format!(\"{a},{b}\"));\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"sorted_pair","statement":"if values.len() < 2 {"},{"line":3,"function":"sorted_pair","statement":"return None;"},{"line":5,"function":"sorted_pair","statement":"let (mut left, mut right) = (0, values.len() - 1);"},{"line":6,"function":"sorted_pair","statement":"while left < right {"},{"line":7,"function":"sorted_pair","statement":"match (values[left] + values[right]).cmp(&target) {"},{"line":13,"function":"sorted_pair","statement":"None"},{"line":17,"function":"main","statement":"let result ="},{"line":19,"function":"main","statement":"println!(\"{result}\");"},{"line":20,"function":"main","statement":"}"},{"line":18,"function":"closure · line 18","statement":"format!(\"{a},{b}\")"}],"version":1,"input":"[2,3,7,11,15]","stdout":"1,5\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"2"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text":"11"},{"kind":"scalar","text":"15"}],"tuple":false}},{"type":"i32","data":{"kind":"scalar","text":"17"}},{"type":"usize","data":{"kind":"scalar","text":"0"}},{"type":"usize","data":{"kind":"scalar","text":"4"}},{"type":"usize","data":{"kind":"scalar","text":"1"}},{"type":"usize","data":{"kind":"scalar","text":"5"}},{"type":"alloc::string::String","data":{"kind":"scalar","text":"\"1,5\""}}],"frames":[{"site":6,"stack":[["main",1]],"locals":[]},{"site":0,"stack":[["main",1],["sorted_pair",2]],"locals":[["values",0],["target",1]]},{"site":2,"stack":[["main",1],["sorted_pair",2]],"locals":[["values",0],["target",1]]},{"site":3,"stack":[["main",1],["sorted_pair",2]],"locals":[["values",0],["target",1],["left",2],["right",3]]},{"site":4,"stack":[["main",1],["sorted_pair",2]],"locals":[["values",0],["target",1],["left",2],["right",3]]},{"site":9,"stack":[["main",1],["closure · line 18",3]],"locals":[["a",4],["b",5]]},{"site":7,"stack":[["main",1]],"locals":[["result",6]]},{"site":8,"stack":[["main",1]],"locals":[["result",6]]}],"verification":{"stdoutMatchesOriginal":true,"independentOracle":true,"omittedCaptures":0}}
