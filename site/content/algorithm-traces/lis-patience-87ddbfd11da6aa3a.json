{"key":"lis-patience-87ddbfd11da6aa3a","sourceHash":"87ddbfd11da6aa3ab67a99671d718af143cc815a9b9d18f7981200fe2c4e60b6","pattern":"lis-patience","category":"dynamic-1d","title":"Longest Increasing Subsequence: Mental Model","idea":"Keep the smallest possible tail for an increasing subsequence of every length.","complexity":"O(n log n) time · O(n) space","source":"fn lis_length(values: &[i32]) -> usize {\n    let mut tails = Vec::new();\n    for &x in values {\n        let i = tails.partition_point(|&old| old < x);\n        if i == tails.len() {\n            tails.push(x);\n        } else {\n            tails[i] = x;\n        }\n    }\n    tails.len()\n}\n\nfn main() {\n    let result = lis_length(&[10, 9, 2, 5, 3, 7, 101, 18]).to_string();\n    println!(\"{result}\");\n}\n","sites":[{"line":2,"function":"lis_length","statement":"let mut tails = Vec::new();"},{"line":3,"function":"lis_length","statement":"for &x in values {"},{"line":4,"function":"lis_length","statement":"let i = tails.partition_point(|&old| old < x);"},{"line":5,"function":"lis_length","statement":"if i == tails.len() {"},{"line":6,"function":"lis_length","statement":"tails.push(x);"},{"line":7,"function":"lis_length","statement":"}"},{"line":8,"function":"lis_length","statement":"tails[i] = x;"},{"line":9,"function":"lis_length","statement":"}"},{"line":11,"function":"lis_length","statement":"tails.len()"},{"line":4,"function":"closure · line 4","statement":"old < x"},{"line":15,"function":"main","statement":"let result = lis_length(&[10, 9, 2, 5, 3, 7, 101, 18]).to_string();"},{"line":16,"function":"main","statement":"println!(\"{result}\");"},{"line":17,"function":"main","statement":"}"}],"version":1,"input":"[10,9,2,5,3,7,101,18]","stdout":"4\n","values":[{"type":"&[i32]","data":{"kind":"list","items":[{"kind":"scalar","text":"10"},{"kind":"scalar","text":"9"},{"kind":"scalar","text":"2"},{"kind":"scalar","text":"5"},{"kind":"scalar","text":"3"},{"kind":"scalar","text":"7"},{"kind":"scalar","text