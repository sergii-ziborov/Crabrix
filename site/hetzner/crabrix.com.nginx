# Public reverse proxy for the independent Crabrix site on loopback port 3212.
# Enable the HTTPS server only after a certificate for crabrix.com exists.
server {
    listen 80;
    listen [::]:80;
    server_name crabrix.com;
    access_log /var/log/crabrix/access.log;
    error_log /var/log/crabrix/error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://crabrix.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name crabrix.com;
    access_log /var/log/crabrix/access.log;
    error_log /var/log/crabrix/error.log;

    ssl_certificate /etc/letsencrypt/live/crabrix.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crabrix.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Ciphertext relay only. Heartbeats keep idle interviews alive; buffering
    # must be disabled so code and selections arrive immediately.
    location ^~ /api/playground/ {
        access_log off;
        client_max_body_size 400k;
        client_body_timeout 10s;
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 15s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
}
