(module
  (import "crabrix_proc_macro_v1" "exchange" (func $exchange (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "crabrix_proc_macro_v1" "read_reply" (func $read (param i32 i32) (result i32)))
  (import "crabrix_native_proxy" "dispatch" (func $dispatch (param i32 i32) (result i64)))
  (memory (export "memory") 1 256)
  (func (export "__crabrix_pm_alloc") (param $length i32) (result i32) (local $pages i32)
    (if (i32.gt_u (local.get $length) (i32.const 16777216)) (then unreachable))
    (local.set $pages (i32.shr_u (i32.add (local.get $length) (i32.const 65535)) (i32.const 16)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1)) (then unreachable))))
    (i32.const 0))
  (func (export "__crabrix_pm_free") (param i32 i32))
  (export "__crabrix_pm_dispatch" (func $dispatch))
  (export "exchange" (func $exchange))
  (export "read_reply" (func $read)))
